+ * 串口日志会被抄进交接文档，抄一次就是一份凭据，和 carpet_link 里那句同一个理由）。
+ * 返回解出的字节数；负数 = 这一串不是合法十六进制（-1）或太长（-2）。 */
+static int hexval(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;

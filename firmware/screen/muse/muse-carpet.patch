+    static lv_font_t copies[sizeof(SIZES) / sizeof(SIZES[0])];
+    for (size_t i = 0; i < sizeof(SIZES) / sizeof(SIZES[0]); i++) {
+        if (font == SIZES[i]) {
+            if (!copies[i].get_glyph_dsc) {
+                copies[i] = *font;
+                copies[i].fallback = &muse_font_cjk_noto_16;
+            }
+            return &copies[i];
+        }
+    }
+#endif
+    return font;
+}

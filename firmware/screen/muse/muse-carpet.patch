+/* ---- 钟面的墙钟：Wi-Fi 起来后起一路 SNTP ---- */
+
+static bool s_sntp_started;
+
+/* gate_task 等到网之后叫一次（幂等）。不阻塞、不等同步：钟面 tick 自己读 time()，
+ * 没同步上就回落 "--:--"。TZ 定成中国标准时（CST-8），现场在那边。这一路只读时间，
+ * 不碰链路那把锁、也不改拨号阶梯 —— 钟面和 Screen-Link 各走各的。 */
+static void clock_sntp_start(void)
+{
+    if (s_sntp_started) return;
+    setenv("TZ", "CST-8", 1);
+    tzset();
+    esp_sntp_config_t cfg = ESP_NETIF_SNTP_DEFAULT_CONFIG("ntp.aliyun.com");
+    cfg.wait_for_sync = false;   /* 不建信号量、不在 gate 里等 */
+    esp_err_t err = esp_netif_sntp_init(&cfg);
+    if (err == ESP_OK) {
+        s_sntp_started = true;
+        ESP_LOGI(TAG, "SNTP 起：ntp.aliyun.com TZ=CST-8（钟面用，联网才同步）");
+    } else {
+        ESP_LOGW(TAG, "SNTP init: %s（钟面回落 --:--）", esp_err_to_name(err));
+    }
+}
+
+bool carpet_link_wallclock(int *year, int *mon, int *mday, int *hour, int *min)
+{
+    time_t now = time(NULL);
+    if (now < (time_t)1704067200) return false;   /* 2024-01-01 之前 = 还没同步上 */
+    struct tm tm;
+    localtime_r(&now, &tm);
+    if (year) *year = tm.tm_year + 1900;
+    if (mon)  *mon  = tm.tm_mon + 1;
+    if (mday) *mday = tm.tm_mday;
+    if (hour) *hour = tm.tm_hour;
+    if (min)  *min  = tm.tm_min;
+    return true;
+}
+
+static void gate_task(void *arg)
+{
+    (void)arg;
+    /* Home Link joins only after the phone has paired this gadget, so wait for
+     * a network instead of starting a link that can't resolve the URL. */
+    while (!muse_wifi_connected()) {
+        /* 250ms 而不是 2s：2026-11-13 冷启动掐表量到 got IP(5.50s) 到 dialing(7.12s)
+         * 之间白等 1.6 秒，全是这一格的粒度。它只在还没网的时候转，代价是几次空读。 */
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+
+    /* 网起来了就给钟面起对时（幂等，不阻塞下面的拨号阶梯）。 */
+    clock_sntp_start();
+
+    s_cb.on_connected = on_connected;
+    s_cb.on_disconnected = on_disconnected;
+    s_cb.on_state = on_state;
+    s_cb.on_dialog = on_dialog;
+    s_cb.on_command = on_command;
+    s_cb.on_ack = on_ack;      /* v4 上行那道闸读的就是这一句 */
+    s_cb.on_event = on_event;  /* B §1 守护灯点：去重/ack/过期都由组件做完，这里只记未读 */
+
+    /* 开不出去就阶梯再来一次，而不是印一条 E 然后把这条任务删掉。
+     * 删掉那一种的代价是 2026-11-10 真机称出来的：t=27s 关联上热点、t=29s
+     * `screen_link_start: ESP_ERR_NO_MEM`（link_task 那一整块栈那轮开不出来），
+     * 之后一直到 t=113s 都是 `ws=down dialed=0 fails=0` —— 屏有网、地址对、
+     * 手机上的服务端也确实活着（同一个固件 t=3.3s 报过 `linked, contract v3`），
+     * 但 App 那边永远显示"连不上圆屏"，屏这边一次都不再拨。
+     * 开机那几十秒正好是内部 RAM 最紧的一段时间（显示、字体、编解码器都在这时候抢），
+     * 撑过去就好了，所以这一条只需要等，不需要别的。 */
+    static const int GATE_RETRY_S[] = {5, 15, 30, 60};
+    const int LAST = (int)(sizeof GATE_RETRY_S / sizeof GATE_RETRY_S[0]) - 1;
+    for (int tries = 0; !s_link_started; tries++) {
+        esp_err_t err = ESP_OK;
+        xSemaphoreTake(s_link_mtx, portMAX_DELAY);
+        /* 拿到锁再说：`>url` 改地址那条（url_restart_task）也在这把锁后面开链路，
+         * 它先开成了的话这里就别再开 —— 第二次 start 只会撞 INVALID_STATE，
+         * 而这一条会把重试阶梯一直跑到 60 秒封顶，日志里全是假故障。 */
+        if (!s_link_started) {
+            url_read();
+            err = link_open();
+        }
+        xSemaphoreGive(s_link_mtx);
+        if (err == ESP_OK) break;
+        int wait_s = GATE_RETRY_S[tries > LAST ? LAST : tries];
+        ESP_LOGE(TAG, "screen_link_start: %s; %d 秒后再拨（第 %d 次）", esp_err_to_name(err),
+                 wait_s, tries + 1);
+        vTaskDelay(pdMS_TO_TICKS(wait_s * 1000));
+    }
+    /* 这一档还是 4096 **字节**（4 KB，不是 16 KB —— 这个 kernel 的 usStackDepth 按字节算），
+     * 没动它：它跑的是 url_read（读 NVS）+ link_open
+     * （里面 ws 句柄和链路任务都在建），现在正是建不起来的那一段时间，减它就是减余量。
+     * 先把它用完时的余量称出来，下次要抬要压都有数。 */
+    ESP_LOGI(TAG, "carpet_gate 这一趟用完还剩 %u 字节",
+             (unsigned)uxTaskGetStackHighWaterMark(NULL));
+    vTaskDelete(NULL);
+}
+
+void carpet_link_start(void)
+{
+    if (s_gate) return;
+    /* 开机补的两条（复位原因 + 唤醒原因 + PMU 在 init 里被清掉之前抄来的按键锁存）。
+     * 放在这里而不是 app_main：这会儿 NVS 已经挂上，PMU 也已经 init 过（那一步早于建 UI），
+     * 两个前提同时满足的只有这一点。 */
+    carpet_diag_boot();
+    /* 先建锁再建任务：链路回调和 UI 的 tick 都从这一把锁后面碰 s_state */
+    if (!s_lock) s_lock = xSemaphoreCreateMutex();
+    if (!s_cmdq) s_cmdq = xQueueCreate(CMD_QUEUE_LEN, sizeof(cmd_msg_t));
+    if (!s_link_mtx) s_link_mtx = xSemaphoreCreateMutex();
+    /* 6144 **字节**（= 6 KB）。**不是 24 KB**：这个 kernel 的 `StackType_t` 是 `uint8_t`
+     * （portmacro.h:78），`idf_additions.c:50` 那句 `usStackDepth * sizeof(StackType_t)`
+     * 是 ×1，`idf_additions.h:268` 也明写 "the number of bytes"。以前这条注释写成
+     * "6144 字 = 24 KB"，错了 4 倍 —— 24 KB 连续内部 RAM 在这块板上根本要不到
+     * （最大连续块实测 22–29K），而任务起来了，这本身就是单位的反证。
+     *
+     * 【2026-11-13 纠正：当初从 4096 抬到 6144 的"依据"是单位错算出来的，不是真溢出。】
+     * 两次实测的原始读数（都是字节）：4096 那档剩 1684，6144 这档剩 3732。
+     * 峰值 = 栈大小 − 剩余：4096−1684 = **2412**，6144−3732 = **2412** —— **两次一样深**。
+     * 旧注释把剩余当成"字"再乘 4，于是算出"峰值 3675 字 / 5211 字、比上次深 1536 字"，
+     * 全是假的；carpet_cmd 在 4096 字节上**从没溢出过**，还有 1684 字节余量。
+     * 现在保留 6144 不动（多吃 2 KB 内部 RAM，换叫醒那条路的余量，不冒回归风险），
+     * 但**别再拿"它需要 24 KB"当理由**；真要腾内部 RAM，这一档是可以压回 4096 的候选，
+     * 压之前重跑三次 nap → 叫醒看剩余。
+     * 没往 PSRAM 放：这条任务要写 flash，写的时候 cache 会关，栈在 PSRAM 的任务不能干这个
+     * （muse_voice.c 给语音任务用 MUSE_BIG_CAPS 时注明：PSRAM 栈的任务碰不得 flash，
+     * 读写都不行 —— 读 NVS 关 cache 那一下栈就不可访问，2026-11-19 实测过）。 */
+    if (xTaskCreate(cmd_task, "carpet_cmd", 6144, NULL, 4, &s_cmd_task) != pdPASS) {
+        s_cmd_task = NULL;
+        ESP_LOGE(TAG, "cmd task out of memory");
+    }
+    if (xTaskCreate(gate_task, "carpet_gate", 4096, NULL, 4, &s_gate) != pdPASS) {
+        s_gate = NULL;
+        ESP_LOGE(TAG, "gate task out of memory");
+    }
+    /* 上行那两只 256 KB 段缓冲 + 那条发送任务在这儿要，不在按下那一刻要：
+     * 开机这几十秒是 PSRAM 最整的一段时间，等手机把链路和语音缓冲都铺开之后再要
+     * 256 KB **连续** PSRAM，就是"按下没反应"那种现场最难查的死法。
+     * 这里不碰 NVS（那一步还没跑 muse_settings_init()）；开关那一格由
+     * muse_app_run() 里的 carpet_mic_preload() 在 NVS 挂载后读掉 —— 不能拖到
+     * 按下那一刻：voice_task 的栈在 PSRAM，读 NVS 关 cache 会当场 assert。 */
+    carpet_mic_init();
+    /* 唤醒词同理，而且更挑时候：create() 要一块 12,288 B **连续内部**（实测），
+     * 开机这会儿内部 RAM 最整。等 Wi-Fi/TLS/LVGL 铺开之后再要，就是"总量够、连续不够"
+     * 那种要不到。这一步也不读设置（同上：muse_settings_init() 还没跑）。
+     * 要不到就只打日志：按键那条路照常好使，唤醒词这一格自己报 ready=0。 */
+    carpet_wake_init();
+}
+

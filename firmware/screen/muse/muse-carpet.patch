index 0000000..0507a5a
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_photo.h
@@ -0,0 +1,63 @@
+/*
+ * 契约的相册通道：`command{cmd:"photo_chunk"}` 进来的 JPEG 字节 → 相册页。
+ * 交接单：carpet-sat-demo/docs/SCREEN-HANDOFF-photo-chunk-2026-11-16.md（App 侧 b56662b 已发）。
+ *
+ * 和 carpet_audio 同族但账不同：audio_chunk 按 turn_id 接续念下一段（停嘴留账），
+ * photo_chunk 按 album_id 一张一张独立 —— 缺号整张丢、下一张换 id 重来，没有接续。
+ *
+ * 内存账（2026-11-18 实称）：这块板 PSRAM 8 MB，原先代码段+常量段 XIP 驻留吃掉 3.6 MB，
+ * 语音 2 MB 缓冲落地后只剩 132 KB —— 照片根本放不下。这一版把 XIP 退回 flash 执行
+ * （devices/sdkconfig.carpet 那三条），腾出 3.6 MB 给这里：拼装缓冲按第一帧申报的
+ * total 现拿（App 侧 PhotoPush 上限 1 MB），收齐进三环槽（最旧先出），解码由 LVGL
+ * 的 TJPGD 按 MCU 小块流式做，不另占整帧缓冲。拿不到内存就整张不收、留一行日志，
+ * 不挤语音那 2 MB —— 现场演示语音是主路，照片让路。
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "cJSON.h"
+
+/*
+ * 收到一帧 photo_chunk。**在链路任务里调**（和 audio 同一条回调），不碰 LVGL。
+ * args：{album_id, seq, total, fmt:"jpeg", b64}，块 2048 字节。
+ * 校验 → base64 解码 → 追加；收齐（收到字节 >= total）进环槽并打一行 `@photo 收齐`。
+ * 返回 false = 这一帧没用。调用方不 ack（和音频同一级：放不出就别说）。
+ */
+bool carpet_photo_on_chunk(const cJSON *args);
+
+/* 链路断了：只重置正在拼的那一张（半张留着会撞下一张的 seq）。
+ * 收齐的照片不清 —— 家人照片断线重连后还该在，和文字那句同一个道理。 */
+void carpet_photo_abort(const char *why);
+
+/* 环槽现状（LVGL 任务读）。gen 每收齐一张涨一；latest 是最新那张的下标。 */
+typedef struct {
+    int count;
+    int latest;
+    uint32_t gen;
+} carpet_photo_view_t;
+
+void carpet_photo_view(carpet_photo_view_t *v);
+
+/*
+ * 把第 index 张钉住并借出它的 JPEG 字节（LVGL 任务调）。钉住的槽不会被新照片顶掉 ——
+ * LVGL 的 TJPGD 是重绘时现解的，显示期间字节必须一直在。返回 NULL = 下标不对。
+ * 同时只钉一张：借新的自动松旧的。size 带出字节数。
+ */
+const uint8_t *carpet_photo_acquire(int index, size_t *size);
+
+/* `>carpet` 回读里那一行：收了几张、拼着哪张、丢过几次、最近一次为什么丢。 */
+void carpet_photo_dump(void);
+
+/* 扫 JPEG 的 SOF 段拿宽高（纯字节解析，不碰 LVGL）。TJPGD 的内存路要显示侧
+ * 先把宽高填进 lv_image_dsc_t 头，所以这一步省不掉。false = 不是 JPEG 或坏了。 */
+bool carpet_photo_jpeg_size(const uint8_t *buf, size_t n, uint16_t *w, uint16_t *h);
+
+/* 开发口 `>phototest`：把固件里嵌的那张测试 JPEG 按线上形状（2048 一块、b64、
+ * seq/total 齐全）喂进同一条 on_chunk，再翻到相册页 —— 和 >audtest 同一个道理：
+ * 不联网、不接手机，这块板在哪都能称接收+解码+渲染整条。每按一次换一张 album_id，
+ * 按两次就能称轮播。只在串口任务里调。 */
+void carpet_photo_bench(void);

diff --git a/esp32/components/muse/carpet/carpet_audio.c b/esp32/components/muse/carpet/carpet_audio.c
new file mode 100644
index 0000000..963d5b9
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_audio.c
@@ -0,0 +1,493 @@
+/*

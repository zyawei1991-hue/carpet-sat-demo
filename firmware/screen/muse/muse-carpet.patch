+#include "muse_board.h"      /* 屏幕几何：宽、高、是不是圆、有没有触摸、对角线 */
+#include "muse_chat_priv.h"   /* muse_hatch_caption_at()：按屏当前的 cols×lines 分页 */
+#include "muse_settings.h"
+#include "muse_state.h"
+#include "muse_wifi.h"
+#include "screen_link.h"
+
+static const char *TAG = "carpet";
+
+/* ---- 上行命令：UI 任务只入队，发送在 carpet_cmd 任务里 ---- */
+
+/* 下标就是契约里那三条在白名单里的顺序，也是屏上三个按钮的顺序。
+ * 组件里的 ALLOWED 表还包含 sos_press 等六条，这一版只发交互那三条。 */
+#define CMD_NONE 0
+#define CMD_COUNT 3
+static const char *const CMD_NAMES[CMD_COUNT] = { "card_next", "card_auto", "poke" };
+
+/* page_report 不在这三条里，因为它不是请求：三条是"用户做了什么，你算结果"，
+ * 这一条是"屏已经在这一页了，你照着写"。它带的是字符串而不是 dir，所以另开一个号，
+ * 也**不动 CMD_NAMES** —— core 的 SchemaDriftTest 拿那张表和契约比，多一条就红。 */
+#define CMD_PAGE (CMD_COUNT + 1)
+
+typedef struct {
+    int cmd;          /* CMD_NAMES 下标 + 1，0 表示空 */
+    int dir;          /* 只有 card_next 用 */
+    char page[16];    /* 只有 CMD_PAGE 用 */
+} cmd_msg_t;
+
+#define CMD_QUEUE_LEN 8
+static QueueHandle_t s_cmdq;
+static TaskHandle_t s_cmd_task;
+static volatile int s_last_cmd = CMD_NONE;
+static volatile int s_sent;
+/* 页报出去几条、最后一条是哪个：翻页是本地动作，"手机上那一格怎么还空着"
+ * 得能在串口一眼分清是屏没发还是手机没接。 */
+static volatile int s_pages_sent;
+static char s_last_page[16];
+
+/* One word each, written from the link task and read from the UI task: a
+ * briefly stale value only costs one frame of the page. */
+static volatile bool s_linked;
+static volatile int s_negotiated;
+static TaskHandle_t s_gate;
+
+/* 最新一帧 state 的**副本**：组件在回调返回后就把那棵原树释放了。
+ * UI 任务和链路任务碰同一棵树，所以必须有锁 —— 没锁的"换帧时删旧的"就是 use-after-free。 */
+static cJSON *s_state;
+static SemaphoreHandle_t s_lock;
+static char s_dialog[40];
+static uint32_t s_dialog_tick;
+
+/* ---- 首屏那张脸的答句 ----
+ *
+ * 答句的**显示**全走 Muse 自己留的口：caption（那张脸下面那条带）、mode（听/想/说）、
+ * level（嘴开合）、progress（环上那点进度）。我们不改 muse_ui.c，也不往脸上叠控件。
+ *
+ * 分页是这里唯一自己拿主意的地方。Muse 云端那一路是**按播放的音频字节**推进念稿位置
+ * 的（`muse_hatch_caption_at(text, at, ...)` 给的就是"at 落在哪一页"），我们没有声音
+ * —— ASR/TTS 都在 Muse 云，这台网络到不了 —— 所以按秒推 at。一页停 2.5 秒是照中文
+ * 朗读速度估的，不是量出来的；上板看一眼就知道该不该改。
+ */
+#define FACE_PAGE_US 2500000   /* 一页停多久 */
+#define FACE_HOLD_US 6000000   /* 念完再挂 6 秒，然后清空、脸收回 idle */
+
+/* 整句 / 上一版已经写上屏的那页 / 正在生成的下一页。三份都在 PSRAM：内部那 12K
+ * 是 ws 任务栈要找连续块的地方，别从它身上再切 1.2K。
+ * **三次独立分配，不是一块切三段** —— 同一块里的两段互为 snprintf/memcpy 的源和目标，
+ * 编译器按同一个对象算，`-Werror=restrict` 当场拦下（2026-11-05 就是这么失败的）。 */
+static char *s_face_text;
+static char *s_face_shown;
+static char *s_face_fresh;
+
+static bool s_face_live;          /* 锁里改：还有句子在挂 */
+static bool s_face_speaking;      /* 最后进来的是答句（dir=down），不是问句 */
+static size_t s_face_at;          /* 念到第几个字节 */
+static int64_t s_face_next_us;    /* 下一次翻页 */
+static int64_t s_face_hold_us;    /* 该收回的时刻 */
+static float s_face_level;        /* 假电平：每个 tick 在 0.22 / 0.70 之间摆（这一轮没声音时才用） */
+/* 这一句属于哪一轮。v3 的语音帧带着同一个 turn_id，所以"这句有没有声音、放到哪了"
+ * 是拿它对出来的 —— 不是拿时间猜。空串 = 这一轮没有 id（`>say` 之外不该出现）。 */
+static char s_face_turn[40];
+
+/* 刚见过的轮次。契约里 turn_id 由起头那一方生成、问和答共用同一个，所以"这一轮我们
+ * 是不是已经见过一句"在这里问一句就知道 —— 见过的那一轮（也就是答句）能挤掉正在念的
+ * 那句，没见过的新轮次（主动播报）不能：彩排台的脚本每 6 秒推一条，420 毫秒就把刚落地
+ * 189 字节的答句顶掉了（2026-11-05 实测），而念到一半被换掉是这条带最不能接受的失败。
+ * dir=up 是屏自己在说，它永远可以挤 —— 那是人家正要问。
+ * 只留 4 格、30 秒内算数：轮次是短命的，别为一句话攒记忆。
+ * 屏自己起头的那轮（将来由 `screen_link_send_dialog_up()` 发出去）要在**发的那一刻**
+ * 也记一笔 —— 那一轮的问句不会回镜，不记的话答句就成了"没见过的新轮次"，被挡在门外。 */
+#define ROUND_SLOTS 4
+#define ROUND_WINDOW_US 30000000
+static char s_round_ids[ROUND_SLOTS][40];
+static int64_t s_round_at_us[ROUND_SLOTS];
+static unsigned s_round_next;
+
+/* 只在锁里调。 */
+static void face_round_note(const char *id){
+    if (!id || !*id) return;
+    unsigned i = s_round_next++ % ROUND_SLOTS;
+    snprintf(s_round_ids[i], sizeof s_round_ids[i], "%s", id);
+    s_round_at_us[i] = esp_timer_get_time();
+}
+
+static bool face_round_seen(const char *id)
+{
+    if (!id || !*id) return false;
+    int64_t now = esp_timer_get_time();
+    for (unsigned i = 0; i < ROUND_SLOTS; i++) {
+        if (s_round_at_us[i] && s_round_ids[i][0] && strcmp(s_round_ids[i], id) == 0 &&
+            now - s_round_at_us[i] < ROUND_WINDOW_US) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* 只在锁里调。 */
+static bool face_bufs_get(void)
+{
+    if (s_face_text && s_face_shown && s_face_fresh) return true;
+    char *a = heap_caps_malloc(MUSE_CAPTION_MAX, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    char *b = heap_caps_malloc(MUSE_CAPTION_MAX, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    char *c = heap_caps_malloc(MUSE_CAPTION_MAX, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!a || !b || !c) {
+        free(a); free(b); free(c);
+        return false;
+    }
+    s_face_text = a;
+    s_face_shown = b;
+    s_face_fresh = c;
+    return true;
+}
+
+/* 同一维度下的复制：两边都是 MUSE_CAPTION_MAX，截断交给长度 */
+static void face_put(char *dst, const char *src)
+{
+    size_t n = strlen(src);
+    if (n >= MUSE_CAPTION_MAX) n = MUSE_CAPTION_MAX - 1;
+    memcpy(dst, src, n);
+    dst[n] = '\0';
+}
+
+/* 只写 muse_state（它自己带锁），不碰任何 LVGL 对象 —— 所以链路任务和 UI 任务
+ * 都能调，不必挪进队列。 */
+static void face_set_mode(muse_mode_t want)
+{
+    muse_mode_t was = muse_state_mode(NULL);
+    if (was == MUSE_MODE_LISTENING) return;   /* 有人正按着说话，别把他打断 */
+    if (was == MUSE_MODE_OFF) muse_state_set_mode(MUSE_MODE_IDLE);   /* 只有 idle 能离开 off */
+    muse_state_set_mode(want);
+}
+
+/* 这张脸现在有没有主人。没人有事的两张（IDLE / THINKING）才归链路搬，
+ * 其余各有其主：SPEAKING 是一句正在念（我们的答句，或 Muse 自己那条云链路的 TTS），
+ * LISTENING 是有人正按着说话，ERROR 是报警，BOOT/OFF 轮不到链路。
+ * 只在锁里调（读的是 muse_state，它自己带锁，这里说的"锁"是别写坏对面）。 */
+static bool face_mode_takeable(void)
+{
+    muse_mode_t m = muse_state_mode(NULL);
+    return m == MUSE_MODE_IDLE || m == MUSE_MODE_THINKING;
+}
+
+/* 契约里的英文枚举一律不许上屏（这是排版红线，不是风格），所以每个都查表；
+ * 认不出的值落"未知"而不是把原样印出去 —— 服务端加一个枚举值不该在屏上冒英文。 */
+typedef struct {
+    const char *key;
+    const char *cn;
+} kv_t;
+
+static const char *kv_lookup(const kv_t *tbl, const char *key, const char *fallback)
+{
+    if (!key) return fallback;
+    for (; tbl->key; tbl++) {
+        if (strcmp(tbl->key, key) == 0) return tbl->cn;
+    }
+    return "未知";
+}
+
+static const kv_t SAT_PHASE[] = {
+    { "idle", "空闲" },       { "searching", "找星" },   { "locked", "已锁定" },
+    { "tx_pending", "发送中" }, { "tx_ok", "已送达" },   { "tx_fail", "发送失败" },
+    { "tx_no_ack", "无回执" }, { NULL, NULL },
+};
+static const kv_t UI_CARD[] = {
+    { "status", "状态卡" },   { "sat", "卫星卡" },     { "dialog", "对话卡" },
+    { "emotion", "表情卡" },  { "clock", "钟面" },     { "maint", "养车卡" },
+    { NULL, NULL },
+};
+static const kv_t EMOTION[] = {
+    { "neutral", "中性" },    { "happy", "开心" },     { "excited", "兴奋" },
+    { "sad", "难过" },        { "worried", "担心" },   { "sleepy", "犯困" },
+    { "thinking", "思考" },   { NULL, NULL },
+};
+static const kv_t SOS_LEVEL[] = {
+    { "normal", "正常" },     { "armed", "待命" },     { "pending", "待发送" },
+    { "sent", "已发出" },     { "acked", "已确认" },   { NULL, NULL },
+};
+static const kv_t DIALOG_SRC[] = {
+    { "asr", "你说的" },      { "local_rule", "本地规则" }, { "model", "模型答的" },
+    { "local_fallback", "兜底话术" }, { "denied", "被拦住" }, { "xiaozhi_cloud", "小智云" },
+    { NULL, NULL },
+};
+
+static const char *str_of(const cJSON *obj, const char *key)
+{
+    const cJSON *item = cJSON_GetObjectItemCaseSensitive(obj, key);
+    return cJSON_IsString(item) ? item->valuestring : NULL;
+}
+
+/* 这一帧是不是"一条到点的养护"（手机那边算出 due/soon 才同时发这两个值；
+ * `note` 那档发的是中性，落不进这里，正好是它该要的"不抢脸"）。
+ * 不复用 fill_from_state：那个要往栈上放一个一百多字节的结构，而这里是链路任务的栈。 */
+static bool frame_maint_worried(const cJSON *st)
+{
+    const cJSON *ui = cJSON_GetObjectItemCaseSensitive(st, "ui");
+    if (!cJSON_IsObject(ui)) return false;
+    const char *card = str_of(ui, "card");
+    const char *emotion = str_of(ui, "emotion");
+    return card && emotion &&
+           strcmp(card, "maint") == 0 && strcmp(emotion, "worried") == 0;
+}
+
+static void fill_from_state(const cJSON *st, carpet_state_view_t *out)
+{
+    const cJSON *sat = cJSON_GetObjectItemCaseSensitive(st, "sat");
+    if (cJSON_IsObject(sat)) {
+        const char *phase = kv_lookup(SAT_PHASE, str_of(sat, "phase"), "—");
+        const cJSON *np = cJSON_GetObjectItemCaseSensitive(sat, "next_pass_in_s");
+        if (cJSON_IsNumber(np) && np->valueint >= 0) {
+            snprintf(out->sat, sizeof out->sat, "%s 下次%d:%02d",
+                     phase, np->valueint / 60, np->valueint % 60);
+        } else {
+            snprintf(out->sat, sizeof out->sat, "%s", phase);
+        }
+    }
+
+    const cJSON *ui = cJSON_GetObjectItemCaseSensitive(st, "ui");
+    if (cJSON_IsObject(ui)) {
+        const char *card = str_of(ui, "card");
+        snprintf(out->card, sizeof out->card, "%s", kv_lookup(UI_CARD, card, "—"));
+        /* 契约里 emotion 可以是 null：那是"这一帧不带情绪"，落回中性，
+         * 不是"保持上一帧"。这条在老固件上踩过一次（旧值一直挂着）。 */
+        const char *emotion = str_of(ui, "emotion");
+        snprintf(out->emotion, sizeof out->emotion, "%s",
+                 emotion ? kv_lookup(EMOTION, emotion, "未知") : "中性");
+        out->maint_worried = card && emotion &&
+                             strcmp(card, "maint") == 0 && strcmp(emotion, "worried") == 0;
+    } else {
+        snprintf(out->emotion, sizeof out->emotion, "%s", "中性");
+    }
+
+    const cJSON *sos = cJSON_GetObjectItemCaseSensitive(st, "sos");
+    snprintf(out->sos, sizeof out->sos, "%s",
+             cJSON_IsObject(sos) ? kv_lookup(SOS_LEVEL, str_of(sos, "level"), "—") : "—");
+}
+
+bool carpet_link_state(carpet_state_view_t *out)
+{
+    memset(out, 0, sizeof *out);
+    if (!s_lock) return false;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (s_state) {
+        fill_from_state(s_state, out);
+        out->has_state = true;
+    }
+    /* 一句对话只挂 5 秒：链路断了、或者两边不说话了，这一行不该一直写"手机在说" */
+    if (s_dialog[0]) {
+        uint32_t age_s = (xTaskGetTickCount() - s_dialog_tick) * portTICK_PERIOD_MS / 1000;
+        if (age_s <= 5) snprintf(out->dialog, sizeof out->dialog, "%s", s_dialog);
+    }
+    xSemaphoreGive(s_lock);
+    return out->has_state;
+}
+
+static void on_state(const cJSON *state, uint32_t seq)
+{
+    (void)seq;
+    /* IDF 那份 cJSON 只有 cJSON_True（类型位枚举），没有上游才加的 cJSON_TRUE */
+    cJSON *dup = cJSON_Duplicate(state, cJSON_True);
+    if (!dup) return;            /* 拷不动就沿用上一帧，反正 1 秒后还有 */
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    cJSON *old = s_state;
+    s_state = dup;
+    /* 到点的养护把脸换成"担心"（§5.4 建议 worried → THINKING，不给 ERROR：
+     * ERROR 是报警脸，观众读成"屏坏了"）。三道让路，一道都不能省：
+     * 　· 这句正挂在脸上（`s_face_live`）—— 语音还在播就把脸换走，嘴立刻不动，
+     *    而口型是这一轮的主功能；
+     * 　· 只有 IDLE/THINKING 这两张"没人有事"的脸可以由我们搬走，
+     *    SPEAKING/LISTENING/ERROR 各有各的主人（见 face_mode_takeable）；
+     * 　· 不担心了就搬回 IDLE —— 少了这一条，脸会一直"想"下去，
+     *    正是 §5.4 那条"帧里没带就得落回中性"的老坑（#34）。
+     * 每一帧都可以判：state 一秒一帧，不是 0.25 秒的轮询 —— §5.4 警告的是轮询那个频率，
+     * 每秒把正在播的口型脸拽回中性才是砸主功能。写在锁里：`s_face_live` 是 UI 任务写的，
+     * 出了锁再读就可能抢掉它刚接下的那一句；muse_state 自己那把自旋锁顺序仍是这把 → 它那把。 */
+    if (!s_face_live && face_mode_takeable()) {
+        face_set_mode(frame_maint_worried(dup) ? MUSE_MODE_THINKING : MUSE_MODE_IDLE);
+    }
+    xSemaphoreGive(s_lock);
+    /* 旧树在锁外删：摘出来之后 UI 已经碰不到它了 */
+    if (old) cJSON_Delete(old);
+}
+
+/* 把一句对话交给首屏。answer=false 是回镜过来的问句（脸"在想"），
+ * true 是答句（脸"在说"）。第一页当场画出来，后面各页由 tick 翻 —— 答句晚
+ * 250 毫秒上屏是站在屏前看得出来的那种晚。
+ *
+ * 写上屏的那几笔都在锁里：三份缓冲跨了两个任务（这句在链路任务、翻页在 UI 任务），
+ * 出了锁再读 `s_face_shown` 就可能读到对面写了一半的那页。muse_state 自己那把是自旋锁，
+ * 顺序永远是我们这把 → 它那把，反过来的路径不存在，所以嵌套安全。 */
+static void face_offer(const char *text, bool answer, const char *turn_id)
+{
+    if (!text || !text[0] || !s_lock) return;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (!face_bufs_get()) {
+        xSemaphoreGive(s_lock);
+        ESP_LOGW(TAG, "no PSRAM for the face caption; this line stays on the scene page");
+        return;
+    }
+    /* 正在念的那句还没念完 —— 谁能挤掉它：屏自己说的那句（dir=up，问它的人正在等），
+     * 和同一轮里后到的那一句（答句，turn_id 在这儿见过）。主动播报让路，这句丢掉，
+     * 场景页那一行照样留痕。id 先记再判：这一句不念，下一句同轮的还要认得出它。 */
+    bool same_round = face_round_seen(turn_id);
+    face_round_note(turn_id);
+    if (s_face_live && s_face_at < strlen(s_face_text) && answer && !same_round) {
+        ESP_LOGI(TAG, "face busy at=%u/%u, 这句先不念: %s",
+                 (unsigned)s_face_at, (unsigned)strlen(s_face_text), text);
+        xSemaphoreGive(s_lock);
+        return;
+    }
+    face_put(s_face_text, text);
+    bool paged = muse_hatch_caption_at(s_face_text, 0, s_face_fresh, MUSE_CAPTION_MAX) &&
+                 s_face_fresh[0];
+    face_put(s_face_shown, paged ? s_face_fresh : s_face_text);
+    /* at=0：这一页就是"0 字节落在的那页"。别按页长往后加 —— 页和页重叠一行，
+     * 加了会把那行念两遍、还往后多吃一行（上板 at=231/174 就是这么冒的）。 */
+    s_face_at = 0;
+    s_face_speaking = answer;
+    snprintf(s_face_turn, sizeof s_face_turn, "%s", turn_id ? turn_id : "");
+    s_face_next_us = esp_timer_get_time() + FACE_PAGE_US;
+    s_face_hold_us = s_face_next_us + FACE_HOLD_US;
+    s_face_level = 0;
+    s_face_live = true;
+
+    muse_state_poke();   /* 屏打盹时这句得把它叫醒 */
+    muse_state_set_caption("%s", s_face_shown);
+    face_set_mode(answer ? MUSE_MODE_SPEAKING : MUSE_MODE_THINKING);
+    ESP_LOGI(TAG, "face page 0/%u: %s", (unsigned)strlen(s_face_text), s_face_shown);
+    xSemaphoreGive(s_lock);
+}
+
+/* LVGL 任务每 0.25 秒调一次（carpet_page_tick 在 `s_tile` 判断之前调用，
+ * 露的正是脸那一格时也得翻）。
+ * 已知边界：屏打盹时 muse_ui 的 UI 任务在 update_sleep() 那里就 return 了，这条 tick
+ * 跟着停 —— 那句答页冻在第一页不动（2026-11-05 上板实测：`>say` 之后 16 秒 at 一直 0，
+ * 发个 'w' 叫醒就接着翻）。poke 只延长时间、不叫醒打盹的屏，所以彩排时要么先戳一下屏，
+ * 要么让答句发生在有人正看着的时候。真要把答句叫醒屏幕，得动 muse_ui 的休眠那条路，
+ * 这份不改上游。 */
+void carpet_link_face_tick(void)
+{
+    if (!s_face_live || !s_lock) return;
+    int64_t now = esp_timer_get_time();
+
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (!s_face_live || !s_face_text) {       /* 刚被 face_offer 换掉 / 已收回 */
+        xSemaphoreGive(s_lock);
+        return;
+    }
+
+    /* v3：这一轮到底有没有声音、放到哪了。有 → 翻页跟着**播放位置**走；
+     * 没有（老服务端、合成失败、那段被丢了、或者这本来就是一句问话）→ 原样按秒推。
+     * 2.5 秒一页是照中文朗读速度估的，而 TTS 的快慢由发送方定、还跟着句子内容变 ——
+     * 声音来了之后再抱着估的数不放，就会出现"字比声音快半句"那种一眼假的东西。
+     *
+     * 锁的顺序是这把 → carpet_audio 那把，反过来的路径不存在（音频那份不认识对话）。 */
+    size_t a_played = 0, a_total = 0;
+    bool a_live = false;
+    bool audio = s_face_turn[0] &&
+                 carpet_audio_state(s_face_turn, &a_played, &a_total, &a_live, NULL) && a_total > 0;
+
+    /* 还在放就不许收回：一句 9 秒的话按原来的 hold 会在第 6 秒把脸收回 idle，
+     * 声音还在响、字已经没了 —— 那是"屏坏了"那一类现场印象。
+     * 只在 a_live 为真的时候续，声音一停就不再续，所以不会退化成"永远挂着"。 */
+    if (audio && a_live) s_face_hold_us = now + FACE_HOLD_US;
+
+    if (now >= s_face_hold_us) {
+        s_face_live = false;
+        muse_state_set_level(0);
+        muse_state_set_progress(0);
+        muse_state_set_caption("%s", "");
+        face_set_mode(MUSE_MODE_IDLE);
+        xSemaphoreGive(s_lock);
+        return;
+    }
+
+    size_t len = strlen(s_face_text);
+    /* 声音那一档：把已播放的比例折到文字字节上，越过当前页末尾就翻一页。
+     * 一次 tick 只翻一页 —— 4Hz 的 tick 跟得上正常语速，真落下了下一拍接着翻，
+     * 不会跳字（翻页点仍然是分页函数给的）。 */
+    size_t want = audio ? (size_t)((double)len * (double)a_played / (double)a_total) : 0;
+    if ((audio ? (a_live && want > s_face_at) : (now >= s_face_next_us)) && s_face_at < len) {
+        /* 下一页在哪个字节翻，由分页函数自己说了算：从 at+1 一路探，探到它给的页和
+         * 现在这张不一样，那个字节就是翻页点。重叠几行、一页几行都不在这儿假设，
+         * 所以既不重复也不跳字；一次只往前扫一页的量（几十字节）。 */
+        size_t probe = s_face_at + 1;
+        bool found = false;
+        while (probe <= len) {
+            if (muse_hatch_caption_at(s_face_text, probe, s_face_fresh, MUSE_CAPTION_MAX) &&
+                s_face_fresh[0] && strcmp(s_face_fresh, s_face_shown) != 0) {
+                found = true;
+                break;
+            }
+            probe++;
+        }
+        if (!found) {
+            /* 念到头了：环画满、翻页停住，**不许动 hold** —— 每次判到头都把收回时刻
+             * 往后推 6 秒，等于永远挂在那（2026-11-05 上板就这么看到的）。 */
+            s_face_at = len;
+            s_face_next_us = s_face_hold_us;
+        } else {
+            face_put(s_face_shown, s_face_fresh);
+            s_face_at = probe;
+            s_face_next_us = now + FACE_PAGE_US;
+            if (!audio) s_face_hold_us = s_face_next_us + FACE_HOLD_US;
+            muse_state_set_caption("%s", s_face_shown);
+            /* 每翻一页留一行：串口上能直接把整句按页拼回来。1 秒一次的串口采样
+             * 分辨不了"跳字"和"没采到"，这一行分得了。 */
+            ESP_LOGI(TAG, "face page at=%u/%u: %s", (unsigned)probe, (unsigned)len, s_face_shown);
+        }
+    }
+    /* 嘴：**有声音的这一轮这里一笔都不写** —— 播放任务每 20 毫秒喂一次真电平
+     * （muse_audio_level 出来的 RMS），比这个 4Hz 的假摆动灵敏 50 倍。
+     * 剩下这条只服务"没声音的那一轮"：那时候嘴还是得动，否则答句看着像没在念。
+     * 别把这条假摆动当成"屏在放声音"，它从来不是。 */
+    if (s_face_speaking && !audio) {
+        s_face_level = s_face_level > 0.5f ? 0.22f : 0.70f;
+        muse_state_set_level(s_face_level);
+        muse_state_set_progress(len ? (float)s_face_at / (float)len : 1.0f);
+    } else if (audio) {
+        /* 进度环直接给音频位置：它就是"这句话还剩多少"的真答案 */
+        muse_state_set_progress((float)a_played / (float)a_total);
+    }
+    xSemaphoreGive(s_lock);
+}
+
+/* 开发口进来的整句都当答句：问句该由手机回镜，这里造一条出来只为验分页。
+ * 同一条 id 记两遍（note 一次、offer 里再判一次）就是为了让第二条 `>say` 也被认成
+ * "同一轮的后半句"，不然那句"新轮次不许挤正在念的"会把开发口的换句也一起挡掉。 */
+void carpet_link_bench_say(const char *text)
+{
+    if (!s_lock) return;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    face_round_note("bench");
+    xSemaphoreGive(s_lock);
+    face_offer(text, true, "bench");
+}
+
+/* ---- 音频探针：把"样本写进去了"和"喇叭响了"这两件事分开证 ---- */
+
+/*
+ * 微雪 1.75 上 ES8311 只做 DAC，真正推喇叭的是板上那颗 NS4150B 功放；它的使能脚
+ * 是 GPIO46（BSP_POWER_AMP_IO，pa_reverted=false ⇒ 高电平开）。codec 驱动把这一脚
+ * 配成 GPIO_MODE_OUTPUT，输出态的脚默认读不回输入通路，所以先 gpio_input_enable()
+ * 只把输入通路打开（不动输出驱动）—— 微雪自己的诊断也是这么读的。
+ * 这一版固件只跑这一整块屏，所以脚号写死；换板要跟着 BSP 改。
+ */
+#define PROBE_PA_GPIO 46
+#define PROBE_CHUNKS  50      /* 50 × 20 ms = 正好一秒 */
+
+/* 只这一个开发口用，所以放静态：串口那条任务只有 3584 字节栈，压不下 640 字节的块。 */
+static int16_t s_probe_tone[MUSE_AUDIO_CHUNK];
+
+/*
+ * 为什么只有放音、没有"用麦克风听自己"：那条本来是想客观判喇叭响没响的，实测走不通 ——
+ * 开机 5.7 秒 Muse 自己的 muse_audio_selftest 读麦克风是好的（-51 dBFS 那两条），
+ * 但过了一会儿所有 muse_audio_read 都立刻失败在
+ * `i2s_common: i2s_channel_read(1410): The channel is not enabled`（RX 通道被谁关了，
+ * 而 s_open 还是 true，所以 muse_audio_power(true) 原地返回）；先 power(false) 再
+ * power(true) 强重开之后，它改成不返回了：日志停在
+ * `I2S_IF: Pending out channel for in channel running`，串口任务从此再也读不到命令。
+ * 麦克风不带超时，卡住就把开发口整条焊死，所以这里不碰它。
+ *
+ * 那这条还剩什么用：它把"写进去 ESP_OK + 节拍是不是真按 16k 走"这一半称清楚。
+ * 节拍准 = 样本真的在往 codec 送（DMA 在吃），不是软件层的空转；
+ * 功放脚电平、speaker_on、音量一起印出来，剩下的就是它管不着的那一段：
+ * 功放供电、MX1.25 喇叭座、喇叭本身 —— 那三段只能听或量。
+ */
+void carpet_link_bench_audio(int seconds)
+{
+    if (seconds < 1) {
+        seconds = 3;
+    }
+    if (seconds > 30) {
+        seconds = 30;
+    }
+    /* 1 kHz、约 -10 dBFS。一个 20 ms 块正好 20 个整周期，所以每块从相位 0 重算也是
+     * 连续的，不用在块之间留状态，也不会听出咔哒。 */
+    for (int i = 0; i < MUSE_AUDIO_CHUNK; i++) {
+        s_probe_tone[i] = (int16_t)(0.316f * 32767.0f
+            * sinf(2.0f * (float)M_PI * 1000.0f * (float)i / MUSE_AUDIO_RATE));
+    }
+    (void)gpio_input_enable(PROBE_PA_GPIO);
+    printf("@audio cfg spk_on=%d vol=%d mic=%ddB PA%d=%d\n",
+           muse_settings_speaker_on(), muse_settings_volume(), muse_settings_mic_gain(),
+           PROBE_PA_GPIO, gpio_get_level(PROBE_PA_GPIO));
+    fflush(stdout);
+
+    long wrote = 0, werr = 0;
+    int64_t t0 = esp_timer_get_time();
+    for (int s = 0; s < seconds; s++) {
+        int64_t s0 = esp_timer_get_time();
+        for (int i = 0; i < PROBE_CHUNKS; i++) {
+            if (muse_audio_write(s_probe_tone, MUSE_AUDIO_CHUNK) != ESP_OK) {
+                werr++;
+            }
+            wrote++;
+        }
+        /* 每秒一行、带这一秒的实际耗时：写不报错但节拍飞掉 = DMA 没在吃 = 没真送出去。 */
+        printf("@audio %d/%d wrote=%ld err=%ld 一秒实测 %.3f 秒 PA%d=%d\n",
+               s + 1, seconds, wrote, werr,
+               (float)(esp_timer_get_time() - s0) / 1e6f,
+               PROBE_PA_GPIO, gpio_get_level(PROBE_PA_GPIO));
+        fflush(stdout);
+    }
+    printf("@audio verdict 送样本这条路 ESP_OK、总耗时 %.3f 秒（放音 %d 秒）；"
+           "听见 ⇒ 之前是接插件/喇叭那边，听不见 ⇒ 功放供电或喇叭座\n",
+           (float)(esp_timer_get_time() - t0) / 1e6f, seconds);
+    fflush(stdout);
+}
+
+static void on_dialog(const cJSON *dialog)
+{
+    const char *dir = str_of(dialog, "dir");
+    const char *src = str_of(dialog, "source");
+    const char *who = (dir && strcmp(dir, "up") == 0) ? "屏在说" : "手机在说";
+    /* source 在契约里就不是必填（必填只有 turn_id / dir / text），缺了就只说谁在说。
+     * 补一个"· —"的尾巴是让人念不通的。 */
+    char line[40];
+    if (src) snprintf(line, sizeof line, "%s · %s", who, kv_lookup(DIALOG_SRC, src, "未知"));
+    else     snprintf(line, sizeof line, "%s", who);
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    snprintf(s_dialog, sizeof s_dialog, "%s", line);
+    s_dialog_tick = xTaskGetTickCount();
+    xSemaphoreGive(s_lock);
+
+    /* 首屏那句整话。场景页那一行只说"谁在说、哪来的"（40 字放不下整句），
+     * 整句给脸下面那条带 —— 契约里问和答都要回镜，所以两边都会走到这里。
+     * 轮次由 face_offer 自己认（它要拿这个决定能不能挤），这里只把 dir 翻译成"是不是答句"。 */
+    const char *turn = str_of(dialog, "turn_id");
+    face_offer(str_of(dialog, "text"), dir && strcmp(dir, "down") == 0, turn);
+
+    /* 答话顺带把屏挪过去。只有 dir=down 才可能有这一项（上行带了会被手机剥掉），
+     * 但它只做换页：认不出的名字忽略 + 一条日志，不 ack。
+     * carpet_page_goto 自己挪到 UI 任务里落地，这里不碰 LVGL。 */
+    if (dir && strcmp(dir, "down") == 0) {
+        const char *action = str_of(dialog, "action");
+        if (action) carpet_page_goto(action);
+    }
+}
+
+/* v3 的下行指令。`t=command` 这一列里只有 audio_chunk 是**手机→屏**的，
+ * 其余（card_next / poke / page_report …）全是屏→手机的请求，不会从这条回调进来。
+ *
+ * 认不出的 cmd 只记一行日志、不断线：组件对"解不开的帧类型"是直接关连接，
+ * 对"不认识的 cmd"才是静默忽略 —— 我们要的是后一种失败方式（现场永远把掉线怀疑成 Wi-Fi 抖）。 */
+static void on_command(const char *cmd, const cJSON *args)
+{
+    if (cmd && strcmp(cmd, "audio_chunk") == 0) {
+        /* 为什么这段不要，carpet_audio 自己会留一行（采样率 / seq / 容量 / 解码） */
+        carpet_audio_on_chunk(args);
+        return;
+    }
+    ESP_LOGW(TAG, "没听过这条下行指令：%s", cmd ? cmd : "(空)");
+}
+
+static void on_connected(int negotiated)
+{
+    s_negotiated = negotiated;
+    s_linked = true;
+    ESP_LOGI(TAG, "linked, contract v%d", negotiated);
+    /* 补报一次当前页：page_report 只在页真的变了的时候发，重连那一刻页没变，
+     * 但手机上那一格已经被清成空了（屏不在了还写着"屏在亲子"是那句镜像能编的
+     * 最贵的假话）。少了这一条，它要等下一次真的翻页才复明。 */
+    carpet_page_reshare();
+}
+
+static void on_disconnected(void)
+{
+    s_linked = false;
+    s_negotiated = 0;
+    /* 半截语音留着，重连之后新答句一开口就会撞上旧缓冲（seq 从 0 起，旧那段还没放完）。
+     * 文字那句不清：断线时念到一半的那句本来就该继续念完。 */
+    carpet_audio_abort("链路断了");
+}
+
+static void cmd_task(void *arg)
+{
+    (void)arg;
+    cmd_msg_t m;
+    while (xQueueReceive(s_cmdq, &m, portMAX_DELAY) == pdTRUE) {
+        if (m.cmd < 1 || m.cmd > CMD_PAGE) continue;
+        const char *name = m.cmd == CMD_PAGE ? "page_report" : CMD_NAMES[m.cmd - 1];
+        cJSON *args = NULL;
+        if (m.cmd == 1) {           /* card_next：dir 必填，手机按它算下一张 */
+            args = cJSON_CreateObject();
+            if (args) cJSON_AddNumberToObject(args, "dir", m.dir >= 0 ? 1 : -1);
+        } else if (m.cmd == CMD_PAGE) {
+            args = cJSON_CreateObject();
+            if (args) cJSON_AddStringToObject(args, "page", m.page);
+        }
+        /* args 的所有权一律交给组件：它非法值当场 delete、正常路径挂进帧里，
+         * 这边再 delete 一次就是 double free。建不出来（没堆）传 NULL，组件补空对象。 */
+        esp_err_t err = screen_link_send_command(name, args);
+        if (err == ESP_OK) {
+            if (m.cmd == CMD_PAGE) {
+                s_pages_sent++;
+                snprintf((char *)s_last_page, sizeof(s_last_page), "%s", m.page);
+            } else {
+                s_last_cmd = m.cmd;
+                s_sent++;
+            }
+            ESP_LOGI(TAG, "sent %s", name);
+        } else {
+            /* 没连上时组件会退回失败，这不是错误现场，只是一次没人应答的按键 */
+            ESP_LOGW(TAG, "send %s: %s", name, esp_err_to_name(err));
+        }
+    }
+}
+
+void carpet_link_send(const char *cmd, int dir)
+{
+    if (!s_cmdq || !cmd) return;
+    int idx = CMD_NONE;
+    for (int i = 0; i < CMD_COUNT; i++) {
+        if (strcmp(cmd, CMD_NAMES[i]) == 0) { idx = i + 1; break; }
+    }
+    if (idx == CMD_NONE) {
+        ESP_LOGW(TAG, "not a contract command: %s", cmd);
+        return;
+    }
+    cmd_msg_t m = { .cmd = idx, .dir = dir };
+    if (xQueueSend(s_cmdq, &m, 0) != pdTRUE) {
+        ESP_LOGW(TAG, "command queue full, dropped %s", cmd);
+    }
+}
+
+const char *carpet_link_last_sent(int *sent)
+{
+    if (sent) *sent = s_sent;
+    return s_last_cmd >= 1 && s_last_cmd <= CMD_COUNT ? CMD_NAMES[s_last_cmd - 1] : "-";
+}
+
+/* 通报"屏现在在哪一页"。页名的合法性由 carpet_page 那张 PAGE_NAMES 表保证
+ * （它只可能从那张表取字），所以这里不再查一遍白名单 —— 查两遍就会出现
+ * "改了页名只改对一处"的那种半夜。 */
+void carpet_link_report_page(const char *page_name)
+{
+    if (!s_cmdq || !page_name || !page_name[0]) return;
+    cmd_msg_t m = { .cmd = CMD_PAGE, .dir = 0 };
+    snprintf(m.page, sizeof m.page, "%s", page_name);
+    if (xQueueSend(s_cmdq, &m, 0) != pdTRUE) {
+        ESP_LOGW(TAG, "command queue full, dropped page_report %s", page_name);
+    }
+}
+
+/* v3 的 hello.screen：从 Muse 的板级描述里取，不在这里写死 466 —— 换一块板（或官方
+ * 改了这块的参数）报出去的还是真的那一块。ppi 由对角线折算，不是第二个来源。
+ * 手机拿这一项只做一件事：定字号和一页几行。它不许猜，猜错了就是圆屏上少半个字那种事。
+ * 同一个函数也给 `>carpet` 回读用 —— 报出去的数和看到的数必须是一个来源，
+ * 否则这条回读只是在复述我自己的假设。 */
+static void screen_geom(int *w, int *h, bool *round, bool *touch, int *ppi)
+{
+    *w = muse_board ? muse_board->width : 0;
+    *h = muse_board ? muse_board->height : 0;
+    *round = muse_board ? muse_board->round : false;
+    *touch = muse_board ? muse_board->touch : false;
+    *ppi = (muse_board && muse_board->diagonal_in > 0.1f)
+         ? (int)(hypotf((float)*w, (float)*h) / muse_board->diagonal_in + 0.5f) : 0;
+}
+
+/* ---- 接入点地址：运行期可设（不必改编译期常量重刷） ----
+ *
+ * 为什么必须有这一层：`CONFIG_SCREEN_LINK_URL` 是**烧在固件里**的，而现场那条地址跟着
+ * 手机热点跑 —— 手机在 aa123 上今天 10.50.174.165、明天 10.50.174.166，每次都要
+ * 改 build 里的 sdkconfig ＋ `idf.py build` ＋ 一次刷机，这条路在用户面前是不成立的。
+ * 现在读的顺序是 **NVS(`muse`/`link_url`) → 出厂常量**，所以：
+ *   · 手机开热点那一档：出厂常量本来就是 `ws://192.168.43.1:8443`（手机自己是 .1），
+ *     设置页里一格都不用填；
+ *   · 拨不通（热点开了客户端隔离）才在设置页或 `>url` 填手机在那个网里的地址。
+ *
+ * 三个记账点，少一个就会变成"改了但看不出来生效没"：
+ *   `s_url` 是**当前真正拨出去**的那条（`screen_link_cfg_t.url` 存的是指针，
+ *     所以这条字符串必须一直活着，不能是栈上的）；
+ *   `s_url_from_nvs` 说来源，`>carpet`/`>url` 把它和地址一起印出来；
+ *   `s_link_mtx` 让"开/关链路"只可能有一个人在做 —— `screen_link_stop()` 里要等
+ *     链路任务自己退出（最长 2 秒），这段时间里 `>url` 再来一次、或开机那条 gate
+ *     刚放行，都会撞车。
+ */
+static char s_url[MUSE_LINK_URL_MAX + 1];
+static volatile bool s_url_from_nvs;
+static screen_link_callbacks_t s_cb;
+static SemaphoreHandle_t s_link_mtx;
+static bool s_link_started;
+
+/* 先读 NVS，没有（空串或从没写过）才回落编译期那一条。来源跟着一起记，
+ * 因为"拨的是哪条"和"是谁决定的"是两个问题：现场排障问的是后者。 */
+static void url_read(void)
+{
+    char nv[MUSE_LINK_URL_MAX + 1];
+    muse_settings_link_url(nv);
+    if (nv[0]) {
+        snprintf(s_url, sizeof s_url, "%s", nv);
+        s_url_from_nvs = true;
+    } else {
+        snprintf(s_url, sizeof s_url, "%s", CONFIG_SCREEN_LINK_URL);
+        s_url_from_nvs = false;
+    }
+}
+
+/* 现在生效的那条地址 + 是谁定的这一条。
+ * `s_url` 只有真的拨出去之后才有内容（gate_task 先等网络），所以还没拨的时候按
+ * 同一条"先 NVS 再出厂"的规则现算 —— 不然现场刚用 `>url` 改完、网还没起来，
+ * 回读会指着出厂值说"这就是在拨的"，那就是在骗人。
+ * 为什么不在 carpet_link_start() 里先 url_read() 一次：试过了，板子上开机直接
+ * `assert failed: xQueueSemaphoreTake queue.c:1709 (( pxQueue ))` 死循环 ——
+ * 那一步 `muse_settings_init()` 还没跑，设置模块那把锁是 NULL。 */
+static void url_effective(char out[MUSE_LINK_URL_MAX + 1], bool *from_nvs)
+{
+    if (s_url[0]) {
+        snprintf(out, MUSE_LINK_URL_MAX + 1, "%s", s_url);
+        *from_nvs = s_url_from_nvs;
+        return;
+    }
+    muse_settings_link_url(out);
+    *from_nvs = out[0] != '\0';
+    if (!out[0]) {
+        snprintf(out, MUSE_LINK_URL_MAX + 1, "%s", CONFIG_SCREEN_LINK_URL);
+    }
+}
+
+/* 拨号。调用者持有 s_link_mtx，且 s_url 已经是想要的那条。 */
+static esp_err_t link_open(void)
+{
+    int gw, gh, gppi;
+    bool gr, gt;
+    screen_geom(&gw, &gh, &gr, &gt, &gppi);
+
+    screen_link_cfg_t cfg = {
+        .url = s_url,
+        .screen_id = CONFIG_SCREEN_LINK_ID,
+        .fw = CONFIG_SCREEN_LINK_FW,
+        .dock_type = CONFIG_SCREEN_LINK_DOCK_TYPE,
+        .read_battery_mv = NULL,   /* 底座还没上板：帧里不带这一项 */
+        .screen_w = gw,
+        .screen_h = gh,
+        .screen_round = gr,
+        .screen_touch = gt,
+        .screen_ppi = gppi,
+    };
+    esp_err_t err = screen_link_start(&cfg, &s_cb);
+    if (err == ESP_OK) {
+        s_link_started = true;
+        ESP_LOGI(TAG, "dialing %s (%s)", s_url, s_url_from_nvs ? "from settings" : "built-in");
+    }
+    return err;
+}
+
+/* 换地址之后重拨一次：先关（发 bye，手机台账立刻离线）再开。
+ * 新起的那条链路自己的退避阶梯从第一档重新开始，这就是"不等阶梯转完"。
+ * 还没拨过（Wi-Fi 没起来，gate 那条还在等）就只存不拨 —— 在这里替 gate 起链路会
+ * 把"没网也去 init 一个 transport"引进来，而 gate 随后那次 start 只会撞 INVALID_STATE。 */
+static void url_restart_task(void *arg)
+{
+    (void)arg;
+    xSemaphoreTake(s_link_mtx, portMAX_DELAY);
+    url_read();
+    if (s_link_started) {
+        screen_link_stop();
+        s_link_started = false;
+        esp_err_t err = link_open();
+        if (err != ESP_OK) {
+            ESP_LOGE(TAG, "re-dial after url change: %s", esp_err_to_name(err));
+        }
+    } else {
+        ESP_LOGI(TAG, "url saved (%s); the link starts on its own once Wi-Fi is up", s_url);
+    }
+    xSemaphoreGive(s_link_mtx);
+    vTaskDelete(NULL);
+}
+
+static void url_restart(void)
+{
+    if (!s_link_mtx) {
+        ESP_LOGE(TAG, "no link mutex, url change not applied");
+        return;
+    }
+    if (xTaskCreate(url_restart_task, "carpet_url", 4096, NULL, 4, NULL) != pdPASS) {
+        ESP_LOGE(TAG, "url restart task out of memory");
+    }
+}
+
+void carpet_link_url(char *out, size_t n, bool *from_nvs)
+{
+    char full[MUSE_LINK_URL_MAX + 1];
+    bool from = false;
+    url_effective(full, &from);
+    if (out && n) snprintf(out, n, "%s", full);
+    if (from_nvs) *from_nvs = from;
+}
+
+esp_err_t carpet_link_set_url(const char *url)
+{
+    if (!s_link_mtx) return ESP_ERR_INVALID_STATE;
+    if (url && *url) {
+        if (strlen(url) > MUSE_LINK_URL_MAX) return ESP_ERR_INVALID_SIZE;
+        /* 只认 ws:// 和 wss:// 起头：填错的人现场要能一眼看出来，别让一个
+         * 手滑的 "192.168.43.1" 变成一条拨不出去又不知道原因的地址。 */
+        if (strncmp(url, "ws://", 5) && strncmp(url, "wss://", 6)) return ESP_ERR_INVALID_ARG;
+        /* 设置页那个键盘会带出空格，空格在 URL 里从来不是有意的 */
+        if (strchr(url, ' ')) return ESP_ERR_INVALID_ARG;
+    }
+    muse_settings_set_link_url(url ? url : "");
+    url_restart();
+    return ESP_OK;
+}
+
+void carpet_link_url_dump(void)
+{
+    char now[MUSE_LINK_URL_MAX + 1];
+    bool from_nvs = false;
+    char want[MUSE_LINK_URL_MAX + 1];
+    url_effective(now, &from_nvs);
+    muse_settings_link_url(want);
+    printf("@url now=%s src=%s saved=%s linked=%d dialed=%d\n",
+           now, from_nvs ? "nvs" : "factory",
+           want[0] ? want : "(none)", (int)screen_link_connected(), (int)s_link_started);
+    /* 地址和网是两件事：这一行说的是"在哪个网里拨这条地址"。
+     * 密码不印 —— 串口日志会被抄进交接文档，那玩意儿抄一次就是一份凭据。 */
+    char ssid[MUSE_SSID_MAX + 1], pass[MUSE_PASS_MAX + 1];
+    muse_settings_wifi(ssid, pass);
+    /* fails/err：拨不上到底是谁的问题，现场只有这两个数分得开 ——
+     * errno=119 是到不了手机（网的事，keeper 会重新关联），errno=113 是端口没人听
+     * （App 的事），http≠0 才是真有一个服务端把这一轮拒了。 */
+    char err[120];
+    screen_link_last_error(err, sizeof(err));
+    printf("@url wifi=%d ssid=%s fails=%lu%s%s\n", (int)muse_wifi_connected(), ssid[0] ? ssid : "(none)",
+           (unsigned long)screen_link_dial_fails(), err[0] ? " err=" : "", err);
+    printf("@url built-in=%s  set: >url ws://a.b.c.d:8443  clear: >url clear\n",
+           CONFIG_SCREEN_LINK_URL);
+    fflush(stdout);
+}
+
+static void gate_task(void *arg)
+{
+    (void)arg;
+    /* Home Link joins only after the phone has paired this gadget, so wait for
+     * a network instead of starting a link that can't resolve the URL. */
+    while (!muse_wifi_connected()) {
+        vTaskDelay(pdMS_TO_TICKS(2000));
+    }
+
+    s_cb.on_connected = on_connected;
+    s_cb.on_disconnected = on_disconnected;
+    s_cb.on_state = on_state;
+    s_cb.on_dialog = on_dialog;
+    s_cb.on_command = on_command;
+
+    xSemaphoreTake(s_link_mtx, portMAX_DELAY);
+    url_read();
+    esp_err_t err = link_open();
+    xSemaphoreGive(s_link_mtx);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "screen_link_start: %s", esp_err_to_name(err));
+    }
+    vTaskDelete(NULL);
+}
+
+void carpet_link_start(void)
+{
+    if (s_gate) return;
+    /* 先建锁再建任务：链路回调和 UI 的 tick 都从这一把锁后面碰 s_state */
+    if (!s_lock) s_lock = xSemaphoreCreateMutex();
+    if (!s_cmdq) s_cmdq = xQueueCreate(CMD_QUEUE_LEN, sizeof(cmd_msg_t));
+    if (!s_link_mtx) s_link_mtx = xSemaphoreCreateMutex();
+    if (xTaskCreate(cmd_task, "carpet_cmd", 4096, NULL, 4, &s_cmd_task) != pdPASS) {
+        s_cmd_task = NULL;
+        ESP_LOGE(TAG, "cmd task out of memory");
+    }
+    if (xTaskCreate(gate_task, "carpet_gate", 4096, NULL, 4, &s_gate) != pdPASS) {
+        s_gate = NULL;
+        ESP_LOGE(TAG, "gate task out of memory");
+    }
+}
+
+void carpet_link_view(carpet_link_view_t *out)
+{
+    out->wifi_up = muse_wifi_connected();
+    out->linked = s_linked;
+    out->negotiated = s_negotiated;
+    out->gap_s = screen_link_state_gap_s();
+}
+
+/*
+ * 给 keeper 的两句。它管这张网卡，而"卡说还连着、其实已经到不了手机"这一种死法
+ * 只有拨号那一侧看得见：esp_wifi 那边仍是 connected，keeper 每轮都判定"什么都不用做"，
+ * 于是每一条拨号都在撞同一个没有路由的地址。keeper 拿这个数决定要不要重新关联。
+ */
+uint32_t carpet_link_dial_fails(void)
+{
+    return screen_link_dial_fails();
+}
+
+void carpet_link_last_error(char *out, size_t cap)
+{
+    screen_link_last_error(out, cap);
+}
+
+/* 开发口：文字和声音一起来。turn_id 两边都用 "audtest" —— 这条的目的就是让
+ * 首屏那句去查"这一轮有没有声音、放到哪了"，id 不一样就查不到，翻页会退回按秒估，
+ * 那正好把要看的两件事都藏起来。先记一轮再交句，同 `>say` 那两条一样的写法。 */
+void carpet_link_bench_say_audio(const char *text, int seconds)
+{
+    if (s_lock && text && *text) {
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        face_round_note("audtest");
+        xSemaphoreGive(s_lock);
+        face_offer(text, true, "audtest");
+    }
+    carpet_audio_bench(seconds);
+}
+
+/* 开发口 `>maint [off]`：本机造一帧"到点的养护"。
+ * 走的是链路收帧时**同一条** `on_state()` —— 不是绕开它去手点那个布尔记号，
+ * 那样称出来的是我自己写的那句 if，不是"这一帧到底到没到"。`off` 造一张中性帧，
+ * 专门称第三道让路（不担心了要搬回 IDLE，少了它脸会一直"想"下去，就是 #34 那个坑）。
+ * 先 `>say 一句长话` 让句子挂在脸上、再发这一帧，称的就是第一道让路：脸不许被搬走，
+ * 这一条只剩「对话」「情绪」两行前面那枚琥珀点（carpet_page.c:874 认的就是下面回读的
+ * 那个 `maint_worried`）。不联网、不接模型，所以这块板在哪都能称这两条。 */
+void carpet_link_bench_maint(bool worried)
+{
+    if (!s_lock) {
+        printf("@maint 链路还没起（没锁），这一帧发不进去\n");
+        fflush(stdout);
+        return;
+    }
+    cJSON *st = cJSON_CreateObject();
+    cJSON *ui = st ? cJSON_AddObjectToObject(st, "ui") : NULL;
+    if (!ui) {
+        if (st) cJSON_Delete(st);
+        printf("@maint 造不出帧（内存）\n");
+        fflush(stdout);
+        return;
+    }
+    cJSON_AddStringToObject(ui, "card", "maint");
+    cJSON_AddStringToObject(ui, "emotion", worried ? "worried" : "neutral");
+    on_state(st, 0);
+    cJSON_Delete(st);
+    /* 回读走 `carpet_link_state()` —— 页面上那两行的点和脸都是从这个视图读的，
+     * 印我传进去的那个参数就成了自己给自己打勾。mode：1=idle 3=thinking 4=speaking。 */
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+    printf("@maint sent=%d view.maint_worried=%d card=%s emotion=%s face=%d mode=%d\n",
+           (int)worried, (int)s.maint_worried, s.card[0] ? s.card : "-",
+           s.emotion[0] ? s.emotion : "-", (int)s_face_live, (int)muse_state_mode(NULL));
+    fflush(stdout);
+}
+
+void carpet_link_dump(void)
+{
+    carpet_link_view_t v;
+    carpet_link_view(&v);
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+
+    /* gap 换算成页面第一行那句中文的规则写在 carpet_page.c 的 tick 里：
+     * 没网=等网络、没连=未接入、gap 无穷=等首帧、>10s=掉线重连、>3s=卡N秒、否则=已接入。 */
+    printf("@carpet wifi=%d linked=%d contract=v%d gap_s=%lu has_state=%d wd=%lu fails=%lu\n",
+           v.wifi_up, v.linked, v.negotiated, (unsigned long)v.gap_s, s.has_state,
+           (unsigned long)screen_link_watchdog_fires(), (unsigned long)screen_link_dial_fails());
+    printf("@carpet sat=%s\n", s.sat[0] ? s.sat : "-");
+    printf("@carpet dialog=%s\n", s.dialog[0] ? s.dialog : "-");
+    /* 首屏那条带上的整句：live=还有话挂着，mode=脸现在哪个状态
+     * （1 idle / 3 thinking / 4 speaking），at/len=念到第几个字节。
+     * 站在屏前看不出"是没收到还是收到没画"，这一行分得清。 */
+    printf("@carpet face=%d mode=%d at=%u/%u\n", (int)s_face_live,
+           (int)muse_state_mode(NULL), (unsigned)s_face_at,
+           (unsigned)(s_face_text ? strlen(s_face_text) : 0));
+    /* 带上现在实际画的那一页（不是整句）—— "收到没"和"画的是哪页"是两件事，
+     * 光看 at/len 分不出分页分得对不对。 */
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    printf("@carpet band=%s\n", s_face_live && s_face_shown ? s_face_shown : "-");
+    xSemaphoreGive(s_lock);
+    /* maint_worried 是那个布尔记号本身（不是屏上的中文串）：#73 的判据是
+     * "这一帧到底到没到"，跟着中文走就成了自己对自己打勾。 */
+    printf("@carpet card=%s emotion=%s maint_worried=%d\n", s.card[0] ? s.card : "-",
+           s.emotion[0] ? s.emotion : "-", (int)s.maint_worried);
+    printf("@carpet sos=%s\n", s.sos[0] ? s.sos : "-");
+    /* 三个按钮发出去几条、最后一条是哪个 —— 站在那块屏前按了才知道有没有通路，
+     * 这一行是"按了真的发出去了"的唯一凭据。 */
+    int sent = 0;
+    const char *last = carpet_link_last_sent(&sent);
+    printf("@carpet sent=%d last=%s\n", sent, last);
+    /* 翻页是本地动作，手机上那一格空着有两种可能：屏没发 / 发了但链路当时没连。
+     * nav=屏现在自认为在哪一页，reported=发出去几条，last=最后一条的名字。
+     * 三个数对不上就是这一行说的，不用猜。 */
+    printf("@carpet nav=%s reported=%d last=%s\n", carpet_page_current_name(),
+           (int)s_pages_sent, s_last_page[0] ? (const char *)s_last_page : "-");
+    /* hello 里那一串屏幕参数（v3）。手机端定字号靠它，报错了整屏排版跟着错，
+     * 所以这里给的是**和发出去同一个来源**的数，不是"应该是 466"。 */
+    int gw, gh, gppi;
+    bool gr, gt;
+    screen_geom(&gw, &gh, &gr, &gt, &gppi);
+    printf("@carpet screen=%dx%d round=%d touch=%d ppi=%d\n", gw, gh, (int)gr, (int)gt, gppi);
+    /* 拨的是哪条、谁定的：现场一半的"连不上"其实是"拨的是上一台电脑那条"。
+     * src=factory 说明 NVS 里那一格是空的（不是丢了，是从没填过）。
+     * 走 url_effective()：网还没起来时 s_url 是空的，那时也要说真话。 */
+    char url_now[MUSE_LINK_URL_MAX + 1];
+    bool url_nvs = false;
+    url_effective(url_now, &url_nvs);
+    printf("@carpet url=%s src=%s\n", url_now, url_nvs ? "nvs" : "factory");
+    carpet_audio_dump();
+    fflush(stdout);
+}
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_link.h b/esp32/components/muse/carpet/carpet_link.h
new file mode 100644
index 0000000..969c865
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_link.h
@@ -0,0 +1,156 @@
+/*
+ * 车联（Screen-Link）在 Muse 里的启动闸门与状态存放。
+ *
+ * Muse 的 UI 是拉取式的：LVGL 任务每帧自己去读状态（见 muse_ui.c 的
+ * update_chrome()），其它任务从不碰 LVGL。所以本文件只写状态，
+ * 画由 carpet_page.c 在 UI 任务里读。
+ *
+ * Wi-Fi 归 Home Link 管（手机配对后才能上网），这里不能自己连，
+ * 只能等 muse_wifi_connected() 真了再启链路。
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "esp_err.h"   /* esp_err_t for carpet_link_set_url() */
+
+/* Safe from any task. Starts the link once Wi-Fi is up; calling it twice does
+ * nothing. */
+void carpet_link_start(void);
+
+/* What the page draws. Snapshot so the UI task reads one consistent set. */
+typedef struct {
+    bool wifi_up;
+    bool linked;
+    int negotiated;          /* 谈下来的契约档；只有 >=2 才走得通对话 */
+    uint32_t gap_s;          /* 距上一帧 state 多少秒；没连上时是 UINT32_MAX */
+} carpet_link_view_t;
+
+void carpet_link_view(carpet_link_view_t *out);
+
+/*
+ * 页面上另外四行要的值，已经从契约的英文枚举翻成中文短串（屏上不许出现英文原值）。
+ * 每一项都只描述**最新那一帧**：帧里没带的字段不会留着上一帧的值，
+ * 所以这里不需要"清一清"的额外约定 —— 整棵树每帧换掉，缺的就是回落值。
+ */
+typedef struct {
+    bool has_state;          /* 这轮会话收到过 state 没有 */
+    char sat[40];            /* 卫星相位 + 下次过境倒计时 */
+    char card[24];           /* 手机上当前画在哪张卡 */
+    char emotion[24];        /* ui.emotion */
+    char sos[24];            /* sos.level */
+    char dialog[40];         /* 最近一句对话的方向和来源；超过 5 秒留空 */
+    /* `ui.card=maint` 且 `ui.emotion=worried` 同时成立：那就是"一条到点的养护"。
+     * 判在解码这一层（这里还拿着契约的英文原值），页面只认这个布尔 ——
+     * 让页面去比"养车卡""担心"这种中文串，等于把改措辞的成本摊到排版那边。 */
+    bool maint_worried;
+} carpet_state_view_t;
+
+/* 从任何任务读都行（里面有锁），但只在 UI 任务的 tick 里调用才有意义。 */
+bool carpet_link_state(carpet_state_view_t *out);
+
+/*
+ * 把一次"用户在这块玻璃上做了什么"送给手机。cmd 只能是契约里那三条
+ * （card_next / card_auto / poke）—— 组件自己还有一道白名单，非法值当场退回，
+ * 而手机端解不开入站帧的处理是**关连接、一句话不说**，所以拼错的代价是掉线。
+ *
+ * dir 只给 card_next 用（+1 往后一张 / -1 往前一张）。
+ *
+ * **这条在 LVGL 任务里调用安全**：它只往队列里放一个 16 字节的小结构，
+ * 真正的 socket 发送在 carpet_cmd 任务里 —— screen_link_send_command() 最坏会
+ * 阻塞约 2 秒，搁在 UI 任务里就是整块屏停两秒（脸不再呼吸、页面不更新）。
+ * 队列满（4 条没发出去）就丢掉并记一条 warning，绝不等待。
+ */
+void carpet_link_send(const char *cmd, int dir);
+
+/*
+ * 通报"屏现在在哪一页"。和上面那条的区别就一句：card_next 那几个是**请求**
+ * （手机可以拒绝、可以算出别的），这一条是**通报** —— 页是屏自己翻的，手机只是
+ * 照着写镜像，不许驳回。页名由 carpet_page.c 的 PAGE_NAMES 给出（和契约的 ScreenPage
+ * 同一张表，core 的 SchemaDriftTest 会比对），所以这里不再查白名单。
+ * 同样只入队，不在 LVGL 任务里发。
+ */
+void carpet_link_report_page(const char *page_name);
+
+/* 最近一次成功装配上行的命令，给 `>carpet` 回读用（不是给人看的，是给我证明
+ * "按下去真的上线了"）。sent=成功发出的条数。 */
+const char *carpet_link_last_sent(int *sent);
+
+/*
+ * 首屏那张脸的答句：**只写 Muse 自己留的三个口**（caption / mode / level / progress），
+ * 不改它的 UI、不叠我们的控件。所以脸还是那张脸，只是话是我们服务端给的。
+ *
+ * 翻页的钟得有人拨。Muse 云端那一路是按**播放的音频**推进念稿位置的，我们不出声音，
+ * 就自己按"念稿"的速度推 —— 挂在这里，由 carpet_page_tick() 每 0.25 秒调一次。
+ * 露的是脸那一格也必须跑，所以调用点在 `s_tile` 判断**之前**。
+ *
+ * 只在 LVGL 任务里调；`on_dialog` 那边（链路任务）负责把整句交进来并画第一页。
+ */
+void carpet_link_face_tick(void);
+
+/* Console readback (`>carpet`): prints the same numbers and strings the tile
+ * draws, one line each. Safe from any task, never touches LVGL. */
+void carpet_link_dump(void);
+
+/*
+ * 接入点地址（手机那一头的 ws 地址）现在**运行期可设**，读的顺序是 NVS(`muse`/`link_url`)
+ * → 出厂常量 `CONFIG_SCREEN_LINK_URL`。为什么要有这一条：现场那台电脑/那部手机的 IP 一直在换，
+ * 只靠编译期常量就是"每换一次网络改一次 sdkconfig、重编、再刷一遍"，那条路在用户面前不成立。
+ *
+ * `carpet_link_url(out, n, &from_nvs)` 给的是**现在生效**的那条和它的来源
+ * （true = 设置页或 `>url` 存进 NVS 的那条；false = 出厂常量）。网还没起来时链路一次都
+ * 没拨过，这时它按同一条"先 NVS 再出厂"的规则现算，而不是回一句出厂值糊弄过去 ——
+ * 因为设置页那一格和 `>url` 回读都要在它之前就能说清"你存的那条已经算数了"。
+ * `carpet_link_set_url(url)` 写 NVS（空串 = 抹掉那一格，回到出厂那条）并**立刻重拨**
+ * —— 先 `screen_link_stop()` 发 bye，再重新 start，所以退避阶梯从头开始，不用等它转完；
+ * 链路一次都没起过时只存下下次要拨的那条，不抢 gate 的活。
+ * 返回 `ESP_ERR_INVALID_ARG` = 不以 ws:// 或 wss:// 开头或带空格，`ESP_ERR_INVALID_SIZE` = 超 63 字节，
+ * `ESP_ERR_INVALID_STATE` = `carpet_link_start()` 还没跑（开机极早期，串口命令到不了这么早）。
+ * `carpet_link_url_dump()` 是串口 `>url` 的回读。
+ */
+void carpet_link_url(char *out, size_t n, bool *from_nvs);
+esp_err_t carpet_link_set_url(const char *url);
+void carpet_link_url_dump(void);
+/*
+ * 连着拨不上多少次，和最后一条失败的原因（都是 screen_link 那两份的转发，
+ * 屏侧要读的是这两句，不是那个组件的头文件）。给 keeper 判"网还连着但已经到不了手机"，
+ * 理由写在 screen_link.h 的 screen_link_dial_fails 注释里。
+ */
+uint32_t carpet_link_dial_fails(void);
+void carpet_link_last_error(char *out, size_t cap);
+
+/*
+ * 开发口：把一句话直接塞进首屏那条带，当它是答句（脸进 speaking、按 2.5 秒一页翻）。
+ * 验分页只用得着这个 —— 不接模型也能看出第二页从哪起、一页装几个字。
+ * `>say 一二三…` 走 muse_input 那条线；只入内存不上网。
+ */
+void carpet_link_bench_say(const char *text);
+
+/*
+ * 开发口：放 N 秒 1 kHz 纯音，同时把 speaker_on / 音量 / 功放使能脚电平 / 每笔写的
+ * 返回和每秒实际耗时印出来 —— 用来把"样本真的按 16k 节拍送出去了"和"喇叭响了"分开证。
+ * `>audio [秒]`，默认 3 秒、最多 30 秒，期间占住串口任务。
+ * 不读麦克风：那条在这块板上要么立刻失败（RX 通道没使能）、要么不返回（等 paired 通道），
+ * 会把开发口整条卡死，实测细节见 carpet_link.c 里那段注释。
+ */
+void carpet_link_bench_audio(int seconds);
+
+/*
+ * 开发口 `>audtest [秒] [一句话]`：**一句文字 + 同 turn_id 的一段语音**一起放。
+ * 文字走首屏那条带（和真答句同一条 face_offer），语音走 carpet_audio 那条环和播放任务。
+ * 两个分开测只能各自看出"不动"，合在一起才看得出这两条：
+ * 念稿是不是跟着**播放位置**翻页（不是按 2.5 秒估），口型是不是跟着**真实电平**动。
+ * text 传空串就只放声音。
+ */
+void carpet_link_bench_say_audio(const char *text, int seconds);
+
+/*
+ * 开发口 `>maint` / `>maint off`：本机造一帧 `ui={card:"maint",emotion:"worried"|"neutral"}`
+ * 的 state，交的是链路收帧时同一条 `on_state()`。为的是让 #73 那三条让路和那枚琥珀点
+ * **不依赖网络**就能称：`>maint` 之后 `>carpet` 那行应回 `maint_worried=1`。
+ * worried=true 之后一定要再来一条 `off`，否则脸一直停在"想"上。
+ */
+void carpet_link_bench_maint(bool worried);

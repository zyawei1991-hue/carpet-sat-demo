diff --git a/esp32/components/muse/carpet/carpet_link.c b/esp32/components/muse/carpet/carpet_link.c
new file mode 100644
index 0000000..dfcdadd
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_link.c
@@ -0,0 +1,331 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "carpet_link.h"
+
+#include "sdkconfig.h"
+#if CONFIG_MUSE_CARPET_CARDS
+
+#include <stdio.h>
+#include <string.h>
+
+#include "cJSON.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/queue.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+#include "muse_wifi.h"
+#include "screen_link.h"
+
+static const char *TAG = "carpet";
+
+/* ---- 上行命令：UI 任务只入队，发送在 carpet_cmd 任务里 ---- */
+
+/* 下标就是契约里那三条在白名单里的顺序，也是屏上三个按钮的顺序。
+ * 组件里的 ALLOWED 表还包含 sos_press 等六条，这一版只发交互那三条。 */
+#define CMD_NONE 0
+#define CMD_COUNT 3
+static const char *const CMD_NAMES[CMD_COUNT] = { "card_next", "card_auto", "poke" };
+
+typedef struct {
+    int cmd;      /* CMD_NAMES 下标 + 1，0 表示空 */
+    int dir;      /* 只有 card_next 用 */
+} cmd_msg_t;
+
+#define CMD_QUEUE_LEN 4
+static QueueHandle_t s_cmdq;
+static TaskHandle_t s_cmd_task;
+static volatile int s_last_cmd = CMD_NONE;
+static volatile int s_sent;
+
+/* One word each, written from the link task and read from the UI task: a
+ * briefly stale value only costs one frame of the page. */
+static volatile bool s_linked;
+static volatile int s_negotiated;
+static TaskHandle_t s_gate;
+
+/* 最新一帧 state 的**副本**：组件在回调返回后就把那棵原树释放了。
+ * UI 任务和链路任务碰同一棵树，所以必须有锁 —— 没锁的"换帧时删旧的"就是 use-after-free。 */
+static cJSON *s_state;
+static SemaphoreHandle_t s_lock;
+static char s_dialog[40];
+static uint32_t s_dialog_tick;
+
+/* 契约里的英文枚举一律不许上屏（这是排版红线，不是风格），所以每个都查表；
+ * 认不出的值落"未知"而不是把原样印出去 —— 服务端加一个枚举值不该在屏上冒英文。 */
+typedef struct {
+    const char *key;
+    const char *cn;
+} kv_t;
+
+static const char *kv_lookup(const kv_t *tbl, const char *key, const char *fallback)
+{
+    if (!key) return fallback;
+    for (; tbl->key; tbl++) {
+        if (strcmp(tbl->key, key) == 0) return tbl->cn;
+    }
+    return "未知";
+}
+
+static const kv_t SAT_PHASE[] = {
+    { "idle", "空闲" },       { "searching", "找星" },   { "locked", "已锁定" },
+    { "tx_pending", "发送中" }, { "tx_ok", "已送达" },   { "tx_fail", "发送失败" },
+    { "tx_no_ack", "无回执" }, { NULL, NULL },
+};
+static const kv_t UI_CARD[] = {
+    { "status", "状态卡" },   { "sat", "卫星卡" },     { "dialog", "对话卡" },
+    { "emotion", "表情卡" },  { "clock", "钟面" },     { NULL, NULL },
+};
+static const kv_t EMOTION[] = {
+    { "neutral", "中性" },    { "happy", "开心" },     { "excited", "兴奋" },
+    { "sad", "难过" },        { "worried", "担心" },   { "sleepy", "犯困" },
+    { "thinking", "思考" },   { NULL, NULL },
+};
+static const kv_t SOS_LEVEL[] = {
+    { "normal", "正常" },     { "armed", "待命" },     { "pending", "待发送" },
+    { "sent", "已发出" },     { "acked", "已确认" },   { NULL, NULL },
+};
+static const kv_t DIALOG_SRC[] = {
+    { "asr", "你说的" },      { "local_rule", "本地规则" }, { "model", "模型答的" },
+    { "local_fallback", "兜底话术" }, { "denied", "被拦住" }, { "xiaozhi_cloud", "小智云" },
+    { NULL, NULL },
+};
+
+static const char *str_of(const cJSON *obj, const char *key)
+{
+    const cJSON *item = cJSON_GetObjectItemCaseSensitive(obj, key);
+    return cJSON_IsString(item) ? item->valuestring : NULL;
+}
+
+static void fill_from_state(const cJSON *st, carpet_state_view_t *out)
+{
+    const cJSON *sat = cJSON_GetObjectItemCaseSensitive(st, "sat");
+    if (cJSON_IsObject(sat)) {
+        const char *phase = kv_lookup(SAT_PHASE, str_of(sat, "phase"), "—");
+        const cJSON *np = cJSON_GetObjectItemCaseSensitive(sat, "next_pass_in_s");
+        if (cJSON_IsNumber(np) && np->valueint >= 0) {
+            snprintf(out->sat, sizeof out->sat, "%s 下次%d:%02d",
+                     phase, np->valueint / 60, np->valueint % 60);
+        } else {
+            snprintf(out->sat, sizeof out->sat, "%s", phase);
+        }
+    }
+
+    const cJSON *ui = cJSON_GetObjectItemCaseSensitive(st, "ui");
+    if (cJSON_IsObject(ui)) {
+        snprintf(out->card, sizeof out->card, "%s",
+                 kv_lookup(UI_CARD, str_of(ui, "card"), "—"));
+        /* 契约里 emotion 可以是 null：那是"这一帧不带情绪"，落回中性，
+         * 不是"保持上一帧"。这条在老固件上踩过一次（旧值一直挂着）。 */
+        const char *emotion = str_of(ui, "emotion");
+        snprintf(out->emotion, sizeof out->emotion, "%s",
+                 emotion ? kv_lookup(EMOTION, emotion, "未知") : "中性");
+    } else {
+        snprintf(out->emotion, sizeof out->emotion, "%s", "中性");
+    }
+
+    const cJSON *sos = cJSON_GetObjectItemCaseSensitive(st, "sos");
+    snprintf(out->sos, sizeof out->sos, "%s",
+             cJSON_IsObject(sos) ? kv_lookup(SOS_LEVEL, str_of(sos, "level"), "—") : "—");
+}
+
+bool carpet_link_state(carpet_state_view_t *out)
+{
+    memset(out, 0, sizeof *out);
+    if (!s_lock) return false;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (s_state) {
+        fill_from_state(s_state, out);
+        out->has_state = true;
+    }
+    /* 一句对话只挂 5 秒：链路断了、或者两边不说话了，这一行不该一直写"手机在说" */
+    if (s_dialog[0]) {
+        uint32_t age_s = (xTaskGetTickCount() - s_dialog_tick) * portTICK_PERIOD_MS / 1000;
+        if (age_s <= 5) snprintf(out->dialog, sizeof out->dialog, "%s", s_dialog);
+    }
+    xSemaphoreGive(s_lock);
+    return out->has_state;
+}
+
+static void on_state(const cJSON *state, uint32_t seq)
+{
+    (void)seq;
+    /* IDF 那份 cJSON 只有 cJSON_True（类型位枚举），没有上游才加的 cJSON_TRUE */
+    cJSON *dup = cJSON_Duplicate(state, cJSON_True);
+    if (!dup) return;            /* 拷不动就沿用上一帧，反正 1 秒后还有 */
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    cJSON *old = s_state;
+    s_state = dup;
+    xSemaphoreGive(s_lock);
+    /* 旧树在锁外删：摘出来之后 UI 已经碰不到它了 */
+    if (old) cJSON_Delete(old);
+}
+
+static void on_dialog(const cJSON *dialog)
+{
+    const char *dir = str_of(dialog, "dir");
+    const char *src = str_of(dialog, "source");
+    const char *who = (dir && strcmp(dir, "up") == 0) ? "屏在说" : "手机在说";
+    /* source 在契约里就不是必填（必填只有 turn_id / dir / text），缺了就只说谁在说。
+     * 补一个"· —"的尾巴是让人念不通的。 */
+    char line[40];
+    if (src) snprintf(line, sizeof line, "%s · %s", who, kv_lookup(DIALOG_SRC, src, "未知"));
+    else     snprintf(line, sizeof line, "%s", who);
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    snprintf(s_dialog, sizeof s_dialog, "%s", line);
+    s_dialog_tick = xTaskGetTickCount();
+    xSemaphoreGive(s_lock);
+}
+
+static void on_connected(int negotiated)
+{
+    s_negotiated = negotiated;
+    s_linked = true;
+    ESP_LOGI(TAG, "linked, contract v%d", negotiated);
+}
+
+static void on_disconnected(void)
+{
+    s_linked = false;
+    s_negotiated = 0;
+}
+
+static void cmd_task(void *arg)
+{
+    (void)arg;
+    cmd_msg_t m;
+    while (xQueueReceive(s_cmdq, &m, portMAX_DELAY) == pdTRUE) {
+        if (m.cmd < 1 || m.cmd > CMD_COUNT) continue;
+        cJSON *args = NULL;
+        if (m.cmd == 1) {           /* card_next：dir 必填，手机按它算下一张 */
+            args = cJSON_CreateObject();
+            if (args) cJSON_AddNumberToObject(args, "dir", m.dir >= 0 ? 1 : -1);
+        }
+        esp_err_t err = screen_link_send_command(CMD_NAMES[m.cmd - 1], args);
+        if (err == ESP_OK) {
+            s_last_cmd = m.cmd;
+            s_sent++;
+            ESP_LOGI(TAG, "sent %s dir=%d", CMD_NAMES[m.cmd - 1], m.dir);
+        } else {
+            /* 没连上时组件会退回失败，这不是错误现场，只是一次没人应答的按键 */
+            ESP_LOGW(TAG, "send %s: %s", CMD_NAMES[m.cmd - 1], esp_err_to_name(err));
+        }
+    }
+}
+
+void carpet_link_send(const char *cmd, int dir)
+{
+    if (!s_cmdq || !cmd) return;
+    int idx = CMD_NONE;
+    for (int i = 0; i < CMD_COUNT; i++) {
+        if (strcmp(cmd, CMD_NAMES[i]) == 0) { idx = i + 1; break; }
+    }
+    if (idx == CMD_NONE) {
+        ESP_LOGW(TAG, "not a contract command: %s", cmd);
+        return;
+    }
+    cmd_msg_t m = { .cmd = idx, .dir = dir };
+    if (xQueueSend(s_cmdq, &m, 0) != pdTRUE) {
+        ESP_LOGW(TAG, "command queue full, dropped %s", cmd);
+    }
+}
+
+const char *carpet_link_last_sent(int *sent)
+{
+    if (sent) *sent = s_sent;
+    return s_last_cmd >= 1 && s_last_cmd <= CMD_COUNT ? CMD_NAMES[s_last_cmd - 1] : "-";
+}
+
+static void gate_task(void *arg)
+{
+    (void)arg;
+    /* Home Link joins only after the phone has paired this gadget, so wait for
+     * a network instead of starting a link that can't resolve the URL. */
+    while (!muse_wifi_connected()) {
+        vTaskDelay(pdMS_TO_TICKS(2000));
+    }
+
+    screen_link_cfg_t cfg = {
+        .url = CONFIG_SCREEN_LINK_URL,
+        .screen_id = CONFIG_SCREEN_LINK_ID,
+        .fw = CONFIG_SCREEN_LINK_FW,
+        .dock_type = CONFIG_SCREEN_LINK_DOCK_TYPE,
+        .read_battery_mv = NULL,   /* 底座还没上板：帧里不带这一项 */
+    };
+    screen_link_callbacks_t cb = {0};
+    cb.on_connected = on_connected;
+    cb.on_disconnected = on_disconnected;
+    cb.on_state = on_state;
+    cb.on_dialog = on_dialog;
+
+    esp_err_t err = screen_link_start(&cfg, &cb);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "screen_link_start: %s", esp_err_to_name(err));
+    }
+    vTaskDelete(NULL);
+}
+
+void carpet_link_start(void)
+{
+    if (s_gate) return;
+    /* 先建锁再建任务：链路回调和 UI 的 tick 都从这一把锁后面碰 s_state */
+    if (!s_lock) s_lock = xSemaphoreCreateMutex();
+    if (!s_cmdq) s_cmdq = xQueueCreate(CMD_QUEUE_LEN, sizeof(cmd_msg_t));
+    if (xTaskCreate(cmd_task, "carpet_cmd", 4096, NULL, 4, &s_cmd_task) != pdPASS) {
+        s_cmd_task = NULL;
+        ESP_LOGE(TAG, "cmd task out of memory");
+    }
+    if (xTaskCreate(gate_task, "carpet_gate", 4096, NULL, 4, &s_gate) != pdPASS) {
+        s_gate = NULL;
+        ESP_LOGE(TAG, "gate task out of memory");
+    }
+}
+
+void carpet_link_view(carpet_link_view_t *out)
+{
+    out->wifi_up = muse_wifi_connected();
+    out->linked = s_linked;
+    out->negotiated = s_negotiated;
+    out->gap_s = screen_link_state_gap_s();
+}
+
+void carpet_link_dump(void)
+{
+    carpet_link_view_t v;
+    carpet_link_view(&v);
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+
+    /* gap 换算成页面第一行那句中文的规则写在 carpet_page.c 的 tick 里：
+     * 没网=等网络、没连=未接入、gap 无穷=等首帧、>10s=掉线重连、>3s=卡N秒、否则=已接入。 */
+    printf("@carpet wifi=%d linked=%d contract=v%d gap_s=%lu has_state=%d wd=%lu\n",
+           v.wifi_up, v.linked, v.negotiated, (unsigned long)v.gap_s, s.has_state,
+           (unsigned long)screen_link_watchdog_fires());
+    printf("@carpet sat=%s\n", s.sat[0] ? s.sat : "-");
+    printf("@carpet dialog=%s\n", s.dialog[0] ? s.dialog : "-");
+    printf("@carpet card=%s emotion=%s\n", s.card[0] ? s.card : "-",
+           s.emotion[0] ? s.emotion : "-");
+    printf("@carpet sos=%s\n", s.sos[0] ? s.sos : "-");
+    /* 三个按钮发出去几条、最后一条是哪个 —— 站在那块屏前按了才知道有没有通路，
+     * 这一行是"按了真的发出去了"的唯一凭据。 */
+    int sent = 0;
+    const char *last = carpet_link_last_sent(&sent);
+    printf("@carpet sent=%d last=%s\n", sent, last);
+    fflush(stdout);
+}
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_link.h b/esp32/components/muse/carpet/carpet_link.h
new file mode 100644
index 0000000..275f384
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_link.h
@@ -0,0 +1,68 @@
+/*
+ * 车联（Screen-Link）在 Muse 里的启动闸门与状态存放。
+ *
+ * Muse 的 UI 是拉取式的：LVGL 任务每帧自己去读状态（见 muse_ui.c 的
+ * update_chrome()），其它任务从不碰 LVGL。所以本文件只写状态，
+ * 画由 carpet_page.c 在 UI 任务里读。
+ *
+ * Wi-Fi 归 Home Link 管（手机配对后才能上网），这里不能自己连，
+ * 只能等 muse_wifi_connected() 真了再启链路。
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Safe from any task. Starts the link once Wi-Fi is up; calling it twice does
+ * nothing. */
+void carpet_link_start(void);
+
+/* What the page draws. Snapshot so the UI task reads one consistent set. */
+typedef struct {
+    bool wifi_up;
+    bool linked;
+    int negotiated;          /* 谈下来的契约档；只有 >=2 才走得通对话 */
+    uint32_t gap_s;          /* 距上一帧 state 多少秒；没连上时是 UINT32_MAX */
+} carpet_link_view_t;
+
+void carpet_link_view(carpet_link_view_t *out);
+
+/*
+ * 页面上另外四行要的值，已经从契约的英文枚举翻成中文短串（屏上不许出现英文原值）。
+ * 每一项都只描述**最新那一帧**：帧里没带的字段不会留着上一帧的值，
+ * 所以这里不需要"清一清"的额外约定 —— 整棵树每帧换掉，缺的就是回落值。
+ */
+typedef struct {
+    bool has_state;          /* 这轮会话收到过 state 没有 */
+    char sat[40];            /* 卫星相位 + 下次过境倒计时 */
+    char card[24];           /* 手机上当前画在哪张卡 */
+    char emotion[24];        /* ui.emotion */
+    char sos[24];            /* sos.level */
+    char dialog[40];         /* 最近一句对话的方向和来源；超过 5 秒留空 */
+} carpet_state_view_t;
+
+/* 从任何任务读都行（里面有锁），但只在 UI 任务的 tick 里调用才有意义。 */
+bool carpet_link_state(carpet_state_view_t *out);
+
+/*
+ * 把一次"用户在这块玻璃上做了什么"送给手机。cmd 只能是契约里那三条
+ * （card_next / card_auto / poke）—— 组件自己还有一道白名单，非法值当场退回，
+ * 而手机端解不开入站帧的处理是**关连接、一句话不说**，所以拼错的代价是掉线。
+ *
+ * dir 只给 card_next 用（+1 往后一张 / -1 往前一张）。
+ *
+ * **这条在 LVGL 任务里调用安全**：它只往队列里放一个 16 字节的小结构，
+ * 真正的 socket 发送在 carpet_cmd 任务里 —— screen_link_send_command() 最坏会
+ * 阻塞约 2 秒，搁在 UI 任务里就是整块屏停两秒（脸不再呼吸、页面不更新）。
+ * 队列满（4 条没发出去）就丢掉并记一条 warning，绝不等待。
+ */
+void carpet_link_send(const char *cmd, int dir);
+
+/* 最近一次成功装配上行的命令，给 `>carpet` 回读用（不是给人看的，是给我证明
+ * "按下去真的上线了"）。sent=成功发出的条数。 */
+const char *carpet_link_last_sent(int *sent);
+
+/* Console readback (`>carpet`): prints the same numbers and strings the tile
+ * draws, one line each. Safe from any task, never touches LVGL. */
+void carpet_link_dump(void);
diff --git a/esp32/components/muse/carpet/carpet_page.c b/esp32/components/muse/carpet/carpet_page.c
new file mode 100644
index 0000000..9800614
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_page.c
@@ -0,0 +1,290 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "carpet/carpet_page.h"
+
+#include "sdkconfig.h"
+#if CONFIG_MUSE_CARPET_CARDS
+
+#include <stdio.h>
+#include <string.h>
+
+#include "carpet/carpet_link.h"
+#include "esp_log.h"
+
+static const char *TAG = "carpet_page";
+
+/* ---------- 字体 ---------- */
+
+/* Muse 自带的中文只有 16 px 一档（fonts/muse_font_cjk_noto_16.c），那是位图，
+ * 字号改不动。这一页要的是隔着两米能读、按得动的条目，所以自己带一份**只含本页
+ * 会画的字**的 TTF 子集（仓库里 tools/muse_font_subset.py 造的，90KB），交给
+ * LVGL 的 tiny_ttf 现算字号。子集漏了的不许画豆腐块：留 16 px 那份全量当 fallback。 */
+#if CONFIG_MUSE_CJK_FONT
+#if CONFIG_MUSE_CJK_FONT_NOTO
+LV_FONT_DECLARE(muse_font_cjk_noto_16)
+#define FALLBACK_FONT muse_font_cjk_noto_16
+#else
+LV_FONT_DECLARE(muse_font_cjk_16)
+#define FALLBACK_FONT muse_font_cjk_16
+#endif
+#define FALLBACK (&FALLBACK_FONT)
+#else
+#define FALLBACK NULL
+#endif
+
+#define FONT_BIG   24   /* 条目名和链路那行：比 Muse 正文的 20 px 还高一档 */
+#define FONT_SMALL 20   /* 值、按钮、副行：Muse 在这块屏上用的那一档 */
+
+#if CONFIG_LV_USE_TINY_TTF
+/* carpet_font.ttf 由本组件 CMakeLists 的 EMBED_FILES 进 rodata，符号名只取文件名 */
+extern const uint8_t carpet_font_ttf_start[] asm("_binary_carpet_font_ttf_start");
+extern const uint8_t carpet_font_ttf_end[] asm("_binary_carpet_font_ttf_end");
+#endif
+
+static lv_font_t *s_big;
+static lv_font_t *s_small;
+
+/* 只在 LVGL 任务里调（build 由 muse_ui 的初始化发起）：create 会动 LVGL 的分配器。 */
+static void fonts_init(void)
+{
+#if CONFIG_LV_USE_TINY_TTF
+    const size_t n = (size_t)(carpet_font_ttf_end - carpet_font_ttf_start);
+    s_big   = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_BIG);
+    s_small = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_SMALL);
+    if (s_big && s_small) {
+        s_big->fallback   = FALLBACK;
+        s_small->fallback = FALLBACK;
+        ESP_LOGI(TAG, "tiny_ttf %u 字节 → %d/%dpx", (unsigned)n, FONT_BIG, FONT_SMALL);
+        return;
+    }
+    ESP_LOGE(TAG, "tiny_ttf 打不开这份子集，整页退回 16px");
+    if (s_big) { lv_tiny_ttf_destroy(s_big); s_big = NULL; }
+    if (s_small) { lv_tiny_ttf_destroy(s_small); s_small = NULL; }
+#endif
+    /* 没开 tiny_ttf（或字库坏了）也得有页面看：ASCII 走 unscii，中文落 16 px 那份 */
+    static lv_font_t small16;
+    if (!small16.get_glyph_dsc) {
+        small16 = lv_font_unscii_16;
+        small16.fallback = FALLBACK;
+    }
+    if (!s_big) s_big = &small16;
+    if (!s_small) s_small = &small16;
+}
+
+/* ---------- Muse 那套配色与卡片 ---------- */
+
+/* 抄 muse_settings_ui.c 的调色板：这一页和右滑那页必须是同一个东西。 */
+#define COLOR_TEXT          0xf2efff
+#define COLOR_DIM           0x8b84a8
+#define COLOR_CARD          0x1a1530
+#define COLOR_CARD_PRESSED  0x2e2552
+#define COLOR_ACCENT        0xa77dff
+#define COLOR_OFF           0xff9a5c   /* 链路不健康：占的是 Muse COLOR_WARN 的位置 */
+
+/* COL_W 就是 Muse 设置页的 LIST_W。卡片高 56 而不是它的 58：这一页要在 466 的圆里
+ * 塞下状态行 + 副行 + 三张卡 + 一排按钮，58 会把最外那张的圆角顶到屏外。 */
+#define COL_W 330
+#define ROW_H 56
+#define BTN_H 52
+#define GAP   6
+#define BTN_W 102
+
+typedef struct {
+    lv_obj_t *label;
+    char shown[64];
+} line_t;
+
+/* 拉取式：值没变就不重画 —— 这一页每个 tick 都被叫一次，而 tiny_ttf 的字模是现算的，
+ * 白重画的代价比位图字体高得多。 */
+static void set_line(line_t *l, const char *text, uint32_t color)
+{
+    if (!l->label) return;
+    if (strcmp(text, l->shown) == 0) return;
+    snprintf(l->shown, sizeof(l->shown), "%s", text);
+    lv_label_set_text(l->label, text);
+    lv_obj_set_style_text_color(l->label, lv_color_hex(color), 0);
+}
+
+static lv_obj_t *make_label(lv_obj_t *parent, const lv_font_t *font, uint32_t color, const char *text)
+{
+    lv_obj_t *l = lv_label_create(parent);
+    lv_obj_set_style_text_font(l, font, 0);
+    lv_obj_set_style_text_color(l, lv_color_hex(color), 0);
+    lv_label_set_text(l, text);
+    return l;
+}
+
+/* Muse 的 card()：能点就建 lv_button（这才吃点击），圆角 18、左右内衬 16、横排、
+ * 按下换色。每张都摘掉 SCROLLABLE —— tile 已被 muse_ui.c 设成 LV_DIR_NONE，
+ * 卡里再留一个可滚的东西就把上滑/下滑吞回去。 */
+static lv_obj_t *make_card(lv_obj_t *parent, bool clickable, int h)
+{
+    lv_obj_t *c = clickable ? lv_button_create(parent) : lv_obj_create(parent);
+    lv_obj_remove_style_all(c);
+    lv_obj_set_size(c, lv_pct(100), h);
+    lv_obj_set_style_radius(c, 18, 0);
+    lv_obj_set_style_bg_opa(c, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(c, lv_color_hex(COLOR_CARD), 0);
+    lv_obj_set_style_bg_color(c, lv_color_hex(COLOR_CARD_PRESSED), LV_STATE_PRESSED);
+    lv_obj_set_style_pad_hor(c, 16, 0);
+    lv_obj_set_flex_flow(c, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(c, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_style_pad_column(c, 12, 0);
+    lv_obj_remove_flag(c, LV_OBJ_FLAG_SCROLLABLE);
+    return c;
+}
+
+/* ---------- 页面 ---------- */
+
+/* 表情不在这儿占一行：脸本身就在演它，串口 >carpet 里照样读得到。 */
+#define ROW_COUNT 3
+static const char *const s_row_names[ROW_COUNT] = { "卫星", "对话", "呼救" };
+
+static line_t s_head;
+static line_t s_card;
+static line_t s_rows[ROW_COUNT];
+
+static void on_row_clicked(lv_event_t *e)
+{
+    (void)e;
+    /* 契约里单击就是 poke，手机的 CardPolicy 拿它开一段互动窗口。
+     * 这里只入队：socket 发送在 carpet_cmd 任务里，LVGL 任务里阻塞两秒
+     * 是把整个界面冻住。 */
+    carpet_link_send("poke", 0);
+}
+
+static void on_btn_clicked(lv_event_t *e)
+{
+    /* 下标就是屏幕上的顺序，也对应契约的三条：0 上一张 1 下一张 2 交回 */
+    const int idx = (int)(intptr_t)lv_event_get_user_data(e);
+    if (idx < 2) carpet_link_send("card_next", idx == 0 ? -1 : 1);
+    else         carpet_link_send("card_auto", 0);
+}
+
+void carpet_page_build(lv_obj_t *tile)
+{
+    if (!tile) return;
+    fonts_init();
+
+    /* 330 宽的卡片离圆心最远能到哪儿：屏半径 233、卡片半宽 165，
+     * sqrt(233^2-165^2)=164。整列最高 28+24+3*56+52+5*6=326，半高 163 < 164，
+     * 最外那张的角 (165,163) 离圆心 232 < 233 —— 圆角不会被裁。 */
+    lv_obj_t *col = lv_obj_create(tile);
+    lv_obj_remove_style_all(col);
+    lv_obj_set_size(col, COL_W, LV_SIZE_CONTENT);
+    lv_obj_align(col, LV_ALIGN_CENTER, 0, 0);
+    lv_obj_set_flex_flow(col, LV_FLEX_FLOW_COLUMN);
+    lv_obj_set_flex_align(col, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_style_pad_row(col, GAP, 0);
+    lv_obj_remove_flag(col, LV_OBJ_FLAG_SCROLLABLE);
+
+    /* 第一行：链路活没活。第二行：手机现在画的是哪张卡 —— 下面三个按钮动的就是它。 */
+    lv_obj_t *head = lv_obj_create(col);
+    lv_obj_remove_style_all(head);
+    lv_obj_set_size(head, lv_pct(100), LV_SIZE_CONTENT);
+    lv_obj_remove_flag(head, LV_OBJ_FLAG_SCROLLABLE);
+    s_head.label = make_label(head, s_big, COLOR_DIM, "未接入");
+    snprintf(s_head.shown, sizeof(s_head.shown), "未接入");
+
+    lv_obj_t *sub = lv_obj_create(col);
+    lv_obj_remove_style_all(sub);
+    lv_obj_set_size(sub, lv_pct(100), LV_SIZE_CONTENT);
+    lv_obj_remove_flag(sub, LV_OBJ_FLAG_SCROLLABLE);
+    s_card.label = make_label(sub, s_small, COLOR_DIM, "手机在画 —");
+    snprintf(s_card.shown, sizeof(s_card.shown), "手机在画 —");
+
+    for (int i = 0; i < ROW_COUNT; i++) {
+        lv_obj_t *c = make_card(col, true, ROW_H);
+        make_label(c, s_big, COLOR_TEXT, s_row_names[i]);
+        /* 值吃掉剩下的宽度并右对齐。Muse 把值限死 130 px，在这儿不够 —— 中文比
+         * 拉丁密，一句"手机在说 · 语音"就超了，所以用 grow + DOTS：长是省略号，
+         * 不会把条目名挤走。 */
+        lv_obj_t *v = make_label(c, s_small, COLOR_DIM, "");
+        lv_obj_set_flex_grow(v, 1);
+        lv_label_set_long_mode(v, LV_LABEL_LONG_MODE_DOTS);
+        lv_obj_set_style_text_align(v, LV_TEXT_ALIGN_RIGHT, 0);
+        s_rows[i].label = v;
+        s_rows[i].shown[0] = '\0';
+        lv_obj_add_event_cb(c, on_row_clicked, LV_EVENT_CLICKED, NULL);
+    }
+
+    /* 三个动作并一排：3*102=306，余 24 px 分给两道间隙。 */
+    lv_obj_t *bar = lv_obj_create(col);
+    lv_obj_remove_style_all(bar);
+    lv_obj_set_size(bar, lv_pct(100), BTN_H);
+    lv_obj_remove_flag(bar, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_flex_flow(bar, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(bar, LV_FLEX_ALIGN_SPACE_BETWEEN, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+
+    static const char *const btn_text[3] = { "上一张", "下一张", "交回" };
+    for (int i = 0; i < 3; i++) {
+        lv_obj_t *b = lv_button_create(bar);
+        lv_obj_remove_style_all(b);
+        lv_obj_set_size(b, BTN_W, BTN_H);
+        lv_obj_set_style_radius(b, 18, 0);
+        lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(b, lv_color_hex(COLOR_CARD), 0);
+        lv_obj_set_style_bg_color(b, lv_color_hex(COLOR_CARD_PRESSED), LV_STATE_PRESSED);
+        lv_obj_remove_flag(b, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_center(make_label(b, s_small, COLOR_ACCENT, btn_text[i]));
+        lv_obj_add_event_cb(b, on_btn_clicked, LV_EVENT_CLICKED, (void *)(intptr_t)i);
+    }
+}
+
+void carpet_page_tick(void)
+{
+    carpet_link_view_t v;
+    carpet_link_view(&v);
+
+    if (!v.wifi_up) {
+        set_line(&s_head, "等网络", COLOR_OFF);
+    } else if (!v.linked) {
+        set_line(&s_head, "未接入", COLOR_OFF);
+    } else if (v.gap_s == UINT32_MAX) {
+        /* hello 已经发出去了，但这一轮还没收到过 state */
+        set_line(&s_head, "等首帧", COLOR_OFF);
+    } else if (v.gap_s > 10) {
+        /* 组件自己会断线重连，这里只把结果画出来 */
+        set_line(&s_head, "掉线重连", COLOR_OFF);
+    } else if (v.gap_s > 3) {
+        char buf[40];
+        snprintf(buf, sizeof buf, "卡%lu秒", (unsigned long)v.gap_s);
+        set_line(&s_head, buf, COLOR_OFF);
+    } else {
+        set_line(&s_head, v.negotiated >= 2 ? "已接入 v2" : "已接入 v1", COLOR_ACCENT);
+    }
+
+    /* 3 秒没帧 = 服务端还在但话说完了（或者热点断了），契约要求保留最后一帧，
+     * 所以不清屏，只统一转成灰。 */
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+    const uint32_t color = (v.linked && v.gap_s <= 3) ? COLOR_TEXT : COLOR_DIM;
+
+    /* 画哪张卡只由帧里的 ui.card 定，屏不许自己挑；这一行是那个事实的读数，
+     * 下面三个按钮发出去的是**请求**，成不成由手机的 CardPolicy 说了算。 */
+    char card[48];
+    snprintf(card, sizeof card, "手机在画 %s", s.card[0] ? s.card : "—");
+    set_line(&s_card, card, color);
+
+    set_line(&s_rows[0], s.sat[0] ? s.sat : "—", color);
+    set_line(&s_rows[1], s.dialog[0] ? s.dialog : "没人说话", color);
+    /* 呼救这一行不"正常"就是要让人看见，所以反过来用强调色 */
+    const bool calm = (s.sos[0] == '\0') || (strcmp(s.sos, "正常") == 0);
+    set_line(&s_rows[2], s.sos[0] ? s.sos : "—", calm ? color : COLOR_ACCENT);
+}
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_page.h b/esp32/components/muse/carpet/carpet_page.h
new file mode 100644
index 0000000..9ac73c7
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_page.h
@@ -0,0 +1,21 @@
+/*
+ * 车联页：上滑从脸进入的那一格 tile，把我们的功能挂进去。
+ *
+ * 只在 LVGL 任务里跑（muse_ui.c 的 frame_tick 调 carpet_page_tick），
+ * 数据一律从 carpet_link_view() 读，不在这里发起任何网络动作。
+ */
+
+#pragma once
+
+#include "sdkconfig.h"
+#if CONFIG_MUSE_CARPET_CARDS
+
+#include "lvgl.h"
+
+/* LVGL task only: builds the menu inside the tile muse_ui.c created. */
+void carpet_page_build(lv_obj_t *tile);
+
+/* LVGL task only: pulls the link state onto the labels, at the chrome tick. */
+void carpet_page_tick(void);
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */

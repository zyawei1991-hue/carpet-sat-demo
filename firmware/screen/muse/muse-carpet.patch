+    { "VM ID", "虚拟机" },
+    { "Device token", "设备令牌" },
+    { "SDK token", "SDK 令牌" },
+    { "Test connection", "测试连接" },
+    { "Set", "已设" },
+    { "Set here", "在这儿填的" },
+    { "Not a token", "不是令牌" },
+    { "Empty for the default", "留空用默认" },
+    { "Optional", "可留空" },
+    { "Empty keeps the current one", "留空保持不变" },
+    { "Empty keeps the current one; a new one restarts", "留空保持不变；填新的会重启" },
+    /* The fold this page got on 11-08: one row, one line under it that says why
+     * it is folded, and the four fields behind it. The value slot is 130 px, so
+     * the state word is three characters; the row name takes "Muse" at 20 px and
+     * one hanzi at 16. The line is the owner's own wording, kept to two wrapped
+     * lines inside the 330 px note column, and it uses no U+2026 or U+2014. */
+    { "Muse cloud", "Muse 云" },

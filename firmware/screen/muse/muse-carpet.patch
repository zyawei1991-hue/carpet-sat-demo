+            carpet_link_bench_event(rest);
+            carpet_link_event_dump();
+        }
+        return true;
+    }
+    /* 本机造一次触摸，走和真手指同一条手势判定路（契约那四条：左右滑切卡、
+     * 上下滑定开/定关明细、长按交回、单击戳一下）。为什么串口要有这一条：
+     * 真玻璃上"划了没反应"分不清是采点没采到、阈值没过、还是链路没通 ——
+     * 这一句把判定那一半单独称出来，日志里 dx/dy/held/判为哪一条都在。 */
+    if (!strncmp(line, "gest", 4) && (line[4] == '\0' || line[4] == ' ')) {
+        const char *rest = line + 4;
+        while (*rest == ' ') rest++;
+        if (!strcmp(rest, "left"))       carpet_page_gesture_bench(-80, 0, 120);
+        else if (!strcmp(rest, "right")) carpet_page_gesture_bench(80, 0, 120);
+        else if (!strcmp(rest, "up"))    carpet_page_gesture_bench(0, -80, 120);
+        else if (!strcmp(rest, "down"))  carpet_page_gesture_bench(0, 80, 120);
+        else if (!strcmp(rest, "tap"))   carpet_page_gesture_bench(0, 0, 120);
+        else if (!strcmp(rest, "hold"))  carpet_page_gesture_bench(0, 0, 900);
+        else {
+            printf("@gest 只认 left / right / up / down / tap / hold\n");
+            fflush(stdout);
+            return true;
+        }
+        fflush(stdout);
+        return true;
+    }
+    /* `>gestfrom <dir>`：和 >gest 同一条判定路，但不先回脸——从当前格起判。
+     * 称「外页划动回中心」（owner 2026-11-14）：先 >gestfrom 到外页，再 >gestfrom 划一下。 */
+    if (!strncmp(line, "gestfrom", 8) && (line[8] == '\0' || line[8] == ' ')) {
+        const char *rest = line + 8;
+        while (*rest == ' ') rest++;
+        if (!strcmp(rest, "left"))       carpet_page_gesture_bench_from(-80, 0, 120);
+        else if (!strcmp(rest, "right")) carpet_page_gesture_bench_from(80, 0, 120);
+        else if (!strcmp(rest, "up"))    carpet_page_gesture_bench_from(0, -80, 120);
+        else if (!strcmp(rest, "down"))  carpet_page_gesture_bench_from(0, 80, 120);
+        else if (!strcmp(rest, "tap"))   carpet_page_gesture_bench_from(0, 0, 120);
+        else {
+            printf("@gestfrom 只认 left / right / up / down / tap（从当前格判，不回脸）\n");
+            fflush(stdout);
+            return true;
+        }
+        fflush(stdout);
+        return true;
+    }
+    /* `>touch`：回读真触摸 indev 解析没解析出来、类型/模式/state/point，外加手势互斥闸。
+     * 真玻璃「划了没反应」时，先用这一条把"真路径有没有入口"和台架判定分开：
+     * pointer=NONE 就是真触摸根本没接上（台架照样能划，所以光称 >gest 看不出来）。 */
+    if (!strncmp(line, "touch", 5) && (line[5] == '\0' || line[5] == ' ')) {
+        carpet_page_touch_dump();

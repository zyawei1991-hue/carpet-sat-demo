+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * Spotpear (斑梨) ESP32-S3-1.8inch-Touch-LCD, JC3636W518 module: round 360 px
+ * ST77916 QSPI panel + CST816 touch, both resets on plain GPIOs (no I/O
+ * expander on this carrier). Audio is a PCM5100A I2S DAC (line out to a 3.5 mm
+ * jack and a pin header — NO speaker amp on board) plus an MSM261 I2S MEMS mic
+ * on its own bus, the 1.46 board's arrangement. No PMU, no battery divider:
+ * power reads report "no battery" honestly. BOOT (GPIO0) is the talk button;
+ * holding a finger on the face tile also talks.
+ * Pins from the vendor schematic (spotpear.cn wiki, 1_P1/2_S3R8/3_DAC/4_lcd).
+ */
+#include <math.h>
+
+#include "driver/gpio.h"
+#include "driver/i2c_master.h"
+#include "driver/i2s_std.h"
+#include "driver/ledc.h"
+#include "driver/spi_master.h"
+#include "driver/usb_serial_jtag.h"
+#include "esp_check.h"
+#include "esp_codec_dev_defaults.h"
+#include "esp_lcd_panel_io.h"
+#include "esp_lcd_panel_ops.h"
+#include "esp_lcd_panel_vendor.h"
+#include "esp_log.h"
+#include "esp_lv_adapter.h"
+#include "esp_sleep.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+#include "muse_audio.h"
+#include "muse_board.h"
+#include "muse_ui.h"
+#include "muse_lcd_bands.h"
+#include "muse_mem.h"
+
+#include "esp_lcd_st77916.h"
+#include "esp_lcd_touch_cst816s.h"
+/* Same 360x360 ST77916 QSPI module family as the 1.85C; if this carrier's
+ * panel ever needs its own gamma/power table, swap the init cmds here. */
+#include "waveshare_s3_185c/st77916_init_185c.h"
+
+static const char *TAG = "board";
+
+/* Pins (vendor schematic 2_S3R8 / 4_lcd). */
+#define LCD_SCLK GPIO_NUM_9
+#define LCD_D0 GPIO_NUM_11
+#define LCD_D1 GPIO_NUM_12
+#define LCD_D2 GPIO_NUM_13
+#define LCD_D3 GPIO_NUM_14
+#define LCD_CS GPIO_NUM_10
+#define LCD_RST GPIO_NUM_47
+#define LCD_BL GPIO_NUM_15
+#define LCD_RES 360
+
+#define I2C_SDA GPIO_NUM_7
+#define I2C_SCL GPIO_NUM_8
+#define TOUCH_INT GPIO_NUM_41
+#define TOUCH_RST GPIO_NUM_40
+
+/* Speaker: PCM5100A on I2S1, no control interface; XSMT unmutes it. */
+#define SPK_MCLK GPIO_NUM_21
+#define SPK_BCLK GPIO_NUM_18
+#define SPK_WS GPIO_NUM_16
+#define SPK_DOUT GPIO_NUM_17
+#define DAC_XSMT GPIO_NUM_48
+/* Mic: MSM261S4030H0R on I2S0, L/R tied low => left slot. */
+#define MIC_BCLK GPIO_NUM_42
+#define MIC_WS GPIO_NUM_45
+#define MIC_DIN GPIO_NUM_46
+
+#define MIC_GAIN_OFFSET_DB 0
+
+#define DRAW_BUF_LINES 72      /* five bands to the screen (muse_lcd_bands.h) */
+#define LCD_CHUNK_BYTES (LCD_RES * 8 * 2)
+
+static i2c_master_bus_handle_t s_i2c;
+static esp_lcd_panel_handle_t s_panel;
+static esp_lcd_panel_io_handle_t s_io;
+static esp_lcd_touch_handle_t s_tp;
+static lv_indev_t *s_touch_indev;
+static muse_gpio_button_t s_boot;
+static i2s_chan_handle_t s_tx, s_rx;
+static i2s_std_slot_config_t s_rx_slot;
+static int32_t s_mic_dc[2];
+static int s_mic_gain_q8 = 256;
+
+/* The ST77916 needs even-aligned update windows over the QSPI command path. */
+static void round_area(lv_event_t *e)
+{
+    lv_area_t *a = lv_event_get_param(e);
+    a->x1 &= ~1;
+    a->y1 &= ~1;
+    a->x2 |= 1;
+    a->y2 |= 1;
+}
+
+static esp_err_t init(void)
+{
+    const i2c_master_bus_config_t i2c_cfg = {
+        .i2c_port = I2C_NUM_0,
+        .sda_io_num = I2C_SDA,
+        .scl_io_num = I2C_SCL,
+        .clk_source = I2C_CLK_SRC_DEFAULT,
+        .glitch_ignore_cnt = 7,
+        .flags.enable_internal_pullup = true,
+    };
+    ESP_RETURN_ON_ERROR(i2c_new_master_bus(&i2c_cfg, &s_i2c), TAG, "i2c");
+
+    ESP_RETURN_ON_ERROR(muse_gpio_button_init(&s_boot, GPIO_NUM_0), TAG, "boot button");
+    /* BOOT is held at flashing time; don't count a held button as a press. */
+    s_boot.pressed = gpio_get_level(GPIO_NUM_0) == 0;
+
+    const gpio_config_t xsmt = {
+        .pin_bit_mask = 1ULL << DAC_XSMT,
+        .mode = GPIO_MODE_OUTPUT,
+    };
+    ESP_RETURN_ON_ERROR(gpio_config(&xsmt), TAG, "xsmt");
+    ESP_RETURN_ON_ERROR(gpio_set_level(DAC_XSMT, 1), TAG, "dac unmute");
+    return ESP_OK;
+}
+
+/* muse_lcd_bands_register takes over the panel IO's color-done callback and,
+ * with the bands, needs the bus set up on the same core as the UI task. */
+static lv_display_t *display_start(lv_indev_t **touch)
+{
+    const ledc_timer_config_t bl_timer = {
+        .speed_mode = LEDC_LOW_SPEED_MODE,
+        .duty_resolution = LEDC_TIMER_10_BIT,
+        .timer_num = LEDC_TIMER_0,
+        .freq_hz = 20000,
+        .clk_cfg = LEDC_AUTO_CLK,
+    };
+    const ledc_channel_config_t bl_ch = {
+        .gpio_num = LCD_BL,
+        .speed_mode = LEDC_LOW_SPEED_MODE,
+        .channel = LEDC_CHANNEL_0,
+        .timer_sel = LEDC_TIMER_0,
+        .duty = 0,
+    };
+    if (ledc_timer_config(&bl_timer) != ESP_OK || ledc_channel_config(&bl_ch) != ESP_OK) {
+        ESP_LOGE(TAG, "backlight pwm");
+        return NULL;
+    }
+
+    const spi_bus_config_t bus = {
+        .sclk_io_num = LCD_SCLK,
+        .data0_io_num = LCD_D0,
+        .data1_io_num = LCD_D1,
+        .data2_io_num = LCD_D2,
+        .data3_io_num = LCD_D3,
+        .max_transfer_sz = LCD_CHUNK_BYTES,
+    };
+    if (spi_bus_initialize(SPI2_HOST, &bus, SPI_DMA_CH_AUTO) != ESP_OK) {
+        ESP_LOGE(TAG, "spi bus");
+        return NULL;
+    }
+    const esp_lcd_panel_io_spi_config_t io_cfg = ST77916_PANEL_IO_QSPI_CONFIG(LCD_CS, NULL, NULL);
+    if (esp_lcd_new_panel_io_spi(SPI2_HOST, &io_cfg, &s_io) != ESP_OK) {
+        ESP_LOGE(TAG, "panel io");
+        return NULL;
+    }
+    st77916_vendor_config_t vendor_cfg = {
+        .init_cmds = ST77916_INIT_185C_CMDS,
+        .init_cmds_size = ST77916_INIT_185C_SIZE,
+        .flags = { .use_qspi_interface = 1 },
+    };
+    const esp_lcd_panel_dev_config_t panel_cfg = {
+        .reset_gpio_num = LCD_RST,
+        .rgb_ele_order = LCD_RGB_ELEMENT_ORDER_RGB,
+        .bits_per_pixel = 16,
+        .vendor_config = &vendor_cfg,
+    };
+    if (esp_lcd_new_panel_st77916(s_io, &panel_cfg, &s_panel) != ESP_OK) {
+        ESP_LOGE(TAG, "st77916");
+        return NULL;
+    }
+    esp_lcd_panel_reset(s_panel);
+    esp_lcd_panel_init(s_panel);
+    esp_lcd_panel_disp_on_off(s_panel, true);
+
+    esp_lv_adapter_config_t adapter_cfg = ESP_LV_ADAPTER_DEFAULT_CONFIG();
+    adapter_cfg.task_core_id = MUSE_UI_CORE;
+    adapter_cfg.task_priority = MUSE_UI_PRIORITY;
+#if CONFIG_LV_USE_TJPGD
+    /* 和 175c 同一档：TJPGD 解码+绘制链溢过适配器默认 8KB（钟面页实测
+     * task lvgl stack overflow ⇒ rst=0xc）。抬到 12KB，水位看 >carpet 回读。 */
+    adapter_cfg.task_stack_size = 12 * 1024;
+#endif
+    if (esp_lv_adapter_init(&adapter_cfg) != ESP_OK) {
+        return NULL;
+    }
+    const esp_lv_adapter_display_config_t disp_cfg = {
+        .panel = s_panel,
+        .panel_io = s_io,
+        .profile = {
+            .interface = ESP_LV_ADAPTER_PANEL_IF_OTHER,
+            .rotation = ESP_LV_ADAPTER_ROTATE_0,
+            .hor_res = LCD_RES,
+            .ver_res = LCD_RES,
+        },
+        .tear_avoid_mode = ESP_LV_ADAPTER_TEAR_AVOID_MODE_NONE,
+    };
+    lv_display_t *disp = muse_lcd_bands_register(disp_cfg, DRAW_BUF_LINES, LCD_CHUNK_BYTES);
+    if (!disp) {
+        return NULL;
+    }
+    lv_display_add_event_cb(disp, round_area, LV_EVENT_INVALIDATE_AREA, NULL);
+
+    esp_lcd_panel_io_handle_t tp_io;
+    const esp_lcd_panel_io_i2c_config_t tp_io_cfg = ESP_LCD_TOUCH_IO_I2C_CST816S_CONFIG();
+    if (esp_lcd_new_panel_io_i2c(s_i2c, &tp_io_cfg, &tp_io) != ESP_OK) {
+        ESP_LOGE(TAG, "touch io");
+        return NULL;
+    }
+    const esp_lcd_touch_config_t tp_cfg = {
+        .x_max = LCD_RES,
+        .y_max = LCD_RES,
+        .rst_gpio_num = TOUCH_RST,
+        .int_gpio_num = TOUCH_INT,
+        .flags = {
+            .swap_xy = 0,
+            .mirror_x = 0,
+            .mirror_y = 0,
+        },
+    };
+    if (esp_lcd_touch_new_i2c_cst816s(tp_io, &tp_cfg, &s_tp) != ESP_OK) {
+        ESP_LOGE(TAG, "cst816");
+        return NULL;
+    }
+    const esp_lv_adapter_touch_config_t tp_lvgl_cfg = ESP_LV_ADAPTER_TOUCH_DEFAULT_CONFIG(disp, s_tp);
+    *touch = esp_lv_adapter_register_touch(&tp_lvgl_cfg);
+    if (!*touch || esp_lv_adapter_start() != ESP_OK) {
+        return NULL;
+    }
+    s_touch_indev = *touch;
+    return disp;
+}
+
+static bool display_lock(int timeout_ms)
+{
+    return esp_lv_adapter_lock(timeout_ms) == ESP_OK;
+}
+
+static void set_brightness(int pct)
+{
+    ledc_set_duty(LEDC_LOW_SPEED_MODE, LEDC_CHANNEL_0, pct * 1023 / 100);
+    ledc_update_duty(LEDC_LOW_SPEED_MODE, LEDC_CHANNEL_0);
+}
+
+static void panel_sleep(bool sleep)
+{
+    esp_lcd_panel_disp_sleep(s_panel, sleep);   /* SLPIN/SLPOUT; GRAM is kept */
+    vTaskDelay(pdMS_TO_TICKS(120));             /* settle before the next command */
+}
+
+static void display_pause(bool pause)
+{
+    if (pause) {
+        esp_lv_adapter_pause(-1);
+    } else {
+        esp_lv_adapter_resume();
+    }
+}
+
+/* No codec control anywhere: the PCM5100A takes I2S as is, esp_codec_dev adds
+ * the volume in software, and the mic gain is applied here. Both channels run
+ * all the time; idle, the speaker sends zeros (auto_clear). */
+static int data_enable(const audio_codec_data_if_t *h, esp_codec_dev_type_t type, bool on)
+{
+    (void)h;
+    (void)type;
+    (void)on;
+    return ESP_CODEC_DEV_OK;
+}
+
+static int spk_write(const audio_codec_data_if_t *h, uint8_t *data, int size)
+{
+    (void)h;
+    size_t wrote;
+    return i2s_channel_write(s_tx, data, size, &wrote, portMAX_DELAY) == ESP_OK ? ESP_CODEC_DEV_OK
+                                                                                : ESP_CODEC_DEV_WRITE_FAIL;
+}
+
+/* A MEMS mic's slot has a small DC offset, which the gain would turn into
+ * clipping: each slot's zero level is tracked and taken off first. */
+static int mic_read(const audio_codec_data_if_t *h, uint8_t *data, int size)
+{
+    (void)h;
+    size_t got;
+    if (i2s_channel_read(s_rx, data, size, &got, pdMS_TO_TICKS(1000)) != ESP_OK || got != (size_t)size) {
+        return ESP_CODEC_DEV_READ_FAIL;
+    }
+    int16_t *s = (int16_t *)data;
+    for (int i = 0; i < size / 2; i++) {
+        int32_t *dc = &s_mic_dc[i & 1];
+        *dc += (s[i] * 256 - *dc) >> 8;
+        int v = (s[i] - (*dc >> 8)) * s_mic_gain_q8 >> 8;
+        s[i] = v > INT16_MAX ? INT16_MAX : v < INT16_MIN ? INT16_MIN : v;
+    }
+    return ESP_CODEC_DEV_OK;
+}
+
+static void set_mic_gain(esp_codec_dev_handle_t mic, int db)
+{
+    (void)mic;
+    s_mic_gain_q8 = (int)(256.0f * powf(10.0f, (db - MIC_GAIN_OFFSET_DB) / 20.0f));
+}
+
+/* Two I2S buses: the PCM5100A on I2S1 with plain 16-bit stereo (MCLK wired on
+ * this carrier), the MEMS mic on I2S0 with the 32-bit slots it needs (each
+ * sample is the slot's top 16 bits). */
+static esp_err_t audio_init(esp_codec_dev_handle_t *spk, esp_codec_dev_handle_t *mic)
+{
+    i2s_chan_config_t tx_chan = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_1, I2S_ROLE_MASTER);
+    tx_chan.auto_clear = true;
+    ESP_RETURN_ON_ERROR(i2s_new_channel(&tx_chan, &s_tx, NULL), TAG, "i2s tx chan");
+    const i2s_std_config_t tx_cfg = {
+        .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(MUSE_AUDIO_RATE),
+        .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
+        .gpio_cfg = {
+            .mclk = SPK_MCLK,
+            .bclk = SPK_BCLK,
+            .ws = SPK_WS,
+            .dout = SPK_DOUT,
+            .din = I2S_GPIO_UNUSED,
+        },
+    };
+    ESP_RETURN_ON_ERROR(i2s_channel_init_std_mode(s_tx, &tx_cfg), TAG, "i2s tx");
+    ESP_RETURN_ON_ERROR(i2s_channel_enable(s_tx), TAG, "i2s tx on");
+
+    i2s_chan_config_t rx_chan = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
+    ESP_RETURN_ON_ERROR(i2s_new_channel(&rx_chan, NULL, &s_rx), TAG, "i2s rx chan");
+    i2s_std_config_t rx_cfg = {
+        .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(MUSE_AUDIO_RATE),
+        .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
+        .gpio_cfg = {
+            .mclk = I2S_GPIO_UNUSED,
+            .bclk = MIC_BCLK,
+            .ws = MIC_WS,
+            .dout = I2S_GPIO_UNUSED,
+            .din = MIC_DIN,
+        },
+    };
+    rx_cfg.slot_cfg.slot_bit_width = I2S_SLOT_BIT_WIDTH_32BIT;
+    rx_cfg.slot_cfg.ws_width = 32;
+    s_rx_slot = rx_cfg.slot_cfg;
+    ESP_RETURN_ON_ERROR(i2s_channel_init_std_mode(s_rx, &rx_cfg), TAG, "i2s rx");
+    ESP_RETURN_ON_ERROR(i2s_channel_enable(s_rx), TAG, "i2s rx on");
+
+    static const audio_codec_data_if_t spk_if = { .enable = data_enable, .write = spk_write };
+    static const audio_codec_data_if_t mic_if = { .enable = data_enable, .read = mic_read };
+    esp_codec_dev_cfg_t out_cfg = { .dev_type = ESP_CODEC_DEV_TYPE_OUT, .data_if = &spk_if };
+    esp_codec_dev_cfg_t in_cfg = { .dev_type = ESP_CODEC_DEV_TYPE_IN, .data_if = &mic_if };
+    *spk = esp_codec_dev_new(&out_cfg);
+    *mic = esp_codec_dev_new(&in_cfg);
+    ESP_RETURN_ON_FALSE(*spk && *mic, ESP_FAIL, TAG, "codec devs");
+    ESP_LOGI(TAG, "audio: PCM5100A (line out, I2S1) + MSM261 mic (I2S0)");
+    return ESP_OK;
+}
+
+/* Bench probe (>micraw): bring-up discriminator for a silent mic. Counts pad
+ * transitions on SD/BCLK/WS (a Hi-Z SD pulled down by R8 never toggles), then
+ * dumps full 32-bit DMA words so a format mismatch is visible instead of
+ * guessed. Other readers of s_rx see transient read failures while the slot
+ * is reconfigured; both handle that as a dropped frame. */
+void spotpear_micraw(void)
+{
+    const int pins[3] = { MIC_DIN, MIC_BCLK, MIC_WS };
+    for (int p = 0; p < 3; p++) {
+        gpio_input_enable(pins[p]);
+        int last = gpio_get_level(pins[p]), toggles = 0;
+        int64_t t0 = esp_timer_get_time();
+        for (int i = 0; i < 100000; i++) {
+            int v = gpio_get_level(pins[p]);
+            toggles += (v != last);
+            last = v;
+        }
+        printf("@micraw pin%d toggles=%d/%lldus last=%d\n", pins[p], toggles,
+               (long long)(esp_timer_get_time() - t0), last);
+    }
+    i2s_std_slot_config_t wide = s_rx_slot;
+    wide.data_bit_width = I2S_DATA_BIT_WIDTH_32BIT;
+    uint32_t w[16];
+    size_t got = 0;
+    i2s_channel_disable(s_rx);
+    if (i2s_channel_reconfig_std_slot(s_rx, &wide) == ESP_OK) {
+        i2s_channel_enable(s_rx);
+        vTaskDelay(pdMS_TO_TICKS(20));
+        if (i2s_channel_read(s_rx, w, sizeof(w), &got, pdMS_TO_TICKS(500)) == ESP_OK) {
+            for (int i = 0; i < 8; i++) {
+                printf("@micraw w%d=%08lx\n", i, (unsigned long)w[i]);
+            }
+        }
+        i2s_channel_disable(s_rx);
+    }
+    i2s_channel_reconfig_std_slot(s_rx, &s_rx_slot);
+    i2s_channel_enable(s_rx);
+}
+
+/* Bench probe (>micen): if a board revision wires CHIPEN to a GPIO instead of
+ * the schematic's 3V3 bar, the mic sits in power-down (SD Hi-Z) until that pin
+ * is driven high. Try each free GPIO and watch the SD pad for transitions. */
+void spotpear_micen(void)
+{
+    const int cand[] = { 1, 2, 3, 4, 5, 6, 38, 39 };
+    gpio_input_enable(MIC_DIN);
+    for (unsigned c = 0; c < sizeof(cand) / sizeof(cand[0]); c++) {
+        /* Open-drain + pull-up: raises a possibly-wired CHIPEN without fighting
+         * anything else on the net (GPIO1-6 are the SD card bus). */
+        const gpio_config_t en = {
+            .pin_bit_mask = 1ULL << cand[c],
+            .mode = GPIO_MODE_OUTPUT_OD,
+            .pull_up_en = GPIO_PULLUP_ENABLE,
+        };
+        gpio_config(&en);
+        gpio_set_level(cand[c], 1);
+        vTaskDelay(pdMS_TO_TICKS(5));
+        int last = gpio_get_level(MIC_DIN), toggles = 0;
+        for (int i = 0; i < 40000; i++) {
+            int v = gpio_get_level(MIC_DIN);
+            toggles += (v != last);
+            last = v;
+        }
+        printf("@micen gpio%d high: sd toggles=%d\n", cand[c], toggles);
+        gpio_set_level(cand[c], 0);
+        gpio_config(&en);
+        gpio_set_direction(cand[c], GPIO_MODE_DISABLE);
+    }
+}
+
+/* Hold-to-talk on the face tile: a finger held on the avatar for
+ * TOUCH_HOLD_MS acts as the talk button. Taps and touches on other tiles
+ * (e.g. settings) never trigger talk. Touch state comes from LVGL's input
+ * device, which owns the CST816 driver handle; reading the driver here
+ * would race LVGL's own reads. */
+#define TOUCH_HOLD_MS 500
+
+static unsigned poll_buttons(void)
+{
+    unsigned ev = muse_gpio_button_poll(&s_boot);
+
+    static bool tp_down = false;          /* finger currently on screen */
+    static bool tp_talking = false;       /* hold threshold reached */
+    static TickType_t tp_press_tick = 0;  /* when the current press began */
+    static bool tp_on_face = false;       /* press started on the face tile */
+
+    bool pressed = false;
+    if (s_touch_indev) {
+        pressed = (lv_indev_get_state(s_touch_indev) == LV_INDEV_STATE_PRESSED);
+    }
+
+    if (pressed && !tp_down) {
+        /* New press: only a hold that starts on the face tile can talk. */
+        tp_down = true;
+        tp_on_face = muse_ui_face_active();
+        tp_press_tick = xTaskGetTickCount();
+        tp_talking = false;
+    } else if (!pressed && tp_down) {
+        /* Release: end the talk if one started. */
+        if (tp_talking) {
+            ev |= MUSE_BTN_TALK_RELEASE;
+        }
+        tp_down = false;
+        tp_talking = false;
+    } else if (pressed && tp_down && tp_on_face && !tp_talking) {
+        /* Still held on the face: start talking once the hold threshold passes. */
+        if ((xTaskGetTickCount() - tp_press_tick) >= pdMS_TO_TICKS(TOUCH_HOLD_MS)) {
+            tp_talking = true;
+            ev |= MUSE_BTN_TALK_PRESS;
+        }
+    }
+    return ev;
+}
+
+static void wait_buttons(int timeout_ms)
+{
+    muse_gpio_buttons_wait((muse_gpio_button_t *const[]){ &s_boot }, 1, timeout_ms);
+}
+
+/* No battery divider and no charge-state line on this carrier: report no
+ * cell rather than invent a voltage. USB presence is the chip's own port. */
+static esp_err_t read_power(muse_power_t *out)
+{
+    out->battery_mv = 0;
+    out->battery_pct = -1;
+    out->charging = false;
+    out->usb = usb_serial_jtag_is_connected();
+    return ESP_OK;
+}
+
+static esp_err_t power_off(void)
+{
+    set_brightness(0);
+    esp_lcd_panel_disp_on_off(s_panel, false);
+    esp_lcd_panel_disp_sleep(s_panel, true);
+    /* No PMU on this board; deep sleep is the closest thing to off. BOOT
+     * wakes it. */
+    esp_sleep_enable_ext0_wakeup(GPIO_NUM_0, 0);
+    esp_deep_sleep_start();
+    return ESP_FAIL;
+}
+
+static const muse_board_t s_board = {
+    .name = "Spotpear ESP32-S3-1.8-Touch-LCD",
+    .width = LCD_RES,
+    .height = LCD_RES,
+    .round = true,
+    .touch = true,
+    .diagonal_in = 1.8f,
+    .talk_button = "BOOT",
+    .talk_hint = { LV_ALIGN_TOP_LEFT, 20, 16 },
+    .frame_ms = 40,
+    .init = init,
+    .display_start = display_start,
+    .display_lock = display_lock,
+    .display_unlock = esp_lv_adapter_unlock,
+    .set_brightness = set_brightness,
+    .panel_sleep = panel_sleep,
+    .display_pause = display_pause,
+    .audio_init = audio_init,
+    .mic_slot = 0,   /* MSM261 L/R tied low: left slot */
+    .set_mic_gain = set_mic_gain,
+    .poll_buttons = poll_buttons,
+    .wait_buttons = wait_buttons,
+    .read_power = read_power,
+    .power_off = power_off,
+};
+
+/* Home Link's app_main starts Muse with this board (main/main.c). */
+const muse_board_t *muse_board_get(void)
+{
+    return &s_board;
+}

+static inline bool in_ear(const limb_q_t *l, int32_t x, int32_t y, int32_t curve_u,
+                          int32_t *lx, int32_t *ly)
+{
+    int32_t dx = x - l->x, dy = y - l->y;
+    if (abs(dx) > l->r + abs(curve_u) || abs(dy) > l->r) {
+        return false;
+    }
+    int32_t u = ((((dx * l->c) >> Q) + ((dy * l->s) >> Q)) * l->inv_rx) >> Q;
+    int32_t v = ((((dy * l->c) >> Q) - ((dx * l->s) >> Q)) * l->inv_ry) >> Q;
+    u -= (curve_u * ((v * v) >> Q)) >> Q;
+    int32_t vv = (v * v) >> Q;
+    if (v < 0) {
+        vv += vv >> 2;               /* 根部比耳尖再收一档，贴头自然 */
+        if (vv > ONE) {

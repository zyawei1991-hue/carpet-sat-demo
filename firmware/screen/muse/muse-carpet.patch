+ * 串口日志会被抄进交接文档，抄一次就是一份凭据，和 carpet_link 里那句同一个理由）。
+ * 返回解出的字节数；负数 = 这一串不是合法十六进制（-1）或太长（-2）。 */
+static int hexval(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static int hex_bytes(const char *hex, char *out, size_t cap)
+{
+    size_t n = 0;
+    for (const char *p = hex; *p; p += 2) {
+        int hi = hexval(p[0]);
+        int lo = p[1] ? hexval(p[1]) : -1;          /* 落单的半个字节也算非法 */
+        if (hi < 0 || lo < 0) return -1;
+        if (n + 1 >= cap) return -2;
+        out[n++] = (char)((hi << 4) | lo);
+    }
+    out[n] = '\0';
+    return (int)n;

+    { "Muse remembers up to 8 networks and joins the strongest one in range. Tap a saved one twice to forget it.",
+      "最多记 8 个网络，自动连最强的。点两次已保存的就忘掉它。" },
+
+    /* ---------- Muse (the cloud pairing page; see HANDOFF's dead list) ------ */
+    { "Muse app: %s\n%s", "Muse 应用：%s\n%s" },
+    /* muse_chat.c / muse_chat_link.c write these into hatch_status.detail, and
+     * the page's second line is that detail. "Connecting..." and "Starting..."
+     * are already above, with the Wi-Fi state words. */
+    { "Pair in the Muse app", "在 Muse 应用里配对" },
+    { "Waiting for Wi-Fi", "等 Wi-Fi 连上" },
+    { "Connects when you talk", "说话时才连接" },
+    { "Through Home Link, text replies", "走 Home Link，只回文字" },
+    { "not paired", "没配对" },
+    { "paired", "已配对" },
+    { "paired with another SDK token, pair again to use this one", "配的是另一个 SDK 令牌，要再配一次" },
+    { "Resetting...", "正在重设..." },
+    { "Tap again to reset", "再点一次重设" },
+    { "Server", "服务器" },
+    { "Muse server", "Muse 服务器" },
+    { "VM ID", "虚拟机" },
+    { "Device token", "设备令牌" },
+    { "SDK token", "SDK 令牌" },
+    { "Test connection", "测试连接" },
+    { "Set", "已设" },
+    { "Set here", "在这儿填的" },
+    { "Not a token", "不是令牌" },
+    { "Empty for the default", "留空用默认" },
+    { "Optional", "可留空" },
+    { "Empty keeps the current one", "留空保持不变" },
+    { "Empty keeps the current one; a new one restarts", "留空保持不变；填新的会重启" },
+    /* The fold this page got on 11-08: one row, one line under it that says why
+     * it is folded, and the four fields behind it. The value slot is 130 px, so
+     * the state word is three characters; the row name takes "Muse" at 20 px and
+     * one hanzi at 16. The line is the owner's own wording, kept to two wrapped
+     * lines inside the 330 px note column, and it uses no U+2026 or U+2014. */
+    { "Muse cloud", "Muse 云" },
+    { "Only for the official Muse API, later on; this car-link demo can't reach it.",
+      "以后接 Muse 官方 API 才用，现在这套车联演示连不到它。" },
+    { "Folded", "已折叠" },
+    { "Expanded", "已展开" },
+    { "Pair with the Muse app to use your account; a device token here overrides it, and a long one is easier to "
+      "send over Bluetooth. The VM ID picks one of your VMs. The SDK token is from gadgets.muse.ai; one set here "
+      "replaces the firmware's. Reset pairing forgets Wi-Fi and the app pairing, then restarts.",
+      "这四格是给 Muse 云端配对用的，车联这条链路用不到，留空就行。" },
+
+    /* ---------- Bluetooth ---------- */
+    { "Forget paired phones", "忘掉配过的手机" },
+    { "Visible as %s", "能被搜到：%s" },
+    { "Phone connected\n%s", "手机已连上\n%s" },
+    { "Paired", "已配对" },
+    { "Waiting for pairing", "等着配对" },
+    { "When on, Muse is visible to phones nearby. Open tools/ble_setup.html in Chrome, connect, and enter the code "
+      "Muse shows to pair.",
+      "开：手机能搜到它；在浏览器里按屏上显示的码配对。" },
+
+    /* ---------- Sound ---------- */
+    { "Voice notes", "语音留言" },
+    { "Mic level", "麦克风电平" },
+    { "Off: hold yellow to talk live, release to listen; blue ends the call. On: hold yellow to send a voice note. "
+      "Applies to the next call.",
+      "关：按住黄键通话，松手听，蓝键结束。开：按住黄键发语音留言。" },
+    { "Talk at arm's length: the bar should reach green (-30 to -15 dBFS) without going orange.",
+      "隔一条手臂说话：电平条到绿色就好（-30 到 -15 dBFS），别到橙色。" },
+
+    /* ---------- Sleep ---------- */
+    { "30 seconds", "30 秒" },
+    { "1 minute", "1 分钟" },
+    { "2 minutes", "2 分钟" },
+    { "5 minutes", "5 分钟" },
+    { "10 minutes", "10 分钟" },
+    { LV_SYMBOL_EYE_CLOSE "  Sleep now", LV_SYMBOL_EYE_CLOSE "  马上熄屏" },
+    { "Turn the screen off after Muse has been idle for:", "空闲多久之后熄屏：" },
+    { "Stay online when asleep", "熄屏后保持联网" },
+    { "On: still reachable over Wi-Fi while dark, at the cost of battery.",
+      "开着时熄屏也连着 Wi-Fi，手机随时能连上；代价是更费电。" },
+    { "Tap the screen or press either button to wake.", "碰屏幕或按任意键都能唤醒。" },

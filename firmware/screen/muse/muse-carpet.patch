+/* 十六进制 → 字节。只服务 `>wifi set`：台架机上要往屏里塞的 SSID 是
+ * 「吨吨吨的Mate 30 5G」这种**带空格的非 ASCII** 名字 —— `>wifi set ssid=吨吨吨的Mate 30 5G pass=…`
+ * 这种写法在第一空格处就断了，而串口那一段到底是不是 UTF-8 也不归屏说了算。
+ * 十六进制把这两个问题一起消掉（回读时解出来的 SSID 原样印，它不是秘密；密码不印 ——
+ * 串口日志会被抄进交接文档，抄一次就是一份凭据，和 carpet_link 里那句同一个理由）。
+ * 返回解出的字节数；负数 = 这一串不是合法十六进制（-1）或太长（-2）。 */
+static int hexval(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static int hex_bytes(const char *hex, char *out, size_t cap)
+{
+    size_t n = 0;
+    for (const char *p = hex; *p; p += 2) {
+        int hi = hexval(p[0]);
+        int lo = p[1] ? hexval(p[1]) : -1;          /* 落单的半个字节也算非法 */
+        if (hi < 0 || lo < 0) return -1;
+        if (n + 1 >= cap) return -2;
+        out[n++] = (char)((hi << 4) | lo);
+    }
+    out[n] = '\0';
+    return (int)n;
+}

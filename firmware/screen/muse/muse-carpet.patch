+
+#include "carpet_audio.h"
+
+#include "sdkconfig.h"
+#if CONFIG_MUSE_CARPET_CARDS
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/idf_additions.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+#include "mbedtls/base64.h"
+#include "muse_audio.h"
+#include "muse_state.h"
+
+static const char *TAG = "carpet_audio";
+
+/*
+ * 一条**线性缓冲**，不是环形：生产者是链路任务（只在尾巴往后追加），
+ * 消费者是播放任务（只在头部往前读，永远读不到还没写的那一段）。
+ * 两端都不绕回，所以省掉环形那套头尾取模 —— 少一处能写错的地方。
+ *
+ * 容量 2 MB = 64 秒 16k/单声道/s16le，和 core 那份 `AudioChunks.MAX_TOTAL_BYTES`
+ * 同一个数（超了那边整段不发，这边也就永远不会溢出）。
+ * 2026-11-06 从 512 KB 提上来：真模型一句 32 字的答句实测 7.5 秒，16 秒那一档
+ * 一句话就能撞穿，而撞穿在观众眼里是"屏上写了整句话、喇叭一声不出"。
+ * 板上 PSRAM 开机日志称到的是 8 MB（`octal_psram ... density 0x03 = 64 Mbit`），
+ * 拿掉 2 MB 还剩 6 MB 给界面和字库；真拿不到时下面那句 ESP_LOGE 会当场说清楚，
+ * 语音这条路整个不接、文字照旧 —— 不靠任何人去猜屏上还剩多少内存。
+ * **不放内部 RAM**：内部剩下的连续小块是 ws 任务栈要找的地方，从它身上切走一块
+ * 是拿整条链路换一个音频缓冲。
+ */
+#define AUDIO_CAP        (2 * 1024 * 1024)
+#define AUDIO_RATE       16000
+#define CHUNK_BYTES      (MUSE_AUDIO_CHUNK * 2)   /* 640 字节 = 正好 20 毫秒 */
+#define MAX_BLOCK_BYTES  2560                     /* 契约里一块 = 80 毫秒，也是发送侧那个数 */
+#define PREBUFFER_BYTES  6400                     /* 先攒 200 毫秒再开口，免得一句里断三截 */
+#define UNDERRUN_MS      1500                     /* 空了这么久还没新块 = 这段断了，别拖着放杂音 */
+#define PLAYER_STACK_BYTES (16 * 1024)            /* 播放任务的栈，**在 PSRAM**：内部 RAM 稳态最大连续块只有 7.4 KB（见 feed() 里那段） */
+#define B64_BUF_BYTES      (4 * ((MAX_BLOCK_BYTES + 2) / 3) + 8)
+/* ^ 一块 PCM 编成 b64 的最坏长度 + 结尾 NUL + 余量：2,560 → 3,416 → 3,424。
+ *   只给开发口 `>audtest` 用（真链路上解码吃的是 ws 帧里的字符串，不另外开这块）。 */
+
+static char *s_buf;
+static SemaphoreHandle_t s_lock;
+static TaskHandle_t s_player;
+static int16_t s_scratch[MUSE_AUDIO_CHUNK];   /* 640 字节，静态：3584 字节栈那条任务压不下 */
+static uint8_t s_bench[MAX_BLOCK_BYTES];
+
+/* 下面这些只在锁里改。跨任务单读一个数是原子的（32 位对齐），
+ * 读到旧值最多让口型慢 20 毫秒，不会读到半个样本。 */
+static char s_turn[40];
+static size_t s_wrote;        /* 已进缓冲的字节 */
+static size_t s_total;        /* 整段字节数，每帧都带；0 = 还不知道 */
+static size_t s_played;       /* 已交给 codec 的字节 */
+static unsigned s_expect_seq; /* 下一块该有的 seq，不连续就整段丢 */
+static bool s_live;           /* 播放任务认为还有声音要放 */
+static volatile float s_level;
+static uint32_t s_frames, s_drops;
+static uint32_t s_gaps, s_gap_ms;           /* 开口之后停下来等过数据几回 / 一共停了多久（毫秒，累计） */
+static const char *s_last_drop = "-";   /* 最近一次为什么丢，给串口回读 */
+
+static void reset_locked(void);
+static void drop_locked(const char *why);
+static void player_task(void *arg);
+
+static void reset_locked(void)
+{
+    s_turn[0] = '\0';
+    s_wrote = s_total = s_played = 0;
+    s_expect_seq = 0;
+    s_live = false;
+    s_level = 0;
+}
+
+static void drop_locked(const char *why)
+{
+    s_drops++;
+    s_last_drop = why;
+    ESP_LOGW(TAG, "这段语音丢掉（%s），文字不受影响", why);
+    reset_locked();
+}
+
+static bool buf_get(void)
+{
+    if (!s_lock) s_lock = xSemaphoreCreateMutex();
+    if (s_buf) return true;
+    s_buf = heap_caps_malloc(AUDIO_CAP, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!s_buf) {
+        ESP_LOGE(TAG, "PSRAM 里拿不到 %d KB，语音这条路整个不接（文字照旧）", AUDIO_CAP / 1024);
+        return false;
+    }
+    return true;
+}
+
+/*
+ * 一帧解码好的 PCM 进缓冲。校验全在这儿：换轮、seq 跳号、整段超限、块超长 ——
+ * 任何一种都**整段丢掉**，不放"能放的那半句"。半句有声音半句没，
+ * 比整段没声音更难解释，而文字答句走的是另一条帧，不受这里影响。
+ */
+static bool feed(const char *turn, unsigned seq, size_t total, const uint8_t *pcm, size_t n)
+{
+    if (!turn || !*turn || n == 0 || (n & 1)) return false;
+    if (!buf_get()) return false;
+
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (s_turn[0] && strcmp(s_turn, turn) != 0) reset_locked();  /* 换了一轮：旧那段不要了 */
+    if (total == 0 || total > AUDIO_CAP) {
+        drop_locked("整段字节数不合规");
+        xSemaphoreGive(s_lock);
+        return false;
+    }
+    if (seq != s_expect_seq) {
+        drop_locked("seq 不连续");
+        xSemaphoreGive(s_lock);
+        return false;
+    }
+    if (n > MAX_BLOCK_BYTES || s_wrote + n > AUDIO_CAP) {
+        drop_locked("这一块装不下");
+        xSemaphoreGive(s_lock);
+        return false;
+    }
+    memcpy(s_buf + s_wrote, pcm, n);
+    s_wrote += n;
+    s_total = total;
+    s_expect_seq = seq + 1;
+    snprintf(s_turn, sizeof s_turn, "%s", turn);
+    s_live = true;
+    s_frames++;
+    xSemaphoreGive(s_lock);
+
+    if (!s_player) {
+        /* 这条任务的栈**必须在 PSRAM**，这是 2026-11-11 称出来的，不是风格问题：
+         * 真机稳态内部 RAM 只剩 `free 20587 / largest 7424` 字节（`>power` 那行
+         * `"heap":{...}` 的原文），而原来这一句是 `xTaskCreate(..., 4096, ...)`
+         * —— 4096 是**字**，ESP32-S3 32 位 = **16,384 字节连续内部 RAM**，最大块才 7.4 KB，
+         * 所以 `xTaskCreate` **每一段都在第 0 帧失败**：现场表现是"屏上整句话、喇叭一声不出"，
+         * 而 `>carpet` 只报 `played=0`，一句都没放。降到 8 KB 也一样起不来，缩栈救不了。
+         *
+         * 走的是这块板自己已经在用的那条：`muse_chat_session.cpp` 的 `muse_chat`
+         * 就是 48 KB PSRAM 栈，而且同样在那条栈上调 `esp_codec_dev_write`。
+         * DMA 相关的缓冲一个都不在栈上 —— `s_scratch` 是静态 .bss（内部 RAM），
+         * `muse_audio.c` 里的 `s_out_stereo` 同理，所以挪栈不动 DMA。
+         * WithCaps 这一族的栈深度单位是**字节**，不是字。
+         *
+         * 失败必须当场把数打出来：这里只有"内存"和"别的"两种死法分得开，
+         * 而没数字的话现场只能回去怀疑 Wi-Fi。 */
+        if (xTaskCreateWithCaps(player_task, "carpet_audio", PLAYER_STACK_BYTES, NULL, 5,
+                               &s_player, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+            s_player = NULL;
+            ESP_LOGE(TAG, "播放任务起不来：PSRAM 空闲 %u KB/最大连续 %u KB，内部 %u KB/最大连续 %u KB",
+                     (unsigned)(heap_caps_get_free_size(MALLOC_CAP_SPIRAM) / 1024),
+                     (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM) / 1024),
+                     (unsigned)(heap_caps_get_free_size(MALLOC_CAP_INTERNAL) / 1024),
+                     (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL) / 1024));
+            xSemaphoreTake(s_lock, portMAX_DELAY);
+            drop_locked("播放任务起不来");
+            xSemaphoreGive(s_lock);
+            return false;
+        }
+    }
+    return true;
+}
+
+/*
+ * 播放任务。**它自己就是节拍**：`muse_audio_write` 是阻塞的，一块 640 字节正好占住
+ * 20 毫秒，所以不需要定时器，也不会越放越快（2026-11-06 的 `>audio` 探针量过：
+ * 250 次写、每次 20 毫秒的名义时长，一秒实测 0.92~1.00 秒）。
+ *
+ * 两件事在锁外做：`muse_audio_write`（要占 20 毫秒，攥着锁会把链路任务的入块一起堵死）
+ * 和 `muse_state_set_level`（口型的来源，每 20 毫秒一次真电平 —— 不再是按 tick 摆的假值）。
+ */
+static void player_task(void *arg)
+{
+    (void)arg;
+    int64_t empty_since = 0;   /* 真·一个字节都不剩的起点，只给 1.5 秒判死用 */
+    int64_t stall_t0 = 0;      /* 本轮"开口之后又停下来等数据"的起点 */
+    bool spoke = false;        /* 本轮开过口没有：没开口前的攒缓冲不算停顿 */
+
+    for (;;) {
+        size_t take_bytes = 0;
+        bool finished = false;
+        bool stalled = false;
+
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        if (!s_live || !s_buf) {
+            empty_since = 0;
+            if (stall_t0) {
+                s_gap_ms += (uint32_t)((esp_timer_get_time() - stall_t0) / 1000);
+                stall_t0 = 0;
+            }
+            spoke = false;
+            xSemaphoreGive(s_lock);
+            vTaskDelay(pdMS_TO_TICKS(40));
+            continue;
+        }
+        size_t avail = s_wrote - s_played;
+        bool complete = s_total > 0 && s_wrote >= s_total;
+
+        if (avail == 0 && complete) {
+            finished = true;
+        } else if (avail == 0) {
+            /* 半中间没数据了：先等。等过头就把这段判死 ——
+             * 一句里断三截比整段没声音更难解释，也更难怀疑到我们自己头上。 */
+            int64_t now = esp_timer_get_time();
+            if (!empty_since) empty_since = now;
+            if (spoke && !stall_t0) { stall_t0 = now; s_gaps++; }
+            if ((now - empty_since) / 1000 > UNDERRUN_MS) {
+                drop_locked("断了 1.5 秒没新块");
+                stalled = true;
+            }
+            xSemaphoreGive(s_lock);
+            if (stalled) muse_state_set_level(0);
+            vTaskDelay(pdMS_TO_TICKS(10));
+            continue;
+        } else if (avail < PREBUFFER_BYTES && !complete && !spoke) {
+            /* 攒够 200 毫秒才开口 —— 这一条**只管开场那一次**。
+             * 2026-11-11 称到过：节拍按 1.00 倍实时喂（本机走线上同一种帧），播放任务
+             * 停在 `gaps=232 gap_ms=10692`，19.5 秒的音频里有一多半是静音。真因不是链路慢，
+             * 是这里把"开场先攒 200 毫秒"写成了永久闸门：生产者按实时速率喂时，缓冲里的
+             * 存量本来就永远不到 6,400 字节，于是放 200 毫秒、停 200 毫秒重新攒，来回抖。
+             * 开口之后只看"有没有数据"（`avail == 0` 那条负责），开场那 200 毫秒的余量
+             * 留着吸收到达抖动 —— 这才是流式播放该有的样子。 */
+            xSemaphoreGive(s_lock);        /* 还没攒够 200 毫秒，别开口 */
+            vTaskDelay(pdMS_TO_TICKS(20));
+            continue;
+        }
+        if (stall_t0) {
+            s_gap_ms += (uint32_t)((esp_timer_get_time() - stall_t0) / 1000);
+            stall_t0 = 0;
+        }
+        empty_since = 0;
+
+        if (!finished) {
+            size_t n = avail >= CHUNK_BYTES ? CHUNK_BYTES : (avail & ~(size_t)1);
+            memcpy(s_scratch, s_buf + s_played, n);
+            s_played += n;
+            take_bytes = n;
+        }
+        xSemaphoreGive(s_lock);
+
+        if (finished) {
+            s_level = 0;
+            muse_state_set_level(0);
+            printf("@audio 放完 %u 字节 / %.1f 秒\n", (unsigned)s_played,
+                   (float)s_played / (AUDIO_RATE * 2));
+            fflush(stdout);
+            xSemaphoreTake(s_lock, portMAX_DELAY);
+            reset_locked();
+            xSemaphoreGive(s_lock);
+            continue;
+        }
+
+        if (muse_audio_write(s_scratch, take_bytes / 2) != ESP_OK) {
+            xSemaphoreTake(s_lock, portMAX_DELAY);
+            drop_locked("muse_audio_write 报错");
+            xSemaphoreGive(s_lock);
+            muse_state_set_level(0);
+            continue;
+        }
+        float lv = muse_audio_level(s_scratch, take_bytes / 2);
+        spoke = true;                              /* 已经开口了：此后任何等数据都算一次停顿 */
+        s_level = lv;
+        muse_state_set_level(lv);
+        if ((s_played % (AUDIO_RATE * 2)) < take_bytes) {   /* 每秒一行，能对着听 */
+            printf("@audio at %u/%u level %.2f\n", (unsigned)s_played, (unsigned)s_total, (double)lv);
+            fflush(stdout);
+        }
+    }
+}
+
+bool carpet_audio_on_chunk(const cJSON *args)
+{
+    if (!cJSON_IsObject(args)) return false;
+    const cJSON *jt = cJSON_GetObjectItemCaseSensitive(args, "turn_id");
+    const cJSON *js = cJSON_GetObjectItemCaseSensitive(args, "seq");
+    const cJSON *jn = cJSON_GetObjectItemCaseSensitive(args, "total");
+    const cJSON *jr = cJSON_GetObjectItemCaseSensitive(args, "rate");
+    const cJSON *jb = cJSON_GetObjectItemCaseSensitive(args, "b64");
+    if (!cJSON_IsString(jt) || !jt->valuestring || !cJSON_IsNumber(js) ||
+        !cJSON_IsNumber(jn) || !cJSON_IsString(jb) || !jb->valuestring) {
+        return false;
+    }
+    /* rate 缺了就按 16k 待（契约里它必填，缺了是发送方的错，但这一帧还是那些字节）；
+     * 明着不是 16k 才丢 —— 按错的采样率播出来是一段变调，比没声音更让人怀疑屏坏了。 */
+    int rate = cJSON_IsNumber(jr) ? jr->valueint : AUDIO_RATE;
+    if (rate != AUDIO_RATE) {
+        ESP_LOGW(TAG, "采样率 %d，本端只吃 %d，这段不接", rate, AUDIO_RATE);
+        return false;
+    }
+
+    static uint8_t decoded[MAX_BLOCK_BYTES + 4];
+    size_t olen = 0;
+    if (mbedtls_base64_decode(decoded, sizeof decoded, &olen,
+                              (const unsigned char *)jb->valuestring, strlen(jb->valuestring)) != 0) {
+        ESP_LOGW(TAG, "base64 解不开这一帧");
+        return false;
+    }
+    return feed(jt->valuestring, (unsigned)js->valueint, (size_t)jn->valueint, decoded, olen);
+}
+
+void carpet_audio_abort(const char *why)
+{
+    if (!s_lock) return;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    bool was = s_live;
+    reset_locked();
+    xSemaphoreGive(s_lock);
+    if (was) {
+        s_level = 0;
+        muse_state_set_level(0);
+        ESP_LOGI(TAG, "语音清空：%s", why);
+    }
+}
+
+/* 现在到底还有没有声音在放。上行那条路要知道这一件事（按下说话之前得先把上一轮的
+ * 尾音停掉，否则录进去的是自己的答句），但 `carpet_audio_state()` 要 turn_id 才答话，
+ * 而上行这边**没有**、也不该再去拿那个 turn_id —— 它是从 dialog 帧里来的。
+ * 所以给一个不看轮号的问法。 */
+bool carpet_audio_live(void)
+{
+    if (!s_lock) return false;
+    bool live;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    live = s_live;
+    xSemaphoreGive(s_lock);
+    return live;
+}
+
+bool carpet_audio_state(const char *turn_id, size_t *played, size_t *total, bool *live, float *level)
+{
+    if (!turn_id || !*turn_id || !s_lock) return false;
+    bool hit;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    hit = s_turn[0] && strcmp(s_turn, turn_id) == 0 && s_total > 0;
+    if (hit) {
+        if (played) *played = s_played;
+        if (total) *total = s_total;
+        if (live) *live = s_live;
+        if (level) *level = s_level;
+    }
+    xSemaphoreGive(s_lock);
+    return hit;
+}
+
+/* ---------------- 开发口 ---------------- */
+
+/*
+ * `>audtest [秒]`：本机造一段"有词有停顿"的语音（440 Hz 音节 + 静音交替），
+ * **走和线上一模一样的那一帧**：`b64` → `cJSON args` → `carpet_audio_on_chunk()` → `feed()`
+ * → 同一个播放任务。网络、模型、服务端全不接。
+ *
+ * 2026-11-11 改的：以前这条直接调 `feed()`，**把 base64 解码和 args 校验整个绕开了**，
+ * 于是"本机自喂通过"并不能证明真从手机进来那一句也会通过 —— 而现场只会撞后一种。
+ * 现在它连解码器一起称，屏侧这一条才算把手机、Wi-Fi、模型排除干净。
+ *
+ * 静音那几段是重点：口型要是全程不动，说明喂给 muse_state 的不是真电平。
+ * 发送节拍刻意贴着实时（80 毫秒一块，按绝对到期时间补发），测的是"边到边放顺不顺"，不是"缓冲能装多少"。
+ * 最后那个 `b64=` 是帧预算的现场读数：一块 2,560 字节 PCM 编出来 3,416 字符，
+ * 加 JSON 外壳整帧约 3.5 KB，而屏侧组帧上限是 4,096。
+ */
+void carpet_audio_bench(int seconds)
+{
+    if (seconds < 1) seconds = 3;
+    if (seconds > 15) seconds = 15;
+    size_t total = (size_t)seconds * AUDIO_RATE * 2;
+    unsigned seq = 0;
+    size_t b64_max = 0;
+    int64_t t0 = esp_timer_get_time();
+
+    /* 一块 b64 最多 4/3 倍再加结尾 NUL：2,560 → 3,416，3,600 有余量。放 PSRAM ——
+     * 内部 RAM 稳态最大连续块只有 7.4 KB（见 feed() 里那段），别在这上面赌 */
+    char *b64 = heap_caps_malloc(B64_BUF_BYTES, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!b64) {
+        printf("@audtest PSRAM 里拿不到 %d B 的编码缓冲，这一条没称\n", B64_BUF_BYTES);
+        return;
+    }
+
+    for (size_t at = 0; at < total; at += MAX_BLOCK_BYTES) {
+        size_t n = (total - at) >= MAX_BLOCK_BYTES ? MAX_BLOCK_BYTES : (total - at);
+        int16_t *s = (int16_t *)s_bench;
+        for (size_t i = 0; i < n / 2; i++) {
+            size_t g = (at + i * 2) / 2;                 /* 全局样本号 */
+            size_t pos = g % (AUDIO_RATE * 38 / 100);    /* 380 毫秒一个"词" */
+            bool voiced = pos < (size_t)(AUDIO_RATE * 30 / 100);
+            s[i] = voiced ? (int16_t)(0.28f * 32767.0f
+                       * sinf(2.0f * (float)M_PI * 440.0f * (float)g / AUDIO_RATE)) : 0;
+        }
+
+        /* 拼成手机那头 `AudioChunks.commands()` 发出来的同一种 args，一个字段都不省 */
+        size_t olen = 0;
+        if (mbedtls_base64_encode((unsigned char *)b64, B64_BUF_BYTES, &olen,
+                                  (const unsigned char *)s_bench, n) != 0 ||
+            olen + 1 > B64_BUF_BYTES) {
+            printf("@audtest 第 %u 块编码失败，停在这\n", seq);
+            break;
+        }
+        b64[olen] = '\0';
+        if (olen > b64_max) b64_max = olen;
+
+        cJSON *args = cJSON_CreateObject();
+        bool ok = false;
+        if (args) {
+            ok = cJSON_AddStringToObject(args, "turn_id", "audtest") &&
+                 cJSON_AddNumberToObject(args, "seq", (double)seq) &&
+                 cJSON_AddNumberToObject(args, "total", (double)total) &&
+                 cJSON_AddNumberToObject(args, "rate", AUDIO_RATE) &&
+                 cJSON_AddStringToObject(args, "b64", b64);
+            if (ok) ok = carpet_audio_on_chunk(args);
+            cJSON_Delete(args);
+        }
+        if (!ok) {
+            printf("@audtest 第 %u 块被拒（b64 %u 字符），停在这\n", seq, (unsigned)olen);
+            break;
+        }
+        seq++;
+        /* 节拍贴着墙上时钟走：第 n 块该在 t0 + n*80 毫秒发出去。
+         * 本机编码 + 拼 JSON 实测每块多花 20 来毫秒，按"发完再睡 80"就会把这点开销
+         * 攒成整段偏慢（15 秒的音频喂 19.4 秒），称到的停顿就不是链路的问题了。
+         * 到期已过就立刻发下一块，平均速率仍然是实时的 1.0 倍。 */
+        int64_t due = t0 + (int64_t)seq * 80000;
+        int64_t now = esp_timer_get_time();
+        if (due > now) vTaskDelay(pdMS_TO_TICKS((int)((due - now) / 1000)));
+    }
+    heap_caps_free(b64);
+    float fed = (float)(esp_timer_get_time() - t0) / 1e6f;
+    printf("@audtest 发了 %u 块 / %u 字节，喂了 %.2f 秒（音频 %.1f 秒，%.2f 倍实时），最大一块 b64=%u\n",
+           seq, (unsigned)total, fed, (float)seconds, (float)seconds / (fed > 0 ? fed : 1.0f),
+           (unsigned)b64_max);
+    fflush(stdout);
+}
+
+void carpet_audio_dump(void)
+{
+    /* 缓冲给多大、PSRAM 还剩多少 —— 把 AUDIO_CAP 提到 2 MB 之后，这是唯一能当场称的办法。
+     * 只报总量会骗人：要的是一整块连续的，所以要一起看最大那块。
+     * 秒数直接算出来给读的人，不用他自己拿 32000 去除。
+     * **打在最早、且在"没收到过语音帧"那条 return 之前**：那条一 return 这行就永远看不到，
+     * 而这一行要的判据（那块 2 MB 到底拿没拿到）恰恰只在还没收到语音时最需要称。 */
+    printf("@audio cap=%u psram_free=%u psram_max=%u 装得下 %.1f 秒\n",
+           (unsigned)AUDIO_CAP,
+           (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM),
+           (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM),
+           (double)AUDIO_CAP / (double)(AUDIO_RATE * 2));
+    if (!s_lock) {
+        printf("@audio 没收到过语音帧\n");
+        fflush(stdout);
+        return;
+    }
+    char turn[40] = "-";
+    size_t wrote = 0, total = 0, played = 0;
+    int live = 0;
+    float level = 0;
+    uint32_t frames = 0, drops = 0, gaps = 0, gap_ms = 0;
+    const char *why = "-";
+
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (s_turn[0]) snprintf(turn, sizeof turn, "%s", s_turn);
+    wrote = s_wrote; total = s_total; played = s_played;
+    live = (int)s_live; level = s_level;
+    frames = s_frames; drops = s_drops; why = s_last_drop;
+    gaps = s_gaps; gap_ms = s_gap_ms;
+    xSemaphoreGive(s_lock);
+
+    printf("@audio turn=%s wrote=%u total=%u played=%u live=%d level=%.2f frames=%u drops=%u last=%s gaps=%u gap_ms=%u\n",
+           turn, (unsigned)wrote, (unsigned)total, (unsigned)played, live,
+           (double)level, (unsigned)frames, (unsigned)drops, why,
+           (unsigned)gaps, (unsigned)gap_ms);
+    fflush(stdout);
+}
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_audio.h b/esp32/components/muse/carpet/carpet_audio.h
new file mode 100644
index 0000000..813c6c9
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_audio.h
@@ -0,0 +1,61 @@
+/*
+ * 契约 v3 的语音通道：`command{cmd:"audio_chunk"}` 进来的 PCM 字节 → 喇叭。
+ *
+ * 为什么住在 carpet 而不是塞进 carpet_link.c：这一份有一段自己的节拍（播放任务
+ * 按 20 毫秒一块往外送），而链路那份文件里全是"谁在说话、这句话念第几页"。
+ * 两边只靠两个数对上：这一轮的 turn_id 和已播放的字节数。
+ *
+ * 为什么不是"另开一条 UDP"：短答句一段几秒、几十 KB，走已有的那条 ws 一次就够，
+ * 少一个端口、少一套 NAT/防火墙故事、少一套心跳（远端那份架构 A.4 #5 自己写的
+ * "一条链路一套心跳"就是这个意思）。真正的语音通话（ASR 上行 + 流式下行）
+ * 才需要那条口，那一档这里明确不做。
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "cJSON.h"
+
+/*
+ * 收到一帧 audio_chunk。**在链路任务里调**（screen_link 的回调全在那儿跑），
+ * 所以这里不许阻塞、不许碰 LVGL：只做校验 + base64 解码 + 追加到缓冲。
+ * turn_id 从 args 里自己读 —— 契约说的那一整套 {turn_id, seq, total, rate, b64} 全在 args 里。
+ * 满、seq 不连续、采样率不是 16000 —— 一律丢掉这一整段并留一行日志，
+ * 但**绝不影响文字答句**：那条走的是 dialog 帧，跟这里没有依赖关系。
+ *
+ * 返回 false = 这一帧没用（解不开 / 参数不对）。调用方不 ack：
+ * 契约里音频是"放不响就别说"那一级，不是"必须执行成功"那一级。
+ */
+bool carpet_audio_on_chunk(const cJSON *args);
+
+/*
+ * 丢掉正在排/正在放的那一段。链路断了、或者开发口要自己造一段时用。
+ * 文字带子不受影响 —— 念稿继续按秒翻，只是嘴不再动。
+ */
+void carpet_audio_abort(const char *why);
+
+/*
+ * 这一轮的声音放到哪了。给首屏那条带用的两件事：
+ *   played/total —— 念稿第几页跟着**播放位置**走，不再按 2.5 秒一页估
+ *   live        —— 还在放就不许收回这句（否则话没念完脸就回 idle）
+ * 返回 false = 这一轮根本没有声音（老固件、老服务端、或者那段被丢了），
+ * 调用方按原来的"按秒推"那套走。level 是这一帧窗口的真实 RMS 电平 0..1。
+ */
+bool carpet_audio_state(const char *turn_id, size_t *played, size_t *total, bool *live, float *level);
+
+/*
+ * 现在到底还有没有声音在放 —— **不看轮号**的问法。
+ * 上行那条路要它：按下说话之前得先把上一轮的尾音停掉，否则录进去的是屏自己念的答句；
+ * 而它手里没有 turn_id（那个从 dialog 帧来），`carpet_audio_state()` 没它答不了话。
+ */
+bool carpet_audio_live(void);
+
+/* 开发口 `>audtest [秒]`：本机造一段语音（正弦包络的"词"）灌进同一条缓冲和同一个
+ * 播放任务 —— 网络、模型、TTS 全不接，也能证明环、节拍、口型、翻页这四件事。
+ * 只在串口那条任务里调；它只负责喂数据，播在播放任务里，所以不占串口。 */
+void carpet_audio_bench(int seconds);
+
+/* `>carpet` 回读里那一行：收了几个字节、总共说多少、放到哪、电平、丢过几次。 */
+void carpet_audio_dump(void);
diff --git a/esp32/components/muse/carpet/carpet_diag.c b/esp32/components/muse/carpet/carpet_diag.c
new file mode 100644
index 0000000..fe24c28
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_diag.c
@@ -0,0 +1,226 @@
+/*
+ * 断电验尸（见 carpet_diag.h 顶部那段）。
+ *
+ * 一条记录长这样：
+ *   b3 t=4 OFF! usb=1 mv=4098 pct=100 off=20 cfg=34 pen=06 key=00 kl=08
+ *   t = 开机到现在多少秒   usb/mv/pct = PMU 眼里的供电
+ *   off = REG_PWROFF_STATUS(0x21)「上一次是谁关的电」   cfg/pen = 那两条按键关机使能
+ *   key = 现在锁存的按键事件   kl = **开机那一刻** PMU 已经锁存着的按键事件
+ *        （muse_pmu_init() 会把它清掉，所以只能在被清之前抄一份 —— 这一格才是"是不是按键把电关了"的答案）
+ *
+ * 写的是 NVS（`nvs` 分区，命名空间 `cdiag`），因为现场那次是整机断电，RAM 和日志都留不下东西。
+ * 环形 16 条：跑一趟 5 分钟大概十几条，正好装得下，也不至于把 flash 写穿。
+ */
+
+#include "carpet_diag.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "esp_log.h"
+#include "esp_sleep.h"
+#include "esp_system.h"   /* esp_reset_reason() + ESP_RST_* */
+#include "esp_timer.h"
+#include "nvs.h"
+
+#include "muse_pmu.h"
+#include "muse_state.h"
+
+static const char *TAG = "carpet.diag";
+
+#define SLOTS 24            /* 环里几条：一趟 5 分钟大概十几条，宁可装得下整趟 */
+#define TICK_MS 30000       /* 低功耗期间多少秒兜一条（20 秒会把 usb-/dark 那两条顶出环） */
+#define NS "cdiag"
+
+static nvs_handle_t s_nvs;
+static bool s_open;
+static uint32_t s_seq;
+static uint8_t s_latched_key;      /* PMU 清掉之前抄的那两份 */
+static uint8_t s_latched_irq1;
+static TickType_t s_last_tick;
+
+/* 开机那两条的"待发"副本。为什么要绕这一道：`carpet_link_start()` 跑在
+ * `muse_settings_init()`（也就是 `nvs_flash_init()`）之前 —— 同一个坑本仓库已经记过一次
+ * （carpet_link.c:762 那段：在那一步读设置会撞 `xQueueSemaphoreTake` 的 NULL 锁死循环）。
+ * 实测到第一版就是这么没的：刷完开机 `>diag` 回读 `seq=0`，两条开机记录当场写不进去。
+ * 所以开机信息先在 RAM 里存着（复位原因、唤醒原因、PMU 那两份锁存都在），
+ * 等第一条写得动的记录（或 `>diag`）把 NVS 打开时再补写，顺序仍按最旧排。 */
+static bool s_boot_pending;
+static uint32_t s_boot_t;
+static char s_boot_why[24];
+static char s_boot_wake[24];
+
+static bool ensure_open(void)
+{
+    if (s_open) {
+        return true;
+    }
+    if (nvs_open(NS, NVS_READWRITE, &s_nvs) != ESP_OK) {
+        return false;   /* 没 flash 就认了：诊断不该把机器弄死 */
+    }
+    s_open = true;
+    if (nvs_get_u32(s_nvs, "n", &s_seq) != ESP_OK) {
+        s_seq = 0;
+    }
+    return true;
+}
+
+/* 落一条：kind 是这条属于哪一类（b 开机 / e 转折 / t 低功耗兜底），tag 短到 6 个字符以内，
+ * secs 是"这一刻是开机后第几秒"—— 开机那两条传的是攒下来的那一刻，其余传现在。
+ * 寄存器按写这一刻读：对转折和兜底本来就该如此；对补写的开机两条，值钱的那两格
+ * （kl=/k1=）是 RAM 里的开机锁存，不受补写时机影响。 */
+static void write_line(char kind, const char *tag, uint32_t secs)
+{
+    if (!ensure_open()) {
+        return;
+    }
+    uint8_t r[MUSE_PMU_DIAG_REGS] = { 0 };
+    bool have = muse_pmu_diag_regs(r, sizeof r) == ESP_OK;
+    muse_power_t p = { .battery_pct = -1, .battery_mv = 0 };
+    if (muse_pmu_read_power(&p) != ESP_OK) {
+        p.battery_pct = -1;
+    }
+    char buf[160];
+    int n = snprintf(buf, sizeof buf,
+                     "%c%" PRIu32 " t=%" PRIu32 " %s usb=%d mv=%" PRId32 " pct=%d"
+                     " off=%02x cfg=%02x pen=%02x key=%02x kl=%02x k1=%02x",
+                     kind, s_seq, secs,
+                     tag ? tag : "-", (int)p.usb, (int32_t)p.battery_mv, p.battery_pct,
+                     have ? r[3] : 0, have ? r[2] : 0, have ? r[4] : 0,
+                     have ? r[6] : 0, s_latched_key, s_latched_irq1);
+    if (n <= 0 || (size_t)n >= sizeof buf) {
+        return;
+    }
+    char key[8];
+    snprintf(key, sizeof key, "r%" PRIu32, s_seq % SLOTS);
+    if (nvs_set_str(s_nvs, key, buf) == ESP_OK) {
+        nvs_set_u32(s_nvs, "n", s_seq + 1);
+        nvs_commit(s_nvs);
+    }
+    s_seq++;
+    ESP_LOGI(TAG, "%s", buf);
+}
+
+/* 开机那两条，等到 NVS 写得动再补；补不成（还是早）就留着，下次再试。 */
+static void flush_boot(void)
+{
+    if (!s_boot_pending || !ensure_open()) {
+        return;
+    }
+    s_boot_pending = false;
+    write_line('b', s_boot_why, s_boot_t);
+    write_line('b', s_boot_wake, s_boot_t);
+}
+
+/* 记录本身：转折（e）和兜底（t）走这里，顺手把欠着的开机两条先补上，顺序才对。 */
+static void record(char kind, const char *tag)
+{
+    flush_boot();
+    write_line(kind, tag, (uint32_t)(esp_timer_get_time() / 1000000));
+}
+
+/* 复位原因的名字：和 muse_battery.c:562 那张表**一模一样**，因为 `@power` 里的 "boot"
+ * 就是它给的 —— 两台仪器必须说同一种话，不然 §15.11 那种"power on 还是 usb"的对不上
+ * 就成了新的疑点。数字一起写，将来发现表里没有的取值还能事后认。 */
+static const char *reset_name(esp_reset_reason_t r)
+{
+    switch (r) {
+    case ESP_RST_POWERON: return "power on";
+    case ESP_RST_SW: return "restart";
+    case ESP_RST_PANIC: return "panic";
+    case ESP_RST_INT_WDT:
+    case ESP_RST_TASK_WDT:
+    case ESP_RST_WDT: return "watchdog";
+    case ESP_RST_DEEPSLEEP: return "deep sleep";
+    case ESP_RST_BROWNOUT: return "brownout";
+    case ESP_RST_USB: return "usb";
+    case ESP_RST_JTAG: return "jtag";
+    default: return "other";
+    }
+}
+
+void carpet_diag_pmu_latched(uint8_t intsts2, uint8_t intsts1)
+{
+    s_latched_key = intsts2;
+    s_latched_irq1 = intsts1;
+}
+
+void carpet_diag_boot(void)
+{
+    /* 开机这一条最值钱：它带的 off=/kl= 就是"上一次是怎么没的"。
+     * 复位原因 / 唤醒原因另起一条，因为塞不进同一行。
+     * 这一步通常还写不进 NVS（早于 nvs_flash_init），所以先存 RAM，写得动的时候再补。 */
+    esp_reset_reason_t why = esp_reset_reason();
+    snprintf(s_boot_why, sizeof s_boot_why, "rst=%d %s", (int)why, reset_name(why));
+    /* 能从 light sleep 醒过来是因为谁：按键 / 定时器 / 网络，一条就够。 */
+    snprintf(s_boot_wake, sizeof s_boot_wake, "wake=%d", (int)esp_sleep_get_wakeup_cause());
+    s_boot_t = (uint32_t)(esp_timer_get_time() / 1000000);
+    s_boot_pending = true;
+    flush_boot();
+}
+
+void carpet_diag_event(const char *tag)
+{
+    record('e', tag);
+}
+
+void carpet_diag_tick(TickType_t now, bool low_power)
+{
+    if (!low_power) {
+        s_last_tick = 0;
+        return;
+    }
+    if (s_last_tick && now - s_last_tick < pdMS_TO_TICKS(TICK_MS)) {
+        return;
+    }
+    s_last_tick = now;
+    record('t', "low");
+}
+
+void carpet_diag_clear(void)
+{
+    if (!ensure_open()) {
+        printf("@diag NVS 打不开\n");
+        fflush(stdout);
+        return;
+    }
+    char key[8];
+    for (uint32_t i = 0; i < SLOTS; i++) {
+        snprintf(key, sizeof key, "r%" PRIu32, i);
+        nvs_erase_key(s_nvs, key);
+    }
+    s_seq = 0;
+    s_boot_pending = false;
+    nvs_set_u32(s_nvs, "n", 0);
+    nvs_commit(s_nvs);
+    printf("@diag cleared\n");
+    fflush(stdout);
+}
+
+void carpet_diag_dump(void)
+{
+    flush_boot();   /* 到这一步 NVS 一定写得动了：把欠着的开机两条先补上再翻 */
+    if (!ensure_open()) {
+        printf("@diag NVS 打不开\n");
+        fflush(stdout);
+        return;
+    }
+    uint32_t newest = s_seq;
+    uint32_t from = newest > SLOTS ? newest - SLOTS : 0;
+    char key[8], buf[176];
+    size_t cap;
+    int shown = 0;
+    printf("@diag seq=%" PRIu32 " slots=%d\n", newest, SLOTS);
+    for (uint32_t i = from; i < newest; i++) {
+        snprintf(key, sizeof key, "r%" PRIu32, i % SLOTS);
+        cap = sizeof buf - 1;
+        buf[0] = '\0';
+        if (nvs_get_str(s_nvs, key, buf, &cap) == ESP_OK) {
+            printf("  %s\n", buf);
+            shown++;
+        }
+    }
+    printf("@diag 翻出 %d 条；b=开机 e=转折 t=低功耗兜底 kl/k1=开机时 PMU 还锁着的按键/其它中断\n", shown);
+    fflush(stdout);
+}
diff --git a/esp32/components/muse/carpet/carpet_diag.h b/esp32/components/muse/carpet/carpet_diag.h
new file mode 100644
index 0000000..4c3b867
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_diag.h
@@ -0,0 +1,41 @@
+/*
+ * 断电验尸：把"死之前那一刻机器的样子"写进 NVS，下次开机能翻出来。
+ *
+ * 为什么要这么绕：现场的症状是"电池 + 熄屏放 5 分钟，回来插 USB 才醒"（HANDOFF §15.11），
+ * 也就是**整机断过电**。断过电之后串口日志全没了，RAM 里的计数也全没了，
+ * 光靠 `@stay` / `@power` 只能看出"重启过"，看不出**死在哪一步、死的时候 PMU 说什么**。
+ * NVS 是唯一能扛过断电的东西，所以每个可疑的转折点都当场落一条，宁可写得土一点。
+ *
+ * 每条记录都带同一组 PMU 原始寄存器（`off=` 那句就是 `REG_PWROFF_STATUS 0x21`，
+ * "上一次是谁把它关掉的"）—— 这一组是这次要认的东西本身，不是我猜出来的线索。
+ *
+ * 只在 CONFIG_MUSE_CARPET_CARDS 里；这块诊断是台架仪器，演示固件交付时按 carpet_diag.c
+ * 顶部那段把它摘掉。
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "freertos/FreeRTOS.h"
+
+/* PMU 在自己清 IRQ 锁存之前，先让它把"开机那一刻已经锁存的按键事件"递过来。
+ * 早于 NVS 就绪，所以只存到 RAM，第一条 boot 记录再一起写出去。 */
+void carpet_diag_pmu_latched(uint8_t intsts2, uint8_t intsts1);
+
+/* 开机补一条：复位原因 + 唤醒原因 + 那两份锁存。从 carpet_link_start() 叫，NVS 那时已经好了。 */
+void carpet_diag_boot(void);
+
+/* 一个转折点：tag 要短（记录进 flash，一条越短越经得起翻）。传 NULL 就是 "-"。 */
+void carpet_diag_event(const char *tag);
+
+/* 低功耗期间的定心丸：low_power 为真时每 20 秒一条，为假就不写。
+ * 这条的作用是"那一段时间里它确实还活着"，所以宁少勿多。 */
+void carpet_diag_tick(TickType_t now, bool low_power);
+
+/* `>diag`：从最旧到最新打出来，最后报一共几条、掉过几次电。 */
+void carpet_diag_dump(void);
+
+/* `>diag clear`：把环抹空、序号归零。跑那一趟之前清一次，读出来才只有这一趟。 */
+void carpet_diag_clear(void);

+/* 钟面（氛围层第一页）：一块大数字时:分 + 日期 + 下次过境，压在星轨背景图上。整列居中。
+ * 三行直接挂 flex 列、按各自行高占位（76px 那档行高约 110，22px 约 32），总高约
+ * 110+6+32+6+32=186，最外 dy≈93 ⇒ 半径 sqrt(150²+93²)=176<233，落在圆内。
+ * 内容用 Ink 蓝系；11-16 起这页没有返回药丸（owner：滑屏就够）。 */
+/* 卫星绕行的 exec_cb：角度→椭圆上坐标（背景图的主环是横 193 / 纵 178 的椭圆，
+ * 卫星必须贴着画出来的环走，用正圆会在上下脱环）。用 set_pos（不挂 align），
+ * 布局不会把它拽回去。 */
+static void orbit_sat_anim(void *var, int32_t deg)
+{
+    lv_obj_t *o = var;
+    lv_obj_t *st = lv_obj_get_parent(o);
+    int cx = lv_obj_get_width(st) / 2;
+    int cy = lv_obj_get_height(st) / 2;
+    float a = (float)deg * 3.14159265f / 180.0f;
+    int x = cx + (int)(ORBIT_RX * sinf(a));
+    int y = cy - (int)(ORBIT_RY * cosf(a));
+    int half = lv_obj_get_width(o) / 2;
+    lv_obj_set_pos(o, x - half, y - half);
+}
+
+/* 星轨层（11-16 第二版）：整屏背景图 + 一颗绕行卫星。
+ * 上一版是纯 LVGL 程序化摆的星点/暗盘/环，owner 对比后说和当初选的 demo 效果图不像——
+ * 那个效果本来就不在任何开源项目里（demo 图是 AI 出的，程序化只是我的复刻）。
+ * 这轮搬的是 Round-Clock（scott987-cmd/ESP32-Round-Clock，Apache-2.0，同款 1.75C 板）
+ * 的壁纸机制：它家时钟就是一张整屏 RGB565 图（main/assets/default.rgb565）叠大数字。
+ * 图换成我们自己的 demo 底图（抹掉烤死的时间/日期/按钮/卫星点，数字和卫星仍是真的：
+ * 时间走 SNTP、卫星走 lv_anim），所以既贴 demo 又不假造。 */
+/* 小屏把 472 底图一次性双线性重采样进 PSRAM（屏+6 见方，和 472/466 同款每边 3px
+ * 烧屏位移余量）。不用 lv_image 运行时缩放：钟面每秒重画、烧屏还要位移，
+ * 缩放钱不能每帧付。只在 build 里跑一次。 */
+static uint16_t *clock_bg_resample(int size)
+{
+    uint16_t *dst = heap_caps_malloc((size_t)size * size * 2, MUSE_BIG_CAPS);
+    const uint16_t *src = (const uint16_t *)carpet_clock_bg_start;
+    const float k = (float)CLOCK_BG_SIZE / size;
+    const int sh[3] = { 11, 5, 0 }, mask[3] = { 31, 63, 31 };
+    for (int y = 0; y < size; y++) {
+        float fy = (y + 0.5f) * k - 0.5f;
+        if (fy < 0) fy = 0;
+        int y0 = (int)fy, y1 = y0 + 1 < CLOCK_BG_SIZE ? y0 + 1 : y0;
+        float ty = fy - y0;
+        for (int x = 0; x < size; x++) {
+            float fx = (x + 0.5f) * k - 0.5f;
+            if (fx < 0) fx = 0;
+            int x0 = (int)fx, x1 = x0 + 1 < CLOCK_BG_SIZE ? x0 + 1 : x0;
+            float tx = fx - x0;
+            uint16_t a = src[y0 * CLOCK_BG_SIZE + x0], b = src[y0 * CLOCK_BG_SIZE + x1];
+            uint16_t c = src[y1 * CLOCK_BG_SIZE + x0], d = src[y1 * CLOCK_BG_SIZE + x1];
+            int out = 0;
+            for (int ch = 0; ch < 3; ch++) {
+                float va = (a >> sh[ch]) & mask[ch], vb = (b >> sh[ch]) & mask[ch];
+                float vc = (c >> sh[ch]) & mask[ch], vd = (d >> sh[ch]) & mask[ch];
+                float v = (va + (vb - va) * tx) * (1 - ty) + (vc + (vd - vc) * tx) * ty;
+                out |= ((int)(v + 0.5f) & mask[ch]) << sh[ch];
+            }
+            dst[y * size + x] = (uint16_t)out;
+        }
+    }
+    return dst;
+}
+
+static void build_clock_orbit(lv_obj_t *tile)
+{
+    lv_obj_t *st = lv_obj_create(tile);
+    lv_obj_remove_style_all(st);
+    lv_obj_set_size(st, LV_PCT(100), LV_PCT(100));
+    lv_obj_center(st);
+    lv_obj_set_style_bg_opa(st, LV_OPA_TRANSP, 0);
+    lv_obj_remove_flag(st, LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE);
+    s_clock_stage = st;
+
+    static lv_image_dsc_t bg_dsc;
+    static uint16_t *bg_small;
+    int bg_size = CLOCK_BG_SIZE;
+    if (s_screen_w < 466) {
+        bg_size = s_screen_w + 6;
+        bg_small = clock_bg_resample(bg_size);
+        if (!bg_small) bg_size = CLOCK_BG_SIZE;
+    }
+    bg_dsc.header.magic = LV_IMAGE_HEADER_MAGIC;
+    bg_dsc.header.cf = LV_COLOR_FORMAT_RGB565;
+    bg_dsc.header.w = bg_size;
+    bg_dsc.header.h = bg_size;
+    bg_dsc.header.stride = bg_size * 2;
+    bg_dsc.data_size = (uint32_t)bg_size * bg_size * 2;
+    bg_dsc.data = bg_small ? (const uint8_t *)bg_small : carpet_clock_bg_start;
+    lv_obj_t *bg = lv_image_create(st);
+    lv_image_set_src(bg, &bg_dsc);
+    lv_obj_center(bg);
+    lv_obj_remove_flag(bg, LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE);
+
+    /* 卫星：带辉光的点，60s 沿画出来的环绕一圈。装饰轨道，不冒充真实过境倒计时。 */
+    s_clock_sat = lv_obj_create(st);
+    lv_obj_remove_style_all(s_clock_sat);
+    lv_obj_set_size(s_clock_sat, SC(16), SC(16));
+    lv_obj_set_style_radius(s_clock_sat, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_color(s_clock_sat, lv_color_hex(0xE8FBFF), 0);
+    lv_obj_set_style_bg_opa(s_clock_sat, LV_OPA_COVER, 0);
+    lv_obj_set_style_shadow_width(s_clock_sat, SC(20), 0);
+    lv_obj_set_style_shadow_color(s_clock_sat, lv_color_hex(ORBIT_CYAN), 0);
+    lv_obj_set_style_shadow_opa(s_clock_sat, LV_OPA_60, 0);
+    lv_obj_remove_flag(s_clock_sat, LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_pos(s_clock_sat, SC(233) - SC(8), SC(233) - ORBIT_RY - SC(8));
+    lv_anim_t an;
+    lv_anim_init(&an);
+    lv_anim_set_var(&an, s_clock_sat);
+    lv_anim_set_exec_cb(&an, orbit_sat_anim);
+    lv_anim_set_values(&an, 0, 360);
+    lv_anim_set_time(&an, 60000);
+    lv_anim_set_repeat_count(&an, LV_ANIM_REPEAT_INFINITE);
+    lv_anim_start(&an);
+}

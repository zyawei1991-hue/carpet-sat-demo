+void carpet_link_dump(void)
+{
+    carpet_link_view_t v;
+    carpet_link_view(&v);
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+
+    /* gap 换算成页面第一行那句中文的规则写在 carpet_page.c 的 tick 里：
+     * 没网=等网络、没连=未接入、gap 无穷=等首帧、>10s=掉线重连、>3s=卡N秒、否则=已接入。 */
+    printf("@carpet wifi=%d linked=%d contract=v%d gap_s=%lu has_state=%d wd=%lu fails=%lu\n",
+           v.wifi_up, v.linked, v.negotiated, (unsigned long)v.gap_s, s.has_state,
+           (unsigned long)screen_link_watchdog_fires(), (unsigned long)screen_link_dial_fails());
+    printf("@carpet sat=%s\n", s.sat[0] ? s.sat : "-");
+    printf("@carpet dialog=%s\n", s.dialog[0] ? s.dialog : "-");
+    /* 首屏那条带上的整句：live=还有话挂着，mode=脸现在哪个状态
+     * （1 idle / 3 thinking / 4 speaking），at/len=念到第几个字节。
+     * 站在屏前看不出"是没收到还是收到没画"，这一行分得清。 */
+    printf("@carpet face=%d mode=%d at=%u/%u\n", (int)s_face_live,
+           (int)muse_state_mode(NULL), (unsigned)s_face_at,
+           (unsigned)(s_face_text ? strlen(s_face_text) : 0));
+    /* 带上现在实际画的那一页（不是整句）—— "收到没"和"画的是哪页"是两件事，
+     * 光看 at/len 分不出分页分得对不对。 */
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    printf("@carpet band=%s\n", s_face_live && s_face_shown ? s_face_shown : "-");
+    xSemaphoreGive(s_lock);
+    /* maint_worried 是那个布尔记号本身（不是屏上的中文串）：#73 的判据是
+     * "这一帧到底到没到"，跟着中文走就成了自己对自己打勾。 */
+    printf("@carpet card=%s emotion=%s maint_worried=%d\n", s.card[0] ? s.card : "-",
+           s.emotion[0] ? s.emotion : "-", (int)s.maint_worried);
+    printf("@carpet sos=%s\n", s.sos[0] ? s.sos : "-");
+    /* 三个按钮发出去几条、最后一条是哪个 —— 站在那块屏前按了才知道有没有通路，
+     * 这一行是"按了真的发出去了"的唯一凭据。 */
+    int sent = 0;
+    const char *last = carpet_link_last_sent(&sent);
+    printf("@carpet sent=%d last=%s\n", sent, last);
+    /* 翻页是本地动作，手机上那一格空着有两种可能：屏没发 / 发了但链路当时没连。
+     * nav=屏现在自认为在哪一页，reported=发出去几条，last=最后一条的名字。
+     * 三个数对不上就是这一行说的，不用猜。 */
+    printf("@carpet nav=%s reported=%d last=%s\n", carpet_page_current_name(),
+           (int)s_pages_sent, s_last_page[0] ? (const char *)s_last_page : "-");
+    /* hello 里那一串屏幕参数（v3）。手机端定字号靠它，报错了整屏排版跟着错，
+     * 所以这里给的是**和发出去同一个来源**的数，不是"应该是 466"。 */
+    int gw, gh, gppi;
+    bool gr, gt;
+    screen_geom(&gw, &gh, &gr, &gt, &gppi);
+    printf("@carpet screen=%dx%d round=%d touch=%d ppi=%d\n", gw, gh, (int)gr, (int)gt, gppi);
+    /* 拨的是哪条、谁定的：现场一半的"连不上"其实是"拨的是上一台电脑那条"。
+     * src=factory 说明 NVS 里那一格是空的（不是丢了，是从没填过）。
+     * 走 url_effective()：网还没起来时 s_url 是空的，那时也要说真话。 */
+    char url_now[MUSE_LINK_URL_MAX + 1];
+    bool url_nvs = false;
+    url_effective(url_now, &url_nvs);
+    printf("@carpet url=%s src=%s\n", url_now, url_nvs ? "nvs" : "factory");
+    /* 上行那一道闸现在开到哪一格。armed 先算出来再打印：printf 的参数求值顺序没有规定，
+     * 把"会去读 NVS 的那一句"和"读回来的那一格"写在同一个调用里，顺序反过来就是假话。 */
+    int mic_armed = carpet_mic_armed() ? 1 : 0;
+    printf("@carpet mic=%s armed=%d（细则 >mic）\n", carpet_mic_mode_name(), mic_armed);
+    carpet_audio_dump();
+    fflush(stdout);
+}
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_link.h b/esp32/components/muse/carpet/carpet_link.h
new file mode 100644
index 0000000..b86d94a
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_link.h
@@ -0,0 +1,174 @@
+/*
+ * 车联（Screen-Link）在 Muse 里的启动闸门与状态存放。
+ *
+ * Muse 的 UI 是拉取式的：LVGL 任务每帧自己去读状态（见 muse_ui.c 的
+ * update_chrome()），其它任务从不碰 LVGL。所以本文件只写状态，
+ * 画由 carpet_page.c 在 UI 任务里读。
+ *
+ * Wi-Fi 归 Home Link 管（手机配对后才能上网），这里不能自己连，
+ * 只能等 muse_wifi_connected() 真了再启链路。
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "esp_err.h"   /* esp_err_t for carpet_link_set_url() */
+
+/* Safe from any task. Starts the link once Wi-Fi is up; calling it twice does
+ * nothing. */
+void carpet_link_start(void);
+
+/* What the page draws. Snapshot so the UI task reads one consistent set. */
+typedef struct {
+    bool wifi_up;
+    bool linked;
+    int negotiated;          /* 谈下来的契约档；只有 >=2 才走得通对话 */
+    uint32_t gap_s;          /* 距上一帧 state 多少秒；没连上时是 UINT32_MAX */
+} carpet_link_view_t;
+
+void carpet_link_view(carpet_link_view_t *out);
+
+/*
+ * 页面上另外四行要的值，已经从契约的英文枚举翻成中文短串（屏上不许出现英文原值）。
+ * 每一项都只描述**最新那一帧**：帧里没带的字段不会留着上一帧的值，
+ * 所以这里不需要"清一清"的额外约定 —— 整棵树每帧换掉，缺的就是回落值。
+ */
+typedef struct {
+    bool has_state;          /* 这轮会话收到过 state 没有 */
+    char sat[40];            /* 卫星相位 + 下次过境倒计时 */
+    char card[24];           /* 手机上当前画在哪张卡 */
+    char emotion[24];        /* ui.emotion */
+    char sos[24];            /* sos.level */
+    char dialog[40];         /* 最近一句对话的方向和来源；超过 5 秒留空 */
+    /* `ui.card=maint` 且 `ui.emotion=worried` 同时成立：那就是"一条到点的养护"。
+     * 判在解码这一层（这里还拿着契约的英文原值），页面只认这个布尔 ——
+     * 让页面去比"养车卡""担心"这种中文串，等于把改措辞的成本摊到排版那边。 */
+    bool maint_worried;
+} carpet_state_view_t;
+
+/* 从任何任务读都行（里面有锁），但只在 UI 任务的 tick 里调用才有意义。 */
+bool carpet_link_state(carpet_state_view_t *out);
+
+/*
+ * 钟面用的墙钟。这套固件本来没有任何对时来源（muse_voice_call.cpp 那句注释明说
+ * "Nothing on the gadget sets the clock (no SNTP)"），所以 gate_task 等到 Wi-Fi 起来后
+ * 起一路 SNTP（ntp.aliyun.com，TZ=CST-8）。**联网才同步**：现场那台手机热点本来就要
+ * 给云端 ASR/TTS 供网，钟面跟着同一条网走，不额外引入依赖。
+ * 返回 true = 已同步（year≥2024），各 out 填本地时间；false = 还没同步上，钟面回落
+ * "--:--" + 「时间同步中」，**不摆一个假时间**（不放假数据那条红线）。
+ * 只在 UI 任务的 tick 里调；纯读 time()/localtime_r()，不碰 LVGL、不阻塞。
+ */
+bool carpet_link_wallclock(int *year, int *mon, int *mday, int *hour, int *min);
+
+/*
+ * 把一次"用户在这块玻璃上做了什么"送给手机。cmd 只能是契约里那三条
+ * （card_next / card_auto / poke）—— 组件自己还有一道白名单，非法值当场退回，
+ * 而手机端解不开入站帧的处理是**关连接、一句话不说**，所以拼错的代价是掉线。
+ *
+ * dir 只给 card_next 用（+1 往后一张 / -1 往前一张）。
+ *
+ * **这条在 LVGL 任务里调用安全**：它只往队列里放一个 16 字节的小结构，
+ * 真正的 socket 发送在 carpet_cmd 任务里 —— screen_link_send_command() 最坏会
+ * 阻塞约 2 秒，搁在 UI 任务里就是整块屏停两秒（脸不再呼吸、页面不更新）。
+ * 队列满（4 条没发出去）就丢掉并记一条 warning，绝不等待。
+ */
+void carpet_link_send(const char *cmd, int dir);
+
+/*
+ * 通报"屏现在在哪一页"。和上面那条的区别就一句：card_next 那几个是**请求**
+ * （手机可以拒绝、可以算出别的），这一条是**通报** —— 页是屏自己翻的，手机只是
+ * 照着写镜像，不许驳回。页名由 carpet_page.c 的 PAGE_NAMES 给出（和契约的 ScreenPage
+ * 同一张表，core 的 SchemaDriftTest 会比对），所以这里不再查白名单。
+ * 同样只入队，不在 LVGL 任务里发。
+ */
+void carpet_link_report_page(const char *page_name);
+
+/* 最近一次成功装配上行的命令，给 `>carpet` 回读用（不是给人看的，是给我证明
+ * "按下去真的上线了"）。sent=成功发出的条数。 */
+const char *carpet_link_last_sent(int *sent);
+
+/*
+ * 首屏那张脸的答句：**只写 Muse 自己留的三个口**（caption / mode / level / progress），
+ * 不改它的 UI、不叠我们的控件。所以脸还是那张脸，只是话是我们服务端给的。
+ *
+ * 翻页的钟得有人拨。Muse 云端那一路是按**播放的音频**推进念稿位置的，我们不出声音，
+ * 就自己按"念稿"的速度推 —— 挂在这里，由 carpet_page_tick() 每 0.25 秒调一次。
+ * 露的是脸那一格也必须跑，所以调用点在 `s_tile` 判断**之前**。
+ *
+ * 只在 LVGL 任务里调；`on_dialog` 那边（链路任务）负责把整句交进来并画第一页。
+ */
+void carpet_link_face_tick(void);
+
+/* Console readback (`>carpet`): prints the same numbers and strings the tile
+ * draws, one line each. Safe from any task, never touches LVGL. */
+void carpet_link_dump(void);
+
+/*
+ * 接入点地址（手机那一头的 ws 地址）现在**运行期可设**，读的顺序是 NVS(`muse`/`link_url`)
+ * → 出厂常量 `CONFIG_SCREEN_LINK_URL`。为什么要有这一条：现场那台电脑/那部手机的 IP 一直在换，
+ * 只靠编译期常量就是"每换一次网络改一次 sdkconfig、重编、再刷一遍"，那条路在用户面前不成立。
+ *
+ * `carpet_link_url(out, n, &from_nvs)` 给的是**现在生效**的那条和它的来源
+ * （true = 设置页或 `>url` 存进 NVS 的那条；false = 出厂常量）。网还没起来时链路一次都
+ * 没拨过，这时它按同一条"先 NVS 再出厂"的规则现算，而不是回一句出厂值糊弄过去 ——
+ * 因为设置页那一格和 `>url` 回读都要在它之前就能说清"你存的那条已经算数了"。
+ * `carpet_link_set_url(url)` 写 NVS（空串 = 抹掉那一格，回到出厂那条）并**立刻重拨**
+ * —— 先 `screen_link_stop()` 发 bye，再重新 start，所以退避阶梯从头开始，不用等它转完；
+ * 链路一次都没起过时只存下下次要拨的那条，不抢 gate 的活。
+ * 返回 `ESP_ERR_INVALID_ARG` = 不以 ws:// 或 wss:// 开头或带空格，`ESP_ERR_INVALID_SIZE` = 超 63 字节，
+ * `ESP_ERR_INVALID_STATE` = `carpet_link_start()` 还没跑（开机极早期，串口命令到不了这么早）。
+ * `carpet_link_url_dump()` 是串口 `>url` 的回读。
+ */
+void carpet_link_url(char *out, size_t n, bool *from_nvs);
+esp_err_t carpet_link_set_url(const char *url);
+void carpet_link_url_dump(void);
+/*
+ * 连着拨不上多少次，和最后一条失败的原因（都是 screen_link 那两份的转发，
+ * 屏侧要读的是这两句，不是那个组件的头文件）。给 keeper 判"网还连着但已经到不了手机"，
+ * 理由写在 screen_link.h 的 screen_link_dial_fails 注释里。
+ */
+uint32_t carpet_link_dial_fails(void);
+void carpet_link_last_error(char *out, size_t cap);
+
+/*
+ * 开发口：把一句话直接塞进首屏那条带，当它是答句（脸进 speaking、按 2.5 秒一页翻）。
+ * 验分页只用得着这个 —— 不接模型也能看出第二页从哪起、一页装几个字。
+ * `>say 一二三…` 走 muse_input 那条线；只入内存不上网。
+ */
+void carpet_link_bench_say(const char *text);
+
+/*
+ * 开发口：放 N 秒 1 kHz 纯音，同时把 speaker_on / 音量 / 功放使能脚电平 / 每笔写的
+ * 返回和每秒实际耗时印出来 —— 用来把"样本真的按 16k 节拍送出去了"和"喇叭响了"分开证。
+ * `>audio [秒]`，默认 3 秒、最多 30 秒，期间占住串口任务。
+ * 不读麦克风：那条在这块板上要么立刻失败（RX 通道没使能）、要么不返回（等 paired 通道），
+ * 会把开发口整条卡死，实测细节见 carpet_link.c 里那段注释。
+ */
+void carpet_link_bench_audio(int seconds);
+
+/*
+ * 开发口 `>audtest [秒] [一句话]`：**一句文字 + 同 turn_id 的一段语音**一起放。
+ * 文字走首屏那条带（和真答句同一条 face_offer），语音走 carpet_audio 那条环和播放任务。
+ * 两个分开测只能各自看出"不动"，合在一起才看得出这两条：
+ * 念稿是不是跟着**播放位置**翻页（不是按 2.5 秒估），口型是不是跟着**真实电平**动。
+ * text 传空串就只放声音。
+ */
+void carpet_link_bench_say_audio(const char *text, int seconds);
+
+/*
+ * 开发口 `>maint` / `>maint off`：本机造一帧 `ui={card:"maint",emotion:"worried"|"neutral"}`
+ * 的 state，交的是链路收帧时同一条 `on_state()`。为的是让 #73 那三条让路和那枚琥珀点
+ * **不依赖网络**就能称：`>maint` 之后 `>carpet` 那行应回 `maint_worried=1`。
+ * worried=true 之后一定要再来一条 `off`，否则脸一直停在"想"上。
+ */
+void carpet_link_bench_maint(bool worried);
+
+/*
+ * 开发口 `>emo <name>`：本机造一帧 `ui={emotion:"<name>"}` 的 state，交链路同一条 on_state()。
+ * name 用契约英文键 neutral/happy/excited/sad/worried/sleepy/thinking。不带 card，脸停 IDLE，
+ * 情绪才上脸（muse_pixel 只在 IDLE 且没摸头时画情绪）。回读 `>carpet` 那行 emotion 同源。
+ */
+void carpet_link_bench_emotion(const char *name);
diff --git a/esp32/components/muse/carpet/carpet_mic.c b/esp32/components/muse/carpet/carpet_mic.c
new file mode 100644
index 0000000..cbee44e
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_mic.c
@@ -0,0 +1,516 @@
+/*
+ * 契约 v4 上行「对着屏说话」的屏侧那半：攒段 → 组帧 → 发。
+ *
+ * 为什么住在 carpet 而不是 muse_voice.c：那边只管"什么时候开始采、什么时候松手"，
+ * 这一份管的是网络那一头的事。两边只靠三个函数对上（begin / feed / end）。
+ * 三件设计根据（不开第二个读者、发帧不占采集节拍、三道闸）写在 carpet_mic.h 顶上。
+ */
+
+#include "carpet_mic.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "cJSON.h"
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_random.h"
+#include "esp_timer.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/idf_additions.h"
+#include "freertos/queue.h"
+#include "freertos/task.h"
+#include "mbedtls/base64.h"
+#include "nvs.h"
+
+#include "carpet/carpet_audio.h"
+#include "muse_audio.h"
+#include "screen_link.h"
+
+static const char *TAG = "carpet_mic";
+
+/* ---------------- 帧的形状（和 v3 下行刻意做成同一套） ---------------- */
+
+#define MIC_RATE       16000          /* 采到的就是这个数，不是"选一个"：屏的通路只产 16k/单声道/s16le */
+#define MIC_SECONDS    8              /* 「按住说」上限。和下行那个 64 秒 / 2 MB 段上限是两个数，别混 */
+#define MIC_MAX_BYTES  (MIC_RATE * 2 * MIC_SECONDS)   /* 256,000 */
+#define MIC_BLOCK      2560           /* 80 毫秒 = 4 个 20 毫秒采集块。下行同一个块大小 */
+#define MIC_MAX_BLOCKS (MIC_MAX_BYTES / MIC_BLOCK)    /* 100 */
+/* 一块编成 b64 的最坏长度 + 结尾 NUL + 余量：2,560 → 3,416 → 3,424。
+ * 和 carpet_audio.c 那个下行预算同一个算法，只是方向反过来；整帧约 3.5 KB，
+ * 压在 SCREEN_LINK_MAX_FRAME 4096（同时是 ws_cfg.buffer_size）里。 */
+#define MIC_B64_BYTES  (4 * ((MIC_BLOCK + 2) / 3) + 8)
+
+#define MIC_TURN_MAX   32             /* `m-<6 位开机随机>-<自增>`，契约要求跨重启唯一 */
+
+/* 断线发生在"我们发过上行之后"的这么久以内，就把这一台手机判成不收上行。
+ * 老 App 的关线在第一帧之后才到屏上，所以看的是"发过之后的断线"而不是超时。 */
+#define MIC_REJECT_US  (5LL * 1000000)
+
+#define MIC_SEGS       2              /* 两只段缓冲：一只在采，另一只可以同时在发上一句 */
+
+/* 那一格开关存的地方。命名空间用 carpet 而不是 muse：carpet_diag 已经占了一个自己
+ * 的（cdiag），走的是同一条理由 —— 我们加的键不该混进 Muse 官方那张设置表，
+ * 那张表有它自己的主机侧测试。 */
+#define MIC_NS         "carpet"
+#define MIC_KEY        "mic_mode"
+
+/* 发送任务的栈。8 KB 放 PSRAM —— 原因和 carpet_audio 播放任务一模一样，
+ * 那块板上 16 KB 连续内部 RAM 从来没给出来过（实测最大连续 7,424 字节），
+ * 而任务建不起来只表现为"按了没反应"。WithCaps 这一族的栈深度单位是**字节**。 */
+#define MIC_SEND_STACK (8 * 1024)
+
+typedef struct {
+    uint8_t *buf;                     /* MIC_MAX_BYTES，PSRAM */
+    size_t len;                       /* 已填字节 */
+    bool busy;                        /* 采或发占着 */
+    bool capped;                      /* 撞到 8 秒上限，后面交进来的没进这一段 */
+} seg_t;
+
+typedef struct {
+    int idx;                          /* s_seg[] 下标 */
+    size_t bytes;
+    char turn[MIC_TURN_MAX];
+    uint32_t blocks;
+} send_job_t;
+
+/* ---------------- 状态 ---------------- */
+
+static seg_t s_seg[MIC_SEGS];
+static QueueHandle_t s_jobs;
+static bool s_dead;                   /* 缓冲或任务要不到：这一路整个不可用，别再每次按下试一次 */
+
+/* 出厂默认 AUTO，不是 OFF（2026-11-13 改）。理由不是"想让它默认能说话"，是 owner 的
+ * 硬约束**演示现场不用电脑**：这一格原来只有串口 `>micup auto` 能改，换一块板或者
+ * NVS 被清过就永久回到关，现场没有任何手段开回来 —— 那等于这个功能在演示台上不存在。
+ * AUTO 本身不放宽任何一道闸：还要手机连着 + 对面在 ack.protocols 里申报过 4 + 没被熔断，
+ * 所以"默认开"不会让它对着一台不认上行的 App 硬发。屏上「声音」页现在也有这一格。 */
+static carpet_mic_mode_t s_mode = CARPET_MIC_FACTORY_MODE;
+static bool s_mode_loaded;
+
+static volatile bool s_phone_v4;      /* 这一轮会话里，对面的 ack 申报过 4 */
+static volatile bool s_rejected;      /* 发过上行之后链路就断：这台手机不收，本会话不再试 */
+static volatile bool s_talk_req;      /* 点 Avatar 进对话：LVGL 任务立记号，采集任务取走 */
+
+static int s_cur = -1;                /* 正在采的那只 */
+static char s_turn[MIC_TURN_MAX];
+static uint32_t s_boot_tag;
+static uint32_t s_turn_n;
+
+/* 只给串口回读用，所以不配锁：全是"最后一次是多少"那种数，读错了不改行为。 */
+static uint32_t s_turns;              /* 交进发送队列的段数 */
+static uint32_t s_frames_ok;          /* 真的发出去的帧数 */
+static uint32_t s_segs_busy;          /* 因为两只缓冲都在忙而没采成的按下 */
+static uint32_t s_bytes_out;
+static int64_t s_last_send_us;
+static int64_t s_last_turn_ms;        /* 上一句发完用了多久（毫秒） */
+static char s_last_err[48];
+
+/* ---------------- 那一格开关（NVS 命名空间 carpet / mic_mode） ---------------- */
+
+static void mic_mode_load(void)
+{
+    if (s_mode_loaded) return;
+    nvs_handle_t h;
+    /* 分家对待："这一格从来没存过"和"现在读不了"不是一件事。
+     * 开机第一次按下可能早于 NVS 起来，那时把读失败当成没存过并缓存下来，
+     * 结果是一台 `>micup force` 存过的屏重启后回不来，串口里还显示 armed=0 —— 现场查不出为什么。 */
+    esp_err_t err = nvs_open(MIC_NS, NVS_READONLY, &h);
+    if (err == ESP_ERR_NVS_NOT_FOUND) {     /* 没存过 = 出厂默认 AUTO（见 s_mode 那段），这一格可以缓存 */
+        s_mode_loaded = true;
+        return;
+    }
+    if (err != ESP_OK) return;              /* 别的失败：下次再读，别缓存 */
+    uint8_t v = 0;
+    if (nvs_get_u8(h, MIC_KEY, &v) == ESP_OK && v <= CARPET_MIC_FORCE) s_mode = (carpet_mic_mode_t)v;
+    nvs_close(h);
+    s_mode_loaded = true;
+}
+
+carpet_mic_mode_t carpet_mic_mode(void)
+{
+    mic_mode_load();
+    return s_mode;
+}
+
+const char *carpet_mic_mode_name(void)
+{
+    (void)carpet_mic_mode();     /* 先读再打印：printf 的参数求值顺序没有规定，别和 armed= 抢跑 */
+    switch (s_mode) {
+    case CARPET_MIC_AUTO:  return "auto";
+    case CARPET_MIC_FORCE: return "force";
+    default:               return "off";
+    }
+}
+
+void carpet_mic_set_mode(carpet_mic_mode_t mode)
+{
+    mic_mode_load();
+    s_mode = mode;
+    /* 手改开关就是人在下命令：把"这台手机不收"那一格一起抹掉。否则 force 明明开着、
+     * 上行却被一次旧断线永久挡着，现场只会看到"按了没反应"。 */
+    s_rejected = false;
+    nvs_handle_t h;
+    if (nvs_open(MIC_NS, NVS_READWRITE, &h) == ESP_OK) {
+        if (nvs_set_u8(h, MIC_KEY, (uint8_t)mode) == ESP_OK) nvs_commit(h);
+        nvs_close(h);
+    } else {
+        strlcpy(s_last_err, "NVS 打不开，开关没存住", sizeof(s_last_err));
+    }
+    ESP_LOGI(TAG, "上行开关 = %s%s", carpet_mic_mode_name(),
+             s_last_err[0] ? "（没存进 NVS，重启回到上一格）" : "");
+}
+
+void carpet_mic_factory_default(void)
+{
+    nvs_handle_t h;
+    if (nvs_open(MIC_NS, NVS_READWRITE, &h) == ESP_OK) {
+        nvs_erase_key(h, MIC_KEY);      /* 只抹这一个键：Wi-Fi / link_url 都在别的命名空间，不动 */
+        nvs_commit(h);
+        nvs_close(h);
+    } else {
+        strlcpy(s_last_err, "NVS 打不开，没抹掉那一格", sizeof(s_last_err));
+    }
+    s_mode = CARPET_MIC_FACTORY_MODE;
+    s_mode_loaded = true;
+    s_rejected = false;
+    ESP_LOGI(TAG, "上行开关恢复出厂 = %s%s", carpet_mic_mode_name(),
+             s_last_err[0] ? "（NVS 没抹掉，重启会回到存过的那一格）" : "");
+}
+
+/* ---------------- 地基 ---------------- */
+
+static void sender_task(void *arg);
+
+/* 要不到内存那一刻把四个数打出来（内部 / PSRAM × 空闲 / 最大连续）。
+ * 这块板的教训是"只打空闲"看不出问题：空闲 20 KB、最大连续 7 KB，
+ * 任何 8 KB 以上的**连续**申请都必输，而日志里只有一句失败。 */
+static void mem_line(char *out, size_t n)
+{
+    snprintf(out, n, "内部 %u/%u  PSRAM %u/%u",
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL),
+             (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM),
+             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM));
+}
+
+void carpet_mic_init(void)
+{
+    char mem[64];
+    s_boot_tag = esp_random();
+
+    for (int i = 0; i < MIC_SEGS; i++) {
+        s_seg[i].buf = heap_caps_malloc(MIC_MAX_BYTES, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+        if (!s_seg[i].buf) {
+            mem_line(mem, sizeof(mem));
+            ESP_LOGE(TAG, "第 %d 只 %u 字节段缓冲要不到（%s）—— 上行整个不可用",
+                     i, (unsigned)MIC_MAX_BYTES, mem);
+            for (int j = 0; j < MIC_SEGS; j++) {
+                if (s_seg[j].buf) heap_caps_free(s_seg[j].buf);
+                s_seg[j].buf = NULL;
+            }
+            strlcpy(s_last_err, "段缓冲要不到", sizeof(s_last_err));
+            s_dead = true;
+            return;
+        }
+    }
+
+    s_jobs = xQueueCreate(MIC_SEGS, sizeof(send_job_t));
+    if (!s_jobs) {
+        ESP_LOGE(TAG, "发送队列要不到 —— 上行整个不可用");
+        s_dead = true;
+        return;
+    }
+
+    TaskHandle_t sender = NULL;
+    if (xTaskCreateWithCaps(sender_task, "carpet_mic", MIC_SEND_STACK, NULL, 5, &sender,
+                            MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT) != pdPASS) {
+        mem_line(mem, sizeof(mem));
+        ESP_LOGE(TAG, "上行发送任务起不来，%d 字节 PSRAM 栈（%s）—— 整个不可用",
+                 MIC_SEND_STACK, mem);
+        strlcpy(s_last_err, "发送任务起不来", sizeof(s_last_err));
+        s_dead = true;
+        return;
+    }
+    ESP_LOGI(TAG, "上行地基就绪：%d 只 %u 字节段缓冲（PSRAM）、一帧 %d 字节 PCM、一段最多 %d 帧",
+             MIC_SEGS, (unsigned)MIC_MAX_BYTES, MIC_BLOCK, MIC_MAX_BLOCKS);
+}
+
+/* ---------------- 三道闸 ---------------- */
+
+bool carpet_mic_armed(void)
+{
+    if (s_dead) return false;
+    carpet_mic_mode_t mode = carpet_mic_mode();       /* 里面顺手把 NVS 那一格读一次 */
+    if (mode == CARPET_MIC_OFF) return false;
+    if (s_rejected) return false;
+    if (mode == CARPET_MIC_AUTO && !s_phone_v4) return false;
+    return screen_link_connected();
+}
+
+bool carpet_mic_link_up(void)
+{
+    return screen_link_connected();
+}
+
+/* 点 Avatar 进对话（B §1 的兜底，永远有效）：LVGL 任务立记号，采集任务下一拍取走，
+ * 和唤醒词命中走同一条 talk_to_phone —— 闸一道都不放宽（仍由 carpet_mic_armed() 判）。 */
+void carpet_mic_talk_request(void)
+{
+    s_talk_req = true;
+}
+
+bool carpet_mic_talk_take(void)
+{
+    if (!s_talk_req) return false;
+    s_talk_req = false;
+    return true;
+}
+
+void carpet_mic_phone_declared(bool has_v4)
+{
+    if (has_v4 == s_phone_v4) return;
+    s_phone_v4 = has_v4;
+    ESP_LOGI(TAG, "对面在 ack 里申报 v4（上行）= %s", has_v4 ? "是" : "否");
+}
+
+void carpet_mic_link_lost(void)
+{
+    if (!s_last_send_us) return;                      /* 从没发过上行，这次断线和我们无关 */
+    int64_t since = esp_timer_get_time() - s_last_send_us;
+    if (since > MIC_REJECT_US) return;                /* 隔了 5 秒以上才断：不记在我们头上 */
+    s_rejected = true;
+    strlcpy(s_last_err, "发过上行之后链路就断了", sizeof(s_last_err));
+    ESP_LOGW(TAG, "这一台手机收了链路（上行发出后 %.1f 秒）—— 本会话不再试。"
+                  "装会收上行的 App 或重启屏才会再试；>micup force 当场清掉这一格",
+             (double)since / 1000000.0);
+}
+
+/* ---------------- 采集侧（voice_task 调，这里不许阻塞、不许发帧） ---------------- */
+
+/* 上一段的峰值（0..32768）。为什么要有这个数：手机那头报「转写失败」的时候，
+ * 屏这边原来只有帧数和字节数 —— 那两个数证明"发出去了"，证明不了"发的是人话"。
+ * 开机自检那条静音基线是 peak 13（-79 dBFS），真人对着屏说话是几千。两个数一比，
+ * 「麦克风根本没采到声音」和「采到了但云端没认出来」当场分开，不必猜也不必等手机日志。 */
+static int s_cur_peak;
+static int s_last_peak;
+
+bool carpet_mic_begin(void)
+{
+    if (s_dead) return false;
+    int idx = -1;
+    for (int i = 0; i < MIC_SEGS; i++) {
+        if (!s_seg[i].busy) { idx = i; break; }
+    }
+    if (idx < 0) {
+        s_segs_busy++;
+        strlcpy(s_last_err, "两只段缓冲都在发上一句", sizeof(s_last_err));
+        ESP_LOGW(TAG, "上一句还没发完，这一次按下不采");
+        return false;
+    }
+    s_cur = idx;
+    s_cur_peak = 0;
+    s_seg[idx].len = 0;
+    s_seg[idx].capped = false;
+    s_seg[idx].busy = true;
+    s_last_err[0] = '\0';
+    snprintf(s_turn, sizeof(s_turn), "m-%06lx-%lu", (unsigned long)(s_boot_tag & 0xffffffUL),
+             (unsigned long)(++s_turn_n));
+    /* 上一轮的尾音先停：这一段是**麦克风**在听，让喇叭继续念会把答句录进下一句里。
+     * 规矩是 owner 2026-11-11 拍的那一条的一半 —— 屏起头这一轮只由屏出声，
+     * 而"放音期间停上行"就在这一行落地。文字那句不动（carpet_audio_abort 只管声音）。 */
+    if (carpet_audio_live()) carpet_audio_abort("对着屏说话");
+    return true;
+}
+
+void carpet_mic_feed(const int16_t *pcm, size_t frames)
+{
+    if (s_cur < 0 || pcm == NULL || frames == 0) return;
+    seg_t *sg = &s_seg[s_cur];
+    size_t add = frames * sizeof(int16_t);
+    if (sg->len + add > MIC_MAX_BYTES) {
+        sg->capped = true;                            /* 到 8 秒上限：这一段封顶，后面丢掉 */
+        add = sg->len < MIC_MAX_BYTES ? MIC_MAX_BYTES - sg->len : 0;
+        if (add == 0) return;
+    }
+    memcpy(sg->buf + sg->len, pcm, add);
+    sg->len += add;
+    /* 只数真收下的那些样本（封顶那一次 add 比 frames 小）。int 而不是 int16：
+     * -(-32768) 是 32768，用 int16 存会绕回负数，峰值就成了假的。 */
+    const int16_t *p = (const int16_t *)(sg->buf + sg->len - add);
+    for (size_t i = 0; i < add / sizeof(int16_t); i++) {
+        int v = p[i] < 0 ? -p[i] : p[i];
+        if (v > s_cur_peak) s_cur_peak = v;
+    }
+}
+
+size_t carpet_mic_limit_frames(void)
+{
+    return MIC_MAX_BYTES / sizeof(int16_t);
+}
+
+bool carpet_mic_full(void)
+{
+    return s_cur >= 0 && s_seg[s_cur].len >= MIC_MAX_BYTES;
+}
+
+void carpet_mic_end(bool send)
+{
+    if (s_cur < 0) return;
+    seg_t *sg = &s_seg[s_cur];
+    size_t bytes = sg->len;
+    if (!send || bytes == 0) {
+        sg->busy = false;                             /* 太短或作废：立刻还回去 */
+        s_cur = -1;
+        return;
+    }
+    send_job_t job = { .idx = s_cur, .bytes = bytes, .turn = { 0 } };
+    job.blocks = (uint32_t)((bytes + MIC_BLOCK - 1) / MIC_BLOCK);
+    strlcpy(job.turn, s_turn, sizeof(job.turn));
+    s_last_peak = s_cur_peak;
+    s_cur = -1;                                       /* 这只归发送任务，busy 先留着 */
+    s_turns++;
+    if (xQueueSend(s_jobs, &job, 0) != pdTRUE) {      /* 满了 = 发送任务没在动，不排队等待 */
+        sg->busy = false;
+        strlcpy(s_last_err, "发送队列满，这一句没送出去", sizeof(s_last_err));
+        ESP_LOGW(TAG, "发送队列满，%u 字节这一句丢掉（这一轮白说）", (unsigned)bytes);
+    }
+}
+
+/* ---------------- 发送侧（本文件自己的任务） ---------------- */
+
+/* 一块 PCM → 一帧 mic_chunk。args 的所有权交给 screen_link_send_command()
+ * （它在非法 cmd、组帧失败、发不完这些路上都已经把 args 释放掉了）。
+ * 返回 false = 这一帧没上线。 */
+static bool send_block(const char *turn, uint32_t seq, size_t seg_bytes, size_t n,
+                       const uint8_t *pcm, char *b64, size_t b64_cap)
+{
+    size_t olen = 0;
+    if (mbedtls_base64_encode((unsigned char *)b64, b64_cap, &olen, pcm, n) != 0
+        || olen + 1 > b64_cap) {
+        strlcpy(s_last_err, "base64 编码失败", sizeof(s_last_err));
+        return false;
+    }
+    b64[olen] = '\0';
+
+    cJSON *args = cJSON_CreateObject();
+    if (!args) return false;
+    cJSON_AddStringToObject(args, "turn_id", turn);
+    cJSON_AddNumberToObject(args, "seq", (double)seq);
+    /* total = **这一整段的字节数**，和 v3 下行同一个语义。因为松手才发，它一开口就是已知的，
+     * 手机那边不必为上行另写一套"等结束标记"的逻辑 —— 拼到 total 就齐了。 */
+    cJSON_AddNumberToObject(args, "total", (double)seg_bytes);
+    cJSON_AddNumberToObject(args, "rate", MIC_RATE);
+    cJSON_AddStringToObject(args, "b64", b64);
+    if (screen_link_send_command("mic_chunk", args) != ESP_OK) {
+        if (!s_last_err[0]) strlcpy(s_last_err, "帧没发出去", sizeof(s_last_err));
+        return false;
+    }
+    return true;
+}
+
+static void sender_task(void *arg)
+{
+    (void)arg;
+    /* b64 缓冲放堆上（3.4 KB），不压栈：8 KB 的栈不该为一帧吃掉它一半。 */
+    char *b64 = heap_caps_malloc(MIC_B64_BYTES, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!b64) ESP_LOGE(TAG, "b64 缓冲要不到，上行发不出去");
+
+    /* 高水位只称第一句：之后每句都印同一组数没意义，而这一行是"8 KB 到底够不够"的证据。 */
+    bool hw_printed = false;
+
+    send_job_t job;
+    while (xQueueReceive(s_jobs, &job, portMAX_DELAY) == pdTRUE) {
+        seg_t *sg = &s_seg[job.idx];
+        uint32_t sent = 0;
+        int64_t t0 = esp_timer_get_time();
+        bool ok = b64 != NULL;
+
+        for (uint32_t blk = 0; ok && blk < job.blocks; blk++) {
+            size_t off = (size_t)blk * MIC_BLOCK;
+            size_t n = job.bytes - off < (size_t)MIC_BLOCK ? job.bytes - off : (size_t)MIC_BLOCK;
+            ok = send_block(job.turn, blk, job.bytes, n, sg->buf + off, b64, MIC_B64_BYTES);
+            if (ok) {
+                sent++;
+                s_frames_ok++;
+                s_bytes_out += (uint32_t)n;
+                s_last_send_us = esp_timer_get_time();
+            }
+        }
+        int64_t us = esp_timer_get_time() - t0;
+        s_last_turn_ms = us / 1000;
+        sg->busy = false;                                 /* 交还这只缓冲 */
+        if (ok) {
+            ESP_LOGI(TAG, "上行 %s：%u/%u 帧、%u 字节（%.2f 秒语音）%.2f 秒发完",
+                     job.turn, (unsigned)sent, (unsigned)job.blocks, (unsigned)job.bytes,
+                     (double)job.bytes / (MIC_RATE * 2), (double)us / 1000000.0);
+        } else {
+            ESP_LOGW(TAG, "上行 %s：只发出 %u/%u 帧就停了（%s）—— 手机那一段拼不完整",
+                     job.turn, (unsigned)sent, (unsigned)job.blocks,
+                     s_last_err[0] ? s_last_err : "没发出去");
+        }
+        if (!hw_printed) {
+            hw_printed = true;
+            ESP_LOGI(TAG, "carpet_mic 还剩 %u 字节栈（8 KB PSRAM 那一档）",
+                     (unsigned)(uxTaskGetStackHighWaterMark(NULL) * sizeof(StackType_t)));
+        }
+    }
+}
+
+/* ---------------- 串口回读与开发口 ---------------- */
+
+void carpet_mic_dump(void)
+{
+    uint32_t free_segs = 0;
+    size_t cur_len = 0;
+    for (int i = 0; i < MIC_SEGS; i++) {
+        if (s_seg[i].buf && !s_seg[i].busy) free_segs++;
+    }
+    if (s_cur >= 0) cur_len = s_seg[s_cur].len;
+    printf("@mic mode=%s armed=%d phone_v4=%d rejected=%d dead=%d linked=%d\n",
+           carpet_mic_mode_name(), carpet_mic_armed() ? 1 : 0, s_phone_v4 ? 1 : 0,
+           s_rejected ? 1 : 0, s_dead ? 1 : 0, screen_link_connected() ? 1 : 0);
+    printf("@mic free_segs=%u/%d turns=%u frames=%u bytes=%u busy_drop=%u cur=%uB cap8=%ds\n",
+           (unsigned)free_segs, MIC_SEGS, (unsigned)s_turns, (unsigned)s_frames_ok,
+           (unsigned)s_bytes_out, (unsigned)s_segs_busy, (unsigned)cur_len, MIC_SECONDS);
+    printf("@mic last_turn=%s send_ms=%lld peak=%d err=%s\n",
+           s_turn, (long long)s_last_turn_ms, s_last_peak, s_last_err[0] ? s_last_err : "-");
+}
+
+/*
+ * `>mictest [秒]`：本机造一段语音（和 `>audtest` 那同一套 440 Hz 音节包络），
+ * 走 `begin/feed/end` 这同一条路 —— **不碰麦克风**，把"帧的形状、组帧、发送任务"
+ * 和"采集通路"分开证。发送在 carpet_mic 那条任务里，所以这条不占串口。
+ */
+void carpet_mic_bench(int seconds)
+{
+    if (seconds < 1) seconds = 2;
+    if (seconds > MIC_SECONDS) seconds = MIC_SECONDS;
+    if (s_dead) {
+        printf("@mictest 上行地基没起来（>mic 看为什么）\n");
+        return;
+    }
+    if (!carpet_mic_begin()) {
+        printf("@mictest 没段缓冲可用（上一句还在发）\n");
+        return;
+    }
+    static int16_t chunk[MUSE_AUDIO_CHUNK];
+    size_t total = (size_t)seconds * MUSE_AUDIO_RATE;
+    size_t done = 0;
+    while (done < total) {
+        size_t n = total - done < (size_t)MUSE_AUDIO_CHUNK ? total - done : (size_t)MUSE_AUDIO_CHUNK;
+        /* 400 毫秒一个音节、200 毫秒一个停顿：让 b64 里既有声音又有静音，
+         * 转写那一步至少在屏侧这一头有东西可传。 */
+        int phase = (int)((done * 1000 / MUSE_AUDIO_RATE) % 600);
+        float amp = phase < 400 ? 0.3f : 0.0f;
+        for (size_t i = 0; i < n; i++) {
+            chunk[i] = (int16_t)(amp * 32767.0f
+                * sinf(2.0f * (float)M_PI * 440.0f * (float)(done + i) / MUSE_AUDIO_RATE));
+        }
+        carpet_mic_feed(chunk, n);
+        done += n;
+    }
+    carpet_mic_end(true);
+    printf("@mictest 造了 %d 秒并交进发送队列（>mic 看发了几帧）\n", seconds);
+}
diff --git a/esp32/components/muse/carpet/carpet_mic.h b/esp32/components/muse/carpet/carpet_mic.h
new file mode 100644
index 0000000..b77731c
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_mic.h
@@ -0,0 +1,120 @@
+/*
+ * 契约 v4 的上行：「对着屏说话」。
+ *
+ * 按下 BOOT（这块板上的下键）→ 屏自己采一段裸 PCM → 松手后按 v3 下行那一套形状
+ * （`command{cmd:"mic_chunk", args:{turn_id,seq,total,rate,b64}}`，一块 2560 字节）
+ * 推给手机 → 手机转写、回 `dialog{dir:"up"}`、再照旧把答句走下行推回来。
+ *
+ * 三件事决定了这一份长什么样，都在 protocol/screen-link.md「上行音频通道」那一节里，
+ * 这里只把结论抄在离代码最近的地方：
+ *
+ * 1. **不开第二个读者**。`voice_task` 每 20 毫秒读一次麦克风，`muse_audio_read` 自己不
+ *    加锁（锁只在 `muse_audio_power` 里），第二个读者就是纯竞争 —— 表现为等满 1 秒令牌，
+ *    然后 `i2s_channel_read(1410): The channel is not enabled`。所以这一份**从不读硬件**：
+ *    样本由 `muse_voice.c` 那条采集循环交进来（`carpet_mic_feed()`），同一个任务、同一个读者。
+ * 2. **发帧不在采集任务里**。`esp_websocket_client_send_text` 最坏阻塞 2 秒，压在上面那
+ *    20 毫秒节拍上掉的是采到的声音。所以采集只管往 PSRAM 段里填，松手时把这一段交给
+ *    本文件自己的发送任务。
+ * 3. **闸是三道，不是一道**：本地开关（NVS `carpet/mic_mode`，**出厂默认 AUTO**，
+ *    屏上「声音」页那一格「对着屏说话」和串口 `>micup` 读写同一格）＋ 对面手机在
+ *    `ack.protocols` 里申报过 4 ＋ 这一轮没被判成"这台手机不收上行"。缺任何一道都不发。
+ *    默认为什么不是 OFF：owner 的硬约束是**演示现场不用电脑**，而这一格原来只有串口能改，
+ *    换板或清 NVS 就永久回到关、现场开不回来。AUTO 不放宽任何一道，所以默认开是安全的。
+ *    为什么要留第三道：万一装的那版 App **申报了 4 但解不了 `mic_chunk`**，
+ *    它的入站解码失败分支是 `conn.close(1000, "bad contract")` —— 一块乱发的固件会把一台
+ *    本来好使的手机当场踢下线，那比"屏不能说话"重得多。所以"发过上行后 5 秒内掉线"
+ *    就认定这台手机不收，本会话不再试（`>micup force` 或重启才清）。
+ *    第二道**只看 `ack.protocols`**：2026-11-13 真机称到 ack 外层没有 `v` 这个键
+ *    （App `encodeDefaults=false`，见 screen_link.h 里 SCREEN_LINK_MIC_UP 那段），
+ *    原来那条"还要 envelope v>=4"的判据永远不可能成立，已删。
+ *
+ * 为什么是"松手再发"而不是"边说边发"：转写那一步（硅基流动 SenseVoice，multipart 上传）
+ * 本来就要拿到整段才能开始，流式省不下端到端延迟；换来的是 `total` 在开口前就是已知的，
+ * 和 v3 下行**同一套拼装规则**，手机那边只留一套分块代码，也正好避开"服务端从没被这块屏
+ * 压过持续入站流量"那条未验证项。
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* 本地开关。默认 CARPET_MIC_AUTO —— 见上面第 3 条（现场不用电脑，所以不能默认关）。
+ * AUTO  = 只在对面申报过 4 的时候才上行（真机那一档，也是屏上那一格"开"对应的档）。
+ * FORCE = 不看申报，只要链路连着就发（台架：fake-phone.mjs 和彩排台走这一档验形状）。
+ *         **故意不上屏**：对着一台解不了 mic_chunk 的 App 硬发会被它 close(1000) 踢下线。
+ * OFF   = 永远不发，屏上这一路退回 Muse 原来那句话（屏上那一格"关"）。 */
+typedef enum {
+    CARPET_MIC_OFF = 0,
+    CARPET_MIC_AUTO,
+    CARPET_MIC_FORCE,
+} carpet_mic_mode_t;
+
+/* 出厂那一档。初值和"恢复出厂"共用这一个数，别处再写第二份就会漂。 */
+#define CARPET_MIC_FACTORY_MODE CARPET_MIC_AUTO
+
+/* 链路起起来时调一次（`carpet_link_start()`）。两只 256 KB 的段缓冲这时候要最便宜，
+ * 等手机把 PSRAM 切碎再来就要不到 —— 所以不在按下的那一刻现要。
+ * 要不到就把这一路判成永久不可用，日志打四个内存数。 */
+void carpet_mic_init(void);
+
+/* 这一次按下该不该由我们收。true = `muse_voice.c` 不许再走 Muse 云端那一路。
+ * 里面会顺手做一件事：NVS 里那一格**第一次走到这行代码时才读** —— `carpet_link_start()`
+ * 跑在 `muse_settings_init()` 之前，那时候 NVS 还没挂载（这条坑 carpet_diag.c 顶部记过：
+ * 第一版没绕，开机那两条诊断当场静默丢失）。按下永远晚于开机，所以读得到。 */
+bool carpet_mic_armed(void);
+/* 链路现在连着没有。给 `muse_voice.c` 那句"该说什么"用：连着手机的时候，
+ * Muse 原来那句 "SET UP MUSE FIRST"（要人装 Muse 官方 App）在这个产品里是一句假指令。 */
+bool carpet_mic_link_up(void);
+
+/* 点 Avatar 进对话（B §1 的唯一兜底，永远有效）：LVGL 任务里点脸那一格调 request 立记号，
+ * 采集任务下一拍 take 取走，和唤醒词命中走同一条 talk_to_phone。闸一道都不放宽
+ * （仍由 carpet_mic_armed() 判）。用记号而不是直接调，是因为采集只许 voice_task 一个读者。 */
+void carpet_mic_talk_request(void);
+bool carpet_mic_talk_take(void);
+
+
+/* 按下（已经过了"太短就不算说话"那道判据）：开始攒这一段。
+ * 返回 false = 两只段缓冲都还在发上一句，这一轮别采。 */
+bool carpet_mic_begin(void);
+
+/* 采集循环里交一个块进来（`muse_audio_read` 刚拿到的那 320 帧）。满了就封顶在 8 秒。 */
+void carpet_mic_feed(const int16_t *pcm, size_t frames);
+
+/* 那 8 秒换算成帧数：采集循环用它自己收尾。这一对数只在本文件定义一次，
+ * 免得 `muse_voice.c` 那边写死一个秒数、这里改上限时两边对不上。 */
+size_t carpet_mic_limit_frames(void);
+
+/* 这一段撞没撞到 8 秒上限。采集循环每圈问一次，到点自己停 —— 而不是把多出来的
+ * 声音交进来再从这里丢掉（那样屏上念的"录了几秒"和真送出去的对不上）。 */
+bool carpet_mic_full(void);
+
+/* 松手。send=true 就把这一段交给发送任务；false（太短、被判不可用）直接扔。
+ * 段缓冲什么时候还回来由发送任务说了算，这里不等它。 */
+void carpet_mic_end(bool send);
+
+/* 对面在 ack 里申报过 4 没有（carpet_link.c 的 on_ack 喂进来）。每次连上重算。 */
+void carpet_mic_phone_declared(bool has_v4);
+
+/* 链路断了（carpet_link.c 的 on_disconnected）。如果断就发生在我们发过上行之后，
+ * 就把这一台手机判成"不收上行"，本会话不再试 —— 这一条是给"装了老 App 的现场"兜底的。 */
+void carpet_mic_link_lost(void);
+
+/* 串口回读：`>mic`。也供 `>carpet` 那一行引用。 */
+void carpet_mic_dump(void);
+
+/* `>micup off|auto|force`：读和改本地开关，改完落 NVS。 */
+carpet_mic_mode_t carpet_mic_mode(void);
+void carpet_mic_set_mode(carpet_mic_mode_t mode);
+/* 台架口（`>micup default`）：只抹 NVS 里 mic_mode 这一个键，回到出厂那一档。
+ * 为什么需要它：验"出厂默认"必须让键真的不存在，而整片擦 NVS 会连带抹掉存过的
+ * Wi-Fi / link_url / stay_online —— 现场那台屏的 Wi-Fi 是 owner 存的，不能为验一个
+ * 默认值把它抹了。抹完 s_mode 直接落到出厂档，不必重启也读得对。 */
+void carpet_mic_factory_default(void);
+const char *carpet_mic_mode_name(void);
+
+/* 开发口 `>mictest [秒]`：本机自己造一段语音（和 `>audtest` 同一套正弦包络），
+ * 走 `begin/feed/end` 这同一条路，**不碰麦克风**，把"帧的形状"和"麦克风通路"分开证。
+ * 只在串口任务里调；它只负责喂，发在发送任务里，所以不占串口。 */
+void carpet_mic_bench(int seconds);

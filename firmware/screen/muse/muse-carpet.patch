+                    printf("@wifi set ssid=%s（%d 字节）pass=%d 字节（不印）wifi_on=1\n", sid, ns, np);
+                    printf("@wifi 下一次扫描就该连上：>url 看 wifi=1 ssid=…，>carpet 看 linked=1\n");

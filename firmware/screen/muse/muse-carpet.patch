+static esp_err_t init(void)
+{
+    const i2c_master_bus_config_t i2c_cfg = {
+        .i2c_port = I2C_NUM_0,
+        .sda_io_num = I2C_SDA,
+        .scl_io_num = I2C_SCL,
+        .clk_source = I2C_CLK_SRC_DEFAULT,
+        .glitch_ignore_cnt = 7,
+        .flags.enable_internal_pullup = true,
+    };
+    ESP_RETURN_ON_ERROR(i2c_new_master_bus(&i2c_cfg, &s_i2c), TAG, "i2c");
+
+    ESP_RETURN_ON_ERROR(muse_gpio_button_init(&s_boot, GPIO_NUM_0), TAG, "boot button");
+    /* BOOT is held at flashing time; don't count a held button as a press. */
+    s_boot.pressed = gpio_get_level(GPIO_NUM_0) == 0;
+
+    const gpio_config_t xsmt = {
+        .pin_bit_mask = 1ULL << DAC_XSMT,
+        .mode = GPIO_MODE_OUTPUT,
+    };
+    ESP_RETURN_ON_ERROR(gpio_config(&xsmt), TAG, "xsmt");
+    ESP_RETURN_ON_ERROR(gpio_set_level(DAC_XSMT, 1), TAG, "dac unmute");
+    return ESP_OK;
+}

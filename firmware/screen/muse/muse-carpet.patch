@@ -0,0 +1,72 @@
+# 车联（Screen-Link）覆盖层：叠在 devices/sdkconfig.muse-waveshare-s3-175 之后。
+#
+# 打开它就有的两件事：
+#   1. 上滑进车联页（muse_ui.c 里 CONFIG_MUSE_CARPET_CARDS 包住的那一格 tile）。
+#      中文字体不用在这儿写 —— Kconfig 里 MUSE_CARPET_CARDS 自己 select 了
+#      MUSE_CJK_FONT 和 MUSE_CJK_FONT_NOTO（910 KB flash 那份，覆盖 GB2312 的 6763 字）。
+#   2. Screen-Link 的接入点 —— 手机是服务端，下面这几个值现场一定要能改。
+#
+# 整层不叠（构建参数里没有 devices/sdkconfig.carpet）出来的东西和上游一致，
+# 我们的改动一行都不进二进制。
+
+CONFIG_MUSE_CARPET_CARDS=y
+
+# 设置页、按钮菜单和配对卡片的中文（MUSE_UI_LANG_ZH 只有叠了上面那条才选得上，
+# 因为只有那条把 910 KB 那份中文字体弄进镜像）。
+#   词表在 components/muse/carpet/carpet_lang_zh.c，不在 muse_lang.c：
+#   上游那条 host 测试 tests/test_muse_lang.py 只认 muse_lang.c 里它自己的三张表，
+#   还拿越南语和带音标的拉丁字体去对每个字形 —— 那两份字体里没有汉字。
+#   字体只有 16 px 这一档，所以这一页凡是带汉字的标签都降到 16 px（标题那档
+#   unscii 直接换掉）；车联页那 24/20 px 是另一份 tiny_ttf 子集，不通用。
+# 想要英文就把这行删了或改成 # ... is not set：查表原样返回英文，和上游一致。
+CONFIG_MUSE_UI_LANG_ZH=y
+
+# 截图验收用的：串口里按 `p`（tools/muse/snap.py）把当前屏打成 base64 的 RGB565。
+# 中文这层是**看图才能定**的——有没有豆腐块、哪条被省略号截了，编译过说明不了。
+# 代价照 sdkconfig.muse-bench 那句说的：不到 1KB 代码，加上截那一张时要一份和屏
+# 同大小的缓冲（466x466 的 RGB565 约 434 KB，截完就还）。和 bench 那份是同一个开关。
+CONFIG_LV_USE_SNAPSHOT=y
+
+# 车联页的字不能停在 16 px：Muse 那份中文是位图字体，只有这一档，字号改不动，
+# 隔着两米读不了。这一页自己带一份 90~120KB 的 TTF 子集（carpet/carpet_font.ttf，
+# 仓库 tools/muse_font_subset.py 造的），由 LVGL 的 tiny_ttf 现算 24/20 px。
+CONFIG_LV_USE_TINY_TTF=y
+CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=64
+# 这一条不是性能调优，是压 bug：LVGL 9.4 的 tiny_ttf 在字模缓存和字距缓存之间
+# 串了释放路径，缓存一轮换就画坏字（另一台机器实拍踩过的）。关掉字距缓存就不撞。
+# 删掉这一行的代价是屏上出现半截笔画，别试。
+CONFIG_LV_TINY_TTF_CACHE_KERNING_CNT=0
+
+# 手机开热点时它自己是 192.168.43.1；连同一个路由器时改成分给手机的地址。
+# 端口固定 8443，而且是明文 ws —— 写成 wss 连不上。
+CONFIG_SCREEN_LINK_URL="ws://192.168.43.1:8443"
+# 必须和 App 白名单里那条一致，不在白名单 App 直接 close(1000, "unknown screen")。
+CONFIG_SCREEN_LINK_ID="WS175B-A3F7"
+CONFIG_SCREEN_LINK_FW="muse-0.1.0"
+CONFIG_SCREEN_LINK_DOCK_TYPE="desk_stand"
+
+# ── 唤醒词（免按键对着屏说话）─────────────────────────────────────────────
+# 只用 WakeNet：不做降噪、不做命令词识别。下面这组数是 2026-11-12 在**这块板上**
+# 刷了带唤醒词的固件之后实读的（不是探针推的）：
+#   app 镜像 3,346,432 B（0x331000），4M 槽余 847,872 B（828 KB，20%）
+#   srmodels.bin 291,068 B，只含下面选的那一个模型
+#   create() 34.0 ms；内部 free 204263→183135（吃 21,128 B）、
+#     最大连续块 131072→98304；PSRAM free 4652844→4329980（吃 322,864 B）
+#   detect() 一块 512 样本 = 32 ms，平均 2.74 ms、最坏 4.61 ms（约 8.6% 一个核）
+#   带上引擎之后的稳态心跳：int=43K/29K min=32K（关 BLE 之前是 int=16K/8K min=6K）
+# 内部 RAM 是靠 app.c 里 carpet 构建跳过 BLE 启动腾出来的（int 16K/8K → 73K/56K）。
+# 探针那份更大的数（21,140 B / 3.63 ms / 11%）量的是 wn9_nihaoxiaozhi_tts，
+# 它的 _MODEL_INFO_ 是 wakenet9**l** —— 重的那一档，只能当上限看。
+#
+# 模型从 flash 里 mmap，不占 RAM；分区就叫 model，见 partitions_muse.csv 尾巴。
+CONFIG_MODEL_IN_FLASH=y
+# 唤醒词本身。换词只改这一行 + 重新 flash（srmodels.bin 会跟着重打）。
+# 选「你好小安」的理由：开车场景里「安」字顺耳。**这个词的权利归属没查过**，
+# 是留给 owner 拍的一项（esp-sr README 顶上那条：商用前必须确认自己是权利人或拿到授权）。
+# 它是 wakenet9_tts2h12（轻档），四个候选里唯一一份 _MODEL_INFO_ 写拼音的，
+# 所以 carpet_wake.c 里有一行把 nihaoxiaoan 译回中文给屏上用。
+# 备选（每个约 291 KB；注意**后两个**是 wakenet9**l**，CPU/内存约 1.3 倍）：
+#   CONFIG_SR_WN_WN9_NIHAODONGDONG_TTS2 你好东东（wakenet9，轻档，和上面同一档开销）
+#   CONFIG_SR_WN_WN9_NIHAOXIAOYI_TTS2   你好小益（wakenet9l，重档）
+#   CONFIG_SR_WN_WN9_NIHAOXIAOZHI       你好小智（wakenet9l，重档；Espressif 演示词）
+CONFIG_SR_WN_WN9_NIHAOXIAOAN_TTS2=y

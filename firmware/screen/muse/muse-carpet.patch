+        case MUSE_EMO_EXCITED:
+            style = EYES_WIDE; mouth = MOUTH_GRIN; brow = 2; blush_emo = 0.30f; break;
+        case MUSE_EMO_SAD:
+            mouth = MOUTH_FROWN; open *= 0.85f; brow = 3; blush_emo = -0.25f; break;
+        case MUSE_EMO_WORRIED:
+            mouth = MOUTH_HMM; open *= 0.90f; brow = 3; blush_emo = -0.10f; break;
+        case MUSE_EMO_SLEEPY:
+            mouth = MOUTH_HMM; open *= 0.45f; blush_emo = -0.10f; break;
+        case MUSE_EMO_THINKING:
+            mouth = MOUTH_HMM; open *= 0.85f; brow = 1; break;
+        default:
+            break;
+        }
+    }
+
     draw_eye(j.fx - eye_dx, eye_y, open, style, s_eyes.gx, s_eyes.gy);
     draw_eye(j.fx + eye_dx, eye_y, open, style, s_eyes.gx, s_eyes.gy);
 
     /* Tiny brows for the expressive states. */
     int bl = iround(j.fx - eye_dx), br = iround(j.fx + eye_dx), by = iround(eye_y) - 4;
-    if (mode == MUSE_MODE_THINKING) {
+    if (brow == 1) {
         px(bl - 1, by + 1, C_BROW); px(bl, by + 1, C_BROW);
         px(br - 1, by, C_BROW); px(br, by - 1, C_BROW);
-    } else if (mode == MUSE_MODE_LISTENING) {
+    } else if (brow == 2) {
         px(bl - 1, by - 1, C_BROW); px(bl, by - 1, C_BROW);
         px(br - 1, by - 1, C_BROW); px(br, by - 1, C_BROW);
+    } else if (brow == 3) {
+        px(bl - 1, by, C_BROW); px(bl, by - 1, C_BROW);
+        px(br - 1, by - 1, C_BROW); px(br, by, C_BROW);
     }
 
-    float blush = 0.55f + happy * 0.45f + (mode == MUSE_MODE_SPEAKING ? 0.15f : 0.0f);
+    float blush = clampf(0.55f + happy * 0.45f + (mode == MUSE_MODE_SPEAKING ? 0.15f : 0.0f)
+                         + blush_emo, 0.0f, 1.0f);
     draw_blush(iround(j.fx - j.fa * 0.72f), iround(eye_y + 2), blush);
     draw_blush(iround(j.fx + j.fa * 0.72f), iround(eye_y + 2), blush);
 
     draw_mouth(iround(j.fx), iround(eye_y + 3), mouth, mouth_open);
 
+    /* 场景换装道具：压在躯干/脸之上、状态特效（火花/声波/担心）之下。 */
+    draw_costume(&j, t, fade);
+

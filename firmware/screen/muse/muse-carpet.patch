+#pragma once
+
+/*
+ * The Simplified-Chinese strings the touch boards' settings pages draw
+ * (muse_settings_ui.c), selected by CONFIG_MUSE_UI_LANG_ZH.
+ *
+ * It lives here, in carpet/, rather than as another table in muse_lang.c, for
+ * one reason: esp32/tests/test_muse_lang.py reads muse_lang.c and expects to
+ * find exactly its own STATUS/MESSAGES/MENU, then checks every letter of every
+ * translation against the Vietnamese and accented-Latin fonts. Chinese glyphs
+ * are in neither, and a second MENU[] would quietly replace the first in that
+ * test's dictionary - so putting hanzi in muse_lang.c would break a host test
+ * we don't run and stop the Vietnamese table being tested at all. muse_lang.c
+ * only gets the hook: muse_lang_menu() calls this on ZH builds.
+ *
+ * Same contract as muse_lang.h: the code says English, this returns its Chinese
+ * or the same pointer back. A miss is English, never a guess.
+ */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The Chinese of `en`, or `en`. */
+const char *carpet_lang_zh(const char *en);
+
+/* Entries in the table, and how many of them this run has drawn. The count is
+ * a development check only (`>zh`): a label whose English got reworded stops
+ * matching in silence, and a page that kept an English row looks fine until
+ * you ask which keys were never hit. */
+int carpet_lang_zh_entries(void);
+int carpet_lang_zh_hits(void);
+
+/* Every table key this run has never drawn, one per line, then @zh done=<hit>
+ * /<total>. A key here is either a row the page never showed (the Sound page's
+ * notes, an unreachable state) or an English string that drifted from the
+ * table - the second kind is the one to chase. */
+void carpet_lang_zh_dump(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/esp32/components/muse/carpet/carpet_link.c b/esp32/components/muse/carpet/carpet_link.c
new file mode 100644
index 0000000..9798062
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_link.c
@@ -0,0 +1,1268 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0

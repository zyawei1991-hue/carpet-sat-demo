 #include "muse_state.h"
 #include "muse_text.h"
 #include "muse_wifi.h"
@@ -133,7 +136,24 @@ bool muse_ui_face_active(void)
     return s_face_active;
 }
 static lv_obj_t *s_settings;
-static lv_obj_t *s_dots[2];
+#if CONFIG_MUSE_CARPET_CARDS
+static lv_obj_t *s_carpet;        /* the tile at row 1: below the face, reached by swiping up */
+#define DOT_COUNT 3
+#else
+#define DOT_COUNT 2

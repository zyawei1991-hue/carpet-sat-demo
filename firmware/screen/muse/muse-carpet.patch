diff --git a/esp32/components/muse/muse_input.c b/esp32/components/muse/muse_input.c
index 7c579bb..7574168 100644
--- a/esp32/components/muse/muse_input.c
+++ b/esp32/components/muse/muse_input.c
@@ -48,6 +48,26 @@
 #include "muse_ui.h"
 #include "muse_voice.h"
 #include "muse_wifi.h"
+#if CONFIG_MUSE_CARPET_CARDS
+#include "carpet/carpet_link.h"
+#include "carpet/carpet_mic.h"
+#include "carpet/carpet_page.h"
+#include "carpet/carpet_diag.h"
+#include "carpet/carpet_wake.h"
+#if CONFIG_MUSE_UI_LANG_ZH
+#include "carpet/carpet_lang_zh.h"
+#endif
+#endif
+/* 断电验尸（carpet_diag.h 顶部）。症状见 HANDOFF §15.11：电池 + 熄屏放几分钟，回来是**整机断过电**
+ * —— 串口日志和 RAM 计数全没了，`>nap` 那套仪器在这一趟上失效。所以每个可疑转折点当场落一条 NVS，
+ * 断电也留得住。carpet 之外的构建里这两个宏是空话，一行行为都不改。 */
+#if CONFIG_MUSE_CARPET_CARDS
+#define CARPET_DIAG(tag) carpet_diag_event(tag)
+#define CARPET_DIAG_TICK(now, low) carpet_diag_tick((now), (low))
+#else
+#define CARPET_DIAG(tag) do {} while (0)
+#define CARPET_DIAG_TICK(now, low) do {} while (0)
+#endif
 #if CONFIG_MUSE_VIDEO
 #include "muse_video.h"
 #endif
@@ -140,6 +160,9 @@ static bool update_power(void);
 
 static void power_off(void)
 {
+    /* 落在这之前的最后一条，就是"它自己按了关机"。这一条要放在最顶上、
+     * 连 `!muse_board->power_off` 那个 return 之前——那条路径是物理开关，同样会断电。 */
+    CARPET_DIAG("OFF!");
     if (!muse_board->power_off) {
         return;   /* a physical switch powers it off */
     }
@@ -170,6 +193,9 @@ static void set_asleep(bool asleep, const char *why)
 {
     if (asleep != muse_state_asleep()) {

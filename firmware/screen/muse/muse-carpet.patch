+    /* 上行这一路现在到底开没开、开在哪一道闸上、发过几帧、最后一次的错。
+     * 站在屏前按住那个键是看不出来的：那三种"没反应"（开关关着 / 对面没申报 / 被熔断判死）
+     * 屏上画的是一模一样的字。 */
+    if (!strcmp(line, "mic")) {
+        carpet_mic_dump();
+        fflush(stdout);
+        return true;
+    }
+#if CONFIG_MUSE_BOARD_SPOTPEAR_S3_18
+    /* 新板麦克风全零的判别探针：数 SD/BCLK/WS 三根线的翻转，再倒 32 位 DMA 原字。
+     * SD 不动而时钟在动 ⇒ 麦克风没在驱动（硬件/使能问题）；SD 在动 ⇒ 采集格式问题。 */
+    if (!strcmp(line, "micraw")) {
+        extern void spotpear_micraw(void);
+        spotpear_micraw();
+        fflush(stdout);
+        return true;
+    }
+    if (!strcmp(line, "micen")) {
+        extern void spotpear_micen(void);
+        spotpear_micen();
+        fflush(stdout);
+        return true;
+    }
+#endif
+    /* 唤醒词：`>wake` 回读，`>wake on|off` 改（和设置页「声音」那一格同一个 NVS key）。
+     * 为什么串口也要有一条：这一路"没反应"分四种，屏上画的字一模一样 ——
+     * 模型没起来(ready=0) / 设置在关(on=0) / 屏正在念(live=1) / 闸没开(armed=0)。
+     * 这一句把四个数一起打出来，现场不用猜。blocks= 在涨才说明麦克风真喂进来了。 */
+    if (!strncmp(line, "wake", 4) && (line[4] == '\0' || line[4] == ' ')) {
+        const char *rest = line + 4;
+        while (*rest == ' ') rest++;
+        if (!strcmp(rest, "on")) {
+            muse_settings_set_wake_on(true);
+        } else if (!strcmp(rest, "off")) {
+            muse_settings_set_wake_on(false);
+        } else if (*rest) {
+            printf("@wake 只认 on / off（不带参数=回读）\n");
+            fflush(stdout);
+            return true;
+        }
+        carpet_wake_dump();
+        return true;
+    }
+    /* 本机造一段语音走 begin/feed/end 那同一条上行路（不碰麦克风、不碰真按下），
+     * 为的是把"帧的形状和发送任务"和"采集通路"分开证。fake-phone.mjs 那边看得见几帧、
+     * 拼出来多少字节、能不能还原成一段能听的 WAV。 */
+    if (!strncmp(line, "mictest", 7) && (line[7] == '\0' || line[7] == ' ')) {
+        carpet_mic_bench(line[7] == ' ' ? atoi(line + 8) : 2);
+        return true;
+    }
+    /* 本机造一帧"到点的养护"，称 #73 那三条让路和那枚琥珀点：`>maint` 是 worried，
+     * `>maint off` 是中性（少了这一条就退不回 IDLE，脸会一直"想"着）。
+     * 和 `>audtest` 同一个道理：不联网、不接模型，这块板在哪都能称。 */
+    if (!strncmp(line, "maint", 5) && (line[5] == '\0' || line[5] == ' ')) {
+        const char *rest = line + 5;
+        while (*rest == ' ') rest++;
+        carpet_link_bench_maint(strcmp(rest, "off") != 0);
+        return true;
+    }
+    /* `>emo <name>`：本机造一帧情绪，称 P2 那条"情绪上脸"——走链路同一条 on_state()。
+     * name 用契约英文键：neutral/happy/excited/sad/worried/sleepy/thinking。脸停 IDLE 才看得清。
+     * 和 >maint 一个道理：不联网、不接模型，这块板在哪都能称。 */
+    if (!strncmp(line, "emo", 3) && (line[3] == '\0' || line[3] == ' ')) {
+        const char *rest = line + 3;
+        while (*rest == ' ') rest++;
+        carpet_link_bench_emotion(rest);
+        return true;
+    }
+    /* B §1 守护灯点的台架口。`>event <kind>` 本机造一条守护事件帧，走链路同一条
+     * on_event()（不联网也能称：灯亮、点 Avatar 念那句、念完自动进对话）；
+     * `>event` 回读未读；`>event clear` 清空。
+     * kind：sos_triggered / sos_acked / sos_failed / sos_cancelled /
+     * fence_enter / fence_exit / sentinel_motion / downlink_msg。 */
+    if (!strncmp(line, "event", 5) && (line[5] == '\0' || line[5] == ' ')) {
+        const char *rest = line + 5;
+        while (*rest == ' ') rest++;
+        if (!*rest) {
+            carpet_link_event_dump();
+        } else if (!strcmp(rest, "clear")) {
+            carpet_link_event_clear();
+            carpet_link_event_dump();
+        } else {
+            carpet_link_bench_event(rest);
+            carpet_link_event_dump();
+        }
+        return true;
+    }
+    /* 本机造一次触摸，走和真手指同一条手势判定路（契约那四条：左右滑切卡、
+     * 上下滑定开/定关明细、长按交回、单击戳一下）。为什么串口要有这一条：
+     * 真玻璃上"划了没反应"分不清是采点没采到、阈值没过、还是链路没通 ——
+     * 这一句把判定那一半单独称出来，日志里 dx/dy/held/判为哪一条都在。 */
+    if (!strncmp(line, "gest", 4) && (line[4] == '\0' || line[4] == ' ')) {
+        const char *rest = line + 4;
+        while (*rest == ' ') rest++;
+        if (!strcmp(rest, "left"))       carpet_page_gesture_bench(-80, 0, 120);
+        else if (!strcmp(rest, "right")) carpet_page_gesture_bench(80, 0, 120);
+        else if (!strcmp(rest, "up"))    carpet_page_gesture_bench(0, -80, 120);
+        else if (!strcmp(rest, "down"))  carpet_page_gesture_bench(0, 80, 120);
+        else if (!strcmp(rest, "tap"))   carpet_page_gesture_bench(0, 0, 120);
+        else if (!strcmp(rest, "hold"))  carpet_page_gesture_bench(0, 0, 900);
+        else {
+            printf("@gest 只认 left / right / up / down / tap / hold\n");
+            fflush(stdout);
+            return true;
+        }
+        fflush(stdout);
+        return true;
+    }
+    /* `>gestfrom <dir>`：和 >gest 同一条判定路，但不先回脸——从当前格起判。
+     * 称「外页划动回中心」（owner 2026-11-14）：先 >gestfrom 到外页，再 >gestfrom 划一下。 */
+    if (!strncmp(line, "gestfrom", 8) && (line[8] == '\0' || line[8] == ' ')) {
+        const char *rest = line + 8;
+        while (*rest == ' ') rest++;
+        if (!strcmp(rest, "left"))       carpet_page_gesture_bench_from(-80, 0, 120);
+        else if (!strcmp(rest, "right")) carpet_page_gesture_bench_from(80, 0, 120);
+        else if (!strcmp(rest, "up"))    carpet_page_gesture_bench_from(0, -80, 120);
+        else if (!strcmp(rest, "down"))  carpet_page_gesture_bench_from(0, 80, 120);
+        else if (!strcmp(rest, "tap"))   carpet_page_gesture_bench_from(0, 0, 120);
+        else {
+            printf("@gestfrom 只认 left / right / up / down / tap（从当前格判，不回脸）\n");
+            fflush(stdout);
+            return true;
+        }
+        fflush(stdout);
+        return true;
+    }
+    /* `>touch`：回读真触摸 indev 解析没解析出来、类型/模式/state/point，外加手势互斥闸。
+     * 真玻璃「划了没反应」时，先用这一条把"真路径有没有入口"和台架判定分开：
+     * pointer=NONE 就是真触摸根本没接上（台架照样能划，所以光称 >gest 看不出来）。 */
+    if (!strncmp(line, "touch", 5) && (line[5] == '\0' || line[5] == ' ')) {
+        carpet_page_touch_dump();
+        return true;
+    }
+    /* `>scene=<n>`：选定第 n 个场景（1 车 / 2 亲子 / 3 对话）+ 头像换装 + 回脸，
+     * 和点一张场景卡同一条路。为的是把 B §3 的换装调色单独截图证。 */
+    if (!strncmp(line, "scene=", 6)) {
+        int n = (line[6] >= '1' && line[6] <= '3' && !line[7]) ? line[6] - '0' : 0;
+        if (n) {
+            carpet_page_scene_bench(n);
+        } else {
+            printf("@scene 只认 1 / 2 / 3（车 / 亲子 / 对话）\n");
+            fflush(stdout);
+        }
+        return true;
+    }
+    /* `>amb`：回读右滑氛围的默认页；`>amb clock|photo` 改它（B §5，和设置页「默认氛围用相册」
+     * 那一格同一个 NVS key album_def）。串口注不了设置页的点击，用这一条设好默认页再 >gest right 截图证。 */
+    if (!strncmp(line, "amb", 3) && (line[3] == '\0' || line[3] == ' ')) {
+        const char *arg = line + 3;
+        while (*arg == ' ') arg++;
+        if (!strcmp(arg, "clock"))      muse_settings_set_album_default(false);
+        else if (!strcmp(arg, "photo")) muse_settings_set_album_default(true);
+        else if (arg[0]) {
+            printf("@amb 只认 clock / photo\n");
+            fflush(stdout);
+            return true;
+        }
+        printf("@amb default=%s\n", muse_settings_album_default() ? "photo" : "clock");
+        fflush(stdout);
+        return true;
+    }
+    /* `>burnin`：回读烧屏防护那两个数 —— 像素位移挪了几次/现在偏多少，亮度封没封住。
+     * 串口证不了"屏真的挪了 3px"（截图差 3px 肉眼难辨），所以给一条可累计的回读：
+     * 隔 30s 再读一次 moves 该涨、dx/dy 该在 8 位环上走；set>cap 时 applied 必须=cap。 */
+    if (!strncmp(line, "burnin", 6) && (line[6] == '\0' || line[6] == ' ')) {
+        muse_ui_burnin_dump();
+        return true;
+    }
+    /* `>bright [pct]`：把亮度档存进 NVS（走屏上滑条同一个 API），只为称烧屏封顶 ——
+     * 存 100 再 >burnin，applied 必须被压到 cap。不带参数=回读当前档。 */
+    if (!strncmp(line, "bright", 6) && (line[6] == '\0' || line[6] == ' ')) {
+        const char *rest = line + 6;
+        while (*rest == ' ') rest++;
+        if (*rest) muse_settings_set_brightness(atoi(rest));
+        printf("@bright set=%d（封顶在 update_sleep 里压，>burnin 看 applied）\n",
+               muse_settings_brightness());
+        fflush(stdout);
+        return true;
+    }
+    /* 接入点地址：不带参数=回读现在拨的是哪条、来源是 NVS 还是出厂；
+     * 带一条 ws://…=存进 NVS 并**立刻重拨**；`clear`=抹掉那一格、回到出厂那条。
+     * 为什么给串口这一条：1.75 寸圆屏上用屏上键盘敲一个 IP 是罚人 —— 现场接电脑的时候
+     * 就用这一条，没电脑的时候才用设置页那一格（两条存的是同一个 NVS key，不是两套状态）。
+     * `esp_err_to_name` 要说清"为什么没存进去"：以 ws:// 开头、不带空格、不超 63 字节。 */
+    if (!strncmp(line, "url", 3) && (line[3] == '\0' || line[3] == ' ')) {
+        const char *rest = line + 3;
+        while (*rest == ' ') rest++;
+        if (!*rest) {
+            carpet_link_url_dump();
+            return true;
+        }
+        bool clear = !strcmp(rest, "clear") || !strcmp(rest, "\"\"");
+        esp_err_t err = carpet_link_set_url(clear ? "" : rest);
+        printf("@url %s: %s\n", clear ? "clear" : "set", esp_err_to_name(err));
+        carpet_link_url_dump();
+        return true;
+    }
+    /* 熄屏后要不要保持联网 —— 和设置页「自动熄屏」那一格是同一个 NVS key，不是两套状态。
+     * 为什么也给串口一条：这一条只在**电池**上看得见差别，而那会儿通常没有串口可看，
+     * 所以现场要么在电脑前提前把它定下来，要么事后拿这一句证明当时是开着的。
+     * nap=1 = 这会儿真的离开 Wi-Fi 了；插着 USB 它永远是 0（update_wifi_nap 的 paused
+     * 要求 on_battery），别拿"nap=0"当这一条生效的证据。
+     * naps= / drops= 是**自上次开机**的两个累计数（只在 RAM 里）：拔了 USB 板子也不掉电，
+     * 所以电池那一趟发生的都记着，插回来读这一句就能复盘 —— 这一条是专门补"电脑 ping 不通屏"
+     * 那个废判据的（HANDOFF §15.6）。电池那一趟要的证据是 naps=0 且 drops=0。 */
+    if (!strncmp(line, "stay", 4) && (line[4] == '\0' || line[4] == ' ')) {
+        const char *rest = line + 4;
+        while (*rest == ' ') rest++;
+        if (!strcmp(rest, "on")) {
+            muse_settings_set_stay_online(true);
+        } else if (!strcmp(rest, "off")) {
+            muse_settings_set_stay_online(false);
+        } else if (*rest) {
+            printf("@stay 只认 on / off（不带参数=回读）\n");
+            fflush(stdout);
+            return true;
+        }
+        printf("@stay on=%d nap=%d naps=%lu drops=%lu wifi=%d\n", (int)muse_settings_stay_online(),
+               (int)s_napping, (unsigned long)s_nap_events, (unsigned long)s_wifi_drops,
+               (int)muse_wifi_connected());
+        fflush(stdout);
+        return true;
+    }
+    /* 中文表自检：把这张表里**从没画过**的键逐条打出来，最后报画过几条/共几条。
+     * 截图只看得见他画出来的那些，这一条看的是剩下的 —— 英文原文被改了个词、表却没跟着改，
+     * 屏上只是那一行退回英文，看着像"还剩几行没翻译"，只有这条能把它指出来。
+     * 没开 CONFIG_MUSE_UI_LANG_ZH 时它什么也不做，只说一声。 */
+    if (!strcmp(line, "zh")) {
+#if CONFIG_MUSE_CARPET_CARDS && CONFIG_MUSE_UI_LANG_ZH
+        carpet_lang_zh_dump();
+#else
+        printf("@zh CONFIG_MUSE_UI_LANG_ZH is off\n");
+        fflush(stdout);
+#endif
+        return true;
+    }
+    /* 把屏上存过的那几个网络抹干净（NVS 里 ssid/password/那一串列表一起抹）。
+     * 有了 #R2 那条优先级倒置，这是**不重刷就退回编译期那条 SSID** 的唯一口：
+     * 抹掉之后 NVS 是空的，出厂那条才重新作数。链路和 Wi-Fi 都要重启一次才看得出来，
+     * 所以这里只把话说明白，不替人 reboot。密码不印。 */
+    if (!strncmp(line, "wifi", 4) && line[4] == ' ') {
+        const char *rest = line + 5;
+        while (*rest == ' ') rest++;
+        if (!strcmp(rest, "clear")) {
+            char ssid[MUSE_SSID_MAX + 1], pass[MUSE_PASS_MAX + 1];
+            muse_settings_wifi(ssid, pass);
+            printf("@wifi was ssid=%s\n", ssid[0] ? ssid : "(none)");
+            muse_settings_set_wifi("", "");
+            printf("@wifi cleared the saved networks; reboot to fall back to CONFIG_HOMEHUB_WIFI_SSID\n");
+        } else if (!strncmp(rest, "set", 3) && (rest[3] == ' ' || rest[3] == '\0')) {
+            /* 存一个网络进 NVS（走的就是屏上那套 Wi-Fi 键盘同一个 API，不新造通路）。
+             * 为什么现在需要这一条：上行音频要称"屏 → 服务端那一趟"，服务端在这台电脑上
+             * （假手机 fake-phone.mjs），可这台电脑此刻只连得到一个网络，屏的 NVS 里存的是
+             * 另一台手机的热点。屏上那个键盘点不动中文 SSID，所以剩下的口只有这一条。
+             * 第二段写 `-` = 开放网络。改完不必重启：muse_settings_set_wifi 自己 notify，
+             * wifi 那一头下一次扫描就会去连。 */
+            char ha[2 * MUSE_SSID_MAX + 1], hp[2 * MUSE_PASS_MAX + 1];
+            ha[0] = hp[0] = '\0';
+            if (sscanf(rest + 3, "%64s %129s", ha, hp) < 2 || !ha[0] || !hp[0]) {
+                printf("@wifi usage: >wifi set <ssid-hex> <pass-hex>   开放网络第二段写 -\n");
+                printf("@wifi   ssid-hex 最多 %d 字，pass-hex 最多 %d 字\n", MUSE_SSID_MAX, MUSE_PASS_MAX);
+            } else {
+                char sid[MUSE_SSID_MAX + 1], pw[MUSE_PASS_MAX + 1];
+                int ns = hex_bytes(ha, sid, sizeof(sid));
+                int np = !strcmp(hp, "-") ? (pw[0] = '\0', 0) : hex_bytes(hp, pw, sizeof(pw));
+                if (ns < 0 || np < 0) {
+                    printf("@wifi 不是合法十六进制（ssid=%d pass=%d；-1=有非 hex 字符 -2=太长）\n", ns, np);
+                } else if (!ns) {
+                    printf("@wifi ssid 是空的，不存（要抹掉存过的网络用 >wifi clear）\n");
+                } else {
+                    if (!muse_settings_wifi_on()) muse_settings_set_wifi_on(true);
+                    muse_settings_set_wifi(sid, pw);
+                    printf("@wifi set ssid=%s（%d 字节）pass=%d 字节（不印）wifi_on=1\n", sid, ns, np);
+                    printf("@wifi 下一次扫描就该连上：>url 看 wifi=1 ssid=…，>carpet 看 linked=1\n");
+                }
+            }
+        } else {
+            printf("@wifi usage: >wifi clear | >wifi set <ssid-hex> <pass-hex>（开放网络 pass 段写 -）\n");
+        }
+        fflush(stdout);
+        return true;
+    }
+    /* 断电验尸：把 NVS 里那一圈记录从最旧到最新打出来（carpet_diag.c）。
+     * 为什么不能用 `>stay` / `>power` 代替：那两台仪器都在 RAM 里，而 §15.11 那一趟是**整机断电**，
+     * 插回来时它们已经归零了（`@power.saved` 还是断电前那一份，正是归零的证据）。
+     * 每一行都带 PMU 原始寄存器：off=<0x21>「上一次是谁关的电」、kl=<开机时锁存的按键>、
+     * cfg/pen = 那两条按键关机使能。b=开机 e=转折 t=低功耗兜底。 */
+    if (!strncmp(line, "diag", 4) && (line[4] == '\0' || line[4] == ' ')) {
+        const char *rest = line + 4;
+        while (*rest == ' ') rest++;
+        if (!strcmp(rest, "clear")) {
+            carpet_diag_clear();
+        } else if (*rest) {
+            printf("@diag 只认 clear（不带参数=回读）\n");
+            fflush(stdout);
+        } else {
+            carpet_diag_dump();
+        }
+        return true;
+    }
+#endif
     bool reset = !strcmp(line, "power.reset");
     if (reset || !strcmp(line, "power")) {
         if (reset) {
@@ -926,6 +1426,12 @@ static bool console_command(char *line, bool whole)
         muse_ui_bench_page(!strcmp(line, "ui=settings"));
         return true;
     }
+#if CONFIG_MUSE_CARPET_CARDS
+    if (!strcmp(line, "ui=carpet")) {
+        muse_ui_bench_carpet();
+        return true;
+    }
+#endif
     if (!strncmp(line, "ui.settings=", 12)) {
         if (muse_settings_ui_bench_open(line + 12)) {
             muse_ui_bench_page(true);
@@ -1028,3 +1534,8 @@ void muse_input_request_power_off(void)
 {
     s_power_off_requested = true;
 }
+
+void muse_input_wake(const char *why)
+{
+    set_asleep(false, why ? why : "remote");
+}

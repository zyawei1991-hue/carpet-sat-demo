@@ -170,6 +193,9 @@ static void set_asleep(bool asleep, const char *why)
 {
     if (asleep != muse_state_asleep()) {
         ESP_LOGI(TAG, "%s (%s)", asleep ? "sleeping" : "waking", why);
+        /* 熄屏那一刻是这一趟的分界线：断电只在它之后发生。why（power button / serial /

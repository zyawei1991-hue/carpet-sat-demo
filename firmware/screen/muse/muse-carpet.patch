+/* ---------------------------------------------------------------------------
+ * 场景换装道具（owner 2026-11-13：不只是调色，要看得见道具）
+ *   车·守护   = 坐进一辆红色小车（车系安全带）
+ *   家·亲子   = 左爪抱玩偶 + 右旁一架滑滑梯
+ *   对话·分身 = 绒毛躯干穿正装（外套 + 白衬衫 V + 领带）
+ * 全锚在 avatar_t 几何上，随 s_costume_pop 用 ordered-dither 浮现、道具再下滑入位
+ * （≈0.4 s，配合 B §3 那段换装）。脸 C_SKIN* 一律不动 —— 强调「还是它换了装扮」。
+ * ------------------------------------------------------------------------- */
+
+static inline void cpx(int x, int y, uint8_t c, float ca)
+{
+    if (bayer(x, y) < ca) px(x, y, c);
+}
+
+static void c_disc(float cx, float cy, float r, uint8_t col, float ca)
+{
+    float r2 = r * r;
+    for (int y = iround(cy - r); y <= iround(cy + r); y++) {
+        for (int x = iround(cx - r); x <= iround(cx + r); x++) {
+            float dx = x + 0.5f - cx, dy = y + 0.5f - cy;
+            if (dx * dx + dy * dy <= r2) cpx(x, y, col, ca);
+        }
+    }
+}
+
+static void c_ellipse(float cx, float cy, float rx, float ry, uint8_t col, float ca)
+{
+    for (int y = iround(cy - ry); y <= iround(cy + ry); y++) {
+        for (int x = iround(cx - rx); x <= iround(cx + rx); x++) {
+            float dx = (x + 0.5f - cx) / rx, dy = (y + 0.5f - cy) / ry;
+            if (dx * dx + dy * dy <= 1.0f) cpx(x, y, col, ca);
+        }
+    }
+}
+
+/* 车载：avatar 坐进一辆红色小车（正面视角）——头露在挡风玻璃上方，浅蓝挡风玻璃 + 暗红框 + 反光，
+ * 宽而平的红车身裹住下半身、比 avatar 宽，底下两只大轮子、前面两只灯 + 格栅 + 保险杠，两爪搭在车沿；
+ * 安全带斜挎胸前透过玻璃可见。owner：「小红车太抽象，能让他坐在小红车里吗」。 */
+static void draw_vehicle(const avatar_t *j, float ca, int slide)
+{
+    int cx = iround(j->cx);
+    int rim = iround(j->cy + j->b * 0.44f) + slide;   /* 车沿（腰际），上半身露在这上方 */
+    int bot = rim + 13;                                /* 车底 */
+    int mid = rim + 6;                                 /* 最宽处 */
+
+    /* 轮子先画（车底两角），比车身宽、露出下半，带亮轮毂。 */
+    c_disc((float)(cx - 16), (float)bot, 3.2f, C_WHEEL, ca);
+    c_disc((float)(cx + 16), (float)bot, 3.2f, C_WHEEL, ca);
+    c_disc((float)(cx - 16), (float)bot, 1.3f, C_WHEEL2, ca);
+    c_disc((float)(cx + 16), (float)bot, 1.3f, C_WHEEL2, ca);
+
+    /* 红车身：口沿略收、中段最宽、底部平收（不收成蛋尖）；左右 + 底描暗红边。 */
+    for (int y = rim; y <= bot; y++) {
+        int hw = (y <= mid) ? 19 + (y - rim) * 3 / 6 : 22 - (y - mid) * 4 / 7;
+        if (hw < 12) hw = 12;
+        for (int x = cx - hw; x <= cx + hw; x++) {
+            bool edge = (x == cx - hw || x == cx + hw || y == bot);
+            cpx(x, y, edge ? C_CARD : C_CAR, ca);
+        }
+    }
+    for (int x = cx - 13; x <= cx + 13; x++) cpx(x, bot - 2, C_CARL, ca);      /* 前保险杠 */
+    c_disc((float)(cx - 10), (float)mid, 1.7f, C_SHIRT, ca);                   /* 左前灯 */
+    c_disc((float)(cx + 10), (float)mid, 1.7f, C_SHIRT, ca);                   /* 右前灯 */
+    for (int x = cx - 3; x <= cx + 3; x += 2) cpx(x, mid + 3, C_CARD, ca);     /* 中网格栅 */
+
+    /* 挡风玻璃：头下方一片宽梯形浅蓝玻璃（下宽上窄），暗红框 + 白色反光斜条。 */
+    int wtop = rim - 8, wbot = rim - 1;
+    for (int y = wtop; y <= wbot; y++) {
+        int ww = 10 + (y - wtop);
+        for (int x = cx - ww; x <= cx + ww; x++) {
+            bool fr = (x == cx - ww || x == cx + ww || y == wtop);
+            cpx(x, y, fr ? C_CARD : C_GLASS, ca);
+        }
+    }
+    cpx(cx + 3, wtop + 2, C_SHIRT, ca);
+    cpx(cx + 4, wtop + 3, C_SHIRT, ca);
+    cpx(cx + 5, wtop + 4, C_SHIRT, ca);
+
+    for (int x = cx - 18; x <= cx + 18; x++) cpx(x, rim, C_CARL, ca);          /* 车沿亮边 */
+    c_disc((float)(cx - 17), (float)rim, 1.8f, C_BL, ca);                      /* 左爪搭车沿 */
+    c_disc((float)(cx + 17), (float)rim, 1.8f, C_BL, ca);                      /* 右爪搭车沿 */
+
+    /* 安全带：斜挎上胸（右肩→左肋）+ 金属扣，透过挡风玻璃可见。 */
+    int sx = iround(j->cx + j->a * 0.52f), sy = iround(j->fy + j->fb + 1.0f);
+    int hx = iround(j->cx - j->a * 0.55f), hy = iround(j->cy + j->b * 0.28f);
+    int steps = abs(hx - sx);
+    if (steps < 1) steps = 1;
+    for (int i = 0; i <= steps; i++) {
+        int x = sx + (hx - sx) * i / steps;
+        int y = sy + (hy - sy) * i / steps;
+        for (int w = 0; w <= 1; w++) {
+            if ((unsigned)(y + w) < H && (unsigned)x < W && s_mask[(y + w) * W + x] == M_BODY) {
+                cpx(x, y + w, C_BELT, ca);
+            }
+        }
+    }
+    for (int dy = -1; dy <= 1; dy++) {
+        for (int dx = -1; dx <= 1; dx++) {
+            cpx(hx + dx, hy + dy, (dx == 0 && dy == 0) ? C_WHEEL : C_BUCKLE, ca);
+        }
+    }
+}
+
+/* 亲子：左爪一只轻轻呼吸的小熊玩偶，右旁一架滑滑梯（梯+平台+斜滑道+支柱）。 */
+static void draw_kids(const avatar_t *j, float ca, int slide, float t)
+{
+    float tx = j->cx - j->a - 1.0f;
+    float ty = j->cy + j->b * 0.28f + slide + sinf(t * 2.0f) * 0.5f;
+    c_ellipse(tx, ty + 2.5f, 3.2f, 4.0f, C_TOY, ca);
+    c_disc(tx - 3.0f, ty + 1.0f, 1.3f, C_TOY, ca);
+    c_disc(tx + 3.0f, ty + 1.0f, 1.3f, C_TOY, ca);
+    c_disc(tx - 1.6f, ty + 6.0f, 1.4f, C_TOYD, ca);
+    c_disc(tx + 1.6f, ty + 6.0f, 1.4f, C_TOYD, ca);
+    c_disc(tx, ty - 3.0f, 3.2f, C_TOY, ca);
+    c_disc(tx - 2.8f, ty - 5.4f, 1.6f, C_TOY, ca);
+    c_disc(tx + 2.8f, ty - 5.4f, 1.6f, C_TOY, ca);
+    c_disc(tx - 2.8f, ty - 5.4f, 0.8f, C_TOYD, ca);
+    c_disc(tx + 2.8f, ty - 5.4f, 0.8f, C_TOYD, ca);
+    c_ellipse(tx, ty - 1.8f, 1.7f, 1.2f, C_BL, ca);
+    cpx(iround(tx - 1.3f), iround(ty - 3.4f), C_IRIS, ca);
+    cpx(iround(tx + 1.3f), iround(ty - 3.4f), C_IRIS, ca);
+    cpx(iround(tx), iround(ty - 2.0f), C_TOYD, ca);
+
+    int lx = iround(j->cx + j->a + 1.0f);
+    int top = iround(j->fy + j->fb) + slide, bot = top + 13;
+    for (int x = lx; x <= lx + 5; x++) { cpx(x, top, C_SLIDE2, ca); cpx(x, top + 1, C_SLIDE2, ca); }
+    for (int y = top + 2; y <= bot; y++) { cpx(lx, y, C_SLIDE2, ca); cpx(lx + 2, y, C_SLIDE2, ca); }
+    for (int r = top + 4; r <= bot - 1; r += 3) {
+        for (int x = lx; x <= lx + 2; x++) cpx(x, r, C_SLIDE2, ca);
+    }
+    for (int y = top + 2; y <= bot; y++) cpx(lx + 5, y, C_SLIDE2, ca);
+    int cx0 = lx + 5, cy0 = top + 1, cx1 = lx + 9, cy1 = bot - 1, st = cy1 - cy0;
+    if (st < 1) st = 1;
+    for (int i = 0; i <= st; i++) {
+        int x = cx0 + (cx1 - cx0) * i / st, y = cy0 + (cy1 - cy0) * i / st;
+        cpx(x, y, C_SLIDE, ca); cpx(x + 1, y, C_SLIDE, ca);
+    }
+}
+
+/* 分身：躯干＋两臂绒毛变西装（外套＋袖），白衬衫 V＋亮翻领＋打结尖角领带＋口袋巾；
+ * 脸和爪尖仍是绒毛。袖＝臂内部染外套色、保留轮廓/缝线，末端露一只绒毛爪。 */
+static void draw_suit(const avatar_t *j, float ca)
+{
+    int cx = iround(j->cx);
+    int ytop = iround(j->fy + j->fb), ybot = iround(j->cy + j->b) - 3;
+    int x0 = iround(j->cx - j->a), x1 = iround(j->cx + j->a);
+    int span = ybot - ytop;
+    if (span < 6) return;
+    static const int8_t N4[4][2] = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } };
+
+    /* 袖子：臂内部染外套色，边缘/缝线（邻接非臂）保留；记下每侧最低臂像素当爪尖。 */
+    int pawlx = -1, pawly = -1, pawrx = -1, pawry = -1;
+    for (int y = ytop - 10; y <= ybot; y++) {
+        if ((unsigned)y >= H) continue;
+        for (int x = x0 - 6; x <= x1 + 6; x++) {
+            if ((unsigned)x >= W || s_mask[y * W + x] != M_ARM) continue;
+            bool edge = false;
+            for (int k = 0; k < 4; k++) {
+                int xx = x + N4[k][0], yy = y + N4[k][1];
+                uint8_t n = ((unsigned)xx < W && (unsigned)yy < H) ? s_mask[yy * W + xx] : M_NONE;
+                if (n != M_ARM) { edge = true; break; }
+            }
+            if (!edge) cpx(x, y, C_SUIT, ca);
+            if (x < cx) { if (y > pawly) { pawly = y; pawlx = x; } }
+            else        { if (y > pawry) { pawry = y; pawrx = x; } }
+        }
+    }
+
+    for (int y = ytop; y <= ybot; y++) {
+        int rel = y - ytop;
+        int sw = rel < 10 ? 6 - (rel * 6) / 10 : 0;   /* 衬衫 V：领口宽、往下收 */
+        for (int x = x0; x <= x1; x++) {
+            if (s_mask[y * W + x] != M_BODY) continue;
+            int adx = abs(x - cx);
+            bool tie =
+                (rel >= 1 && rel <= 3 && adx <= (rel <= 1 ? 1 : 2)) ||   /* 结 */
+                (rel >= 4 && rel <= span - 5 && adx <= 1) ||             /* 带身 */
+                (rel >= span - 4 && rel <= span - 3 && adx <= 2) ||      /* 下摆放宽 */
+                (rel == span - 2 && adx <= 1) ||                         /* 尖角 */
+                (rel == span - 1 && adx == 0);
+            bool shirt = !tie && adx <= sw;
+            bool lapel = !tie && !shirt && rel < 11 && adx <= sw + 2;
+            uint8_t c = tie ? C_TIE : shirt ? C_SHIRT : lapel ? C_SUITL : C_SUIT;
+            cpx(x, y, c, ca);
+        }
+    }
+
+    if (pawly >= 0) c_disc((float)pawlx, (float)pawly, 1.5f, C_BL, ca);   /* 袖口露出的爪 */
+    if (pawry >= 0) c_disc((float)pawrx, (float)pawry, 1.5f, C_BL, ca);
+
+    cpx(cx - 6, ytop + 5, C_SHIRT, ca);   /* 左胸口袋巾 */
+    cpx(cx - 5, ytop + 5, C_SHIRT, ca);
+    cpx(cx - 6, ytop + 6, C_SHIRT, ca);
+}
+
+static void draw_costume(const avatar_t *j, float t, float fade)
+{
+    if (s_scene == 0) return;
+    float ca = s_costume_pop * fade;
+    if (ca < 0.02f) return;
+    int slide = (int)((1.0f - s_costume_pop) * 5.0f);   /* 道具从上方下滑入位 */
+    switch (s_scene) {
+    case 1: draw_vehicle(j, ca, slide); break;
+    case 2: draw_kids(j, ca, slide, t); break;
+    case 3: draw_suit(j, ca); break;
+    default: break;
+    }
+}
+
 /* ---------------------------------------------------------------------------
  * Frame
  * ------------------------------------------------------------------------- */
@@ -1047,25 +1340,59 @@ void muse_pixel_render(const muse_pose_t *p)
         mouth = MOUTH_GRIN;
     }
 
+    /* 情绪只在"没人有事"的 IDLE 脸上、且没在摸头时上脸；说话/听/想/报警/关机各有主人，

+static int hex_bytes(const char *hex, char *out, size_t cap)
+{
+    size_t n = 0;
+    for (const char *p = hex; *p; p += 2) {
+        int hi = hexval(p[0]);
+        int lo = p[1] ? hexval(p[1]) : -1;          /* 落单的半个字节也算非法 */
+        if (hi < 0 || lo < 0) return -1;
+        if (n + 1 >= cap) return -2;
+        out[n++] = (char)((hi << 4) | lo);
+    }
+    out[n] = '\0';
+    return (int)n;

+        }
+        bool end_now = false;
+        if (hands_free) {
+            float db = muse_audio_dbfs(s_chunk, MUSE_AUDIO_CHUNK);
+            s_hf_win[win_n % HF_WINDOW] = db;
+            win_n++;
+            size_t have = win_n < HF_WINDOW ? win_n : HF_WINDOW;
+            float floor_db = s_hf_win[0];
+            for (size_t i = 1; i < have; i++) {
+                if (s_hf_win[i] < floor_db) floor_db = s_hf_win[i];

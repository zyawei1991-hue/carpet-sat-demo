+#define LCD_SCLK GPIO_NUM_9
+#define LCD_D0 GPIO_NUM_11
+#define LCD_D1 GPIO_NUM_12
+#define LCD_D2 GPIO_NUM_13
+#define LCD_D3 GPIO_NUM_14
+#define LCD_CS GPIO_NUM_10

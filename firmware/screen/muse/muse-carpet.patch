+/* ---------- folded groups ----------
+ *
+ * Two pages carry rows this demo never reaches. The owner wanted that visible
+ * layer back without deleting anything, so it is a fold, not a removal: one
+ * tappable row above a column, the column starting hidden.
+ *
+ * Both halves are the page's own row() and column(), so there is no new widget
+ * and no new gesture - and leaving a sub-page drops it (show() -> drop()), so
+ * the group is folded again the next time the page opens. Nothing about the
+ * fold goes into NVS, which is why there is no state variable to save.
+ */
+static lv_obj_t *s_fold_hatch_col, *s_fold_hatch_val;
+static lv_obj_t *s_fold_batt_col, *s_fold_batt_val;
+
+static void fold_toggle(lv_obj_t *col, lv_obj_t *val)
+{
+    bool fold = !lv_obj_has_flag(col, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_set_flag(col, LV_OBJ_FLAG_HIDDEN, fold);
+    /* "Expanded", not "Open" - the table already answers "Open" with 开, which
+     * is the switch word and would read as a setting rather than a state. */
+    set_text(val, fold ? "Folded" : "Expanded");
+}
+
+static void on_fold_hatch(lv_event_t *e)
+{
+    (void)e;
+    fold_toggle(s_fold_hatch_col, s_fold_hatch_val);
+}
+
+static void on_fold_batt(lv_event_t *e)
+{
+    (void)e;
+    fold_toggle(s_fold_batt_col, s_fold_batt_val);
+}
+
+/* The header row, the one line that says what is behind it, then the column it
+ * opens - all three in that order in the list, so the line is readable while
+ * the group is still folded. Returns the column to build into. */
+static lv_obj_t *fold(lv_obj_t *list, const char *head, const char *caption, lv_event_cb_t cb, lv_obj_t **val_out)
+{
+    row(list, LV_SYMBOL_DOWN, head, val_out, cb, NULL);
+    if (caption) {
+        note(list, caption);
+    }
+    lv_obj_t *col = column(list);
+    lv_obj_add_flag(col, LV_OBJ_FLAG_HIDDEN);
+    set_text(*val_out, "Folded");
+    return col;
+}

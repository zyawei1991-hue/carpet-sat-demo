+static const char *TAG = "carpet_page";
+
+/* ---------- 字体 ---------- */
+
+/* Muse 自带的中文只有 16 px 一档（fonts/muse_font_cjk_noto_16.c），那是位图，
+ * 字号改不动。这一页要的是隔着两米能读、按得动的条目，所以自己带一份**只含本页
+ * 会画的字**的 TTF 子集（仓库里 tools/muse_font_subset.py 造的），交给 LVGL 的
+ * tiny_ttf 现算字号。子集漏了的不许画豆腐块：留 16 px 那份全量当 fallback。
+ * 28/22 是两层页之后重新定的：一屏只剩条目名和一个值，字可以比原来那一版更大。
+ * **改了字号或文案都要重跑那份子集**，否则新字落回 16 px，一行里大小不一。 */
+#if CONFIG_MUSE_CJK_FONT
+#if CONFIG_MUSE_CJK_FONT_NOTO
+LV_FONT_DECLARE(muse_font_cjk_noto_16)
+#define FALLBACK_FONT muse_font_cjk_noto_16
+#else
+LV_FONT_DECLARE(muse_font_cjk_16)
+#define FALLBACK_FONT muse_font_cjk_16
+#endif
+#define FALLBACK (&FALLBACK_FONT)
+#else
+#define FALLBACK NULL
+#endif
+
+#define FONT_BIG    28   /* 场景名、条目名、详情的值：圆屏隔着两米读的那一档 */
+#define FONT_SMALL  22   /* 提示、按钮、副行：和 Muse 正文同档，比条目名矮一级 */
+#define FONT_GLYPH  30   /* 宫格卡片里那一颗字：只做视觉锚点，不承担读 */
+
+#if CONFIG_LV_USE_TINY_TTF
+/* carpet_font.ttf 由本组件 CMakeLists 的 EMBED_FILES 进 rodata，符号名只取文件名 */
+extern const uint8_t carpet_font_ttf_start[] asm("_binary_carpet_font_ttf_start");
+extern const uint8_t carpet_font_ttf_end[] asm("_binary_carpet_font_ttf_end");
+#endif
+
+static lv_font_t *s_big;
+static lv_font_t *s_small;
+static lv_font_t *s_glyph;
+
+/* 只在 LVGL 任务里调（build 由 muse_ui 的初始化发起）：create 会动 LVGL 的分配器。 */
+static void fonts_init(void)
+{
+#if CONFIG_LV_USE_TINY_TTF
+    const size_t n = (size_t)(carpet_font_ttf_end - carpet_font_ttf_start);
+    s_big   = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_BIG);
+    s_small = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_SMALL);
+    if (s_big && s_small) {
+        s_big->fallback   = FALLBACK;
+        s_small->fallback = FALLBACK;
+        /* 宫格那颗字是同一份子集里已有的汉字（场景名的第一个字），只是再开一号。
+         * 开不出来就用 28 那档：字在，矮一点，不影响点。 */
+        s_glyph = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_GLYPH);
+        if (!s_glyph) s_glyph = s_big;
+        s_glyph->fallback = FALLBACK;
+        ESP_LOGI(TAG, "tiny_ttf %u 字节 → %d/%d/%dpx",
+                 (unsigned)n, FONT_BIG, FONT_SMALL, FONT_GLYPH);
+        return;
+    }
+    ESP_LOGE(TAG, "tiny_ttf 打不开这份子集，整页退回 16px");
+    if (s_big) { lv_tiny_ttf_destroy(s_big); s_big = NULL; }
+    if (s_small) { lv_tiny_ttf_destroy(s_small); s_small = NULL; }
+#endif
+    /* 没开 tiny_ttf（或字库坏了）也得有页面看：ASCII 走 unscii，中文落 16 px 那份 */
+    static lv_font_t small16;
+    if (!small16.get_glyph_dsc) {
+        small16 = lv_font_unscii_16;
+        small16.fallback = FALLBACK;
+    }
+    if (!s_big) s_big = &small16;
+    if (!s_small) s_small = &small16;
+    if (!s_glyph) s_glyph = &small16;
+}
+
+/* ---------- Muse 那套配色与卡片 ---------- */
+
+/* 抄 muse_settings_ui.c 的调色板：这一页和右滑那页必须是同一个东西。 */
+#define COLOR_TEXT          0xf2efff
+#define COLOR_DIM           0x8b84a8
+#define COLOR_CARD          0x1a1530
+#define COLOR_CARD_PRESSED  0x2e2552
+#define COLOR_ACCENT        0xa77dff
+#define COLOR_OFF           0xff9a5c   /* 链路不健康：占的是 Muse COLOR_WARN 的位置 */
+
+/* 宫格每格一颗色，全部取自 Muse 自己用过的色号（muse_ui.c 的 0x70baff / 0xffd060、
+ * muse_settings_ui.c 的 COLOR_OK）—— 这一页不能看起来比右滑那页更像外来户。 */
+#define COLOR_HUE_BLUE      0x70baff
+#define COLOR_HUE_MINT      0x6ff0bf
+#define COLOR_HUE_AMBER     0xffd060
+
+/* 466 的圆里，宽 300 的一列上下各能让到多少：屏半径 233、半宽 150，
+ * sqrt(233^2-150^2)=178 ⇒ 整列最高 356 px。场景页都按这条上限排过：
+ * 最满的一页 44+34+3*52+26+44+5*6=338，没顶到 356，最外那张的圆角不会被裁。 */
+#define COL_W      300
+#define ROW_H      52
+#define BTN_H      44
+#define BTN_W      92   /* 三个并一排 276，余 24 分给两道间隙 */
+#define TITLE_H    34
+#define SUB_H      26
+#define GAP        6
+#define DOT_D      12   /* 行首琥珀点的直径：条目名 22px、值 16px，12 既看得清也不顶行高 */
+
+/* L1 宫格。容器 364×380 居中 ⇒ 占 x 51..415、y 43..423，圆屏半径 233，逐角称过：
+ * 第一行卡片外角 (51,104) → sqrt(182²+129²)=223 ✓
+ * 第二行卡片外角 (51,344) → sqrt(182²+111²)=213 ✓
+ * 底部回脸条（宽 300）下角 (83,397) → sqrt(150²+164²)=222 ✓
+ * 顶部状态行那一带（y 43..71）可用宽只有 269，所以那句必须居中，不能贴左：
+ * 居中后最长的一句"掉线重连"（88px）离圆边还有 60 以上。 */
+#define GRID_CELL   116                 /* 一张场景卡：3 个一行 + 两道 8px 间隙 = 364 */
+#define GRID_GAP      8
+#define GRID_W     (3 * GRID_CELL + 2 * GRID_GAP)
+#define GRID_H    380
+#define GRID_ROUND  56                  /* 那颗字的圆底托 */
+#define GRID_ROWS_Y  61                 /* 第一行卡片在容器里的 y（往下是 61+124） */
+#define GRID_BACK_Y 310                 /* 回脸条：贴底会掉到圆外，这是称过的最后一档 */
+
+/* ---------- 页名：和契约的 ScreenPage 一字不差 ---------- */
+
+/* SchemaDriftTest 从 muse-carpet.patch 里正则扫出这张表，和 core 的 ScreenPage 比对，
+ * 所以**名字和条数都是契约的一部分**：改名就是改契约，得两边同一轮提。
+ * PAGE_NAMES[0] 的 face 不是这一页里的某一层 —— 它是 tileview 最上那格，归 Muse 的脸。 */
+enum {
+    PG_FACE, PG_PICKER, PG_VEHICLE, PG_KIDS, PG_AVATAR, PG_CLOCK, PG_GALLERY, PG_PHOTO,
+    PG_COUNT
+};
+static const char *const PAGE_NAMES[PG_COUNT] = {
+    "face", "picker", "vehicle", "kids", "avatar", "clock", "gallery", "photo"
+};
+
+/* ---------- 条目表 ---------- */
+
+/* 右边的值从契约的哪一项来。F_NONE = 这一版还没接上的那一页 —— 不许拿旧值或占位数字糊上去。 */
+enum { F_SAT, F_DIALOG, F_SOS, F_CARD, F_EMOTION, F_NONE };
+
+typedef struct {
+    const char *name;
+    int8_t field;
+    int8_t target;    /* >=0 = 跳这一页（L1 的入口）；-1 = 进功能详情（L3） */
+} row_def_t;
+
+#define PG_NONE (-1)
+
+/* L1 的格子：一颗字 + 一个场景名。那颗字取场景名的第一个字 —— 子集里一定有它，
+ * 因为场景名本身就要画。不拿 LVGL 自带的 32 个 FontAwesome 符号假装有车、有人、有钟：
+ * 那套符号里汽车/人/钟都没有，硬凑只会印出一个对不上号的图。 */
+typedef struct {
+    const char *name;
+    const char *glyph;
+    uint32_t hue;
+    int8_t target;
+    bool dim;       /* 这一版还没接上的那一格：整格压暗，不装作能用 */
+} cell_def_t;
+
+static const cell_def_t PICKER_CELLS[] = {
+    { "车载",     "车", COLOR_HUE_BLUE,  PG_VEHICLE, false },
+    { "亲子",     "亲", COLOR_HUE_MINT,  PG_KIDS,    false },
+    { "数字分身", "分", COLOR_ACCENT,    PG_AVATAR,  false },
+    { "时钟",     "钟", COLOR_HUE_AMBER, PG_CLOCK,   false },
+    { "图片播放", "图", COLOR_DIM,       PG_GALLERY, true  },

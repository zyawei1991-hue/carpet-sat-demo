diff --git a/esp32/components/muse/boards/board_spotpear_s3_18.c b/esp32/components/muse/boards/board_spotpear_s3_18.c
new file mode 100644
index 0000000..8b6b7bf
--- /dev/null
+++ b/esp32/components/muse/boards/board_spotpear_s3_18.c
@@ -0,0 +1,550 @@
+/*

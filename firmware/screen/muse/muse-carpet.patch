+      "隔一条手臂说话：电平条到绿色就好（-30 到 -15 dBFS），别到橙色。" },
+
+    /* ---------- Sleep ---------- */
+    { "30 seconds", "30 秒" },
+    { "1 minute", "1 分钟" },
+    { "2 minutes", "2 分钟" },
+    { "5 minutes", "5 分钟" },
+    { "10 minutes", "10 分钟" },
+    { LV_SYMBOL_EYE_CLOSE "  Sleep now", LV_SYMBOL_EYE_CLOSE "  马上熄屏" },
+    { "Turn the screen off after Muse has been idle for:", "空闲多久之后熄屏：" },
+    { "Stay online when asleep", "熄屏后保持联网" },
+    { "On: still reachable over Wi-Fi while dark, at the cost of battery.",
+      "开着时熄屏也连着 Wi-Fi，手机随时能连上；代价是更费电。" },
+    { "Tap the screen or press either button to wake.", "碰屏幕或按任意键都能唤醒。" },
+
+    /* ---------- Battery ---------- */
+    /* The fold added 11-08; four hanzi in a 124 px row name. */
+    { "Battery diagnostics", "电池诊断" },
+    { "Used", "已用掉" },
+    { "A full charge", "充满能用" },
+    { "Chip asleep", "打盹时间" },
+    { "Wakes", "唤醒次数" },
+    { "CPU busy", "CPU 占用" },
+    { LV_SYMBOL_REFRESH "  Start over", LV_SYMBOL_REFRESH "  重新计时" },
+    { "No battery", "没有电池" },
+    { "Unplug USB to start measuring.", "拔掉 USB 开始计时。" },
+    { "On battery for %s", "电池供电 %s" },
+    { "Last run: %s on battery", "上次电池供电 %s" },
+    { "None", "无" },
+    { "%d h %d min", "%d 小时 %d 分" },
+    { "%d min", "%d 分" },
+    { "lasts ~%d h", "能用约 %d 小时" },
+    { "%d%% so far", "目前用了 %d%%" },
+    { "measuring", "计时中" },
+    { "Also kept awake by: %s", "还让它醒着：%s" },
+    { "Measures from unplugging USB until it's plugged back in. The gauge moves in 1% steps, so give it a few "
+      "hours. Chip asleep is time in light sleep; CPU busy is time a core was running a task.",
+      "拔 USB 起算，插回为止；一格 1%，要几小时才准。" },
+
+    /* ---------- Power ---------- */
+    { "Power Muse off completely?", "要彻底关机吗？" },
+    { LV_SYMBOL_POWER "  Power off", LV_SYMBOL_POWER "  关机" },
+    { "Tap the screen to turn it back on.", "碰屏幕就能再开机。" },
+    { "Press the %s button to turn it back on.", "按 %s 键再开机。" },
+    { "Press the %s button to turn it back on. To just turn the screen off, press the %s button.",
+      "按 %s 键再开机；只想熄屏就按 %s 键。" },
+
+    /* ---------- the text-entry page ---------- */
+    { "Show", "显示" },
+    { "Hide", "隐藏" },
+};
+
+#define N ((int)(sizeof(TABLE) / sizeof(TABLE[0])))
+
+/* Which keys this run has actually drawn, for `>zh`. */
+static uint8_t s_seen[(N + 7) / 8];
+static int s_hits;
+
+const char *carpet_lang_zh(const char *en)
+{
+    for (int i = 0; i < N; i++) {
+        if (!strcmp(TABLE[i].en, en)) {
+            s_seen[i / 8] |= 1 << (i % 8);
+            s_hits++;
+            return TABLE[i].zh;
+        }
+    }
+    return en;
+}
+
+int carpet_lang_zh_entries(void)
+{
+    return N;
+}
+
+/* Keys drawn at least once, not lookups: `s_hits` repeats an entry every tick
+ * a label is refreshed, so counting calls would say thousands for six pages. */
+int carpet_lang_zh_hits(void)
+{
+    int hit = 0;
+    for (int i = 0; i < N; i++) {
+        if (s_seen[i / 8] & (1 << (i % 8))) {
+            hit++;
+        }
+    }
+    return hit;
+}
+
+void carpet_lang_zh_dump(void)
+{
+    for (int i = 0; i < N; i++) {
+        if (!(s_seen[i / 8] & (1 << (i % 8)))) {
+            printf("@zh never: %s\n", TABLE[i].en);
+        }
+    }
+    printf("@zh drawn=%d entries=%d\n", carpet_lang_zh_hits(), N);
+    fflush(stdout);
+}

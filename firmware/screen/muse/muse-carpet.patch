+static const row_def_t VEHICLE_ROWS[] = {
+    { "卫星", F_SAT,    PG_NONE },
+    { "对话", F_DIALOG, PG_NONE },
+    { "呼救", F_SOS,    PG_NONE },
+};
+static const row_def_t KIDS_ROWS[] = {
+    { "对话", F_DIALOG, PG_NONE },
+    { "过境", F_SAT,    PG_NONE },

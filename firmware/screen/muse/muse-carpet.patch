diff --git a/esp32/components/muse/CMakeLists.txt b/esp32/components/muse/CMakeLists.txt
index b478d5e..96eac0d 100644
--- a/esp32/components/muse/CMakeLists.txt
+++ b/esp32/components/muse/CMakeLists.txt
@@ -46,6 +46,17 @@ if(CONFIG_MUSE_ENABLED)
     else()
         list(APPEND srcs "muse_ui.c" "muse_menu.c" "muse_settings_ui.c" "muse_keypad.c" "muse_lv_mem.c")
     endif()
+    if(CONFIG_MUSE_CARPET_CARDS)
+        # Our car-link tile: the page (LVGL task) and the Screen-Link gate.
+        list(APPEND srcs "carpet/carpet_page.c" "carpet/carpet_link.c")
+        # 24/20px Chinese for that page: a ~120KB subset, sized by tiny_ttf at run
+        # time (Muse's own CJK bitmap font only comes in 16px). It is NOT tracked in
+        # the fork -- copy it in from our repo (firmware/screen/muse/font/) before
+        # configuring, or this embed line fails the configure step outright. Regenerate
+        # it with firmware/screen/tools/muse_font_subset.py whenever the page's wording
+        # changes (a missed glyph drops to the 16px fallback, so it shows as mixed sizes).
+        list(APPEND embed "carpet/carpet_font.ttf")
+    endif()
     if(CONFIG_MUSE_HATCH)
         list(APPEND srcs "muse_chat.c" "muse_account_api.c" "muse_chat_session.cpp")
         list(APPEND embed "test_reply.mp3")   # muse_hatch_mp3_selftest
@@ -192,7 +203,11 @@ set(muse_priv_requires
     esp_driver_pcnt efuse
     # The Sticky's microSD (CONFIG_MUSE_STICKY_SD). Requirements are resolved
     # before Kconfig values exist, so these can't depend on it; only the code does.
-    fatfs esp_driver_sdspi sdmmc)
+    fatfs esp_driver_sdspi sdmmc
+    # The car-link page's client. Requirements are resolved before Kconfig
+    # exists, so this is unconditional; with CONFIG_MUSE_CARPET_CARDS off no
+    # object from it is referenced and none gets linked.
+    screen_link)
 list(APPEND muse_priv_requires camera)
 
 idf_component_register(
diff --git a/esp32/components/muse/Kconfig b/esp32/components/muse/Kconfig
index 588d7c6..75c4bf6 100644
--- a/esp32/components/muse/Kconfig
+++ b/esp32/components/muse/Kconfig
@@ -297,6 +297,20 @@ menu "Muse"
             rarer characters and Korean show as boxes. Takes about 910 KB of
             flash, against about 1.2 MB.
 
+    config MUSE_CARPET_CARDS
+        bool "Car-link page above the face (Screen-Link cards)"
+        depends on MUSE_ENABLED && !MUSE_UI_FREEINK
+        select MUSE_CJK_FONT
+        select MUSE_CJK_FONT_NOTO
+        default n
+        help
+            Adds a third tile to the touch UI: swipe up from the face for our
+            own menu (link / satellite / dialog / emotion / SOS), fed by the
+            Screen-Link client in components/screen_link. Home Link still owns
+            Wi-Fi and pairing, so the link starts only once a network is up.
+            Its labels are Chinese, so this selects the CJK caption font
+            (about 910 KB of flash). Off, the build is upstream's.
+
     config MUSE_LATIN_FONT
         bool "Show Vietnamese and other accented letters in captions"
         depends on MUSE_ENABLED && !MUSE_UI_FREEINK
diff --git a/esp32/components/muse/carpet/carpet_font.ttf b/esp32/components/muse/carpet/carpet_font.ttf

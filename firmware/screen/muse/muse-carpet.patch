+#include "carpet/carpet_page.h"
+
+#include "sdkconfig.h"
+#if CONFIG_MUSE_CARPET_CARDS
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "carpet/carpet_link.h"
+#include "carpet/carpet_mic.h"
+#include "esp_log.h"
+#include "muse_ui.h"
+#include "muse_pixel.h"
+#include "muse_settings.h"
+
+static const char *TAG = "carpet_page";
+
+/* ---------- 字体 ---------- */
+
+/* Muse 自带的中文只有 16 px 一档（fonts/muse_font_cjk_noto_16.c），那是位图，
+ * 字号改不动。这一页要的是隔着两米能读、按得动的条目，所以自己带一份**只含本页
+ * 会画的字**的 TTF 子集（仓库里 tools/muse_font_subset.py 造的），交给 LVGL 的
+ * tiny_ttf 现算字号。子集漏了的不许画豆腐块：留 16 px 那份全量当 fallback。
+ * 28/22 是两层页之后重新定的：一屏只剩条目名和一个值，字可以比原来那一版更大。
+ * **改了字号或文案都要重跑那份子集**，否则新字落回 16 px，一行里大小不一。 */
+#if CONFIG_MUSE_CJK_FONT
+#if CONFIG_MUSE_CJK_FONT_NOTO
+LV_FONT_DECLARE(muse_font_cjk_noto_16)
+#define FALLBACK_FONT muse_font_cjk_noto_16
+#else
+LV_FONT_DECLARE(muse_font_cjk_16)
+#define FALLBACK_FONT muse_font_cjk_16
+#endif
+#define FALLBACK (&FALLBACK_FONT)
+#else
+#define FALLBACK NULL
+#endif
+
+#define FONT_BIG    28   /* 场景名、条目名、详情的值：圆屏隔着两米读的那一档 */
+#define FONT_SMALL  22   /* 提示、按钮、副行：和 Muse 正文同档，比条目名矮一级 */
+#define FONT_GLYPH  30   /* 宫格卡片里那一颗字：只做视觉锚点，不承担读 */
+#define FONT_CLOCK  76   /* 钟面那两位时:分：整页就它一个主角，隔着两米也要一眼读到 */
+
+#if CONFIG_LV_USE_TINY_TTF
+/* carpet_font.ttf 由本组件 CMakeLists 的 EMBED_FILES 进 rodata，符号名只取文件名 */
+extern const uint8_t carpet_font_ttf_start[] asm("_binary_carpet_font_ttf_start");
+extern const uint8_t carpet_font_ttf_end[] asm("_binary_carpet_font_ttf_end");
+#endif
+
+static lv_font_t *s_big;
+static lv_font_t *s_small;
+static lv_font_t *s_glyph;
+static lv_font_t *s_clock;
+
+/* 只在 LVGL 任务里调（build 由 muse_ui 的初始化发起）：create 会动 LVGL 的分配器。 */
+static void fonts_init(void)
+{
+#if CONFIG_LV_USE_TINY_TTF
+    const size_t n = (size_t)(carpet_font_ttf_end - carpet_font_ttf_start);
+    s_big   = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_BIG);
+    s_small = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_SMALL);
+    if (s_big && s_small) {
+        s_big->fallback   = FALLBACK;
+        s_small->fallback = FALLBACK;
+        /* 宫格那颗字是同一份子集里已有的汉字（场景名的第一个字），只是再开一号。
+         * 开不出来就用 28 那档：字在，矮一点，不影响点。 */
+        s_glyph = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_GLYPH);
+        if (!s_glyph) s_glyph = s_big;
+        s_glyph->fallback = FALLBACK;
+        /* 钟面那两位时:分只用到数字和冒号，子集里一定有（sat 倒计时就画它们）。
+         * 开不出来就用 28 那档：钟还在，只是小一点，不影响读。 */
+        s_clock = lv_tiny_ttf_create_data(carpet_font_ttf_start, n, FONT_CLOCK);
+        if (!s_clock) s_clock = s_big;
+        s_clock->fallback = FALLBACK;
+        ESP_LOGI(TAG, "tiny_ttf %u 字节 → %d/%d/%d/%dpx",
+                 (unsigned)n, FONT_BIG, FONT_SMALL, FONT_GLYPH, FONT_CLOCK);
+        return;
+    }
+    ESP_LOGE(TAG, "tiny_ttf 打不开这份子集，整页退回 16px");
+    if (s_big) { lv_tiny_ttf_destroy(s_big); s_big = NULL; }
+    if (s_small) { lv_tiny_ttf_destroy(s_small); s_small = NULL; }
+#endif
+    /* 没开 tiny_ttf（或字库坏了）也得有页面看：ASCII 走 unscii，中文落 16 px 那份 */
+    static lv_font_t small16;
+    if (!small16.get_glyph_dsc) {
+        small16 = lv_font_unscii_16;
+        small16.fallback = FALLBACK;
+    }
+    if (!s_big) s_big = &small16;
+    if (!s_small) s_small = &small16;
+    if (!s_glyph) s_glyph = &small16;
+    if (!s_clock) s_clock = &small16;
+}
+
+/* ---------- Muse 那套配色与卡片 ---------- */
+
+/* 抄 muse_settings_ui.c 的调色板：这一页和右滑那页必须是同一个东西。 */
+#define COLOR_TEXT          0xf2efff
+#define COLOR_DIM           0x8b84a8
+#define COLOR_CARD          0x1a1530
+#define COLOR_CARD_PRESSED  0x2e2552
+#define COLOR_ACCENT        0xa77dff
+#define COLOR_OFF           0xff9a5c   /* 链路不健康：占的是 Muse COLOR_WARN 的位置 */
+
+/* 宫格每格一颗色，全部取自 Muse 自己用过的色号（muse_ui.c 的 0x70baff / 0xffd060、
+ * muse_settings_ui.c 的 COLOR_OK）—— 这一页不能看起来比右滑那页更像外来户。 */
+#define COLOR_HUE_BLUE      0x70baff
+#define COLOR_HUE_MINT      0x6ff0bf
+#define COLOR_HUE_AMBER     0xffd060
+
+/* 钟面这一页的内容用 ROUND-SCREEN-VISUAL-BASELINE.md 的 Ink 蓝系（不是兄弟页那套紫）。
+ * 只这一页换：它的左右邻是 gallery/photo 两张占位页，色差几乎看不见；把紫的那几页
+ * 一起迁是另一轮的活，这轮不碰（owner 已拍的范围就是钟面 + 烧屏）。返回那颗药丸仍用
+ * 共享的紫 —— 它是所有页同一个导航件，一致性比配色纯更要紧。 */
+#define INK_TEXT_HIGH       0xF2F5F9   /* 时:分主角 */
+#define INK_TEXT_MID        0xB3BFCE   /* 日期 */
+#define INK_TEXT_LOW        0x94A1B4   /* 不活/等首帧时的过境行 */
+#define INK_SAT             0x58A6FF   /* 活着的下次过境：基线那颗卫星蓝 */
+#define INK_WAIT            0xE3B341   /* 还没对上时：琥珀，不摆假时间 */
+
+/* 466 的圆里，宽 300 的一列上下各能让到多少：屏半径 233、半宽 150，
+ * sqrt(233^2-150^2)=178 ⇒ 整列最高 356 px。场景页都按这条上限排过：
+ * 最满的一页 44+34+3*52+26+44+5*6=338，没顶到 356，最外那张的圆角不会被裁。 */
+#define COL_W      300
+#define ROW_H      52
+#define BTN_H      44
+#define BTN_W      92   /* 三个并一排 276，余 24 分给两道间隙 */
+#define TITLE_H    34
+#define SUB_H      26
+#define GAP        6
+#define DOT_D      12   /* 行首琥珀点的直径：条目名 22px、值 16px，12 既看得清也不顶行高 */
+
+/* L1 宫格。容器 364×380 居中 ⇒ 占 x 51..415、y 43..423，圆屏半径 233，逐角称过：
+ * 第一行卡片外角 (51,104) → sqrt(182²+129²)=223 ✓
+ * 第二行卡片外角 (51,344) → sqrt(182²+111²)=213 ✓
+ * 底部回脸条（宽 300）下角 (83,397) → sqrt(150²+164²)=222 ✓
+ * 顶部状态行那一带（y 43..71）可用宽只有 269，所以那句必须居中，不能贴左：
+ * 居中后最长的一句"掉线重连"（88px）离圆边还有 60 以上。 */
+#define GRID_CELL   116                 /* 一张场景卡：3 个一行 + 两道 8px 间隙 = 364 */
+#define GRID_GAP      8
+#define GRID_W     (3 * GRID_CELL + 2 * GRID_GAP)
+#define GRID_H    380
+#define GRID_ROUND  56                  /* 那颗字的圆底托 */
+#define GRID_ROWS_Y  61                 /* 第一行卡片在容器里的 y（往下是 61+124） */
+#define GRID_BACK_Y 310                 /* 回脸条：贴底会掉到圆外，这是称过的最后一档 */
+
+/* ---------- 页名：和契约的 ScreenPage 一字不差 ---------- */
+
+/* SchemaDriftTest 从 muse-carpet.patch 里正则扫出这张表，和 core 的 ScreenPage 比对，
+ * 所以**名字和条数都是契约的一部分**：改名就是改契约，得两边同一轮提。
+ * PAGE_NAMES[0] 的 face 不是这一页里的某一层 —— 它是 tileview 最上那格，归 Muse 的脸。 */
+enum {
+    PG_FACE, PG_PICKER, PG_VEHICLE, PG_KIDS, PG_AVATAR, PG_CLOCK, PG_GALLERY, PG_PHOTO,
+    PG_COUNT
+};
+static const char *const PAGE_NAMES[PG_COUNT] = {
+    "face", "picker", "vehicle", "kids", "avatar", "clock", "gallery", "photo"
+};
+
+/* ---------- 条目表 ---------- */
+
+/* 右边的值从契约的哪一项来。F_NONE = 这一版还没接上的那一页 —— 不许拿旧值或占位数字糊上去。 */
+enum { F_SAT, F_DIALOG, F_SOS, F_CARD, F_EMOTION, F_NONE };
+
+typedef struct {
+    const char *name;
+    int8_t field;
+    int8_t target;    /* >=0 = 跳这一页（L1 的入口）；-1 = 进功能详情（L3） */
+} row_def_t;
+
+#define PG_NONE (-1)
+
+/* B §3 场景环：只有三域（车/家/对话），横向三张卡，当前场景高亮。那颗字取场景名
+ * 第一个字 —— 子集里一定有它（车/亲/对 都在现有词表里），不另跑字库子集。
+ * 时钟/相册不在这里：它们归右滑氛围层（B §5），不再混进场景环。 */
+typedef struct {
+    const char *name;
+    const char *glyph;
+    uint32_t hue;
+    int8_t target;
+    bool dim;       /* 这一版还没接上的那一格：整格压暗，不装作能用 */
+    int8_t scene;   /* 换装号（muse_pixel_set_scene）：1 车·守护 / 2 家·亲子 / 3 对话·助手 */
+} cell_def_t;
+
+static const cell_def_t PICKER_CELLS[] = {
+    { "车",   "车", COLOR_HUE_BLUE,  PG_VEHICLE, false, 1 },
+    { "亲子", "亲", COLOR_HUE_MINT,  PG_KIDS,    false, 2 },
+    { "对话", "对", COLOR_ACCENT,    PG_AVATAR,  false, 3 },
+};
+static const row_def_t VEHICLE_ROWS[] = {
+    { "卫星", F_SAT,    PG_NONE },
+    { "对话", F_DIALOG, PG_NONE },
+    { "呼救", F_SOS,    PG_NONE },
+};
+static const row_def_t KIDS_ROWS[] = {
+    { "对话", F_DIALOG, PG_NONE },
+    { "过境", F_SAT,    PG_NONE },
+    { "安全", F_SOS,    PG_NONE },
+};
+static const row_def_t AVATAR_ROWS[] = {
+    { "答句", F_DIALOG,  PG_NONE },
+    { "情绪", F_EMOTION, PG_NONE },
+};
+/* 时钟不再走条目表：它整页是一块大数字钟面（build_clock / clock_refresh 专门画），
+ * 所以 PAGE_DEFS[PG_CLOCK] 的 rows=NULL、n_rows=0，tick 里单独一支更新。 */
+static const row_def_t GALLERY_ROWS[] = {
+    { "图片", F_NONE, PG_NONE },
+};
+/* 相册：契约第 8 个页名，App 侧 ScreenMirror 已经把它当「右滑氛围层·相册轮播」。
+ * 推图通道还没落地，所以和 gallery 一样是 F_NONE —— 不摆几张假照片充数。 */
+static const row_def_t PHOTO_ROWS[] = {
+    { "相册", F_NONE, PG_NONE },
+};
+
+#define ARRAY_LEN(a) ((int)(sizeof(a) / sizeof((a)[0])))
+#define MAX_ROWS 5
+
+/* 每页的结构：标题（L1 没有）+ 条目 + 一条副行。副行有三种身份，见下面 sub_* 的注释。 */
+#define PF_CARD_BAR   0x01   /* 底部那三个按钮：动的是手机上的卡片 */
+#define PF_SUB_STATIC 0x02   /* 副行是写死的一句话，不参与每帧更新 */
+#define PF_GRID       0x04   /* L1：画的是场景宫格，不是条目列表（rows 用不上） */
+
+typedef struct {
+    const char *title;      /* NULL = L1：这一层的名字就是"选一个场景"，写在屏上是占一行说废话 */
+    const row_def_t *rows;
+    int8_t n_rows;
+    uint8_t flags;
+} page_def_t;
+
+/* 下标按 PG_* 写死：这张表里 0 号是 face，它没有列（脸是 tileview 那一格，不归这里画）。 */
+static const page_def_t PAGE_DEFS[PG_COUNT] = {
+    [PG_PICKER]  = { NULL,       NULL,         0,                     PF_GRID },
+    [PG_VEHICLE] = { "车载",     VEHICLE_ROWS, ARRAY_LEN(VEHICLE_ROWS), PF_CARD_BAR },
+    [PG_KIDS]    = { "亲子",     KIDS_ROWS,    ARRAY_LEN(KIDS_ROWS),    PF_CARD_BAR },
+    [PG_AVATAR]  = { "数字分身", AVATAR_ROWS,  ARRAY_LEN(AVATAR_ROWS),  0 },
+    [PG_CLOCK]   = { "时钟",     NULL,         0,                     0 },
+    [PG_GALLERY] = { "图片播放", GALLERY_ROWS, ARRAY_LEN(GALLERY_ROWS), PF_SUB_STATIC },
+    [PG_PHOTO]   = { "相册",     PHOTO_ROWS,   ARRAY_LEN(PHOTO_ROWS),   PF_SUB_STATIC },
+};
+
+/* 建页时按这一条给"还没接"那一页写死副行，其余页的副行是活的。 */
+static const char *const GALLERY_NOTE = "还没接上 · 不放假数据";
+
+/* ---------- 导航状态 ---------- */
+
+/*
+ * B（docs/ROUND-SCREEN-GESTURES.md）：脸居中的十字，四方向各管一格 ——
+ *   下拉→场景环（ring，上方格）/ 上滑→功能层（func，下方格）/
+ *   左滑→设置（Muse 那格）/ 右滑→氛围（amb，左方格）。
+ * 契约那八页按身份分住三格：picker 住 ring；vehicle/kids/avatar 住 func；
+ * clock/gallery/photo 住 amb。翻页仍是**本地动作**，不等手机往返；切完发一条
+ * page_report 通报到哪一页。L3（功能详情）不报，且只住在 func 格。
+ */
+static int8_t s_tile = PG_FACE;   /* tileview 现在露哪格：0 脸 / 1 设置 / 2 功能 / 3 场景环 / 4 氛围 */
+static int8_t s_pg = PG_PICKER;   /* 当前格里的哪一页（face/settings 不用它） */
+static bool s_detail;             /* L3 开着（只在 func 格） */
+static int8_t s_scene_pg = PG_VEHICLE;  /* 上滑去的"当前场景"：最近一次进的功能页 */
+static int8_t s_amb_pg = PG_CLOCK;      /* 右滑去的氛围：最近一次进的氛页，再右滑在这几页间轮 */
+
+static lv_obj_t *s_col[PG_COUNT]; /* 那一叠列，按身份分住三格，同时只露一个 */
+static lv_obj_t *s_detail_col;
+/* 三格各自的根对象：手势命中测试只查"现在露着的那一格"，别的格不算。 */
+static lv_obj_t *s_func_tile;
+static lv_obj_t *s_ring_tile;
+static lv_obj_t *s_amb_tile;
+static lv_obj_t *s_scene_card[3];   /* 场景环那三张卡：apply() 按当前场景给谁描边 */
+static lv_obj_t *s_shown_col;       /* 上一次露出的列：只在它变了时播入场动效，不每帧重播 */
+
+/* 这一页住哪一格。face→0；设置不是契约页，由手势直接跳 1，不在这里。 */
+static int tile_for_page(int pg)
+{
+    switch (pg) {
+    case PG_PICKER:                                   return 3;   /* 场景环 */
+    case PG_VEHICLE: case PG_KIDS: case PG_AVATAR:    return 2;   /* 功能层 */
+    case PG_CLOCK: case PG_GALLERY: case PG_PHOTO:    return 4;   /* 氛围 */
+    default:                                          return 0;   /* 脸 */
+    }
+}
+
+/* 这一页是哪个场景（换装号）；不是场景页就 0（本色）。 */
+static int scene_of_page(int pg)
+{
+    for (int i = 0; i < ARRAY_LEN(PICKER_CELLS); i++) {
+        if (PICKER_CELLS[i].target == pg) return PICKER_CELLS[i].scene;
+    }
+    return 0;
+}
+
+typedef struct {
+    lv_obj_t *label;
+    char shown[72];
+} line_t;
+
+typedef struct {
+    line_t rows[MAX_ROWS];
+    lv_obj_t *dot[MAX_ROWS];   /* 行首那枚琥珀点：只在该行装的是"到点的养护"时亮 */
+    line_t sub;
+} page_lines_t;
+static page_lines_t s_lines[PG_COUNT];
+/* 钟面那三行（时:分 / 日期 / 下次过境）。不进 s_lines：它不是条目表，build_clock 单独建。 */
+static line_t s_clock_hero;
+static line_t s_clock_date;
+static line_t s_clock_pass;
+static line_t s_detail_title;
+static line_t s_detail_value;
+static line_t s_detail_hint;
+
+static int s_detail_field = F_NONE;
+static const char *s_detail_name = "";
+
+/* 通报去重：和上一次发出去的名字一样就不重发。屏每 250ms 看一次自己在哪一页，
+ * 没有这一条就是每秒一条同样的 page_report。 */
+static char s_reported[16];
+
+/* dialog.action / reshare 都只立记号，动作在 tick 里做（那里才是 LVGL 任务）。
+ * 带一个序号：名字写完再自增，UI 那边只认涨过的号，不会出现"刚写入就被清掉"。 */
+static volatile uint32_t s_pending_seq;
+static volatile char s_pending_name[16];
+static uint32_t s_applied_seq;
+static volatile bool s_reshare;
+
+/* ---------- 排版小件 ---------- */
+
+static void set_line(line_t *l, const char *text, uint32_t color)
+{
+    if (!l->label) return;
+    if (strcmp(text, l->shown) == 0) return;
+    snprintf(l->shown, sizeof(l->shown), "%s", text);
+    lv_label_set_text(l->label, text);
+    lv_obj_set_style_text_color(l->label, lv_color_hex(color), 0);
+}
+
+static lv_obj_t *make_label(lv_obj_t *parent, const lv_font_t *font, uint32_t color, const char *text)
+{
+    lv_obj_t *l = lv_label_create(parent);
+    lv_obj_set_style_text_font(l, font, 0);
+    lv_obj_set_style_text_color(l, lv_color_hex(color), 0);
+    lv_label_set_text(l, text);
+    return l;
+}
+
+/* Muse 的 card()：能点就建 lv_button（这才吃点击），圆角 18、左右内衬 16、横排、
+ * 按下换色。每张都摘掉 SCROLLABLE —— tile 已被 muse_ui.c 设成 LV_DIR_NONE，
+ * 卡里再留一个可滚的东西就把上滑/下滑吞回去。 */
+static lv_obj_t *make_card(lv_obj_t *parent, bool clickable, int h)
+{
+    lv_obj_t *c = clickable ? lv_button_create(parent) : lv_obj_create(parent);
+    lv_obj_remove_style_all(c);
+    lv_obj_set_size(c, lv_pct(100), h);
+    lv_obj_set_style_radius(c, 18, 0);
+    lv_obj_set_style_bg_opa(c, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(c, lv_color_hex(COLOR_CARD), 0);
+    lv_obj_set_style_bg_color(c, lv_color_hex(COLOR_CARD_PRESSED), LV_STATE_PRESSED);
+    lv_obj_set_style_pad_hor(c, 16, 0);
+    lv_obj_set_flex_flow(c, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(c, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_style_pad_column(c, 12, 0);
+    lv_obj_remove_flag(c, LV_OBJ_FLAG_SCROLLABLE);
+    /* 不能点的那种是纯容器：留着默认的 CLICKABLE 会把整块玻璃都变成"控件"，
+     * 手势判定就分不出"点在按钮上"和"点在空处"。 */
+    if (!clickable) lv_obj_remove_flag(c, LV_OBJ_FLAG_CLICKABLE);
+    return c;
+}
+
+/* 定高的一横条：里面的东西按行排。副行和标题都借它，免得 label 自己长高把列顶歪。 */
+static lv_obj_t *make_band(lv_obj_t *parent, int h)
+{
+    lv_obj_t *o = lv_obj_create(parent);
+    lv_obj_remove_style_all(o);
+    lv_obj_set_size(o, lv_pct(100), h);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);   /* 纯容器，见 make_card 那条注释 */
+    return o;
+}
+
+/* 值那一列：吃掉剩下的宽度并右对齐。中文比拉丁密，长值吃不满一整行会被挤走条目名，
+ * 所以用 grow + DOTS —— 长就省略号。 */
+static void make_value(lv_obj_t *parent, line_t *slot)
+{
+    lv_obj_t *v = make_label(parent, s_small, COLOR_DIM, "");
+    lv_obj_set_flex_grow(v, 1);
+    lv_label_set_long_mode(v, LV_LABEL_LONG_MODE_DOTS);
+    lv_obj_set_style_text_align(v, LV_TEXT_ALIGN_RIGHT, 0);
+    slot->label = v;
+    slot->shown[0] = '\0';
+}
+
+/* 行首那枚琥珀点（12 px 圆，COLOR_HUE_AMBER）。养护提醒到点时点在"对话"和"情绪"
+ * 这两行前面 —— 那两行装的正是这一条：句子在对话那一行，担心在情绪那一行。
+ * 为什么要有它：答句占着首屏那条带的时候脸演不成"担心"（#73 那条优先序），
+ * 屏上就只剩颜色还能说"这一条是到点的养护"。
+ * 建的时候必须排在条目名之后、值之前：flex 按创建顺序排孩子。
+ * 摘掉 CLICKABLE 是必须的 —— 点了那点得等于点这一行（进详情），不能被孩子吞了。
+ * 藏起来用 HIDDEN：flex 里藏着的孩子不占位，所以不亮时版式和没有这个点一模一样。 */
+static lv_obj_t *make_dot(lv_obj_t *parent)
+{
+    lv_obj_t *d = lv_obj_create(parent);
+    lv_obj_remove_style_all(d);
+    lv_obj_set_size(d, DOT_D, DOT_D);
+    lv_obj_set_style_radius(d, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_opa(d, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(d, lv_color_hex(COLOR_HUE_AMBER), 0);
+    lv_obj_remove_flag(d, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_flag(d, LV_OBJ_FLAG_HIDDEN, true);
+    return d;
+}
+
+/* 一列：宽 300、按内容长、在 tile 里居中 —— 圆屏上居中才有最大可用高度。 */
+static lv_obj_t *make_col(lv_obj_t *tile)
+{
+    lv_obj_t *col = lv_obj_create(tile);
+    lv_obj_remove_style_all(col);
+    lv_obj_set_size(col, COL_W, LV_SIZE_CONTENT);
+    lv_obj_align(col, LV_ALIGN_CENTER, 0, 0);
+    lv_obj_set_flex_flow(col, LV_FLEX_FLOW_COLUMN);
+    lv_obj_set_flex_align(col, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_style_pad_row(col, GAP, 0);
+    lv_obj_remove_flag(col, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(col, LV_OBJ_FLAG_CLICKABLE);   /* 纯容器，见 make_card 那条注释 */
+    return col;
+}
+
+/* 定宽定高的盒子，孩子用绝对坐标摆：宫格要的是"第几行第几列"，
+ * 上面那条 flex 列只会按内容往下堆，摆不出网格。 */
+static lv_obj_t *make_box(lv_obj_t *tile, int w, int h)
+{
+    lv_obj_t *o = lv_obj_create(tile);
+    lv_obj_remove_style_all(o);
+    lv_obj_set_size(o, w, h);
+    lv_obj_align(o, LV_ALIGN_CENTER, 0, 0);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);   /* 纯容器，见 make_card 那条注释 */
+    return o;
+}
+
+static lv_obj_t *make_pill(lv_obj_t *parent, int w, int h, const char *text,
+                           lv_event_cb_t cb, void *ud)
+{
+    lv_obj_t *b = lv_button_create(parent);
+    lv_obj_remove_style_all(b);
+    lv_obj_set_size(b, w, h);
+    lv_obj_set_style_radius(b, 18, 0);
+    lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(b, lv_color_hex(COLOR_CARD), 0);
+    lv_obj_set_style_bg_color(b, lv_color_hex(COLOR_CARD_PRESSED), LV_STATE_PRESSED);
+    lv_obj_remove_flag(b, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_center(make_label(b, s_small, COLOR_ACCENT, text));
+    if (cb) lv_obj_add_event_cb(b, cb, LV_EVENT_CLICKED, ud);
+    return b;
+}
+
+/* ---------- 值：契约的中文短串 → 屏上的一行 ---------- */
+
+static const char *field_text(int field, const carpet_state_view_t *s, char *buf, size_t n)
+{
+    switch (field) {
+    case F_SAT:     snprintf(buf, n, "%s", s->sat[0] ? s->sat : "—"); break;
+    case F_DIALOG:  snprintf(buf, n, "%s", s->dialog[0] ? s->dialog : "没人说话"); break;
+    case F_SOS:     snprintf(buf, n, "%s", s->sos[0] ? s->sos : "—"); break;
+    case F_CARD:    snprintf(buf, n, "%s", s->card[0] ? s->card : "—"); break;
+    case F_EMOTION: snprintf(buf, n, "%s", s->emotion[0] ? s->emotion : "中性"); break;
+    case F_NONE:    snprintf(buf, n, "%s", "还没接"); break;
+    default:        buf[0] = '\0'; break;
+    }
+    return buf;
+}
+
+/* 只有"不正常"的呼救才抢强调色 —— 正常那一值不该一直晃人眼。 */
+static uint32_t field_color(int field, const carpet_state_view_t *s, bool live)
+{
+    if (field == F_SOS && s->sos[0] && strcmp(s->sos, "正常") != 0) return COLOR_ACCENT;
+    return live ? COLOR_TEXT : COLOR_DIM;
+}
+
+/* ---------- 通报 ---------- */
+
+static const char *report_name(void)
+{
+    if (s_tile == 0) return PAGE_NAMES[PG_FACE];
+    if (s_tile == 1) return NULL;   /* 设置那一格：契约里没有这个页名，报了会被拒收，而拒收在屏上没有任何反馈 */
+    return PAGE_NAMES[s_pg];        /* 功能/场景环/氛围：报当前格露着的那一页 */
+}
+
+static void report_now(void)
+{
+    const char *name = report_name();
+    if (!name) return;
+    if (strcmp(name, s_reported) == 0) return;
+    snprintf(s_reported, sizeof s_reported, "%s", name);
+    carpet_link_report_page(name);
+}
+
+const char *carpet_page_current_name(void)
+{
+    const char *n = report_name();
+    return n ? n : PAGE_NAMES[PG_PICKER];
+}
+
+/* ---------- 导航 ---------- */
+
+static void apply(void)
+{
+    for (int i = PG_PICKER; i < PG_COUNT; i++) {
+        if (s_col[i]) {
+            lv_obj_set_flag(s_col[i], LV_OBJ_FLAG_HIDDEN,
+                            !(s_tile == tile_for_page(i) && !s_detail && s_pg == i));
+        }
+    }
+    if (s_detail_col) {
+        lv_obj_set_flag(s_detail_col, LV_OBJ_FLAG_HIDDEN, !(s_tile == 2 && s_detail));
+    }
+    /* 场景环：当前场景那张卡描一圈自己的色相，别的不描 —— 「当前居中」的高亮态。 */
+    for (int i = 0; i < ARRAY_LEN(PICKER_CELLS); i++) {
+        if (!s_scene_card[i]) continue;
+        bool cur = PICKER_CELLS[i].target == s_scene_pg;
+        lv_obj_set_style_border_width(s_scene_card[i], cur ? 3 : 0, 0);
+        lv_obj_set_style_border_opa(s_scene_card[i], LV_OPA_COVER, 0);
+        lv_obj_set_style_border_color(s_scene_card[i], lv_color_hex(PICKER_CELLS[i].hue), 0);
+    }
+}
+
+/* ---------- 入场动效（owner 2026-11-13：场景切换页要有动效） ----------
+ * 跨格跳转已改瞬切（muse_ui.c：一次划动只露一屏，不滚穿中心脸），动效落在
+ * 露出的那一屏内容上：场景环三张卡错峰升起，其余页整列轻轻 settle。translate_y
+ * 带着孩子一起移、不开销图层；每次先 lv_anim_delete 防重复动画堆叠。 */
+static void col_slide_cb(void *obj, int32_t v)
+{
+    lv_obj_set_style_translate_y((lv_obj_t *)obj, v, 0);
+}
+
+static void animate_column_in(lv_obj_t *col)
+{
+    if (!col) return;
+    lv_anim_delete(col, col_slide_cb);
+    lv_obj_set_style_translate_y(col, 24, 0);
+    lv_anim_t a;
+    lv_anim_init(&a);
+    lv_anim_set_var(&a, col);
+    lv_anim_set_exec_cb(&a, col_slide_cb);
+    lv_anim_set_values(&a, 24, 0);
+    lv_anim_set_duration(&a, 220);
+    lv_anim_set_path_cb(&a, lv_anim_path_ease_out);
+    lv_anim_start(&a);
+}
+
+static void animate_picker_cards(void)
+{
+    for (int i = 0; i < ARRAY_LEN(PICKER_CELLS); i++) {
+        lv_obj_t *card = s_scene_card[i];
+        if (!card) continue;
+        lv_anim_delete(card, col_slide_cb);
+        lv_obj_set_style_translate_y(card, 30, 0);
+        lv_anim_t a;
+        lv_anim_init(&a);
+        lv_anim_set_var(&a, card);
+        lv_anim_set_exec_cb(&a, col_slide_cb);
+        lv_anim_set_values(&a, 30, 0);
+        lv_anim_set_duration(&a, 260);
+        lv_anim_set_delay(&a, (uint32_t)i * 80);   /* 三张卡错峰升起 */
+        lv_anim_set_path_cb(&a, lv_anim_path_ease_out);
+        lv_anim_start(&a);
+    }
+}
+
+/* 露出的列变了才播：进脸/设置（无本组件列）把记号清空，下次进任何一格都重新播。 */
+static void entrance_anim(void)
+{
+    lv_obj_t *shown = NULL;
+    if (s_tile == 2 && s_detail) shown = s_detail_col;
+    else if (s_tile >= 2 && !s_detail) shown = s_col[s_pg];
+    if (shown == s_shown_col) return;
+    s_shown_col = shown;
+    if (!shown) return;
+    if (s_tile == 3 && s_pg == PG_PICKER) animate_picker_cards();
+    else animate_column_in(shown);
+}
+
+/* 把"现在露哪一格"同步进状态：按格挑该露的页（功能格用当前场景，氛围格用当前氛页，
+ * 场景环恒是 picker），收 L3，刷一次列的可见性并通报。不调 goto —— 露格那一步由
+ * 调用方（手势/圆点/dialog.action）先做，这里只跟着认。 */
+static void sync_tile(int t)
+{
+    s_tile = (int8_t)t;
+    s_detail = false;
+    if (t == 2)      s_pg = s_scene_pg;
+    else if (t == 3) s_pg = PG_PICKER;
+    else if (t == 4) s_pg = s_amb_pg;
+    apply();
+    entrance_anim();
+    report_now();
+}
+
+static void nav_to(int pg)
+{
+    if (pg == PG_FACE) {
+        muse_ui_show_face();
+        sync_tile(0);
+        return;
+    }
+    const int t = tile_for_page(pg);
+    if (t == 2) {
+        s_scene_pg = (int8_t)pg;   /* 记住"当前场景"，上滑回这一页 */
+        muse_pixel_set_scene(scene_of_page(pg));   /* 头像同步换装（B §3） */
+    } else if (t == 4) s_amb_pg = (int8_t)pg;     /* 记住"当前氛围"，右滑回这一页 */
+    muse_ui_goto_tile(t);   /* 把那一格滑进来（脸在中心，四格围它） */
+    sync_tile(t);
+}
+
+static void nav_back(void)
+{
+    /* owner 2026-11-13：所有「返回」一律回 Avatar，不再层级回退（详情/场景环
+     * 也直接回脸）。nav_to(PG_FACE) 里的 sync_tile(0) 会顺手清掉 s_detail。 */
+    nav_to(PG_FACE);
+}
+
+/* 详情那三行：点完立刻刷一次，不然到下一个 tick 之前屏上是上一个功能的值。 */
+static void detail_refresh(void)
+{
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+    carpet_link_view_t v;
+    carpet_link_view(&v);
+    const bool live = v.linked && v.gap_s <= 3;
+    char buf[72];
+    set_line(&s_detail_title, s_detail_name, COLOR_TEXT);
+    set_line(&s_detail_value, field_text(s_detail_field, &s, buf, sizeof buf),
+             live ? COLOR_TEXT : COLOR_DIM);
+    set_line(&s_detail_hint, live ? "最新一帧的值" : "3 秒没帧 · 是旧值",
+             live ? COLOR_DIM : COLOR_OFF);
+}
+
+static void detail_open(const row_def_t *def)
+{
+    s_detail_field = def->field;
+    s_detail_name = def->name;
+    s_detail = true;
+    s_detail_title.shown[0] = '\0';   /* 换功能了：必须重画，哪怕字一样 */
+    s_detail_value.shown[0] = '\0';
+    apply();
+    entrance_anim();
+    detail_refresh();
+    /* L3 不通报：s_pg 没变，report_now 的去重天然不发。 */
+}
+
+void carpet_page_goto(const char *page_name)
+{
+    /* 从链路任务调（dialog.action 的落地）：这里只记名字，翻页在 tick 里做。 */
+    if (!page_name || !page_name[0]) return;
+    for (int i = 0; i < PG_COUNT; i++) {
+        if (strcmp(page_name, PAGE_NAMES[i]) != 0) continue;
+        snprintf((char *)s_pending_name, sizeof s_pending_name, "%s", page_name);
+        s_pending_seq++;   /* 写完名字再涨号：UI 只认涨过的 */
+        return;
+    }
+    /* 认不出的名字：忽略 + 一条日志，不 ack、不报错。契约里 action 是只下行、
+     * 不要回执的，屏擅自回一条反倒多出两侧同时开口的可能。 */
+    ESP_LOGW(TAG, "unknown action page: %s", page_name);
+}
+
+void carpet_page_reshare(void)
+{
+    /* hello 之后补报一次当前页：少了这一条，重连后手机上那一格一直空着
+     *（App 的文案是"屏没报它在哪一页"），直到下一次真的翻页才复明。 */
+    s_reshare = true;
+}
+
+void carpet_page_notify_tile(int tile_index)
+{
+    if (tile_index == s_tile) return;
+    sync_tile(tile_index);   /* 滑走时收 L3，回来只见当前格该露的那一页 */
+}
+
+/* ---------- 触摸手势：B 的四方向 ---------- */
+
+/*
+ * docs/ROUND-SCREEN-GESTURES.md（owner 2026-11-13 拍「以 B 为准」），一次触摸只认一个动作：
+ *   下拉 ≥60px → 场景环（ring 格，picker）
+ *   上滑 ≥60px → 功能层（func 格，当前场景那一页）
+ *   左滑 ≥60px → 设置（Muse 那格）
+ *   右滑 ≥60px → 氛围（amb 格；已在氛围则在这几页间轮换）
+ *   单击空处   → 回脸（兜底；脸/设置那两格的点击归 Muse 自己）
+ * 位移优先于时长，横滑优先于竖滑。60px 约 5.7mm（266dpi），是算出来的，
+ * 还没在真玻璃上称过。长按 B 没派导航动作（SOS 圆钮那条不适用：这屏没有圆钮），只判不发。
+ *
+ * 互斥（B §2.1）：SOS 布防/待发/已发四手势全冻结；对话中上下滑保留、左右滑忽略；
+ * 熄屏全无效。这三道在 gesture_settle / drag_timer 里判。
+ *
+ * 为什么轮询 indev 而不是挂 LV_EVENT_GESTURE：这个构建里手势识别是关的
+ * （开机日志 LV_USE_GESTURE_RECOGNITION 那一行），只有单点指针事件；而且每一格
+ * 都在吃 CLICKED，事件冒泡到哪一层不由我们定 —— indev 的点是唯一和命中测试无关的事实。
+ * A 那套（左右滑 card_next / 上下滑明细层）的**判定引擎**留着，**方向语义**换成 B。
+ */
+#define SWIPE_MIN_PX  60
+#define LONG_PRESS_MS 800
+
+static lv_indev_t *s_ptr;
+static bool s_down;
+static int s_x0, s_y0, s_x1, s_y1;
+static uint32_t s_press_tick;
+/* 按下点落在按钮/条目卡上：那一下归它自己的 CLICKED，手势不抢也不重复发。 */
+static bool s_on_control;
+
+/* `>gest` 台架口：不碰真玻璃也能把四条判定各称一遍。只写整数、不碰 LVGL 对象，
+ * 所以可以从串口那条任务调；翻页那一步留给 tick（那才是 LVGL 任务）。 */
+static volatile bool s_bench;
+static volatile bool s_bench_nav;
+static volatile int s_bench_scene;   /* >scene=<n>：串口立记号，LVGL 任务里选场景+换装+回脸 */
+static bool s_bench_down;
+static int s_bench_x0, s_bench_y0, s_bench_x1, s_bench_y1;
+static uint32_t s_bench_until;
+static uint32_t s_bench_hold;
+
+static lv_indev_t *pointer_indev(void)
+{
+    for (lv_indev_t *d = lv_indev_get_next(NULL); d; d = lv_indev_get_next(d)) {
+        if (lv_indev_get_type(d) == LV_INDEV_TYPE_POINTER) return d;
+    }
+    return NULL;
+}
+
+/* 这一点是不是落在真会响应点击的东西上。容器一律摘了 CLICKABLE（见 make_*），
+ * 所以这里认出来的只有按钮和条目卡 —— 不摘的话整块玻璃都算"控件"，
+ * 手势一条也发不出去。root 是那一格的根对象，它自己不算控件，得跳过。 */
+static bool hits_control(lv_obj_t *o, const lv_point_t *p, lv_obj_t *root)
+{
+    if (!o || lv_obj_has_flag(o, LV_OBJ_FLAG_HIDDEN)) return false;
+    if (o != root && lv_obj_hit_test(o, p)) return true;
+    const uint32_t n = lv_obj_get_child_count(o);
+    for (uint32_t i = 0; i < n; i++) {
+        if (hits_control(lv_obj_get_child(o, (int32_t)i), p, root)) return true;
+    }
+    return false;
+}
+
+/* 现在露着的那一格的根对象。脸/设置没有本组件的控件，返回 NULL（命中测试不算）。 */
+static lv_obj_t *active_tile_obj(void)
+{
+    if (s_tile == 2) return s_func_tile;
+    if (s_tile == 3) return s_ring_tile;
+    if (s_tile == 4) return s_amb_tile;
+    return NULL;
+}
+
+static void gesture_settle(void)
+{
+    enum { G_SWIPE_X, G_SWIPE_Y, G_HOLD, G_TAP };
+    static const char *const G_NAME[] = { "横滑", "竖滑", "长按", "单击" };
+    const int dx = s_x1 - s_x0;
+    const int dy = s_y1 - s_y0;
+    const uint32_t held = lv_tick_diff(lv_tick_get(), s_press_tick);
+    int g;
+    if (abs(dx) >= SWIPE_MIN_PX && abs(dx) >= abs(dy)) g = G_SWIPE_X;
+    else if (abs(dy) >= SWIPE_MIN_PX)                    g = G_SWIPE_Y;
+    else if (held >= LONG_PRESS_MS)                      g = G_HOLD;
+    else                                                 g = G_TAP;
+    /* 这一行的字被 firmware/screen/tools/gesture_log.py 的正则认着，改字要连着改那份。 */
+    ESP_LOGI(TAG, "抬手 dx=%d dy=%d held=%ums → 判为%s（阈值 %dpx）",
+             dx, dy, (unsigned)held, G_NAME[g], SWIPE_MIN_PX);
+
+    /* B §2.1 互斥。熄屏全无效（drag_timer 已拦一道，这里再兜底）。 */
+    if (muse_ui_dark()) return;
+    carpet_state_view_t st;
+    carpet_link_state(&st);
+    /* SOS 布防/待发/已发：四手势全冻结，屏上只有 SOS 进度。"正常"以外的值都算进行中。 */
+    if (st.sos[0] && strcmp(st.sos, "正常") != 0) {
+        ESP_LOGI(TAG, "SOS 进行中（%s），四手势冻结", st.sos);
+        return;
+    }
+    if (s_on_control) {
+        ESP_LOGI(TAG, "按下点在控件上，这一下归它自己的点击，手势不抢");
+        return;
+    }
+    /* 对话进行中：上下滑保留（边聊边切场景/看功能），左右滑忽略。判据用契约的 dialog 行
+     * （最近一句、5 秒内非空）—— 这是屏侧拿得到的"在对话"信号，不另引一套状态。 */
+    const bool talking = st.dialog[0] != '\0';
+
+    switch (g) {
+    case G_SWIPE_X:
+        if (talking) { ESP_LOGI(TAG, "对话中，左右滑忽略"); return; }
+        if (s_tile != 0) {
+            /* owner 2026-11-14：Avatar 是中心枢纽。在任何外页横滑都先回中心脸，
+             * 不再按绝对方向跳到对侧外页（那会跳过中心）。唯一例外：氛围页右滑
+             * 仍是时钟/相册/照片轮换（留在氛围、不穿中心）。 */
+            if (dx > 0 && s_tile == 4) {
+                const int8_t next = s_amb_pg == PG_CLOCK ? PG_GALLERY
+                                  : s_amb_pg == PG_GALLERY ? PG_PHOTO : PG_CLOCK;
+                nav_to(next);
+                ESP_LOGI(TAG, "氛围页右滑 → 轮换到 %s", PAGE_NAMES[next]);
+            } else {
+                nav_to(PG_FACE);
+                ESP_LOGI(TAG, "外页横滑 → 回中心 Avatar");
+            }
+            break;
+        }
+        if (dx < 0) {                       /* 中心脸：左滑 → 设置 */
+            muse_ui_goto_tile(1);
+            sync_tile(1);
+            ESP_LOGI(TAG, "左滑 → 设置");
+        } else {                            /* 中心脸：右滑 → 氛围（默认页由设置选，B §5） */
+            const int8_t def = muse_settings_album_default() ? PG_PHOTO : PG_CLOCK;
+            nav_to(def);
+            ESP_LOGI(TAG, "右滑 → 氛围（%s）", PAGE_NAMES[def]);
+        }
+        break;
+    case G_SWIPE_Y:
+        if (s_tile != 0) {
+            /* 外页竖滑也先回中心脸，不跳到对侧外页（owner 2026-11-14）。 */
+            nav_to(PG_FACE);
+            ESP_LOGI(TAG, "外页竖滑 → 回中心 Avatar");
+            break;
+        }
+        if (dy > 0) { nav_to(PG_PICKER);   ESP_LOGI(TAG, "下拉 → 场景环"); }
+        else        { nav_to(s_scene_pg);  ESP_LOGI(TAG, "上滑 → 功能层（%s）", PAGE_NAMES[s_scene_pg]); }
+        break;
+    case G_HOLD:
+        /* B 没给长按派导航动作（SOS 圆钮那条不适用：这屏没有圆钮）。只判不发。 */
+        ESP_LOGI(TAG, "长按：B 未派动作，不动");
+        break;
+    default:   /* G_TAP：点空处回脸（兜底）。设置那一格的点击归 Muse 自己。 */
+        if (s_tile == 2 || s_tile == 3 || s_tile == 4) {
+            nav_to(PG_FACE);
+            ESP_LOGI(TAG, "单击空处 → 回脸");
+        } else if (s_tile == 0) {
+            /* B §1 的唯一兜底：点 Avatar 进对话。立记号，采集任务下一拍走和唤醒词
+             * 同一条 talk_to_phone（闸一道都不放宽）。脸那格没有本组件控件，点击
+             * 干净地落到这里（active_tile_obj 返回 NULL → s_on_control=false）。 */
+            carpet_mic_talk_request();
+            ESP_LOGI(TAG, "点 Avatar → 进对话");
+        }
+        break;
+    }
+}
+
+static void drag_timer(lv_timer_t *t)
+{
+    (void)t;
+    /* 熄屏：所有手势无效（B §2.1）。睡眠盖那一下归 Muse 叫醒，这里不跟。 */
+    if (muse_ui_dark()) { s_down = false; return; }
+    /* 台架那一下要等 tick 把脸滑进来：四方向都从默认态（脸）起判，才称得准。 */
+    if (s_bench && s_bench_nav) return;
+
+    lv_point_t p;
+    bool down;
+    if (s_bench) {
+        if (!s_bench_down) {
+            p.x = s_bench_x0; p.y = s_bench_y0; down = true;
+            s_bench_down = true;
+        } else if ((int32_t)(lv_tick_get() - s_bench_until) < 0) {
+            p.x = s_bench_x0; p.y = s_bench_y0; down = true;
+        } else {
+            p.x = s_bench_x1; p.y = s_bench_y1; down = false;
+        }
+    } else {
+        if (!s_ptr) {
+            s_ptr = pointer_indev();
+            if (!s_ptr) return;
+        }
+        lv_indev_get_point(s_ptr, &p);
+        down = (lv_indev_get_state(s_ptr) == LV_INDEV_STATE_PRESSED);
+    }
+
+    if (down && !s_down) {
+        s_down = true;
+        s_x0 = s_x1 = p.x;
+        s_y0 = s_y1 = p.y;
+        s_press_tick = lv_tick_get();
+        /* 台架的按住时长从这一拍算，不从串口任务那一拍算 —— 按下边沿要等
+         * tick 清 s_bench_nav，最多 250ms，在那边定截止时刻就白吃掉这一段。 */
+        if (s_bench) s_bench_until = s_press_tick + s_bench_hold;
+        lv_obj_t *at = active_tile_obj();
+        s_on_control = at && hits_control(at, &p, at);
+        ESP_LOGI(TAG, "按下 (%d,%d) 格=%d 页=%s", p.x, p.y, (int)s_tile,
+                 s_tile >= 2 ? PAGE_NAMES[s_pg] : (s_tile == 0 ? "face" : "settings"));
+        return;
+    }
+    if (s_down) {
+        /* 每一拍都记终点，抬手那一拍也记 —— 少了这一句 dx/dy 就永远是 0。 */
+        s_x1 = p.x;
+        s_y1 = p.y;
+        if (!down) {
+            s_down = false;
+            s_bench = false;
+            gesture_settle();   /* 四方向从任何一格都判；互斥/回脸在 settle 里分 */
+        }
+    }
+}
+
+static void bench_gesture(int dx, int dy, int hold_ms, bool reset_face)
+{
+    /* 起点挑在空玻璃上：竖划走 x=40（列从 x=83 起），横划走 y=30（标题带之上），
+     * 两个点都在 233 半径的圆里，也都躲开了条目卡和「返回」。 */
+    s_bench_x0 = (dy != 0 && dx == 0) ? 40 : 200;
+    s_bench_y0 = (dy != 0 && dx == 0) ? 200 : 30;
+    s_bench_x1 = s_bench_x0 + dx;
+    s_bench_y1 = s_bench_y0 + dy;
+    s_bench_hold = (uint32_t)(hold_ms > 0 ? hold_ms : 120);
+    s_bench_until = lv_tick_get() + s_bench_hold;   /* 真值在按下那一拍重算 */
+    s_bench_down = false;
+    /* reset_face=true：tick 先回脸再判（中心四方向扇出）；false：从当前格判
+     * （外页划动回中心，owner 2026-11-14 那条修复要在外页起判才称得到）。 */
+    s_bench_nav = reset_face;
+    s_bench = true;   /* 最后立这个记号：drag_timer 只认它 */
+    printf("@gest 造 dx=%d dy=%d hold=%dms reset=%d（>carpet 看页，日志看判为哪一条）\n",
+           dx, dy, hold_ms > 0 ? hold_ms : 120, (int)reset_face);
+}
+
+void carpet_page_gesture_bench(int dx, int dy, int hold_ms)
+{
+    bench_gesture(dx, dy, hold_ms, true);
+}
+
+void carpet_page_gesture_bench_from(int dx, int dy, int hold_ms)
+{
+    bench_gesture(dx, dy, hold_ms, false);
+}
+
+/* `>scene=<n>` 台架口：和点一张场景卡同一条路（设当前场景 + 换装 + 回脸），
+ * 为的是把换装调色单独截图证。串口任务只写一个整数，落地都在 LVGL 任务里。 */
+void carpet_page_scene_bench(int n)
+{
+    s_bench_scene = n;
+}
+
+/* ---------- 事件 ---------- */
+
+static void on_row_clicked(lv_event_t *e)
+{
+    const row_def_t *def = lv_event_get_user_data(e);
+    if (!def) return;
+    if (def->target >= 0) nav_to(def->target);
+    else detail_open(def);
+}
+
+static void on_back_clicked(lv_event_t *e)
+{
+    (void)e;
+    nav_back();
+}
+
+static void on_poke_clicked(lv_event_t *e)
+{
+    (void)e;
+    /* 契约里单击就是 poke，手机的 CardPolicy 拿它开一段互动窗口。
+     * 这里只入队：socket 发送在 carpet_cmd 任务里，LVGL 任务里阻塞两秒
+     * 是把整个界面冻住。 */
+    carpet_link_send("poke", 0);
+}
+
+static void on_btn_clicked(lv_event_t *e)
+{
+    /* 下标就是屏幕上的顺序，也对应契约的三条：0 上一张 1 下一张 2 交回 */
+    const int idx = (int)(intptr_t)lv_event_get_user_data(e);
+    if (idx < 2) carpet_link_send("card_next", idx == 0 ? -1 : 1);
+    else         carpet_link_send("card_auto", 0);
+}
+
+/* ---------- 建页 ---------- */
+
+static void build_rows(lv_obj_t *col, const page_def_t *d, page_lines_t *pl)
+{
+    for (int i = 0; i < d->n_rows; i++) {
+        const row_def_t *def = &d->rows[i];
+        lv_obj_t *c = make_card(col, true, ROW_H);
+        make_label(c, s_big, COLOR_TEXT, def->name);
+        pl->dot[i] = make_dot(c);
+        make_value(c, &pl->rows[i]);
+        lv_obj_add_event_cb(c, on_row_clicked, LV_EVENT_CLICKED, (void *)def);
+    }
+}
+
+/* B §3：点一张场景卡 = 选定这个场景。设当前场景 + 头像换装，然后回脸看换装
+ * （不是跳功能页 —— 上滑才是看功能）。换装走 muse_pixel 调色，约 0.5 s 过渡。 */
+static void on_scene_clicked(lv_event_t *e)
+{
+    const cell_def_t *c = lv_event_get_user_data(e);
+    if (!c) return;
+    s_scene_pg = c->target;
+    muse_pixel_set_scene(c->scene);
+    ESP_LOGI(TAG, "选场景 %s → 换装 scene=%d", c->name, (int)c->scene);
+    nav_to(PG_FACE);
+}
+
+/* B §3 场景环：三域（车/家/对话）横向三张卡，当前场景描边高亮（apply 里刷）。
+ * 点一张卡 = 选定场景 + 头像换装 + 回脸。值一个都不显示 —— 入口不许跟着帧变，
+ * 那条红线从上一版就有，这版照留。时钟/相册归右滑氛围层，不再混进这里。 */
+static lv_obj_t *build_picker(lv_obj_t *tile, page_lines_t *pl)
+{
+    lv_obj_t *box = make_box(tile, GRID_W, GRID_H);
+
+    lv_obj_t *band = make_band(box, SUB_H);
+    pl->sub.label = make_label(band, s_small, COLOR_DIM, "未接入");
+    snprintf(pl->sub.shown, sizeof pl->sub.shown, "未接入");
+    lv_obj_center(pl->sub.label);   /* 顶部那一带圆屏只剩 269 的宽，靠左边摆会被裁 */
+
+    /* 三张卡一排，竖直居中在副行和回脸条之间（外角逐张称过，都在圆内）。 */
+    const int row_y = 120;
+    for (int i = 0; i < ARRAY_LEN(PICKER_CELLS); i++) {
+        const cell_def_t *c = &PICKER_CELLS[i];
+        lv_obj_t *card = lv_button_create(box);
+        lv_obj_remove_style_all(card);
+        lv_obj_set_size(card, GRID_CELL, GRID_CELL);
+        lv_obj_set_pos(card, i * (GRID_CELL + GRID_GAP), row_y);
+        lv_obj_set_style_radius(card, 26, 0);
+        lv_obj_set_style_bg_opa(card, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(card, lv_color_hex(COLOR_CARD), 0);
+        lv_obj_set_style_bg_color(card, lv_color_hex(COLOR_CARD_PRESSED), LV_STATE_PRESSED);
+        lv_obj_remove_flag(card, LV_OBJ_FLAG_SCROLLABLE);
+        s_scene_card[i] = card;
+
+        /* 底托只有颜色是 20% 的透明度，字是实的：AMOLED 上黑底 + 淡色块，
+         * 比给字描边便宜，也不会让 30px 的笔画糊成一团。 */
+        lv_obj_t *disc = lv_obj_create(card);
+        lv_obj_remove_style_all(disc);
+        lv_obj_set_size(disc, GRID_ROUND, GRID_ROUND);
+        lv_obj_align(disc, LV_ALIGN_TOP_MID, 0, 12);
+        lv_obj_set_style_radius(disc, LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_bg_opa(disc, LV_OPA_20, 0);
+        lv_obj_set_style_bg_color(disc, lv_color_hex(c->hue), 0);
+        lv_obj_remove_flag(disc, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_remove_flag(disc, LV_OBJ_FLAG_CLICKABLE);   /* 点它等于点这张卡 */
+        lv_obj_center(make_label(disc, s_glyph, c->hue, c->glyph));
+
+        lv_obj_t *nm = make_label(card, s_small, COLOR_TEXT, c->name);
+        lv_obj_set_width(nm, GRID_CELL);
+        lv_obj_set_style_text_align(nm, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_align(nm, LV_ALIGN_TOP_MID, 0, 78);
+
+        lv_obj_add_event_cb(card, on_scene_clicked, LV_EVENT_CLICKED, (void *)c);
+    }
+
+    lv_obj_t *back = make_pill(box, COL_W, BTN_H, "返回", on_back_clicked, NULL);
+    lv_obj_set_pos(back, (GRID_W - COL_W) / 2, GRID_BACK_Y);
+
+    lv_obj_set_flag(box, LV_OBJ_FLAG_HIDDEN, true);
+    return box;
+}
+
+/* 卡片那一排按钮：只有真的会动手机卡片的页才有。 */
+static void build_card_bar(lv_obj_t *col)
+{
+    static const char *const btn_text[3] = { "上一张", "下一张", "交回" };
+    lv_obj_t *bar = lv_obj_create(col);
+    lv_obj_remove_style_all(bar);
+    lv_obj_set_size(bar, lv_pct(100), BTN_H);
+    lv_obj_remove_flag(bar, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(bar, LV_OBJ_FLAG_CLICKABLE);   /* 纯容器，见 make_card 那条注释 */
+    lv_obj_set_flex_flow(bar, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(bar, LV_FLEX_ALIGN_SPACE_BETWEEN, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    for (int i = 0; i < 3; i++) {
+        lv_obj_t *b = lv_button_create(bar);
+        lv_obj_remove_style_all(b);
+        lv_obj_set_size(b, BTN_W, BTN_H);
+        lv_obj_set_style_radius(b, 18, 0);
+        lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(b, lv_color_hex(COLOR_CARD), 0);
+        lv_obj_set_style_bg_color(b, lv_color_hex(COLOR_CARD_PRESSED), LV_STATE_PRESSED);
+        lv_obj_remove_flag(b, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_center(make_label(b, s_small, COLOR_ACCENT, btn_text[i]));
+        lv_obj_add_event_cb(b, on_btn_clicked, LV_EVENT_CLICKED, (void *)(intptr_t)i);
+    }
+}
+
+/* 钟面（氛围层第一页）：返回 + 一块大数字时:分 + 日期 + 下次过境。整列居中。
+ * 三行直接挂 flex 列、按各自行高占位（76px 那档行高约 110，22px 约 32），总高约
+ * 44+6+110+6+32+6+32=236，最外 dy≈118 ⇒ 半径 sqrt(150²+118²)=191<233，落在圆内。
+ * 内容用 Ink 蓝系；返回药丸仍是共享的紫（见 INK_ 那段注释）。 */
+static void build_clock(lv_obj_t *col)
+{
+    make_pill(col, COL_W, BTN_H, "返回", on_back_clicked, NULL);
+
+    /* 不套定高 band：band 的猜高度会和字体真实行高对不上、上下溢出。列是
+     * LV_SIZE_CONTENT，让每行按自然行高占位、文字在 COL_W 内居中，最稳。
+     * 没同步上先摆 "--:--"，不摆假时间。 */
+    s_clock_hero.label = make_label(col, s_clock, INK_TEXT_HIGH, "--:--");
+    lv_obj_set_width(s_clock_hero.label, COL_W);
+    lv_obj_set_style_text_align(s_clock_hero.label, LV_TEXT_ALIGN_CENTER, 0);
+    snprintf(s_clock_hero.shown, sizeof s_clock_hero.shown, "--:--");
+
+    s_clock_date.label = make_label(col, s_small, INK_WAIT, "时间同步中");
+    lv_obj_set_width(s_clock_date.label, COL_W);
+    lv_obj_set_style_text_align(s_clock_date.label, LV_TEXT_ALIGN_CENTER, 0);
+    snprintf(s_clock_date.shown, sizeof s_clock_date.shown, "时间同步中");
+
+    s_clock_pass.label = make_label(col, s_small, INK_TEXT_LOW, "等首帧");
+    lv_obj_set_width(s_clock_pass.label, COL_W);
+    lv_obj_set_style_text_align(s_clock_pass.label, LV_TEXT_ALIGN_CENTER, 0);
+    /* sat 那句可能长（char[40]）：截一行加省略号，别让它折行把列顶出圆。 */
+    lv_label_set_long_mode(s_clock_pass.label, LV_LABEL_LONG_MODE_DOTS);
+    snprintf(s_clock_pass.shown, sizeof s_clock_pass.shown, "等首帧");
+
+    lv_obj_set_flag(col, LV_OBJ_FLAG_HIDDEN, true);
+}
+
+/* 每帧只读 time()/localtime_r()（carpet_link_wallclock 里），不碰链路锁、不阻塞。
+ * 同步上了就画真时真日期；没同步上回落 "--:--" + 「时间同步中」（琥珀），绝不摆假时间。
+ * 过境行直接搬 sat 那句活倒计时（"已锁定 下次2:33"），没有就「等首帧」。 */
+static void clock_refresh(const carpet_state_view_t *s, bool live)
+{
+    int year, mon, mday, hour, min;
+    char buf[72];
+    if (carpet_link_wallclock(&year, &mon, &mday, &hour, &min)) {
+        snprintf(buf, sizeof buf, "%02d:%02d", hour, min);
+        set_line(&s_clock_hero, buf, INK_TEXT_HIGH);
+        snprintf(buf, sizeof buf, "%04d-%02d-%02d", year, mon, mday);
+        set_line(&s_clock_date, buf, INK_TEXT_MID);
+    } else {
+        set_line(&s_clock_hero, "--:--", INK_TEXT_HIGH);
+        set_line(&s_clock_date, "时间同步中", INK_WAIT);
+    }
+    set_line(&s_clock_pass, s->sat[0] ? s->sat : "等首帧",
+             live ? INK_SAT : INK_TEXT_LOW);
+}
+
+/* 场景页（L2）从上到下：返回、标题、条目、（要的话）"在画 X"+ 三个按钮。
+ * L1 不走这里，它有自己的宫格。 */
+static void build_page(int pg, lv_obj_t *col)
+{
+    const page_def_t *d = &PAGE_DEFS[pg];
+    page_lines_t *pl = &s_lines[pg];
+
+    make_pill(col, COL_W, BTN_H, "返回", on_back_clicked, NULL);
+    make_label(make_band(col, TITLE_H), s_big, COLOR_TEXT, d->title);
+    build_rows(col, d, pl);
+    if (d->flags & PF_CARD_BAR) {
+        /* 这一行是那三个按钮的上下文：它们切的是手机上那张卡，不是这一页。 */
+        pl->sub.label = make_label(make_band(col, SUB_H), s_small, COLOR_DIM, "在画 —");
+        snprintf(pl->sub.shown, sizeof pl->sub.shown, "在画 —");
+        build_card_bar(col);
+    } else if (d->flags & PF_SUB_STATIC) {
+        pl->sub.label = make_label(make_band(col, SUB_H), s_small, COLOR_DIM, GALLERY_NOTE);
+        snprintf(pl->sub.shown, sizeof pl->sub.shown, "%s", GALLERY_NOTE);
+    }
+    lv_obj_set_flag(col, LV_OBJ_FLAG_HIDDEN, true);
+}
+
+void carpet_page_build(lv_obj_t *func_tile, lv_obj_t *ring_tile, lv_obj_t *amb_tile)
+{
+    if (!func_tile || !ring_tile || !amb_tile) return;
+    fonts_init();
+    /* 三格各自的根：手势命中测试只查现在露着的那一格（active_tile_obj）。 */
+    s_func_tile = func_tile;
+    s_ring_tile = ring_tile;
+    s_amb_tile = amb_tile;
+
+    for (int i = PG_PICKER; i < PG_COUNT; i++) {
+        const int t = tile_for_page(i);
+        lv_obj_t *tile = (t == 3) ? ring_tile : (t == 4) ? amb_tile : func_tile;
+        if (PAGE_DEFS[i].flags & PF_GRID) {
+            s_col[i] = build_picker(tile, &s_lines[i]);
+            continue;
+        }
+        s_col[i] = make_col(tile);
+        if (i == PG_CLOCK) build_clock(s_col[i]);   /* 钟面整页特殊：大数字，不走条目表 */
+        else               build_page(i, s_col[i]);
+    }
+
+    /* L3：一份复用的详情，住功能格（条目都在功能页上）。复用是有硬约束在 ——
+     * 绝不在自己的点击回调里删对象，那会让 LVGL 回到已经释放的指针。 */
+    s_detail_col = make_col(func_tile);
+    make_pill(s_detail_col, COL_W, BTN_H, "返回", on_back_clicked, NULL);
+    s_detail_title.label = make_label(make_band(s_detail_col, TITLE_H), s_big, COLOR_TEXT, "");
+    s_detail_title.shown[0] = '\0';
+
+    lv_obj_t *dv = lv_obj_create(s_detail_col);
+    lv_obj_remove_style_all(dv);
+    lv_obj_set_size(dv, COL_W, LV_SIZE_CONTENT);
+    lv_obj_remove_flag(dv, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(dv, LV_OBJ_FLAG_CLICKABLE);   /* 纯容器，见 make_card 那条注释 */
+    s_detail_value.label = make_label(dv, s_big, COLOR_TEXT, "");
+    s_detail_value.shown[0] = '\0';
+    lv_label_set_long_mode(s_detail_value.label, LV_LABEL_LONG_MODE_WRAP);
+    lv_obj_set_width(s_detail_value.label, COL_W - 32);
+
+    s_detail_hint.label = make_label(make_band(s_detail_col, SUB_H), s_small, COLOR_DIM, "");
+    s_detail_hint.shown[0] = '\0';
+    make_pill(s_detail_col, COL_W, BTN_H, "戳一下", on_poke_clicked, NULL);
+    lv_obj_set_flag(s_detail_col, LV_OBJ_FLAG_HIDDEN, true);
+
+    /* 划动判定靠轮询：40ms 一次。一次 60 px 的划动最快也就 100ms 出头，采得到两三点。 */
+    lv_timer_create(drag_timer, 40, NULL);
+
+    apply();
+}
+
+void carpet_page_tick(void)
+{
+    /* 首屏的答句先翻 —— 露的正是脸那一格时下面那句 return 不会跑到，
+     * 而那一格才是这句答句该出现的地方。 */
+    carpet_link_face_tick();
+
+    /* 台架那一下先回脸：四方向都从默认态（脸）起判才称得准（串口任务不许动 LVGL 对象）。 */
+    if (s_bench_nav) {
+        s_bench_nav = false;
+        nav_to(PG_FACE);
+    }
+
+    /* >scene=<n>：和点场景卡同一条路，落在 LVGL 任务里（串口只立了记号）。 */
+    if (s_bench_scene) {
+        int n = s_bench_scene;
+        s_bench_scene = 0;
+        if (n >= 1 && n <= ARRAY_LEN(PICKER_CELLS)) {
+            const cell_def_t *c = &PICKER_CELLS[n - 1];
+            s_scene_pg = c->target;
+            muse_pixel_set_scene(c->scene);
+            ESP_LOGI(TAG, "选场景 %s → 换装 scene=%d", c->name, (int)c->scene);
+            nav_to(PG_FACE);
+        }
+    }
+
+    if (s_reshare) {
+        s_reshare = false;
+        s_reported[0] = '\0';
+        report_now();
+    }
+
+    /* 手机在答句里带的跳页在这里落地 —— 上面那些都要动 LVGL 的对象。 */
+    if (s_pending_seq != s_applied_seq) {
+        s_applied_seq = s_pending_seq;
+        char want[16];
+        snprintf(want, sizeof want, "%s", (const char *)s_pending_name);
+        for (int i = 0; i < PG_COUNT; i++) {
+            if (strcmp(want, PAGE_NAMES[i]) == 0) {
+                nav_to(i);
+                break;
+            }
+        }
+    }
+
+    carpet_link_view_t v;
+    carpet_link_view(&v);
+
+    if (s_tile < 2) return;   /* 脸和设置那格由 Muse 自己画，这一页一个字都不改 */
+
+    if (s_detail) {
+        detail_refresh();
+        return;
+    }
+
+    /* 只更新露着的那一页：tiny_ttf 的字模是现算的，把六页全刷一遍是白付的钱。 */
+    const page_def_t *d = &PAGE_DEFS[s_pg];
+    page_lines_t *pl = &s_lines[s_pg];
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+    /* 3 秒没帧 = 服务端还在但话说完了（或者热点断了），契约要求保留最后一帧，
+     * 所以不清屏，只统一转成灰。 */
+    const bool live = v.linked && v.gap_s <= 3;
+
+    if (s_pg == PG_PICKER) {
+        /* 第一行只说链路活没活 —— 现场"按了没反应"十次有八次是这一行没到位。 */
+        if (!v.wifi_up) {
+            set_line(&pl->sub, "等网络", COLOR_OFF);
+        } else if (!v.linked) {
+            set_line(&pl->sub, "未接入", COLOR_OFF);
+        } else if (v.gap_s == UINT32_MAX) {
+            set_line(&pl->sub, "等首帧", COLOR_OFF);
+        } else if (v.gap_s > 10) {
+            set_line(&pl->sub, "掉线重连", COLOR_OFF);
+        } else if (v.gap_s > 3) {
+            char buf[40];
+            snprintf(buf, sizeof buf, "卡%lu秒", (unsigned long)v.gap_s);
+            set_line(&pl->sub, buf, COLOR_OFF);
+        } else {
+            set_line(&pl->sub, "已接入", COLOR_ACCENT);   /* 契约号只在串口日志里（carpet_link 的 linked 那行） */
+        }
+    } else if (d->flags & PF_CARD_BAR) {
+        /* 这一行是那三个按钮的上下文：它们切的是手机上那张卡，不是这一页。 */
+        char card[48];
+        snprintf(card, sizeof card, "在画 %s", s.card[0] ? s.card : "—");
+        set_line(&pl->sub, card, live ? COLOR_TEXT : COLOR_DIM);
+    } else if (s_pg == PG_CLOCK) {
+        clock_refresh(&s, live);   /* 钟面：读墙钟 + 搬 sat 倒计时，n_rows=0 下面那圈不跑 */
+    }
+    /* 剩下那页（图片播放）的副行是写死的一句话，帧里没有对应的东西，不碰。 */
+
+    /* 条目行的值。L1 在表里 n_rows=0（宫格不走 rows），所以这一条对 L1 压根不跑 ——
+     * 换来的是"入口不许跟着帧变"这条红线写在结构里。 */
+    char buf[72];
+    for (int i = 0; i < d->n_rows; i++) {
+        int field = d->rows[i].field;
+        set_line(&pl->rows[i], field_text(field, &s, buf, sizeof buf),
+                 field_color(field, &s, live));
+        /* 点的是"这一条是到点的养护"，不是"这一行有值"：别的卡、别的句子都不亮。
+         * 认的两行各有其道理 —— 对话那一行装的就是那句养护话（它走 dialog 帧上来），
+         * 情绪那一行直接写着"担心"。详情的 L3 不点数：那一页整页都在说这一条。 */
+        if (pl->dot[i]) {
+            bool mark = s.maint_worried && (field == F_DIALOG || field == F_EMOTION);
+            lv_obj_set_flag(pl->dot[i], LV_OBJ_FLAG_HIDDEN, !mark);
+        }
+    }
+}
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_page.h b/esp32/components/muse/carpet/carpet_page.h
new file mode 100644
index 0000000..4ec0f02
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_page.h
@@ -0,0 +1,63 @@
+/*
+ * 场景页（L1 选场景 / L2 场景 / L3 功能详情）住在 muse_ui.c 建的那格 tile 里。
+ *
+ * 分权：**在哪一页归屏，这一页里说什么归手机**（protocol/screen-link.md）。
+ * 所以这一页的翻页是本地动作，不等手机往返；切完发一条 `page_report` —— 那是**通报**，
+ * 不是申请，手机不许驳回也不该被屏等回执。L3（功能详情）**不报**：手机上只有场景这一层，
+ * 报得越深，两侧各自说话的机会越多。
+ *
+ * 只在 LVGL 任务里跑（muse_ui.c 的 update_chrome 调 tick），
+ * 数据一律从 carpet_link_view() / carpet_link_state() 读，这里不发起任何网络动作。
+ */
+
+#pragma once
+
+#include "sdkconfig.h"
+#if CONFIG_MUSE_CARPET_CARDS
+
+#include "lvgl.h"
+
+/* LVGL task only: builds the page tree across the three carpet tiles muse_ui.c
+ * created — func（上滑功能层）/ ring（下拉场景环）/ amb（右滑氛围）. */
+void carpet_page_build(lv_obj_t *func_tile, lv_obj_t *ring_tile, lv_obj_t *amb_tile);
+
+/* LVGL task only: pulls the link state onto the labels, at the chrome tick. */
+void carpet_page_tick(void);
+
+/*
+ * LVGL task only: 五格 tile 现在露的是哪一格（0 脸 / 1 设置 / 2 功能 / 3 场景环 / 4 氛围）。
+ * 变了就通报一次；**设置那一格不报** —— 契约的 ScreenPage 里没有 settings，
+ * 手机端对认不出的页名一律拒收，而拒收在屏上没有任何反馈，静默留着比报错更难查。
+ */
+void carpet_page_notify_tile(int tile_index);
+
+/* 当前该报的页名（脸那格是 "face"，L3 报它父场景的名）。给串口回读用。 */
+const char *carpet_page_current_name(void);
+
+/*
+ * 链路刚建起来时（hello 之后）补报一次当前页。少了这一条，重连之后手机上那一格
+ * 会一直空着（App 的文案是「屏没报它在哪一页」），直到下一次真的翻页才复明。
+ * 从链路任务调：它只清一个去重缓存并把命令塞进队列，不碰 LVGL。
+ */
+void carpet_page_reshare(void);
+
+/* 手机在答句里带着跳页（dialog.action）时调：切过去，和本地翻页同一条路。 */
+void carpet_page_goto(const char *page_name);
+
+/*
+ * `>gest` 台架口：本机造一次触摸（起点在空玻璃上，拖 dx/dy，按住 hold_ms 再抬手），
+ * 走的是和真手指**同一条**判定路 —— 为的是把"手势判定 + 上行"和"真玻璃采点"分开证。
+ * 可以从串口任务调：它只写几个整数，翻页和判定都在 LVGL 任务里做。
+ */
+void carpet_page_gesture_bench(int dx, int dy, int hold_ms);
+
+/* `>gestfrom` 台架口：和上面同一条判定路，但**不先回脸**——从当前露着的那一格起判。
+ * 为的是称 owner 2026-11-14 那条「外页划动回中心」：先 >gestfrom 到外页，再 >gestfrom
+ * 划一下，看是不是回中心脸（而不是跳到对侧外页）。 */
+void carpet_page_gesture_bench_from(int dx, int dy, int hold_ms);
+
+/* `>scene=<n>` 台架口：选定第 n 个场景（1 车 / 2 亲子 / 3 对话）+ 头像换装 + 回脸，
+ * 和点一张场景卡同一条路。串口任务只写一个整数，落地在 LVGL 任务里。 */
+void carpet_page_scene_bench(int n);
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_wake.c b/esp32/components/muse/carpet/carpet_wake.c
new file mode 100644
index 0000000..3365ac9
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_wake.c
@@ -0,0 +1,229 @@
+/*
+ * 唤醒词那一件（见 carpet_wake.h 顶上那段：为什么只做 WakeNet、三条硬规矩、实测代价）。
+ *
+ * 这一份不读硬件、不发帧、不碰闸。它只把采集循环交进来的样本重分块、喂给 WakeNet，
+ * 命中就锁存一下。起轮、采集、发送、闸全在 muse_voice.c / carpet_mic.c 那两份里。
+ */
+
+#include "carpet_wake.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+
+#include "model_path.h"
+#include "esp_wn_models.h"
+#include "esp_wn_iface.h"
+
+#include "carpet_audio.h"
+#include "carpet_mic.h"
+#include "muse_settings.h"
+
+static const char *TAG = "carpet.wake";
+
+/* 命中之后多少块之内不再判（一块 32 ms，62 块约 2 秒）。
+ * 为什么要这一道：一个词说完之后，尾音和紧接着的那句话还在同一段音频里，
+ * WakeNet 自己的不应期不够长时会连着报两次 —— 表现是"说一句话屏起了两轮"。
+ * 这一档不放宽闸，只是别让同一句话被数两遍。 */
+#define COOL_BLOCKS 62
+
+/* 模型说一块多少样本（实测 512）。要不到这个数就不起来，所以这里只给一个上限，
+ * 超过它就判成"这个模型不是我们称过的那一档"，宁可不用也不喂错块长。 */
+#define MAX_CHUNK 1024
+
+static const esp_wn_iface_t *s_wn;
+static model_iface_data_t *s_md;
+static srmodel_list_t *s_models;
+static const char *s_words = "";
+static int s_chunk;                 /* 模型要的块长（样本） */
+static int16_t *s_acc;              /* 重分块环，内部 RAM（1 KB 上下，detect 的 SIMD 吃它） */
+static size_t s_fill;
+
+static volatile bool s_hit;         /* 锁存的命中，take() 取走即清 */
+static volatile bool s_inhibit;
+static uint32_t s_cool;
+
+/* >wake 的回读数。都是自上次开机的累计，只在 RAM 里。 */
+static uint32_t s_blocks;           /* 喂够一块、真跑了 detect 的次数 */
+static uint32_t s_hits;
+static uint32_t s_dropped;          /* 被挡着（设置在关 / 屏在念 / inhibit）丢掉的块 */
+static int64_t s_us_sum;
+static int64_t s_us_worst;
+static unsigned s_int_free, s_int_largest, s_psram_free;   /* create() 之后那一份 */
+
+static void heap_now(unsigned *free_int, unsigned *largest_int, unsigned *free_psram)
+{
+    *free_int = (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    *largest_int = (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL);
+    *free_psram = (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM);
+}
+
+void carpet_wake_init(void)
+{
+    if (s_md) return;
+
+    /* 分区名字必须就叫 model：esp-sr 的 CMakeLists 按这个名字找分区、把 srmodels.bin
+     * 刷进去（partitions_muse.csv 尾巴那一行）。名字不对这里返回 NULL，而不是报错。 */
+    s_models = esp_srmodel_init("model");
+    if (!s_models) {
+        ESP_LOGE(TAG, "model 分区里没有模型：srmodels.bin 没刷？（按键那条路照常好使）");
+        return;
+    }
+    char *name = esp_srmodel_filter(s_models, ESP_WN_PREFIX, NULL);
+    if (!name) {
+        ESP_LOGE(TAG, "模型分区里没有 wakenet 模型（CONFIG_SR_WN_* 一个都没开？）");
+        return;
+    }
+    s_wn = esp_wn_handle_from_name(name);
+    if (!s_wn) {
+        ESP_LOGE(TAG, "esp_wn_handle_from_name(%s) 返回 NULL", name);
+        return;
+    }
+    s_words = esp_srmodel_get_wake_words(s_models, name);
+    if (!s_words) s_words = "";
+    /* 模型报回来的"词"其实是 _MODEL_INFO_ 里第 3 个下划线段（esp-sr 的
+     * get_wake_words_from_info 就是这么切的），打包的人写什么就是什么。
+     * 四个候选都实读过：只有「你好小安」那一份写的是拼音 nihaoxiaoan，
+     * 你好东东 / 你好小益 / 你好小智 三份本来就是中文。屏上要教人念的是中文，
+     * 所以这一份单独译回来；换别的模型时这行不生效，仍用模型自己报的字。 */
+    if (strcmp(s_words, "nihaoxiaoan") == 0) s_words = "你好小安";
+
+    unsigned f0, l0, p0;
+    heap_now(&f0, &l0, &p0);
+    int64_t t0 = esp_timer_get_time();
+    /* DET_MODE_90 是称过的那一档（探针用的就是它）。换档要重新称误触发。 */
+    s_md = s_wn->create(name, DET_MODE_90);
+    int64_t t1 = esp_timer_get_time();
+    if (!s_md) {
+        ESP_LOGE(TAG, "create() 失败：内部 free=%u 最大块=%u（要一块 12288 B 连续内部）", f0, l0);
+        s_wn = NULL;
+        return;
+    }
+    heap_now(&s_int_free, &s_int_largest, &s_psram_free);
+
+    s_chunk = s_wn->get_samp_chunksize(s_md);
+    int rate = s_wn->get_samp_rate(s_md);
+    int chans = s_wn->get_channel_num(s_md);
+    if (s_chunk <= 0 || s_chunk > MAX_CHUNK || chans != 1 || rate != 16000) {
+        /* 喂错块长 detect() 不报错，只是永远不命中 —— 所以这里宁可判死。 */
+        ESP_LOGE(TAG, "模型这一档没称过：一块 %d 样本 × %d 声道 @ %d Hz，不用它", s_chunk, chans, rate);
+        s_wn->destroy(s_md);
+        s_md = NULL;
+        s_wn = NULL;
+        return;
+    }
+    /* 一块的缓冲放**内部**：只有 1 KB 上下，而 detect() 的 SIMD 一直在读它。
+     * 探针那版放 PSRAM 也跑得动（3.63 ms/块），但那是喂静音和正弦量的，真词没验过；
+     * 这里不拿识别率去赌一个可以白拿的差别。 */
+    s_acc = heap_caps_malloc((size_t)s_chunk * sizeof(int16_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+    if (!s_acc) {
+        ESP_LOGE(TAG, "要不到 %d B 的重分块缓冲", (int)(s_chunk * sizeof(int16_t)));
+        s_wn->destroy(s_md);
+        s_md = NULL;
+        s_wn = NULL;
+        return;
+    }
+    s_fill = 0;
+
+    ESP_LOGI(TAG, "唤醒词就绪：「%s」 模型=%s 一块=%d 样本(%.0f ms)@%d Hz",
+             s_words, name, s_chunk, (double)s_chunk * 1000.0 / (double)rate, rate);
+    /* 这四个数就是"这一版在这块板上到底吃不吃得下"的现场证据，和探针那份对得上才算数。 */
+    ESP_LOGI(TAG, "create() 用了 %.1f ms：内部 free %u→%u 最大块 %u→%u | PSRAM free %u→%u",
+             (double)(t1 - t0) / 1000.0, f0, s_int_free, l0, s_int_largest, p0, s_psram_free);
+}
+
+bool carpet_wake_ready(void)
+{
+    return s_md != NULL;
+}
+
+const char *carpet_wake_word(void)
+{
+    return s_words;
+}
+
+void carpet_wake_inhibit(bool on)
+{
+    s_inhibit = on;
+    if (on) {
+        s_fill = 0;      /* 半块陈料不留到下一轮 */
+        s_hit = false;
+    }
+}
+
+/* 够一块了：跑一次 detect。命中就锁存，并起不应期。 */
+static void detect_block(void)
+{
+    /* 屏自己在念答句的时候不听：否则答句里的字会被当成新一轮的唤醒词。
+     * 设置在关的时候也不跑 —— 省的就是那 11% CPU。 */
+    if (s_inhibit || carpet_audio_live() || !muse_settings_wake_on()) {
+        s_dropped++;
+        return;
+    }
+    if (s_cool) {
+        s_cool--;
+        s_dropped++;
+        return;
+    }
+    int64_t a = esp_timer_get_time();
+    int r = s_wn->detect(s_md, s_acc);
+    int64_t d = esp_timer_get_time() - a;
+    s_blocks++;
+    s_us_sum += d;
+    if (d > s_us_worst) s_us_worst = d;
+    if (r > 0) {
+        s_hits++;
+        s_hit = true;
+        s_cool = COOL_BLOCKS;
+        ESP_LOGI(TAG, "命中「%s」（第 %lu 块，累计 %lu 次）", s_words,
+                 (unsigned long)s_blocks, (unsigned long)s_hits);
+    }
+}
+
+void carpet_wake_feed(const int16_t *pcm, size_t frames)
+{
+    if (!s_md || !pcm || !frames) return;
+    /* 320 → 512 的重分块：采集那一档是 20 ms，模型那一档是 32 ms，两边不成整数倍，
+     * 所以必须留半块。直接按 320 喂 detect() 不会报错，只会永远不命中。 */
+    size_t done = 0;
+    while (done < frames) {
+        size_t need = (size_t)s_chunk - s_fill;
+        size_t take = frames - done < need ? frames - done : need;
+        memcpy(s_acc + s_fill, pcm + done, take * sizeof(int16_t));
+        s_fill += take;
+        done += take;
+        if (s_fill == (size_t)s_chunk) {
+            s_fill = 0;
+            detect_block();
+        }
+    }
+}
+
+bool carpet_wake_take(void)
+{
+    if (!s_hit) return false;
+    s_hit = false;
+    return true;
+}
+
+void carpet_wake_dump(void)
+{
+    unsigned f, l, p;
+    heap_now(&f, &l, &p);
+    printf("@wake ready=%d word=%s chunk=%d on=%d inhibit=%d live=%d armed=%d\n",
+           (int)carpet_wake_ready(), s_words[0] ? s_words : "(none)", s_chunk,
+           (int)muse_settings_wake_on(), (int)s_inhibit, (int)carpet_audio_live(),
+           (int)carpet_mic_armed());
+    printf("@wake blocks=%lu hits=%lu dropped=%lu cool=%lu detect avg=%.2f ms worst=%.2f ms\n",
+           (unsigned long)s_blocks, (unsigned long)s_hits, (unsigned long)s_dropped,
+           (unsigned long)s_cool,
+           s_blocks ? (double)s_us_sum / (double)s_blocks / 1000.0 : 0.0,
+           (double)s_us_worst / 1000.0);
+    printf("@wake create 之后 int=%u/%u psram=%u | 现在 int=%u/%u psram=%u\n",
+           s_int_free, s_int_largest, s_psram_free, f, l, p);
+    printf("@wake 设置页「声音」那一格 / 串口 >wake on|off；闸仍看 >mic\n");
+    fflush(stdout);
+}
\ No newline at end of file
diff --git a/esp32/components/muse/carpet/carpet_wake.h b/esp32/components/muse/carpet/carpet_wake.h
new file mode 100644
index 0000000..bbcf994
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_wake.h
@@ -0,0 +1,67 @@
+/*
+ * 唤醒词：免按键「对着屏说话」。
+ *
+ * 为什么有这一份：开车的时候按住屏上那个键是不合理的（owner 的原话）。所以这一份
+ * 只做一件事 —— 在**已有的那一个麦克风读者**上一直听着一个词，听见了就替人按下那个键。
+ * 后面整条路（预滚、采集、分帧、松手发、闸）一个字都不改，仍走 carpet_mic 那一份。
+ *
+ * 三条硬规矩，和 carpet_mic.h 顶上那三条是同一套：
+ *
+ * 1. **不开第二个读者**。这一份从不碰硬件：`muse_voice.c` 的 `idle_capture()` 每 20 毫秒
+ *    把读到的 320 个样本交进来（`carpet_wake_feed()`）。第二个读者会等满 1 秒令牌，
+ *    表现是"所有录音都失败在 The channel is not enabled"。
+ * 2. **屏自己在念的时候不听**。`carpet_audio_live()` 为真就把喂进来的样本丢掉 ——
+ *    否则答句里的字会被当成新一轮的唤醒词，屏会自己跟自己说个没完。
+ * 3. **闸照旧**。命中只是"替人按了一下"，能不能真发上去仍由 `carpet_mic_armed()` 判
+ *    （本地开关 + 对面申报过 v4 + 没被熔断）。这一份不放宽任何一道。
+ *
+ * 为什么只用 WakeNet、不用 esp-sr 的 AFE/MultiNet：AFE 那套要 100 KB 级别的内部 RAM，
+ * 这块板腾不出来；而我们要的只是"听见一个词"，降噪和命令词识别都用不上（转写在手机上）。
+ * 实测代价（esp-sr 2.4.7 / 这块 S3 / DET_MODE_90）：
+ *   进镜像 88,509 B；一个中文模型 291 KB（flash 的 model 分区，mmap，不占 RAM）；
+ *   create() 吃 21,140 B 内部 + 323,684 B PSRAM，要一块 12,288 B **连续内部**，56.8 ms；
+ *   detect() 一块 32 ms 音频平均 3.63 ms、最坏 5.11 ms（约 11% CPU）；
+ *   静音和 1 kHz 正弦各 200 块，误触发 0 次。
+ * 内部 RAM 是靠 app.c 里 carpet 构建跳过 BLE 启动腾出来的：同一份心跳
+ * int=16K/8K min=6K → int=73K/56K min=62K。BLE 在这个产品里没人用（屏自己入热点、
+ * 自己拨 App 的 WebSocket，见 docs/APP-SCREEN-CONNECT.md §1）。
+ *
+ * 一块的样本数由模型说（`get_samp_chunksize`，实测 512 = 32 ms），和采集那一档
+ * （MUSE_AUDIO_CHUNK = 320 = 20 ms）不一样，所以这里有一个 320→512 的重分块环。
+ * 这不是可以省的：喂错块长 detect() 不报错，只是永远不命中。
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* 开机调一次（`carpet_link_start()`，和 carpet_mic_init() 同一处）。
+ * 为什么在那儿：create() 要一块 12 KB **连续内部**，开机这几十秒是内部 RAM 最整的
+ * 一段时间；等 Wi-Fi/TLS/LVGL 都铺开之后再要，就是"要得到总量、要不到连续"那种死法。
+ * 这一步不读设置（那会儿 muse_settings_init() 还没跑，读设置会撞 NULL 锁）。
+ * 失败不致命：模型分区没刷、内存不够，都只打日志，按键那条路照常好使。 */
+void carpet_wake_init(void);
+
+/* 模型和句柄都起来了没有。false 时 feed() 什么都不做。 */
+bool carpet_wake_ready(void);
+
+/* 采集循环每读一次就交一次（320 个样本，16 kHz 单声道）。
+ * 内部重分块成模型要的块长，够一块就 detect() 一次；命中锁存，等 take() 取。
+ * 设置关着、屏在念、被 inhibit 的时候直接丢掉并清空环（不留半块陈料）。 */
+void carpet_wake_feed(const int16_t *pcm, size_t frames);
+
+/* 取走一次命中（取走即清）。采集循环拿它决定要不要起一轮免按键对话。 */
+bool carpet_wake_take(void);
+
+/* 一轮对话期间挂起检测（起轮时 true、收尾时 false）。
+ * 和 carpet_audio_live() 是两道：那道挡的是"屏在念答句"，这道挡的是"这一轮还没完"。 */
+void carpet_wake_inhibit(bool on);
+
+/* 唤醒词本身（模型自己报的，例如「你好小安」）。没起来时返回空串。 */
+const char *carpet_wake_word(void);
+
+/* 开发口 `>wake`：起来没有、用的哪个词、一块多少样本、喂过几块、命中几次、
+ * 现在是不是被挡着、以及内部/PSRAM 余量。站在屏前说一句话是看不出这些的。 */
+void carpet_wake_dump(void);
\ No newline at end of file

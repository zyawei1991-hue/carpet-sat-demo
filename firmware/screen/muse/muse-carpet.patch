+static void build_clock(lv_obj_t *col)
+{
+    build_clock_orbit(lv_obj_get_parent(col));
+    /* 11-16 owner：返回那颗药丸突兀，滑屏本来就能走遍四格 + 中心脸，钟面这页不再摆返回。
+     * 别的内页（场景/详情）仍留着。 */
+
+    /* 不套定高 band：band 的猜高度会和字体真实行高对不上、上下溢出。列是
+     * LV_SIZE_CONTENT，让每行按自然行高占位、文字在 COL_W 内居中，最稳。
+     * 没同步上先摆 "--:--"，不摆假时间。 */
+    s_clock_hero.label = make_label(col, s_clock, INK_TEXT_HIGH, "--:--");
+    lv_obj_set_width(s_clock_hero.label, COL_W);
+    lv_obj_set_style_text_align(s_clock_hero.label, LV_TEXT_ALIGN_CENTER, 0);
+    snprintf(s_clock_hero.shown, sizeof s_clock_hero.shown, "--:--");
+
+    s_clock_date.label = make_label(col, s_small, INK_WAIT, "时间同步中");
+    lv_obj_set_width(s_clock_date.label, COL_W);
+    lv_obj_set_style_text_align(s_clock_date.label, LV_TEXT_ALIGN_CENTER, 0);
+    snprintf(s_clock_date.shown, sizeof s_clock_date.shown, "时间同步中");
+
+    s_clock_pass.label = make_label(col, s_small, INK_TEXT_LOW, "等首帧");
+    lv_obj_set_width(s_clock_pass.label, COL_W);
+    lv_obj_set_style_text_align(s_clock_pass.label, LV_TEXT_ALIGN_CENTER, 0);
+    /* sat 那句可能长（char[40]）：截一行加省略号，别让它折行把列顶出圆。 */
+    lv_label_set_long_mode(s_clock_pass.label, LV_LABEL_LONG_MODE_DOTS);
+    snprintf(s_clock_pass.shown, sizeof s_clock_pass.shown, "等首帧");
+
+    lv_obj_move_foreground(col);   /* 文字列压到星轨层上面 */
+    lv_obj_set_flag(col, LV_OBJ_FLAG_HIDDEN, true);
+    lv_obj_set_flag(s_clock_stage, LV_OBJ_FLAG_HIDDEN, true);
+}
+
+/* 每帧只读 time()/localtime_r()（carpet_link_wallclock 里），不碰链路锁、不阻塞。
+ * 同步上了就画真时真日期；没同步上回落 "--:--" + 「时间同步中」（琥珀），绝不摆假时间。
+ * 过境行直接搬 sat 那句活倒计时（"已锁定 下次2:33"），没有就「等首帧」。 */
+static void clock_refresh(const carpet_state_view_t *s, bool live)
+{
+    int year, mon, mday, hour, min;
+    char buf[72];
+    if (carpet_link_wallclock(&year, &mon, &mday, &hour, &min)) {
+        snprintf(buf, sizeof buf, "%02d:%02d", hour, min);
+        set_line(&s_clock_hero, buf, INK_TEXT_HIGH);
+        snprintf(buf, sizeof buf, "%04d-%02d-%02d", year, mon, mday);
+        set_line(&s_clock_date, buf, INK_TEXT_MID);
+    } else {
+        set_line(&s_clock_hero, "--:--", INK_TEXT_HIGH);
+        set_line(&s_clock_date, "时间同步中", INK_WAIT);
+    }
+    set_line(&s_clock_pass, s->sat[0] ? s->sat : "等首帧",
+             live ? INK_SAT : INK_TEXT_LOW);
+}
+
+/* 相册页（氛围层第三页）：收齐的 JPEG 整屏居中，多张 8 秒一轮。
+ * 解码不在这儿做 —— LVGL 的 TJPGD 在重绘时按 MCU 小块现解（lv_tjpgd.c），
+ * 这里只把字节指针和宽高填进 dsc。所以显示期间那张的字节必须一直在：
+ * acquire 把它钉住，新照片顶掉的只会是别的槽。
+ * 472×472 比 466 屏每边大 3px：App 压图就是这个尺寸（PhotoPush），圆屏裁掉四角，
+ * 烧屏 ±3px 位移也有黑边可挪，466 上不缩放。小屏（360）先预解码成 RGB565 整帧
+ * 再等比缩到屏宽（流式 TJPGD 上压缩放会黑，见 photo_show），围绕中心 pivot 居中。 */
+static void build_photo(lv_obj_t *col)
+{
+    lv_obj_t *st = lv_obj_create(lv_obj_get_parent(col));
+    lv_obj_remove_style_all(st);
+    lv_obj_set_size(st, LV_PCT(100), LV_PCT(100));
+    lv_obj_center(st);
+    lv_obj_set_style_bg_opa(st, LV_OPA_TRANSP, 0);
+    lv_obj_remove_flag(st, LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE);
+    s_photo_stage = st;
+
+    s_photo_img = lv_image_create(st);
+    lv_obj_center(s_photo_img);
+    lv_obj_remove_flag(s_photo_img, LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_flag(st, LV_OBJ_FLAG_HIDDEN, true);
+
+    /* 没照片时的那一列：一句实话 + 怎么让它有照片。不摆假照片、不摆死按钮。
+     * 和钟面一样不摆返回药丸（owner 11-16：滑屏就够）。 */
+    s_photo_empty.label = make_label(col, s_big, COLOR_TEXT, "相册");
+    lv_obj_set_width(s_photo_empty.label, COL_W);
+    lv_obj_set_style_text_align(s_photo_empty.label, LV_TEXT_ALIGN_CENTER, 0);
+    snprintf(s_photo_empty.shown, sizeof s_photo_empty.shown, "相册");
+
+    s_photo_hint.label = make_label(col, s_small, COLOR_DIM, "还没收到照片");
+    lv_obj_set_width(s_photo_hint.label, COL_W);
+    lv_obj_set_style_text_align(s_photo_hint.label, LV_TEXT_ALIGN_CENTER, 0);
+    snprintf(s_photo_hint.shown, sizeof s_photo_hint.shown, "还没收到照片");
+
+    lv_obj_t *hint2 = make_label(col, s_small, COLOR_DIM, "在手机 App 里选一张推过来");
+    lv_obj_set_width(hint2, COL_W);
+    lv_obj_set_style_text_align(hint2, LV_TEXT_ALIGN_CENTER, 0);
+    lv_label_set_long_mode(hint2, LV_LABEL_LONG_MODE_WRAP);
+
+    lv_obj_set_flag(col, LV_OBJ_FLAG_HIDDEN, true);
+}
+
+/* 把第 idx 张摆上屏。字节借自环槽（钉住），宽高现扫 SOF —— TJPGD 的内存路
+ * 要先填 dsc 头。扫不出宽高的坏图不上屏，留一行日志，不画半张。 */
+static void photo_show(int idx)
+{
+    size_t n = 0;
+    const uint8_t *bytes = carpet_photo_acquire(idx, &n);
+    if (!bytes || n == 0) return;
+    uint16_t w = 0, h = 0;
+    if (!carpet_photo_jpeg_size(bytes, n, &w, &h)) {
+        ESP_LOGW(TAG, "这张 JPEG 扫不出宽高（%u 字节），不上屏", (unsigned)n);
+        return;
+    }
+    /* App 推的是 472 见方：小屏等比缩到屏宽，pivot 在中心 ⇒ 按源尺寸居中仍然居中。 */
+    int fit = w > h ? w : h;
+    int scale = fit > s_screen_w ? (int)((uint32_t)s_screen_w * 256 / fit) : 256;
+    if (s_photo_scale_bench) scale = s_photo_scale_bench;
+
+    s_photo_dsc.header.magic = LV_IMAGE_HEADER_MAGIC;
+    bool predecoded = false;
+    if (scale < 256) {
+        /* TJPGD 是流式解码，运行时缩放压在它上面整帧画黑（360 真机称到：
+         * scale=256 全帧 / 195 只剩导航点）。先一次性解成 RGB565 整帧，
+         * 缩放就压在普通位图上，走 LVGL 常规变换路。 */
+        jpeg_dec_config_t cfg = DEFAULT_JPEG_DEC_CONFIG();
+        cfg.output_type = JPEG_PIXEL_FORMAT_RGB565_LE;
+        jpeg_dec_handle_t dec = NULL;
+        if (jpeg_dec_open(&cfg, &dec) == JPEG_ERR_OK) {
+            jpeg_dec_io_t io = { .inbuf = (uint8_t *)bytes, .inbuf_len = (int)n };
+            jpeg_dec_header_info_t info;
+            int outlen = 0;
+            if (jpeg_dec_parse_header(dec, &io, &info) == JPEG_ERR_OK &&
+                jpeg_dec_get_outbuf_len(dec, &outlen) == JPEG_ERR_OK && outlen > 0) {
+                uint8_t *buf = heap_caps_aligned_alloc(16, (size_t)outlen, MUSE_BIG_CAPS);
+                if (buf) {
+                    io.outbuf = buf;
+                    if (jpeg_dec_process(dec, &io) == JPEG_ERR_OK) {
+                        free(s_photo_rgb);
+                        s_photo_rgb = buf;
+                        s_photo_dsc.header.cf = LV_COLOR_FORMAT_RGB565;
+                        s_photo_dsc.header.w = info.width;
+                        s_photo_dsc.header.h = info.height;
+                        s_photo_dsc.header.stride = info.width * 2;
+                        s_photo_dsc.data_size = (uint32_t)outlen;
+                        s_photo_dsc.data = buf;
+                        predecoded = true;
+                    } else {
+                        free(buf);
+                    }
+                }
+            }
+            jpeg_dec_close(dec);
+        }
+        if (!predecoded) {
+            /* 解不出来就退回不缩放：中心裁切但看得见，不画黑帧假装有图。 */
+            ESP_LOGW(TAG, "相册预解码失败，退回不缩放（小屏会裁边）");
+            scale = 256;
+        }
+    }
+    if (!predecoded) {
+        s_photo_dsc.header.cf = LV_COLOR_FORMAT_RAW;   /* RAW 才走解码器链，TJPGD 认 JFIF 接手 */
+        s_photo_dsc.header.w = w;
+        s_photo_dsc.header.h = h;
+        s_photo_dsc.header.stride = w * 3;
+        s_photo_dsc.data_size = (uint32_t)n;
+        s_photo_dsc.data = bytes;
+    }
+    lv_image_set_src(s_photo_img, &s_photo_dsc);
+    lv_image_set_scale(s_photo_img, scale);
+    lv_obj_center(s_photo_img);
+    ESP_LOGI(TAG, "相册上屏第 %d 张：%ux%u %u 字节 scale=%d%s", idx + 1, w, h,
+             (unsigned)n, scale, predecoded ? " 预解码" : "");
+}
+
+/* 台架判别口（>photoscale）：256=不缩、195=缩到 360，0=回自动。用来把
+ * "小屏相册黑屏"判到缩放路上还是别的路上。 */
+void carpet_page_bench_photo_scale(int v)
+{
+    s_photo_scale_bench = v;
+    s_photo_bench_pending = 1;
+    printf("@photoscale bench=%d\n", v);
+    fflush(stdout);
+}
+
+/* 每拍看一眼环账：新收齐 → 立刻切到最新那张；多张 → 8 秒轮播。
+ * 0↔非0 翻转才重排隐现（apply），其余时候只动图像源，不碰别的页。 */
+static void photo_refresh(void)
+{
+    carpet_photo_view_t pv;
+    carpet_photo_view(&pv);
+    int64_t now = esp_timer_get_time() / 1000;
+    bool had = s_photo_count > 0;
+
+    if (pv.count == 0) {
+        s_photo_count = 0;
+        s_photo_gen = pv.gen;
+        if (had) apply();
+        return;
+    }
+    if (pv.gen != s_photo_gen) {
+        s_photo_gen = pv.gen;
+        s_photo_idx = pv.count - 1;   /* 新来的那张就是最新 */
+        s_photo_last_ms = now;
+        photo_show(s_photo_idx);
+    } else if (pv.count > 1 && now - s_photo_last_ms >= PHOTO_TEMPO_MS) {
+        s_photo_idx = (s_photo_idx + 1) % pv.count;
+        s_photo_last_ms = now;
+        photo_show(s_photo_idx);
+    }
+    s_photo_count = pv.count;
+    if ((s_photo_count > 0) != had) apply();
+}
+
+/* 场景页（L2）从上到下：返回、标题、条目、（要的话）"在画 X"+ 三个按钮。
+ * L1 不走这里，它有自己的宫格。 */
+static void build_page(int pg, lv_obj_t *col)
+{
+    const page_def_t *d = &PAGE_DEFS[pg];
+    page_lines_t *pl = &s_lines[pg];
+
+    make_pill(col, COL_W, BTN_H, "返回", on_back_clicked, NULL);
+    make_label(make_band(col, TITLE_H), s_big, COLOR_TEXT, d->title);
+    build_rows(col, d, pl);
+    if (d->flags & PF_CARD_BAR) {
+        /* 这一行是那三个按钮的上下文：它们切的是手机上那张卡，不是这一页。 */
+        pl->sub.label = make_label(make_band(col, SUB_H), s_small, COLOR_DIM, "在画 —");
+        snprintf(pl->sub.shown, sizeof pl->sub.shown, "在画 —");
+        build_card_bar(col);
+    } else if (d->flags & PF_SUB_STATIC) {
+        pl->sub.label = make_label(make_band(col, SUB_H), s_small, COLOR_DIM, GALLERY_NOTE);
+        snprintf(pl->sub.shown, sizeof pl->sub.shown, "%s", GALLERY_NOTE);
+    }
+    lv_obj_set_flag(col, LV_OBJ_FLAG_HIDDEN, true);
+}
+
+void carpet_page_build(lv_obj_t *func_tile, lv_obj_t *ring_tile, lv_obj_t *amb_tile,
+                       lv_obj_t *face_tile)
+{
+    if (!func_tile || !ring_tile || !amb_tile) return;
+    s_screen_w = lv_display_get_horizontal_resolution(lv_display_get_default());
+    fonts_init();
+    /* 三格各自的根：手势命中测试只查现在露着的那一格（active_tile_obj）。 */
+    s_func_tile = func_tile;
+    s_ring_tile = ring_tile;
+    s_amb_tile = amb_tile;
+
+    /* B §1 守护灯点：Avatar 头顶正上方一枚琥珀点（y=84 按头部顶端 ≈106 的实拍估的，
+     * 刷完截图校正）。make_dot 自带不可点击 + 默认藏 —— 灯是示警不是按钮，
+     * 脸那格的点击仍干净地落到 tap 分支。 */
+    if (face_tile) {
+        s_guard_dot = make_dot(face_tile);
+        lv_obj_align(s_guard_dot, LV_ALIGN_TOP_MID, 0, SC(84));
+    }
+
+    for (int i = PG_PICKER; i < PG_COUNT; i++) {
+        const int t = tile_for_page(i);
+        lv_obj_t *tile = (t == 3) ? ring_tile : (t == 4) ? amb_tile : func_tile;
+        if (PAGE_DEFS[i].flags & PF_GRID) {
+            s_col[i] = build_picker(tile, &s_lines[i]);
+            continue;
+        }
+        s_col[i] = make_col(tile);
+        if (i == PG_CLOCK)      build_clock(s_col[i]);   /* 钟面整页特殊：大数字，不走条目表 */
+        else if (i == PG_PHOTO) build_photo(s_col[i]);   /* 相册整页特殊：照片本身，不走条目表 */
+        else                    build_page(i, s_col[i]);
+    }
+
+    /* L3：一份复用的详情，住功能格（条目都在功能页上）。复用是有硬约束在 ——
+     * 绝不在自己的点击回调里删对象，那会让 LVGL 回到已经释放的指针。 */
+    s_detail_col = make_col(func_tile);
+    make_pill(s_detail_col, COL_W, BTN_H, "返回", on_back_clicked, NULL);
+    s_detail_title.label = make_label(make_band(s_detail_col, TITLE_H), s_big, COLOR_TEXT, "");
+    s_detail_title.shown[0] = '\0';
+
+    lv_obj_t *dv = lv_obj_create(s_detail_col);
+    lv_obj_remove_style_all(dv);
+    lv_obj_set_size(dv, COL_W, LV_SIZE_CONTENT);
+    lv_obj_remove_flag(dv, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(dv, LV_OBJ_FLAG_CLICKABLE);   /* 纯容器，见 make_card 那条注释 */
+    s_detail_value.label = make_label(dv, s_big, COLOR_TEXT, "");
+    s_detail_value.shown[0] = '\0';
+    lv_label_set_long_mode(s_detail_value.label, LV_LABEL_LONG_MODE_WRAP);
+    lv_obj_set_width(s_detail_value.label, COL_W - SC(32));
+
+    s_detail_hint.label = make_label(make_band(s_detail_col, SUB_H), s_small, COLOR_DIM, "");
+    s_detail_hint.shown[0] = '\0';
+    make_pill(s_detail_col, COL_W, BTN_H, "戳一下", on_poke_clicked, NULL);
+    lv_obj_set_flag(s_detail_col, LV_OBJ_FLAG_HIDDEN, true);
+
+    /* 划动判定靠轮询：40ms 一次。一次 60 px 的划动最快也就 100ms 出头，采得到两三点。 */
+    lv_timer_create(drag_timer, 40, NULL);
+
+    apply();
+}
+
+void carpet_page_tick(void)
+{
+    /* 首屏的答句先翻 —— 露的正是脸那一格时下面那句 return 不会跑到，
+     * 而那一格才是这句答句该出现的地方。 */
+    carpet_link_face_tick();
+
+    /* 守护灯点跟未读走：这半截在 s_tile 判断之前，脸那格露着时也要刷。
+     * 点被念掉（broadcast 清未读）下一拍自然灭。 */
+    if (s_guard_dot)
+        lv_obj_set_flag(s_guard_dot, LV_OBJ_FLAG_HIDDEN, !carpet_link_event_pending());
+
+    /* 台架那一下先回脸：四方向都从默认态（脸）起判才称得准（串口任务不许动 LVGL 对象）。 */
+    if (s_bench_nav) {
+        s_bench_nav = false;
+        nav_to(PG_FACE);
+    }
+
+    /* >scene=<n>：和点场景卡同一条路，落在 LVGL 任务里（串口只立了记号）。 */
+    if (s_bench_scene) {
+        int n = s_bench_scene;
+        s_bench_scene = 0;
+        if (n >= 1 && n <= ARRAY_LEN(PICKER_CELLS)) {
+            const cell_def_t *c = &PICKER_CELLS[n - 1];
+            s_scene_pg = c->target;
+            muse_pixel_set_scene(c->scene);
+            ESP_LOGI(TAG, "选场景 %s → 换装 scene=%d", c->name, (int)c->scene);
+            nav_to(PG_FACE);
+        }
+    }
+
+    /* >touch：真触摸 indev 回读（只读），落在 LVGL 任务里。 */
+    if (s_touch_dump) {
+        s_touch_dump = false;
+        touch_dump_locked();
+    }
+
+    /* >photoscale：和上面同一条规矩，串口立记号、这里动 LVGL。 */
+    if (s_photo_bench_pending) {
+        s_photo_bench_pending = 0;
+        if (s_photo_count > 0) photo_show(s_photo_idx);
+    }
+
+    if (s_reshare) {
+        s_reshare = false;
+        s_reported[0] = '\0';
+        report_now();
+    }
+
+    /* 手机在答句里带的跳页在这里落地 —— 上面那些都要动 LVGL 的对象。 */
+    if (s_pending_seq != s_applied_seq) {
+        s_applied_seq = s_pending_seq;
+        char want[16];
+        snprintf(want, sizeof want, "%s", (const char *)s_pending_name);
+        for (int i = 0; i < PG_COUNT; i++) {
+            if (strcmp(want, PAGE_NAMES[i]) == 0) {
+                nav_to(i);
+                break;
+            }
+        }
+    }
+
+    carpet_link_view_t v;
+    carpet_link_view(&v);
+
+    if (s_tile < 2) return;   /* 脸和设置那格由 Muse 自己画，这一页一个字都不改 */
+
+    if (s_detail) {
+        detail_refresh();
+        return;
+    }
+
+    /* 只更新露着的那一页：tiny_ttf 的字模是现算的，把六页全刷一遍是白付的钱。 */
+    const page_def_t *d = &PAGE_DEFS[s_pg];
+    page_lines_t *pl = &s_lines[s_pg];
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+    /* 3 秒没帧 = 服务端还在但话说完了（或者热点断了），契约要求保留最后一帧，
+     * 所以不清屏，只统一转成灰。 */
+    const bool live = v.linked && v.gap_s <= 3;
+
+    if (s_pg == PG_PICKER) {
+        /* 第一行只说链路活没活 —— 现场"按了没反应"十次有八次是这一行没到位。 */
+        if (!v.wifi_up) {
+            set_line(&pl->sub, "等网络", COLOR_OFF);
+        } else if (!v.linked) {
+            set_line(&pl->sub, "未接入", COLOR_OFF);
+        } else if (v.gap_s == UINT32_MAX) {
+            set_line(&pl->sub, "等首帧", COLOR_OFF);
+        } else if (v.gap_s > 10) {
+            set_line(&pl->sub, "掉线重连", COLOR_OFF);
+        } else if (v.gap_s > 3) {
+            char buf[40];
+            snprintf(buf, sizeof buf, "卡%lu秒", (unsigned long)v.gap_s);
+            set_line(&pl->sub, buf, COLOR_OFF);
+        } else {
+            set_line(&pl->sub, "已接入", COLOR_ACCENT);   /* 契约号只在串口日志里（carpet_link 的 linked 那行） */
+        }
+    } else if (d->flags & PF_CARD_BAR) {
+        /* 这一行是那三个按钮的上下文：它们切的是手机上那张卡，不是这一页。 */
+        char card[48];
+        snprintf(card, sizeof card, "在画 %s", s.card[0] ? s.card : "—");
+        set_line(&pl->sub, card, live ? COLOR_TEXT : COLOR_DIM);
+    } else if (s_pg == PG_CLOCK) {
+        clock_refresh(&s, live);   /* 钟面：读墙钟 + 搬 sat 倒计时，n_rows=0 下面那圈不跑 */
+    } else if (s_pg == PG_PHOTO) {
+        photo_refresh();           /* 相册：环账有新就切最新，多张 8 秒一轮 */
+    }
+    /* 剩下那页（图片播放）的副行是写死的一句话，帧里没有对应的东西，不碰。 */
+
+    /* 条目行的值。L1 在表里 n_rows=0（宫格不走 rows），所以这一条对 L1 压根不跑 ——
+     * 换来的是"入口不许跟着帧变"这条红线写在结构里。 */
+    char buf[72];
+    for (int i = 0; i < d->n_rows; i++) {
+        int field = d->rows[i].field;
+        set_line(&pl->rows[i], field_text(field, &s, buf, sizeof buf),
+                 field_color(field, &s, live));
+        /* 点的是"这一条是到点的养护"，不是"这一行有值"：别的卡、别的句子都不亮。
+         * 认的两行各有其道理 —— 对话那一行装的就是那句养护话（它走 dialog 帧上来），
+         * 情绪那一行直接写着"担心"。详情的 L3 不点数：那一页整页都在说这一条。 */
+        if (pl->dot[i]) {
+            bool mark = s.maint_worried && (field == F_DIALOG || field == F_EMOTION);
+            lv_obj_set_flag(pl->dot[i], LV_OBJ_FLAG_HIDDEN, !mark);
+        }
+    }
+}
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_page.h b/esp32/components/muse/carpet/carpet_page.h
new file mode 100644
index 0000000..7142bbc
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_page.h
@@ -0,0 +1,73 @@
+/*
+ * 场景页（L1 选场景 / L2 场景 / L3 功能详情）住在 muse_ui.c 建的那格 tile 里。
+ *
+ * 分权：**在哪一页归屏，这一页里说什么归手机**（protocol/screen-link.md）。
+ * 所以这一页的翻页是本地动作，不等手机往返；切完发一条 `page_report` —— 那是**通报**，
+ * 不是申请，手机不许驳回也不该被屏等回执。L3（功能详情）**不报**：手机上只有场景这一层，
+ * 报得越深，两侧各自说话的机会越多。
+ *
+ * 只在 LVGL 任务里跑（muse_ui.c 的 update_chrome 调 tick），
+ * 数据一律从 carpet_link_view() / carpet_link_state() 读，这里不发起任何网络动作。
+ */
+
+#pragma once
+
+#include "sdkconfig.h"
+#if CONFIG_MUSE_CARPET_CARDS
+
+#include "lvgl.h"
+
+/* LVGL task only: builds the page tree across the three carpet tiles muse_ui.c
+ * created — func（上滑功能层）/ ring（下拉场景环）/ amb（右滑氛围）.
+ * face_tile 那一格本组件照旧一个字都不画，只把 B §1 的守护灯点挂上去。 */
+void carpet_page_build(lv_obj_t *func_tile, lv_obj_t *ring_tile, lv_obj_t *amb_tile,
+                       lv_obj_t *face_tile);
+
+/* LVGL task only: pulls the link state onto the labels, at the chrome tick. */
+void carpet_page_tick(void);
+
+/*
+ * LVGL task only: 五格 tile 现在露的是哪一格（0 脸 / 1 设置 / 2 功能 / 3 场景环 / 4 氛围）。
+ * 变了就通报一次；**设置那一格不报** —— 契约的 ScreenPage 里没有 settings，
+ * 手机端对认不出的页名一律拒收，而拒收在屏上没有任何反馈，静默留着比报错更难查。
+ */
+void carpet_page_notify_tile(int tile_index);
+
+/* 当前该报的页名（脸那格是 "face"，L3 报它父场景的名）。给串口回读用。 */
+const char *carpet_page_current_name(void);
+
+/*
+ * 链路刚建起来时（hello 之后）补报一次当前页。少了这一条，重连之后手机上那一格
+ * 会一直空着（App 的文案是「屏没报它在哪一页」），直到下一次真的翻页才复明。
+ * 从链路任务调：它只清一个去重缓存并把命令塞进队列，不碰 LVGL。
+ */
+void carpet_page_reshare(void);
+
+/* 手机在答句里带着跳页（dialog.action）时调：切过去，和本地翻页同一条路。 */
+void carpet_page_goto(const char *page_name);
+
+/*
+ * `>gest` 台架口：本机造一次触摸（起点在空玻璃上，拖 dx/dy，按住 hold_ms 再抬手），
+ * 走的是和真手指**同一条**判定路 —— 为的是把"手势判定 + 上行"和"真玻璃采点"分开证。
+ * 可以从串口任务调：它只写几个整数，翻页和判定都在 LVGL 任务里做。
+ */
+void carpet_page_gesture_bench(int dx, int dy, int hold_ms);
+
+/* `>gestfrom` 台架口：和上面同一条判定路，但**不先回脸**——从当前露着的那一格起判。
+ * 为的是称 owner 2026-11-14 那条「外页划动回中心」：先 >gestfrom 到外页，再 >gestfrom
+ * 划一下，看是不是回中心脸（而不是跳到对侧外页）。 */
+void carpet_page_gesture_bench_from(int dx, int dy, int hold_ms);
+
+/* `>scene=<n>` 台架口：选定第 n 个场景（1 车 / 2 亲子 / 3 对话）+ 头像换装 + 回脸，
+ * 和点一张场景卡同一条路。串口任务只写一个整数，落地在 LVGL 任务里。 */
+void carpet_page_scene_bench(int n);
+
+/* `>touch` 台架口：回读真触摸 indev 的解析结果（类型/模式/state/point）+ 手势互斥闸。
+ * 台架那条造点不走 indev，真玻璃划不动时唯一没称过的就是这一段。串口立记号，LVGL 任务里读。 */
+void carpet_page_touch_dump(void);
+
+/* `>photoscale <n>` 台架口：强制相册那张的 lv_image scale（256=不缩），0=回自动。
+ * 小屏相册黑屏时用来判别是不是缩放路的问题。 */
+void carpet_page_bench_photo_scale(int v);
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */
diff --git a/esp32/components/muse/carpet/carpet_photo.c b/esp32/components/muse/carpet/carpet_photo.c
new file mode 100644
index 0000000..227a8f6
--- /dev/null
+++ b/esp32/components/muse/carpet/carpet_photo.c
@@ -0,0 +1,368 @@
+/*
+ * 契约的相册通道（见 carpet_photo.h 头上那段账）。形状照抄 carpet_audio：
+ * 链路任务收帧 → 校验 → base64 解码 → 拼装 → 收齐进环；LVGL 任务只借字节。
+ * 和音频那本账的区别写在头上：一张一张独立，缺号整张丢，没有"停嘴留账"。
+ */
+
+#include "carpet_photo.h"
+
+#include "sdkconfig.h"
+#if CONFIG_MUSE_CARPET_CARDS
+
+#include <stdio.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+#include "mbedtls/base64.h"
+
+#include "carpet_page.h"
+
+static const char *TAG = "carpet_photo";
+
+#define PHOTO_CAP        (1024 * 1024)   /* App 侧 PhotoPush 的整张上限，超了那边不发 */
+#define PHOTO_CHUNK      2048            /* 契约：一块 2048 字节 JPEG */
+#define PHOTO_SLOTS      3               /* 环槽数：最新一张 + 前两张，够轮播不撑内存 */
+#define B64_BUF_BYTES    (4 * ((PHOTO_CHUNK + 2) / 3) + 8)   /* 2048 → 2732 → 2740 */
+
+typedef struct {
+    uint8_t *buf;          /* 收齐后从拼装缓冲直接过户，不二次拷贝 */
+    size_t size;
+    char album[40];
+    uint32_t gen;          /* 收齐序号，全环单调涨；0 = 空槽 */
+    bool pinned;           /* LVGL 正显示着它：TJPGD 重绘时现解，字节不能动 */
+} slot_t;
+
+static slot_t s_slots[PHOTO_SLOTS];
+static SemaphoreHandle_t s_lock;
+
+/* 正在拼的那一张。buf 按第一帧申报的 total 现拿（PSRAM），收齐过户给环槽。 */
+static struct {
+    char album[40];
+    uint8_t *buf;
+    size_t cap;            /* = 申报的 total */
+    size_t wrote;
+    unsigned expect_seq;
+} s_asm;
+
+static uint32_t s_gen;         /* 每收齐一张涨一 */
+static uint32_t s_photos;      /* 累计收齐几张（含被顶掉的） */
+static uint32_t s_frames, s_drops;
+static const char *s_last_drop = "-";
+
+static void reset_asm_locked(void)
+{
+    if (s_asm.buf) heap_caps_free(s_asm.buf);
+    s_asm.buf = NULL;
+    s_asm.album[0] = '\0';
+    s_asm.cap = s_asm.wrote = 0;
+    s_asm.expect_seq = 0;
+}
+
+static void drop_locked(const char *why)
+{
+    s_drops++;
+    s_last_drop = why;
+    ESP_LOGW(TAG, "这张照片丢掉（%s），别的照片和语音不受影响", why);
+    reset_asm_locked();
+}
+
+static bool lock_get(void)
+{
+    if (!s_lock) s_lock = xSemaphoreCreateMutex();
+    return s_lock != NULL;
+}
+
+/* 收齐进环：找空槽，没有就顶最旧那张**没被钉住的**。钉住的最多一张
+ * （acquire 同时只钉一张），所以三槽永远有得顶，不会把正显示的那张抽走。 */
+static void store_locked(void)
+{
+    int victim = -1;
+    uint32_t oldest = UINT32_MAX;
+    for (int i = 0; i < PHOTO_SLOTS; i++) {
+        if (!s_slots[i].buf) { victim = i; break; }
+        if (!s_slots[i].pinned && s_slots[i].gen < oldest) {
+            oldest = s_slots[i].gen;
+            victim = i;
+        }
+    }
+    if (victim < 0) {   /* 理论上到不了：三槽全钉住违反 acquire 的约定 */
+        drop_locked("环槽全被钉住");
+        return;
+    }
+    slot_t *sl = &s_slots[victim];
+    if (sl->buf) heap_caps_free(sl->buf);
+    sl->buf = s_asm.buf;
+    sl->size = s_asm.wrote;
+    snprintf(sl->album, sizeof sl->album, "%s", s_asm.album);
+    sl->gen = ++s_gen;
+    sl->pinned = false;
+    s_asm.buf = NULL;   /* 过户了，reset 不许再 free */
+    s_photos++;
+    printf("@photo 收齐 album=%s %u 字节（环里第 %u 张）\n",
+           sl->album, (unsigned)sl->size, (unsigned)s_photos);
+    fflush(stdout);
+    reset_asm_locked();
+}
+
+bool carpet_photo_on_chunk(const cJSON *args)
+{
+    if (!cJSON_IsObject(args)) return false;
+    const cJSON *ja = cJSON_GetObjectItemCaseSensitive(args, "album_id");
+    const cJSON *js = cJSON_GetObjectItemCaseSensitive(args, "seq");
+    const cJSON *jn = cJSON_GetObjectItemCaseSensitive(args, "total");
+    const cJSON *jf = cJSON_GetObjectItemCaseSensitive(args, "fmt");
+    const cJSON *jb = cJSON_GetObjectItemCaseSensitive(args, "b64");
+    if (!cJSON_IsString(ja) || !ja->valuestring || !cJSON_IsNumber(js) ||
+        !cJSON_IsNumber(jn) || !cJSON_IsString(jb) || !jb->valuestring) {
+        return false;
+    }
+    /* fmt 缺了就按 jpeg 待（字节自己会说话，解码那头还有一道 JFIF 闸）；
+     * 明着不是 jpeg 才丢 —— 和音频对 rate 的那条同一个道理。 */
+    if (cJSON_IsString(jf) && jf->valuestring && strcmp(jf->valuestring, "jpeg") != 0) {
+        ESP_LOGW(TAG, "fmt=%s，本端只吃 jpeg，这张不接", jf->valuestring);
+        return false;
+    }
+
+    static uint8_t decoded[PHOTO_CHUNK + 4];
+    size_t olen = 0;
+    if (mbedtls_base64_decode(decoded, sizeof decoded, &olen,
+                              (const unsigned char *)jb->valuestring, strlen(jb->valuestring)) != 0) {
+        ESP_LOGW(TAG, "base64 解不开这一帧");
+        return false;
+    }
+    if (olen == 0 || olen > PHOTO_CHUNK) return false;
+
+    size_t total = (size_t)jn->valueint;
+    unsigned seq = (unsigned)js->valueint;
+    if (!lock_get()) return false;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+
+    /* seq=0 = 这张从头来（同一张重推也走这条）；换了 album_id 也从头来。 */
+    if (seq == 0 || strcmp(s_asm.album, ja->valuestring) != 0) {
+        reset_asm_locked();
+        if (total == 0 || total > PHOTO_CAP) {
+            drop_locked("整张字节数不合规");
+            xSemaphoreGive(s_lock);
+            return false;
+        }
+        s_asm.buf = heap_caps_malloc(total, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+        if (!s_asm.buf) {
+            ESP_LOGE(TAG, "PSRAM 里拿不到 %u B（空闲 %u KB/最大连续 %u KB），这张不接",
+                     (unsigned)total,
+                     (unsigned)(heap_caps_get_free_size(MALLOC_CAP_SPIRAM) / 1024),
+                     (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM) / 1024));
+            drop_locked("PSRAM 拿不到");
+            xSemaphoreGive(s_lock);
+            return false;
+        }
+        s_asm.cap = total;
+        snprintf(s_asm.album, sizeof s_asm.album, "%s", ja->valuestring);
+    }
+    if (total != s_asm.cap) {
+        drop_locked("total 中途变了");
+        xSemaphoreGive(s_lock);
+        return false;
+    }
+    if (seq != s_asm.expect_seq) {
+        drop_locked("seq 不连续");
+        xSemaphoreGive(s_lock);
+        return false;
+    }
+    if (s_asm.wrote + olen > s_asm.cap) {
+        drop_locked("这一块装不下");
+        xSemaphoreGive(s_lock);
+        return false;
+    }
+    memcpy(s_asm.buf + s_asm.wrote, decoded, olen);
+    s_asm.wrote += olen;
+    s_asm.expect_seq = seq + 1;
+    s_frames++;
+    bool complete = s_asm.wrote >= s_asm.cap;
+    if (complete) store_locked();
+    xSemaphoreGive(s_lock);
+    return true;
+}
+
+void carpet_photo_abort(const char *why)
+{
+    if (!s_lock) return;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    bool was = s_asm.buf != NULL;
+    reset_asm_locked();   /* 只清拼着的那半张；收齐的照片留着，断线重连还该在 */
+    xSemaphoreGive(s_lock);
+    if (was) ESP_LOGI(TAG, "半张照片清空：%s", why);
+}
+
+void carpet_photo_view(carpet_photo_view_t *v)
+{
+    v->count = 0;
+    v->latest = -1;
+    v->gen = s_gen;   /* 32 位对齐单读原子，和音频那本账同一个约定 */
+    if (!s_lock) return;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    uint32_t newest = 0;
+    for (int i = 0; i < PHOTO_SLOTS; i++) {
+        if (!s_slots[i].buf) continue;
+        v->count++;
+        if (s_slots[i].gen > newest) {
+            newest = s_slots[i].gen;
+            v->latest = i;
+        }
+    }
+    xSemaphoreGive(s_lock);
+}
+
+const uint8_t *carpet_photo_acquire(int index, size_t *size)
+{
+    if (!s_lock || index < 0) return NULL;
+    const uint8_t *out = NULL;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    /* index 是"按收齐先后排第几"：三槽里挑第 index 小的 gen。槽会被顶掉，
+     * 下标跟着漂 —— 所以页面那边每次都从 view 重数，不缓存槽号。 */
+    int order[PHOTO_SLOTS];
+    int n = 0;
+    for (int i = 0; i < PHOTO_SLOTS; i++)
+        if (s_slots[i].buf) order[n++] = i;
+    for (int a = 0; a < n; a++)
+        for (int b = a + 1; b < n; b++)
+            if (s_slots[order[b]].gen < s_slots[order[a]].gen) {
+                int t = order[a]; order[a] = order[b]; order[b] = t;
+            }
+    if (index < n) {
+        for (int i = 0; i < PHOTO_SLOTS; i++) s_slots[i].pinned = false;
+        slot_t *sl = &s_slots[order[index]];
+        sl->pinned = true;
+        out = sl->buf;
+        if (size) *size = sl->size;
+    }
+    xSemaphoreGive(s_lock);
+    return out;
+}
+
+/* JPEG 的宽高只在 SOF 段里，TJPGD 的 VARIABLE 路要我们先填进 dsc 头
+ * （lv_tjpgd.c decoder_info 直接抄 img_dsc->header.w/h），所以这里自己扫一遍标记。
+ * 纯字节解析，不碰 LVGL；扫到 SOS/EOI 还没见着 SOF 就是坏图。 */
+bool carpet_photo_jpeg_size(const uint8_t *b, size_t n, uint16_t *w, uint16_t *h)
+{
+    if (!b || n < 4 || b[0] != 0xFF || b[1] != 0xD8) return false;
+    size_t at = 2;
+    while (at + 4 <= n) {
+        if (b[at] != 0xFF) return false;
+        uint8_t marker = b[at + 1];
+        if (marker == 0x01 || (marker >= 0xD0 && marker <= 0xD7)) { at += 2; continue; }
+        if (marker == 0xD9 || marker == 0xDA) return false;
+        size_t len = ((size_t)b[at + 2] << 8) | b[at + 3];
+        if (len < 2 || at + 2 + len > n) return false;
+        bool sof = (marker >= 0xC0 && marker <= 0xCF) &&
+                   marker != 0xC4 && marker != 0xC8 && marker != 0xCC;
+        if (sof) {
+            if (len < 7) return false;
+            *h = (uint16_t)(((uint16_t)b[at + 5] << 8) | b[at + 6]);
+            *w = (uint16_t)(((uint16_t)b[at + 7] << 8) | b[at + 8]);
+            return *w > 0 && *h > 0;
+        }
+        at += 2 + len;
+    }
+    return false;
+}
+
+void carpet_photo_dump(void)
+{
+    printf("@photo 收齐=%u 帧=%u drops=%u last=%s psram_free=%u\n",
+           (unsigned)s_photos, (unsigned)s_frames, (unsigned)s_drops, s_last_drop,
+           (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
+    if (!s_lock) {
+        printf("@photo 没收到过照片帧\n");
+        fflush(stdout);
+        return;
+    }
+    char album[40] = "-";
+    size_t wrote = 0, cap = 0;
+    int count = 0, pinned = -1;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (s_asm.album[0]) snprintf(album, sizeof album, "%s", s_asm.album);
+    wrote = s_asm.wrote; cap = s_asm.cap;
+    for (int i = 0; i < PHOTO_SLOTS; i++) {
+        if (!s_slots[i].buf) continue;
+        count++;
+        if (s_slots[i].pinned) pinned = i;
+    }
+    xSemaphoreGive(s_lock);
+    printf("@photo 环=%d/%d 钉=%d 拼着=%s %u/%u\n",
+           count, PHOTO_SLOTS, pinned, album, (unsigned)wrote, (unsigned)cap);
+    /* 解码+绘制在 lvgl 任务上跑，它溢过栈（8KB 那版）。水位回读用来定栈够不够：
+     * 12288 - 剩 = 实测峰值。 */
+    TaskHandle_t lv = xTaskGetHandle("lvgl");
+    if (lv) {
+        unsigned left = (unsigned)uxTaskGetStackHighWaterMark(lv);
+#if CONFIG_LV_USE_TJPGD
+        printf("@photo lvgl 栈最少剩=%u 字节（12K 档峰值约 %u）\n", left, 12 * 1024 - left);
+#else
+        printf("@photo lvgl 栈最少剩=%u 字节\n", left);
+#endif
+    }
+    fflush(stdout);
+}
+
+/* ---------------- 开发口 ---------------- */
+
+extern const uint8_t carpet_photo_test_start[] asm("_binary_carpet_photo_test_jpg_start");
+extern const uint8_t carpet_photo_test_end[] asm("_binary_carpet_photo_test_jpg_end");
+
+/*
+ * `>phototest`：把固件里嵌的那张测试 JPEG 按线上形状喂进同一条 on_chunk ——
+ * b64 → cJSON args → 校验 → 解码 → 拼装 → 进环，一步不绕（>audtest 同一个道理）。
+ * 每按一次换一张 album_id，按两次称轮播。喂完翻到相册页，截图就能称解码+渲染。
+ * 照片不是实时流，不按 80ms 节拍补发，只管喂；每 64 块让一次任务，别饿着链路。
+ */
+void carpet_photo_bench(void)
+{
+    static unsigned s_bench_n;
+    size_t total = (size_t)(carpet_photo_test_end - carpet_photo_test_start);
+    char album[40];
+    snprintf(album, sizeof album, "bench-%u", ++s_bench_n);
+
+    char *b64 = heap_caps_malloc(B64_BUF_BYTES, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!b64) {
+        printf("@phototest PSRAM 里拿不到 %d B 的编码缓冲，这一条没称\n", B64_BUF_BYTES);
+        return;
+    }
+    unsigned seq = 0;
+    bool ok = true;
+    for (size_t at = 0; at < total && ok; at += PHOTO_CHUNK, seq++) {
+        size_t n = (total - at) >= PHOTO_CHUNK ? PHOTO_CHUNK : (total - at);
+        size_t olen = 0;
+        if (mbedtls_base64_encode((unsigned char *)b64, B64_BUF_BYTES, &olen,
+                                  carpet_photo_test_start + at, n) != 0 ||
+            olen + 1 > B64_BUF_BYTES) {
+            printf("@phototest 第 %u 块编码失败，停在这\n", seq);
+            ok = false;
+            break;
+        }
+        b64[olen] = '\0';
+        cJSON *args = cJSON_CreateObject();
+        if (args) {
+            ok = cJSON_AddStringToObject(args, "album_id", album) &&
+                 cJSON_AddNumberToObject(args, "seq", (double)seq) &&
+                 cJSON_AddNumberToObject(args, "total", (double)total) &&
+                 cJSON_AddStringToObject(args, "fmt", "jpeg") &&
+                 cJSON_AddStringToObject(args, "b64", b64);
+            if (ok) ok = carpet_photo_on_chunk(args);
+            cJSON_Delete(args);
+        } else {
+            ok = false;
+        }
+        if ((seq & 63) == 63) vTaskDelay(pdMS_TO_TICKS(1));
+    }
+    heap_caps_free(b64);
+    printf("@phototest %s 喂了 %u 块 / %u 字节，%s。翻到相册页，>carpet 读环账\n",
+           album, seq, (unsigned)total, ok ? "全收" : "**中途被拒 —— 看上面那行 drops**");
+    fflush(stdout);
+    if (ok) carpet_page_goto("photo");
+}
+
+#endif /* CONFIG_MUSE_CARPET_CARDS */

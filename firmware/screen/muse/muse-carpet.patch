+/* 开发口：文字和声音一起来。turn_id 两边都用 "audtest" —— 这条的目的就是让
+ * 首屏那句去查"这一轮有没有声音、放到哪了"，id 不一样就查不到，翻页会退回按秒估，
+ * 那正好把要看的两件事都藏起来。先记一轮再交句，同 `>say` 那两条一样的写法。 */
+void carpet_link_bench_say_audio(const char *text, int seconds)
+{
+    if (s_lock && text && *text) {
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        face_round_note("audtest");
+        xSemaphoreGive(s_lock);
+        face_offer(text, true, "audtest");
+    }
+    carpet_audio_bench(seconds);
+}
+
+/* 开发口 `>maint [off]`：本机造一帧"到点的养护"。
+ * 走的是链路收帧时**同一条** `on_state()` —— 不是绕开它去手点那个布尔记号，
+ * 那样称出来的是我自己写的那句 if，不是"这一帧到底到没到"。`off` 造一张中性帧，
+ * 专门称第三道让路（不担心了要搬回 IDLE，少了它脸会一直"想"下去，就是 #34 那个坑）。
+ * 先 `>say 一句长话` 让句子挂在脸上、再发这一帧，称的就是第一道让路：脸不许被搬走，
+ * 这一条只剩「对话」「情绪」两行前面那枚琥珀点（carpet_page.c:874 认的就是下面回读的
+ * 那个 `maint_worried`）。不联网、不接模型，所以这块板在哪都能称这两条。 */
+void carpet_link_bench_maint(bool worried)
+{
+    if (!s_lock) {
+        printf("@maint 链路还没起（没锁），这一帧发不进去\n");
+        fflush(stdout);
+        return;
+    }
+    cJSON *st = cJSON_CreateObject();
+    cJSON *ui = st ? cJSON_AddObjectToObject(st, "ui") : NULL;
+    if (!ui) {
+        if (st) cJSON_Delete(st);
+        printf("@maint 造不出帧（内存）\n");
+        fflush(stdout);
+        return;
+    }
+    cJSON_AddStringToObject(ui, "card", "maint");
+    cJSON_AddStringToObject(ui, "emotion", worried ? "worried" : "neutral");
+    on_state(st, 0);
+    cJSON_Delete(st);
+    /* 回读走 `carpet_link_state()` —— 页面上那两行的点和脸都是从这个视图读的，
+     * 印我传进去的那个参数就成了自己给自己打勾。mode：1=idle 3=thinking 4=speaking。 */
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+    printf("@maint sent=%d view.maint_worried=%d card=%s emotion=%s face=%d mode=%d\n",
+           (int)worried, (int)s.maint_worried, s.card[0] ? s.card : "-",
+           s.emotion[0] ? s.emotion : "-", (int)s_face_live, (int)muse_state_mode(NULL));
+    fflush(stdout);
+}
+
+/* 开发口 `>emo <name>`：本机造一帧 ui.emotion=<name> 的 state，走链路收帧时**同一条**
+ * on_state() —— 称的是"这一帧的情绪到底有没有上脸"，不是手点那个枚举（那样称出来的是
+ * 我自己写的那句 switch，不是帧到没到）。name 用契约英文键：neutral/happy/excited/sad/
+ * worried/sleepy/thinking。不带 card，所以不触发养护那三道让路，脸停在 IDLE，情绪才看得清。
+ * 回读走 carpet_link_state()（页面「情绪」那行同源）。不联网、不接模型，这块板在哪都能称。 */
+void carpet_link_bench_emotion(const char *name)
+{
+    if (!s_lock) {
+        printf("@emo 链路还没起（没锁），这一帧发不进去\n");
+        fflush(stdout);
+        return;
+    }
+    const char *key = (name && name[0]) ? name : "neutral";
+    cJSON *st = cJSON_CreateObject();
+    cJSON *ui = st ? cJSON_AddObjectToObject(st, "ui") : NULL;
+    if (!ui) {
+        if (st) cJSON_Delete(st);
+        printf("@emo 造不出帧（内存）\n");
+        fflush(stdout);
+        return;
+    }
+    cJSON_AddStringToObject(ui, "emotion", key);
+    on_state(st, 0);
+    cJSON_Delete(st);
+    carpet_state_view_t s;
+    carpet_link_state(&s);
+    printf("@emo sent=%s view.emotion=%s face=%d mode=%d\n",
+           key, s.emotion[0] ? s.emotion : "-", (int)s_face_live, (int)muse_state_mode(NULL));
+    fflush(stdout);
+}
